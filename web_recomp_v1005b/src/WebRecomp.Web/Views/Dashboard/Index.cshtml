@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="recomp-dashboard">
    <header class="dash-title-row">
        <div>
            <div class="dash-kicker">TODAY</div>
            <h1>@Model.ActionDate.ToString("dddd, MMMM d")</h1>
            <p class="lede">Week @Model.ProgramWeek • @Model.PlanCode</p>
        </div>
        <div class="dash-status @Model.TodayStatusClass">@Model.TodayStatusLabel</div>
    </header>

    @if (Model.NeedsCurrentWeight)
    {
        <section class="card dashboard-weight-needed" aria-labelledby="weight-needed-title">
            <div class="app-kicker">ONE QUICK STEP</div>
            <h2 id="weight-needed-title">Morning weight needed</h2>
            <p>Enter today’s morning weight before Recomp can calculate today’s workout, nutrition, recovery, and glycogen recommendations. Your Dashboard will appear as soon as today’s weight is saved.</p>
            <div class="app-action-row">
                <a class="primary button"
                   asp-controller="Daily"
                   asp-action="Index"
                   asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Enter morning weight</a>
            </div>
        </section>
    }
    else
    {
        <div class="dash-primary-grid">
        <section class="dash-panel dash-workout">
            <div class="dash-panel-label"><span class="dash-number">1</span><span>WORKOUT</span></div>

            <div class="dash-workout-stack">
                <div class="dash-workout-block planned">
                    <span class="dash-workout-step-label">PLANNED</span>
                    <h2>@Model.PlannedWorkout</h2>
                    <div class="dash-workout-meta">
                        @Model.WorkoutDurationMin.ToString("0") min <span>•</span> @Model.WorkoutEffort
                    </div>
                    <p class="dash-workout-description">@Model.WorkoutDescription</p>
                </div>

                <div class="dash-workout-block recomp">
                    <span class="dash-workout-step-label">RECOMP RECOMMENDATION</span>
                    @if (Model.ScheduleChangeRecommended)
                    {
                        <h3>Change to @Model.RecommendedWorkout</h3>
                        <p class="dash-recomp-why"><strong>Why:</strong> @Model.WorkoutRecommendationRationale</p>
                    }
                    else
                    {
                        <h3>Keep Plan</h3>
                    }
                </div>

                <div class="dash-workout-block actual">
                    <span class="dash-workout-step-label">ACTUAL</span>
                    @if (!string.IsNullOrWhiteSpace(Model.WorkoutActual))
                    {
                        <h3>@Model.WorkoutActual</h3>
                    }
                    else
                    {
                        <h3 class="dash-not-logged">Not logged yet</h3>
                    }
                </div>
            </div>
        </section>

        <section class="dash-panel dash-nutrition">
            <div class="dash-panel-label"><span class="dash-number">2</span><span>NUTRITION</span></div>
            <h2>@Model.Calories.ToString("0") <span class="dash-unit">calories</span></h2>
            <div class="dash-macro-grid">
                <div><strong>@Model.ProteinG.ToString("0")</strong><span>Protein</span></div>
                <div><strong>@Model.CarbsG.ToString("0")</strong><span>Carbs</span></div>
                <div><strong>@Model.FatG.ToString("0")</strong><span>Fat</span></div>
            </div>
            <div class="dash-nutrition-class">@Model.NutritionDayLabel</div>
            <p>@Model.NutritionTip</p>

            @if (Model.NutritionActualLogged)
            {
                <div class="dash-actual-line">
                    <strong>Actual so far:</strong>
                    @(Model.ActualCalories?.ToString("0") ?? "—") cal •
                    @(Model.ActualProteinG?.ToString("0") ?? "—") P •
                    @(Model.ActualCarbsG?.ToString("0") ?? "—") C •
                    @(Model.ActualFatG?.ToString("0") ?? "—") F
                </div>
            }
        </section>

        <section class="dash-panel dash-coach">
            <div class="dash-panel-label"><span class="dash-number">3</span><span>COACH</span></div>
            <h2>@Model.CoachTitle</h2>
            <p class="dash-coach-copy">@Model.CoachRecommendation</p>
            <div class="dash-coach-factors">
                @if (Model.EnergyScore.HasValue)
                {
                    <span>Energy @($"{Model.EnergyScore.Value}/10")</span>
                }
                @if (Model.SorenessScore.HasValue)
                {
                    <span>Soreness @($"{Model.SorenessScore.Value}/10")</span>
                }
                @if (Model.SleepHours.HasValue)
                {
                    <span>Sleep @Model.SleepHours.Value.ToString("0.#") h</span>
                }
                <span>Fuel @Model.GlycogenReadiness</span>
            </div>
            <details class="dash-why">
                <summary>Why this recommendation?</summary>
                <p>@Model.CoachWhy</p>
            </details>
        </section>
    </div>

    <section class="dash-tomorrow-repeat-section">
        <div class="dash-section-heading dash-tomorrow-heading">
            <div>
                <div class="dash-kicker">TOMORROW'S PLAN</div>
                <h2>@Model.TomorrowDate.ToString("dddd, MMMM d")</h2>
            </div>
            <span class="dash-preliminary">Preliminary</span>
        </div>

        @if (!Model.TomorrowPlanAvailable)
        {
            <div class="dash-empty">Tomorrow has not been planned yet. Use Weekly Plan to add the session.</div>
        }
        else
        {
            <div class="dash-primary-grid dash-tomorrow-repeat-grid">
                <section class="dash-panel dash-workout dash-tomorrow-panel">
                    <div class="dash-panel-label"><span>WORKOUT</span></div>
                    <h2>@Model.TomorrowWorkout</h2>
                    <p class="dash-focus">@Model.TomorrowFocus</p>
                    <p class="dash-description">@Model.TomorrowDescription</p>
                    <div class="dash-facts">
                        <span><strong>Time</strong> @Model.TomorrowDurationMin?.ToString("0") min</span>
                        <span><strong>Effort</strong> @Model.TomorrowEffort</span>
                    </div>
                </section>

                <section class="dash-panel dash-nutrition dash-tomorrow-panel">
                    <div class="dash-panel-label"><span>NUTRITION</span></div>
                    @if (Model.TomorrowCalories.HasValue)
                    {
                        <h2>@Model.TomorrowCalories.Value.ToString("0") <span class="dash-unit">calories</span></h2>
                        <div class="dash-macro-grid">
                            <div><strong>@Model.TomorrowProteinG?.ToString("0")</strong><span>Protein</span></div>
                            <div><strong>@Model.TomorrowCarbsG?.ToString("0")</strong><span>Carbs</span></div>
                            <div><strong>@Model.TomorrowFatG?.ToString("0")</strong><span>Fat</span></div>
                        </div>
                        <p class="muted">Preliminary target using what Recomp knows today.</p>
                    }
                    else
                    {
                        <p>Nutrition estimate unavailable until a current body weight is available.</p>
                    }
                </section>

                <section class="dash-panel dash-coach dash-tomorrow-panel">
                    <div class="dash-panel-label"><span>COACH</span></div>
                    <h2>Prepare for tomorrow</h2>
                    <p class="dash-coach-copy">@Model.TomorrowTip</p>
                </section>
            </div>
        }
    </section>

    <section class="dash-section dash-fuel-detail">
        <div class="dash-section-heading">
            <div>
                <div class="dash-kicker">FUEL &amp; GLYCOGEN REFILL</div>
                <h2>How yesterday affects today</h2>
            </div>
            <span class="dash-detail-date">@Model.PreviousDate.ToString("MMM d") → @Model.ActionDate.ToString("MMM d")</span>
        </div>

        <div class="dash-fuel-flow">
            <div class="dash-fuel-card">
                <span class="dash-cell-label">1 • Yesterday's nutrition</span>
                @if (!Model.PreviousTargetAvailable && !Model.PreviousNutritionActualLogged)
                {
                    <p>No nutrition target or actual is available for yesterday.</p>
                }
                else
                {
                    <div class="dash-compare-head"><span>Target</span><span>Actual</span></div>
                    <div class="dash-compare-row"><strong>Calories</strong><span>@(Model.PreviousTargetCalories?.ToString("0") ?? "—")</span><span>@(Model.PreviousActualCalories?.ToString("0") ?? "—")</span></div>
                    <div class="dash-compare-row"><strong>Protein</strong><span>@(Model.PreviousTargetProteinG?.ToString("0") ?? "—") g</span><span>@(Model.PreviousActualProteinG?.ToString("0") ?? "—") g</span></div>
                    <div class="dash-compare-row dash-carb-row"><strong>Carbs</strong><span>@(Model.PreviousTargetCarbsG?.ToString("0") ?? "—") g</span><span>@(Model.PreviousActualCarbsG?.ToString("0") ?? "—") g</span></div>
                    <div class="dash-compare-row"><strong>Fat</strong><span>@(Model.PreviousTargetFatG?.ToString("0") ?? "—") g</span><span>@(Model.PreviousActualFatG?.ToString("0") ?? "—") g</span></div>
                    @if (Model.PreviousCarbDifferenceG.HasValue)
                    {
                        <div class="dash-difference @(Model.PreviousCarbDifferenceG.Value < 0 ? "short" : "met")">
                            Carb difference: @Model.PreviousCarbDifferenceG.Value.ToString("+0;-0;0") g
                        </div>
                    }
                    <p class="muted">Target source: @Model.PreviousTargetSource</p>
                }
            </div>

            <div class="dash-flow-arrow" aria-hidden="true">→</div>

            <div class="dash-fuel-card">
                <span class="dash-cell-label">2 • Yesterday's refill</span>
                <div class="dash-big-metric">@Model.PreviousGlycogenDemandG.ToString("0") g</div>
                <span class="muted">Estimated workout glycogen demand</span>
                <div class="dash-refill-line">
                    <div><strong>@(Model.PreviousRestorationCreditG?.ToString("0") ?? "—") g</strong><span>Restoration credit</span></div>
                    <div><strong>@(Model.PreviousRestorationRatio?.ToString("P0") ?? "—")</strong><span>Day refill</span></div>
                </div>
                <p>@Model.PreviousFuelSummary</p>
            </div>

            <div class="dash-flow-arrow" aria-hidden="true">→</div>

            <div class="dash-fuel-card dash-today-impact">
                <span class="dash-cell-label">3 • Today's impact</span>
                <div class="dash-recovery-meter">
                    <div class="dash-meter-value">@Model.AbsoluteRestorationRatio.ToString("P0")</div>
                    <div>
                        <strong>4-day carbohydrate recovery</strong>
                        <span>@Model.FourDayRestorationCreditG.ToString("0") g credit / @Model.FourDayGlycogenDemandG.ToString("0") g demand</span>
                    </div>
                </div>
                <dl class="dash-detail-list">
                    <dt>Recovery target for today's workout</dt><dd>@Model.FunctionalTargetRatio.ToString("P0")</dd>
                    <dt>Target achievement</dt><dd>@Model.TargetAchievementRatio.ToString("P0")</dd>
                    <dt>Fuel readiness</dt><dd>@Model.GlycogenReadiness</dd>
                    <dt>Carbs reserved for recovery</dt><dd>@Model.CarryoverCarbsG.ToString("0") g</dd>
                    <dt>Suggested before training</dt><dd>@Model.PreWorkoutCarbsG.ToString("0") g</dd>
                </dl>
            </div>
        </div>

        <div class="dash-physiology-note">
            <strong>Protein stays high. Training earns additional carbs.</strong>
            Recomp keeps protein high to support lean tissue and recovery, maintains a base carbohydrate intake, and increases carbohydrate when training creates more glycogen-replacement demand. Dietary carbohydrate is the most direct dietary source for restoring muscle glycogen after training. If the day’s protein is covered and calories and fat still fit, some of that carbohydrate can come from enjoyable foods; adherence is part of a sustainable plan.
        </div>
    </section>
    }
</div>
