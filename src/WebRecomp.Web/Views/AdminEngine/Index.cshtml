@model WebRecomp.Web.ViewModels.AdminEngineViewModel

@{
    ViewData["Title"] = "Recomp Engine";
    Layout = "_AdminLayout";

    var calculationGroups = Model.CalculationGroups
        .ToDictionary(
            x => x.Category,
            StringComparer.OrdinalIgnoreCase);

    var categories = Model.Parameters
        .GroupBy(x => x.Category)
        .OrderBy(x =>
            x.Key.StartsWith(
                "Model Calibration",
                StringComparison.OrdinalIgnoreCase)
                    ? 0
                    : 1)
        .ThenBy(x => x.Key)
        .ToArray();

    string FormatValue(decimal value, string unit)
    {
        if (unit == "ratio")
            return value.ToString("0.00");

        if (unit == "g")
            return $"{value:0.#} g";

        if (unit == "score")
            return value.ToString("0.##");

        if (unit == "hours")
            return $"{value:0.##} h";

        if (unit == "seconds")
            return $"{value:0.##} sec";

        return $"{value:0.##} {unit}".Trim();
    }

    string FormatRange(
        decimal? minimum,
        decimal? maximum,
        string unit)
    {
        if (!minimum.HasValue && !maximum.HasValue)
            return "Not specified";

        if (minimum.HasValue && maximum.HasValue)
            return $"{FormatValue(minimum.Value, unit)} – {FormatValue(maximum.Value, unit)}";

        if (minimum.HasValue)
            return $"≥ {FormatValue(minimum.Value, unit)}";

        return $"≤ {FormatValue(maximum!.Value, unit)}";
    }

    string FriendlyBasis(string basis)
        => basis.Replace("_", " ");
}

<div class="admin-engine-page">

    <div class="admin-engine-header">
        <div>
            <div class="eyebrow">RECOMP ENGINE 2.0</div>
            <h1>Engine Configuration</h1>

            <p>
                Review the calculations, dependencies and tunable parameters
                used by the 12 Week Recomp recommendation engine.
                This configuration page is currently read-only.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="Index"
           class="button-secondary">
            Back to Administration
        </a>
    </div>


    <section class="admin-engine-summary">

        <div class="admin-engine-summary-item">
            <span>Configuration</span>
            <strong>@Model.VersionCode</strong>
        </div>

        <div class="admin-engine-summary-item">
            <span>Status</span>
            <strong>@Model.StatusCode</strong>
        </div>

        <div class="admin-engine-summary-item">
            <span>Validation</span>

            @if (Model.IsValid)
            {
                <strong class="engine-valid">
                    PASS
                </strong>
            }
            else
            {
                <strong class="engine-invalid">
                    REVIEW REQUIRED
                </strong>
            }
        </div>

        <div class="admin-engine-summary-item">
            <span>Parameters</span>
            <strong>@Model.Parameters.Count</strong>
        </div>

    </section>


    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <section class="admin-engine-description">
            @Model.Description
        </section>
    }


    @if (!Model.IsValid)
    {
        <section class="admin-engine-validation-errors">

            <h2>Configuration issues</h2>

            <ul>
                @foreach (var issue in Model.ValidationIssues)
                {
                    <li>@issue</li>
                }
            </ul>

        </section>
    }


    <section class="admin-engine-section">

        <div class="admin-engine-section-header">
            <div>
                <div class="eyebrow">
                    ENGINE 2.0 PREVIEW
                </div>

                <h2>Training Prescription Preview</h2>

                <div class="admin-engine-description-small">
                    Shows what the current @Model.VersionCode
                    training model would prescribe for each configured
                    workout. These are preview outputs and do not yet
                    change live recommendations.
                </div>
            </div>

            <span>
                @Model.TrainingPreviews.Count workouts
            </span>
        </div>

        <div class="admin-engine-table-wrap">

            <table class="admin-engine-table">

                <thead>
                <tr>
                    <th>Workout</th>
                    <th>Training Purpose</th>
                    <th>Recommended Dose</th>
                    <th>Intensity</th>
                    <th>Expected Cost</th>
                    <th>Calculation</th>
                </tr>
                </thead>

                <tbody>

                @foreach (var item in Model.TrainingPreviews)
                {
                    <tr>

                        <td>
                            <strong>
                                @item.WorkoutName
                            </strong>

                            <div class="admin-engine-key">
                                @item.WorkoutTypeCode
                            </div>

                            <div class="admin-engine-description-small">
                                @item.TargetArea
                            </div>
                        </td>


                        <td>
                            <strong>
                                @item.TrainingPurpose
                            </strong>

                            <div class="admin-engine-description-small">
                                @item.PhysiologicalPurpose
                            </div>
                        </td>


                        <td>
                            @if (item.ApproximateWorkingSets.HasValue)
                            {
                                <strong>
                                    Approx.
                                    @item.ApproximateWorkingSets
                                    working sets
                                </strong>

                                <div class="admin-engine-description-small">
                                    @item.RecommendedMinutes.ToString("0")
                                    minutes
                                </div>
                            }
                            else
                            {
                                <strong>
                                    @item.RecommendedMinutes.ToString("0")
                                    minutes
                                </strong>

                                <div class="admin-engine-description-small">
                                    @item.PrescriptionModeCode
                                </div>
                            }
                        </td>


                        <td>
                            @if (item.TargetRpeMinimum.HasValue
                                && item.TargetRpeMaximum.HasValue)
                            {
                                <strong>
                                    RPE
                                    @item.TargetRpeMinimum.Value.ToString("0")
                                    –
                                    @item.TargetRpeMaximum.Value.ToString("0")
                                </strong>

                                <div class="admin-engine-description-small">
                                    @(item.RpeScopeCode == "WORKING_SET"
                                        ? "Working-set RPE"
                                        : "Session RPE")
                                </div>
                            }
                            else
                            {
                                <strong>
                                    Purpose-driven
                                </strong>
                            }

                            <div class="admin-engine-description-small">
                                @item.IntensityGuidance
                            </div>
                        </td>


                        <td>
                            @item.ExpectedTrainingCost
                        </td>


                        <td>
                            <details class="engine-rationale">

                                <summary>
                                    How calculated
                                </summary>

                                <div class="engine-rationale-content">

                                    <p>
                                        @item.VolumeBasis
                                    </p>

                                    <dl>
                                        <dt>Prescription mode</dt>
                                        <dd>
                                            @item.PrescriptionModeCode
                                        </dd>

                                        <dt>Duration</dt>
                                        <dd>
                                            @item.RecommendedMinutes.ToString("0")
                                            minutes
                                        </dd>

                                        @if (item.ApproximateWorkingSets.HasValue)
                                        {
                                            <dt>Working sets</dt>
                                            <dd>
                                                Approximately
                                                @item.ApproximateWorkingSets
                                            </dd>
                                        }

                                        @if (item.TargetRpeMinimum.HasValue
                                            && item.TargetRpeMaximum.HasValue)
                                        {
                                            <dt>RPE range</dt>
                                            <dd>
                                                @item.TargetRpeMinimum.Value.ToString("0")
                                                –
                                                @item.TargetRpeMaximum.Value.ToString("0")
                                            </dd>
                                        }
                                    </dl>

                                </div>

                            </details>
                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </section>

    @foreach (var category in categories)
    {
        calculationGroups.TryGetValue(
            category.Key,
            out var calculation);

        <section class="admin-engine-section">

            <div class="admin-engine-section-header">
                <div>
                    <h2>@category.Key</h2>

                    @if (calculation is not null)
                    {
                        <div class="admin-engine-key">
                            @calculation.Title
                        </div>
                    }
                </div>

                <span>@category.Count() parameters</span>
            </div>


            @if (calculation is not null)
            {
                <div class="admin-engine-calculation">

                    <div class="admin-engine-calculation-status">

                        @if (calculation.IntegrationStatusCode == "IMPLEMENTED")
                        {
                            <strong class="engine-valid">
                                @calculation.IntegrationStatusLabel
                            </strong>
                        }
                        else
                        {
                            <strong class="engine-modified">
                                @calculation.IntegrationStatusLabel
                            </strong>
                        }

                        <div class="admin-engine-description-small">
                            @calculation.IntegrationStatusDescription
                        </div>

                    </div>


                    <div class="admin-engine-calculation-block">

                        <h3>What this calculation does</h3>

                        <p>
                            @calculation.Summary
                        </p>

                    </div>


                    <div class="admin-engine-calculation-block">

                        <h3>Actual calculation</h3>

                        <div class="admin-engine-formula">

                            @foreach (var line in calculation.FormulaLines)
                            {
                                @if (string.IsNullOrWhiteSpace(line))
                                {
                                    <div>&nbsp;</div>
                                }
                                else
                                {
                                    <div>@line</div>
                                }
                            }

                        </div>

                    </div>


                    <div class="admin-engine-calculation-block">

                        <h3>How this reaches the recommendation</h3>

                        <div class="admin-engine-dependency">

                            @foreach (var line in calculation.DependencyLines)
                            {
                                @if (string.IsNullOrWhiteSpace(line))
                                {
                                    <div>&nbsp;</div>
                                }
                                else
                                {
                                    <div>@line</div>
                                }
                            }

                        </div>

                    </div>

                </div>
            }


            <div class="admin-engine-table-wrap">

                <table class="admin-engine-table">

                    <thead>
                    <tr>
                        <th>Parameter</th>
                        <th>Current</th>
                        <th>12WR Default</th>
                        <th>Allowed Range</th>
                        <th>Basis</th>
                        <th>Details</th>
                    </tr>
                    </thead>

                    <tbody>

                    @foreach (var item in category)
                    {
                        <tr>

                            <td>
                                <strong>@item.DisplayName</strong>

                                <div class="admin-engine-key">
                                    @item.Key
                                </div>

                                <div class="admin-engine-description-small">
                                    @item.Description
                                </div>

                                @if (!string.IsNullOrWhiteSpace(
                                    item.EffectOnCalculation))
                                {
                                    <div class="admin-engine-parameter-effect">

                                        <strong>
                                            Effect on calculation:
                                        </strong>

                                        @item.EffectOnCalculation

                                    </div>
                                }
                            </td>


                            <td>
                                <strong>
                                    @FormatValue(
                                        item.CurrentValue,
                                        item.Unit)
                                </strong>

                                @if (item.IsModifiedFromDefault)
                                {
                                    <div class="engine-modified">
                                        Modified
                                    </div>
                                }
                                else
                                {
                                    <div class="engine-default-match">
                                        Matches 12WR default
                                    </div>
                                }

                                @if (item.Uses12WrDefault)
                                {
                                    <div class="engine-fallback">
                                        Using catalog fallback
                                    </div>
                                }
                                else
                                {
                                    <div class="engine-stored">
                                        Stored in configuration
                                    </div>
                                }
                            </td>


                            <td>
                                <strong>
                                    @FormatValue(
                                        item.DefaultValue,
                                        item.Unit)
                                </strong>

                                <div class="admin-engine-version">
                                    Default v@item.DefaultVersion
                                </div>
                            </td>


                            <td>
                                @FormatRange(
                                    item.MinimumValue,
                                    item.MaximumValue,
                                    item.Unit)
                            </td>


                            <td>
                                @FriendlyBasis(item.BasisType)
                            </td>


                            <td>

                                <details class="engine-rationale">

                                    <summary>
                                        Why this value?
                                    </summary>

                                    <div class="engine-rationale-content">

                                        <p>
                                            @item.Rationale
                                        </p>

                                        @if (!string.IsNullOrWhiteSpace(
                                            item.EffectOnCalculation))
                                        {
                                            <h4>
                                                Effect on calculation
                                            </h4>

                                            <p>
                                                @item.EffectOnCalculation
                                            </p>
                                        }

                                        <dl>

                                            <dt>Current value</dt>
                                            <dd>
                                                @FormatValue(
                                                    item.CurrentValue,
                                                    item.Unit)
                                            </dd>

                                            <dt>12WR default</dt>
                                            <dd>
                                                @FormatValue(
                                                    item.DefaultValue,
                                                    item.Unit)
                                            </dd>

                                            <dt>Allowed range</dt>
                                            <dd>
                                                @FormatRange(
                                                    item.MinimumValue,
                                                    item.MaximumValue,
                                                    item.Unit)
                                            </dd>

                                            <dt>Basis</dt>
                                            <dd>
                                                @FriendlyBasis(
                                                    item.BasisType)
                                            </dd>

                                            <dt>Introduced</dt>
                                            <dd>
                                                Engine
                                                @item.IntroducedEngineVersion
                                            </dd>

                                            <dt>Default definition</dt>
                                            <dd>
                                                Version
                                                @item.DefaultVersion
                                            </dd>

                                        </dl>

                                        <p class="engine-evidence-note">
                                            Evidence references and
                                            parameter history will be
                                            added as the Engine 2.0
                                            evidence catalog is completed.
                                        </p>

                                    </div>

                                </details>

                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>

        </section>
    }

</div>

