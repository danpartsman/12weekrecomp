@{
    ViewData["Title"] = "Workout Complete";

    var workoutName =
        ViewData["WorkoutName"] as string
        ?? "Completed Workout";

    var duration =
        ViewData["DurationMinutes"] as string
        ?? "-";

    var rpe =
        ViewData["SessionRpe"] as string
        ?? "-";

    var exerciseCount =
        ViewData["ExerciseCount"] is int exercises
            ? exercises
            : 0;

    var workingSets =
        ViewData["WorkingSets"] is int sets
            ? sets
            : 0;

    var calories =
        ViewData["NetCalories"] as string;

    var glycogen =
        ViewData["GlycogenDemand"] as string;

    var analysisAvailable =
        ViewData["AnalysisAvailable"] is bool available
        && available;

    var workoutDateIso =
        ViewData["WorkoutDateIso"] as string
        ?? DateTime.Today.ToString("yyyy-MM-dd");
}

<div class="app-page workout-intelligence-page wi-complete-page">
    <section class="card wi-complete-card">
        <div class="wi-complete-check"
             aria-hidden="true">
            &#10003;
        </div>

        <div class="wi-complete-kicker">
            SEGMENT COMPLETE
        </div>

        <h1>@workoutName</h1>

        <div class="wi-complete-stats">
            <div class="wi-complete-stat">
                <span>Duration</span>
                <strong>@duration min</strong>
            </div>

            <div class="wi-complete-stat">
                <span>RPE</span>
                <strong>@rpe</strong>
            </div>

            <div class="wi-complete-stat">
                <span>Working sets</span>
                <strong>@workingSets</strong>
            </div>

            <div class="wi-complete-stat">
                <span>Exercises</span>
                <strong>@exerciseCount</strong>
            </div>

            @if (analysisAvailable)
            {
                <div class="wi-complete-stat">
                    <span>Workout energy</span>
                    <strong>@calories kcal</strong>
                </div>

                <div class="wi-complete-stat">
                    <span>Glycogen demand</span>
                    <strong>@glycogen g</strong>
                </div>
            }
        </div>

        <section class="wi-complete-sync"
                 aria-label="Workout saved across 12 Week Recomp">
            <strong>Daily Tracking and Dashboard updated</strong>
            <p>
                This completed WorkoutSession is now the actual training record for the day.
                Daily Tracking shows it as completed, and the Dashboard uses the actual duration,
                RPE, calorie estimate and glycogen demand instead of the planned workout estimate.
            </p>

            <div class="wi-actions">
                <a class="button"
                   asp-controller="DailyEntry"
                   asp-action="Index"
                   asp-route-date="@workoutDateIso"
                   asp-fragment="training">
                    View Daily Tracking
                </a>

                <a class="button"
                   asp-controller="Dashboard"
                   asp-action="CommandCentral">
                    View Command Central
                </a>
            </div>
        </section>

        <section class="wi-complete-next-v1012"
                 aria-label="Continue training">
            <strong>Continue training?</strong>
            <p>
                Start another segment with its own independent timer, or finish
                training and return to your dashboard.
            </p>

            <div class="wi-actions">
                <a class="button primary"
                   asp-controller="DetailedWorkout"
                   asp-action="Index"
                   asp-route-mode="start"
                   asp-route-startCategory="system"
                   asp-route-trainingFilter="cardio">
                    Start Cardio
                </a>

                <a class="button"
                   asp-controller="DetailedWorkout"
                   asp-action="Index"
                   asp-route-mode="start"
                   asp-route-startCategory="my"
                   asp-route-trainingFilter="strength">
                    Start Strength
                </a>
            </div>
        </section>

        <a class="button wi-complete-dashboard"
           asp-controller="Dashboard"
           asp-action="CommandCentral">
            Finish Training &amp; Return to Command Central
        </a>
    </section>
</div>