@model WebRecomp.Web.Controllers.CoachWorkspacePage
@{ ViewData["SnapCoachScope"] = Model.CoachId; }
<link rel="stylesheet" href="~/css/coach-photos.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/coach-agreement.css" asp-append-version="true" />
<style>
.coach-workspace-mobile-nav{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:14px}.coach-financial-editor{overflow-x:auto}.coach-financial-table [hidden]{display:none!important}
.coach-financial-table input[type=number]{text-align:center;font-variant-numeric:tabular-nums}
@@media(min-width:701px){.coach-financial-table th:nth-child(n+3),.coach-financial-table td:nth-child(n+3){text-align:center;vertical-align:middle}.coach-financial-table input[type=number]{display:block;margin-inline:auto;max-width:100%;box-sizing:border-box}}

@@media(max-width:700px){.coach-workspace-mobile-nav{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.coach-workspace-mobile-nav .button{display:flex;width:100%;min-height:48px;align-items:center;justify-content:center;box-sizing:border-box;text-align:center}.coach-workspace-page{min-width:0}.coach-workspace-page .card{padding:14px;max-width:100%;box-sizing:border-box;overflow-wrap:anywhere}.coach-workspace-page form{max-width:100%;min-width:0}.coach-workspace-page input:not([type=hidden]):not([type=checkbox]),.coach-workspace-page select,.coach-workspace-page textarea{max-width:100%;box-sizing:border-box;font-size:16px;min-height:46px}.coach-workspace-page textarea{width:100%;min-height:90px}.coach-workspace-page button,.coach-workspace-page .button{min-height:48px;padding:12px 16px;font-size:1rem;white-space:normal}.coach-workspace-page table:not(.coach-financial-table){display:block;max-width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch}.coach-workspace-page fieldset{min-width:0}.coach-workspace-page h1{font-size:1.55rem;line-height:1.25}}
@@media(max-width:700px){.coach-financial-editor{overflow:visible!important}.coach-financial-table,.coach-financial-table tbody,.coach-financial-table tr,.coach-financial-table td{display:block;width:100%;box-sizing:border-box}.coach-financial-table thead{display:none}.coach-financial-table tr{border:1px solid var(--line,#475569);border-radius:12px;padding:12px;margin:12px 0;background:var(--surface,#111827)}.coach-financial-table td{display:flex;align-items:center;justify-content:space-between;gap:12px;border:0!important;padding:7px 0!important;text-align:left!important;white-space:normal!important}.coach-financial-table td:before{content:attr(data-label);font-size:.85rem;font-weight:700;flex:0 0 42%;color:var(--muted,#94a3b8)}.coach-financial-table td.coach-financial-rule{display:block;padding:8px 0!important}.coach-financial-table td.coach-financial-rule:before{display:none}.coach-financial-table td.coach-financial-rule strong{font-size:1.05rem}.coach-financial-table td input,.coach-financial-table td select{width:100%!important;min-width:0;max-width:56%;min-height:46px;box-sizing:border-box;font-size:16px}.coach-financial-table td.coach-financial-rule small{white-space:normal}.coach-macro-table-scroll{overscroll-behavior-x:contain}.coach-macro-table{min-width:760px}.coach-limits-table{width:100%!important}.coach-accept-button{width:100%;min-height:48px}}
.coach-macro-table-scroll{overflow-x:auto;max-width:100%;margin:1rem 0}.coach-macro-table{width:100%;min-width:900px;border-collapse:collapse;table-layout:fixed}.coach-macro-table th,.coach-macro-table td{text-align:center!important;vertical-align:middle;padding:.65rem .35rem;white-space:nowrap;font-variant-numeric:tabular-nums}.coach-macro-table th:first-child,.coach-macro-table td:first-child{text-align:left!important;width:110px;padding-left:.75rem}.coach-limits-panel{margin:1rem 0}.coach-limits-table{width:min(100%,440px)!important;max-width:440px;table-layout:fixed;margin:0!important}.coach-limits-table th,.coach-limits-table td{text-align:left!important;padding:.5rem .75rem!important}.coach-limits-table th:first-child,.coach-limits-table td:first-child{width:70%}.coach-limits-table th:last-child,.coach-limits-table td:last-child{width:30%;text-align:left!important}.coach-accept-button{display:inline-flex!important;align-items:center;justify-content:center;min-height:44px;padding:12px 20px!important;font-size:1rem!important;font-weight:700!important;border-radius:12px!important;cursor:pointer}
</style>
@{ViewData["Title"]="Coach workspace";}
<div class="coach-workspace-page"><section class="coach-photo-heading"><div><h1>@Model.CoachName · Coach workspace</h1></div><img src="/images/coach-workspace-nutrition.webp" width="320" height="160" alt="" decoding="async" /></section>
<nav class="coach-workspace-mobile-nav" aria-label="Coaching shortcuts">
    <a class="button" asp-controller="AccountabilityLedger" asp-action="Index" asp-route-clientId="@Model.ClientId" asp-route-coachUserId="@Model.CoachId">Fees</a>
    @if (Model.IsCoach)
    {
        <a class="button" asp-controller="CoachSummary" asp-action="Day" asp-route-clientId="@Model.ClientId">Daily Review</a>
    }
    <a class="button" asp-controller="SimpleSnap" asp-action="Index" asp-route-clientId="@Model.ClientId" asp-route-coachUserId="@Model.CoachId">Snap Workouts</a>
    @if (SimpleCoaching.Enabled(Context.RequestServices.GetRequiredService<Microsoft.Extensions.Configuration.IConfiguration>()))
    {
        <a class="button" asp-controller="CoachTasks" asp-action="Index" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId">Tasks</a>
    }
    @if (Model.IsCoach)
    {
        <a class="button" asp-controller="Coach" asp-action="Index">Coach Center</a>
    }
    else
    {
        <a class="button" asp-controller="MyCoach" asp-action="Index">My Coach</a>
    }
</nav>
@if(TempData["CoachWorkspaceStatus"] is string status){<p role="status">@status</p>}
@using System.Text.Json
@using WebRecomp.Web.Services.Coaching
<section class="card">
<h2>Macro targets</h2>
@if(Model.MacroOffers.Count==0){<p>No macro targets yet.</p>}
@foreach(var offer in Model.MacroOffers){
<details class="card" open="@(!offer.Accepted)">
<summary><strong>Effective @offer.EffectiveWeek.ToString("MMM d, yyyy")</strong> · @(offer.Accepted?"Accepted":"Review and accept")</summary>
@if(!string.IsNullOrWhiteSpace(offer.Reason)){<p>@offer.Reason</p>}
@if(offer.EngineJson is not null && offer.AdjustedJson is not null){
try{
using var engine=JsonDocument.Parse(offer.EngineJson);
using var adjusted=JsonDocument.Parse(offer.AdjustedJson);
var engineDays=engine.RootElement.EnumerateArray().ToArray();
var coachDays=adjusted.RootElement.EnumerateArray().ToArray();
<div class="coach-macro-table-scroll"><table class="coach-macro-table"><thead><tr><th>Day</th><th>System protein</th><th>Coach protein</th><th>System carbs</th><th>Coach carbs</th><th>System fat</th><th>Coach fat</th><th>System calories</th><th>Coach calories</th></tr></thead><tbody>
@for(var i=0;i<Math.Min(engineDays.Length,coachDays.Length);i++){
var s=engineDays[i];var a=coachDays[i];
decimal number(JsonElement x,string name){return x.TryGetProperty(name,out var v)&&v.ValueKind==JsonValueKind.Number?v.GetDecimal():0m;}
var sp=number(s,"ProteinG");var sc=number(s,"RecommendedCarbsG");var sf=number(s,"FatG");
var cp=number(a,"ProteinG");var cc=number(a,"RecommendedCarbsG");var cf=number(a,"FatG");
<tr><td>@(s.TryGetProperty("Date",out var d)?d.GetString():"Day "+(i+1))</td><td>@sp.ToString("0.#") g</td><td><strong>@cp.ToString("0.#") g</strong></td><td>@sc.ToString("0.#") g</td><td><strong>@cc.ToString("0.#") g</strong></td><td>@sf.ToString("0.#") g</td><td><strong>@cf.ToString("0.#") g</strong></td><td>@((sp*4+sc*4+sf*9).ToString("0"))</td><td><strong>@((cp*4+cc*4+cf*9).ToString("0"))</strong></td></tr>
}
</tbody></table></div>
}catch(JsonException){<p>Macro targets are unavailable. Contact support.</p>}
}
@{var limits=JsonDocument.Parse(offer.RulesJson);}
<details class="coach-limits-panel"><summary>Coach limits</summary><table class="coach-limits-table"><thead><tr><th>Setting</th><th>Value</th></tr></thead><tbody>
@foreach(var rule in limits.RootElement.EnumerateObject().Where(x=>x.Name.EndsWith("Min")||x.Name.EndsWith("Max")||x.Name.EndsWith("Target"))){
<tr><td>@System.Text.RegularExpressions.Regex.Replace(rule.Name,"([a-z])([A-Z])","$1 $2")</td><td>@rule.Value.ToString()</td></tr>
}</tbody></table></details>
@{limits.Dispose();}
@if (offer.FinancialOptIn) { <p>Fees require an accepted agreement.</p> }
@if(offer.Accepted){<p>Accepted @offer.AcceptedUtc?.ToString("MMM d, yyyy h:mm tt") UTC</p>}
else if(!Model.IsCoach){<form asp-action="AcceptMacros" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">@Html.AntiForgeryToken()<input type="hidden" name="versionId" value="@offer.VersionId" /><input type="hidden" name="fingerprint" value="@offer.Fingerprint" /><button class="button coach-accept-button" type="submit">Accept macro targets</button></form>}
else{<p>Awaiting client acceptance.</p>}
</details>}
</section>
<section class="card" id="financial-agreement">
<h2>Fee agreement</h2>
@{var financial=Model.FinancialAgreement!;}
<div class="coach-agreement-summary"><div><strong>Payment terms</strong>@(financial.PaymentSchedule=="next-day"?"Due the following day":financial.PaymentSchedule=="monthly"?"Due on the first day of the following month":$"Due every {financial.PaymentDay}")</div>
<div><strong>Status</strong>@financial.Status.Replace("-", " ") · Revision @financial.Revision @if(financial.AcceptedUtc is DateTime accepted){<span> · Accepted @accepted.ToString("MMM d, yyyy h:mm tt") UTC</span>}</div></div>
<p>New terms require client acceptance.</p>
@if (financial.Rules.Take(4).Any(rule => rule.Enabled && rule.LimitMode == "prescription"))
{
    <p>Older nutrition rules need updated limits and client approval for automatic assessment.</p>
}
@if (financial.Status != "accepted" && financial.AcceptedHistory?.Count > 0)
{
    <p>The accepted agreement is still active.</p>
}
@if(!string.IsNullOrWhiteSpace(financial.ClientNote)){<p><strong>Client response:</strong> @financial.ClientNote</p>}
@if(Model.IsCoach)
{
<details open="@(financial.Status!="accepted")"><summary>Edit proposal</summary>
<form asp-action="FinancialProposal" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">
@Html.AntiForgeryToken()
<input type="hidden" name="ExpectedRevision" value="@financial.Revision" />
<div class="coach-financial-editor"><table class="coach-financial-table"><thead><tr><th>Enable</th><th>Rule</th><th>Amount ($)</th><th>Assess</th><th>Limit type</th><th>Minimum / % under</th><th>Maximum / % over</th></tr></thead><tbody>
@for(var i=0;i<financial.Rules.Count;i++){
var rule=financial.Rules[i];
var limitMode=rule.LimitMode=="actual"?"actual":"system-percent";
var lower=rule.LimitMode=="prescription"?10m:rule.LowerLimit;
var upper=rule.LimitMode=="prescription"?10m:rule.UpperLimit;
var unit=CoachAgreementLimits.Unit(i);
var ruleTitle=i<8?(rule.Name.EndsWith(" penalty")?rule.Name:rule.Name+" penalty"):(rule.Name.EndsWith(" coaches incentive")?rule.Name:rule.Name.Replace(" bonus","")+" coaches incentive");
<tr data-agreement-limit-row data-limit-unit="@unit">
<td data-label="Enabled"><select name="Enabled[@i]" aria-label="Enable @ruleTitle"><option value="false" selected="@(!rule.Enabled)">Off</option><option value="true" selected="@rule.Enabled">On</option></select></td>
<td class="coach-financial-rule"><strong>@ruleTitle</strong><small style="display:block">@(i<4?"Outside the daily nutrition limits selected here":rule.Criterion)</small></td>
<td data-label="Amount ($)"><input type="number" name="Amount[@i]" value="@rule.Amount" min="0" max="10000" step="1" required style="width:90px" /></td>
<td data-label="Assess"><select name="Frequency[@i]"><option value="daily" selected="@(rule.Frequency=="daily")">Daily</option><option value="weekly" selected="@(rule.Frequency=="weekly")">Weekly</option><option value="monthly" selected="@(rule.Frequency=="monthly")">Monthly</option></select></td>
@if(i<4){
<td data-label="Limit type"><select name="LimitMode[@i]" data-limit-mode aria-label="@ruleTitle limit type"><option value="actual" selected="@(limitMode=="actual")">Actual values (@unit)</option><option value="system-percent" selected="@(limitMode=="system-percent")">% under/over system</option></select></td>
<td data-label="@(limitMode=="actual"?$"Minimum ({unit})":"Under system (%)")" data-limit-lower-cell><input type="number" name="LowerLimit[@i]" value="@lower?.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.01" required data-limit-lower aria-label="@ruleTitle lower limit" /></td>
<td data-label="@(limitMode=="actual"?$"Maximum ({unit})":"Over system (%)")" data-limit-upper-cell><input type="number" name="UpperLimit[@i]" value="@upper?.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" step="0.01" required data-limit-upper aria-label="@ruleTitle upper limit" /></td>
}else{
<td colspan="3" data-label="Criterion">As described above<input type="hidden" name="LimitMode[@i]" value="event" /><input type="hidden" name="LowerLimit[@i]" value="" /><input type="hidden" name="UpperLimit[@i]" value="" /></td>
}
<td hidden><input type="hidden" name="Minimum[@i]" value="@rule.Minimum" /><input type="hidden" name="Maximum[@i]" value="@rule.Maximum" /></td>
</tr>
}
</tbody></table></div>
<p>Set limits in g or kcal per day, or as a percentage of the daily system target. Nutrition incentives use the same limits.</p>
@if(financial.Rules.Any(x=>x.Minimum>0||x.Maximum>0)){
<details><summary>Saved fee limits</summary>
@foreach(var savedRule in financial.Rules.Where(x=>x.Minimum>0||x.Maximum>0)){<p>@savedRule.Name: charge threshold @savedRule.Minimum.ToString("C"), cap @savedRule.Maximum.ToString("C") per @savedRule.Frequency period.</p>}
</details>}
<p>Fee corrections are available for 14 days after a period closes.</p>
<fieldset><legend>Payment schedule</legend>
<label>Payment due
<select name="PaymentSchedule">
<option value="next-day" selected="@(financial.PaymentSchedule=="next-day")">Next day</option>
<option value="weekly" selected="@(financial.PaymentSchedule=="weekly")">Weekly</option>
<option value="monthly" selected="@(financial.PaymentSchedule=="monthly")">Monthly (first day of following month)</option>
</select></label>
<label>Weekly due day
<select name="PaymentDay">
@foreach(var day in Enum.GetValues<DayOfWeek>()){<option value="@day" selected="@(financial.PaymentDay==day)">@day</option>}
</select></label>
</fieldset>
<details><summary>Preview proposal</summary>
<p><strong>Coach:</strong> @Model.CoachName · <strong>Agreement revision:</strong> @(financial.Revision+1)</p>
<p>The client sees the enabled rules, amounts, limits and payment schedule you submit.</p>
<ul>
@for(var previewIndex=0;previewIndex<financial.Rules.Count;previewIndex++){
var previewRule=financial.Rules[previewIndex];
var previewTitle=previewIndex<8?(previewRule.Name.EndsWith(" penalty")?previewRule.Name:previewRule.Name+" penalty"):(previewRule.Name.EndsWith(" coaches incentive")?previewRule.Name:previewRule.Name.Replace(" bonus","")+" coaches incentive");
<li>@previewTitle</li>
}
</ul>
<p>Acceptance requires the client’s account email and password.</p>
</details>
<button class="button coach-accept-button" type="submit">Send proposal</button>
</form></details>
}
else
{
@if(financial.Status=="draft"){<p>No proposal yet.</p>}
else{
<partial name="_FinancialAgreementRules" model="financial" />
@if(financial.Rules.Any(x=>x.Enabled&&(x.Minimum>0||x.Maximum>0))){<details><summary>Dollar settlement limits</summary>@foreach(var savedRule in financial.Rules.Where(x=>x.Enabled&&(x.Minimum>0||x.Maximum>0))){<p>@savedRule.Name: charge threshold @savedRule.Minimum.ToString("C"), cap @savedRule.Maximum.ToString("C") per @savedRule.Frequency period.</p>}</details>}
@if(financial.Status=="pending"){
<form class="coach-financial-response" asp-action="FinancialResponse" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">
@Html.AntiForgeryToken()
<input type="hidden" name="expectedRevision" value="@financial.Revision" />
<label>Comments<textarea name="note" rows="3" maxlength="2000" placeholder="Required when requesting changes or declining"></textarea></label>
<fieldset><legend>Confirm acceptance</legend>
<label>Account email<input type="email" name="username" maxlength="320" autocomplete="username" /></label>
<label>Current password<input type="password" name="password" maxlength="1024" autocomplete="current-password" /></label>
</fieldset>
<div class="coach-agreement-response-actions"><button type="submit" name="decision" value="accepted">Accept agreement</button>
<button type="submit" name="decision" value="changes-requested" class="secondary" formnovalidate>Request changes</button>
<button type="submit" name="decision" value="declined" class="secondary" formnovalidate>Decline</button></div>
</form>
}
}
}
@if (Model.IsCoach && (financial.Status == "accepted" || financial.AcceptedHistory?.Count > 0))
{
    <details>
        <summary>Review a day</summary>
        <form asp-action="FinancialReview" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">
            @Html.AntiForgeryToken()
            <label>Date<input type="date" name="date" required /></label>
            <label><input type="checkbox" name="excused" value="true" /> Excuse this day</label>
            <label>Override daily cheat-food count<input type="number" name="cheatFoods" min="0" max="1000" step="1" /></label>
            <p>Clear both fields to remove a review.</p>
            <button type="submit">Save review</button>
        </form>
        @if (financial.Reviews is { Count: > 0 } reviews)
        {
            <ul>
            @foreach (var review in reviews.OrderByDescending(x => x.Key).Take(14))
            {
                <li>@review.Key.ToString("MMM d, yyyy") · @(review.Value.Excused ? "Excused" : "Not excused") · @(review.Value.CheatFoods?.ToString() ?? "—") reviewed cheat foods</li>
            }
            </ul>
        }
    </details>
}
<p><a class="button" asp-controller="CoachWorkspace" asp-action="Index" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" asp-fragment="agreement-discussion">Discuss agreement</a></p>
</section>
<section class="card" id="agreement-discussion"><h2>New discussion</h2>
<form asp-action="Send" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">@Html.AntiForgeryToken()
<input type="hidden" name="Kind" value="message" />
<label>Subject<input name="Subject" maxlength="120" required /></label>
<label>Message<textarea name="Body" maxlength="2000" rows="4" required></textarea></label>
<button class="button" type="submit">Start discussion</button></form></section>
<section class="card"><h2>Discussions</h2>
@{var discussions=Model.Messages.Where(m=>m.Kind=="message").GroupBy(m=>m.ThreadId??m.Id).OrderByDescending(g=>g.Max(m=>m.CreatedUtc)).ToList();}
@if(discussions.Count==0){<p>No discussions yet.</p>}
@foreach(var thread in discussions){
var first=thread.OrderBy(m=>m.CreatedUtc).First();
var last=thread.OrderByDescending(m=>m.CreatedUtc).First();
<details class="card" id="thread-@thread.Key">
<summary><strong>@(first.Subject??"Earlier conversation")</strong> · @thread.Count() @(thread.Count()==1?"message":"messages") · Last reply @last.CreatedUtc.ToString("MMM d, yyyy")</summary>
@foreach(var m in thread.OrderBy(m=>m.CreatedUtc)){
<article style="border-bottom:1px solid #ffffff22;padding:.8rem 0"><strong>@m.AuthorName</strong> <small>@m.CreatedUtc.ToString("MMM d, yyyy h:mm tt") UTC</small><p style="white-space:pre-wrap;overflow-wrap:anywhere">@m.Body</p></article>
}
<form asp-action="Send" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">@Html.AntiForgeryToken()
<input type="hidden" name="Kind" value="message" /><input type="hidden" name="ThreadId" value="@thread.Key" />
<label>Reply<textarea name="Body" maxlength="2000" rows="3" required></textarea></label><button class="button" type="submit">Post reply</button></form>
</details>}
</section>
<section class="card"><h2>Snap Workouts</h2>
@if (Model.Workouts.Count == 0)
{
    <p>No Snap Workouts yet.</p>
}
else
{
    <ul>
    @foreach (var workout in Model.Workouts)
    {
        <li><a asp-controller="SimpleSnap" asp-action="Index" asp-route-clientId="@Model.ClientId"
            asp-route-coachUserId="@Model.CoachId" asp-route-assignment="@workout.Id" asp-fragment="snap-@workout.Id">@workout.Name</a></li>
    }
    </ul>
}
</section>
<section class="card"><h2>Add workout note</h2>
@if(Model.Workouts.Count==0){<p>No Snap Workouts available.</p>}else{
<form asp-action="Send" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">
@Html.AntiForgeryToken()
<input type="hidden" name="Kind" value="snap-note" />
<label for="workout-id">Workout</label><select id="workout-id" name="WorkoutId" required>@foreach(var w in Model.Workouts){<option value="@w.Id">@w.Name</option>}</select>
<label for="note-body">@(Model.IsCoach?"Coach's note to client":"Client's note to coach")</label><textarea id="note-body" name="Body" maxlength="2000" rows="3" required></textarea>
<button type="submit">Send note</button></form>}
</section>
<section class="card"><h2>Workout notes</h2>
@{var notes=Model.Messages.Where(m=>m.Kind=="snap-note").OrderByDescending(m=>m.CreatedUtc).ToList();}
@if(notes.Count==0){<p>No workout notes yet.</p>}
@foreach(var note in notes){<article style="border-bottom:1px solid #ffffff22;padding:.75rem 0"><strong>@note.AuthorName</strong> · <small>@note.CreatedUtc.ToString("MMM d, yyyy h:mm tt") UTC</small> · Workout @note.WorkoutId<p style="white-space:pre-wrap;overflow-wrap:anywhere">@note.Body</p></article>}
</section>
<section class="card"><h2>Activity</h2>
@if(Model.Activity.Count==0){<p>No activity yet.</p>}
@foreach(var a in Model.Activity){<p><small>@a.CreatedUtc.ToString("MMM d, yyyy h:mm tt") UTC</small> · @a.Description</p>}
</section></div>

<script src="~/js/coach-agreement-limits.js" asp-append-version="true" defer></script>
