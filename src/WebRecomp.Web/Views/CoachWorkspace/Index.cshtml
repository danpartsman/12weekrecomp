@model WebRecomp.Web.Controllers.CoachWorkspacePage
<style>
@media(max-width:700px){.coach-financial-editor{overflow:visible!important}.coach-financial-table,.coach-financial-table tbody,.coach-financial-table tr,.coach-financial-table td{display:block;width:100%;box-sizing:border-box}.coach-financial-table thead{display:none}.coach-financial-table tr{border:1px solid var(--line,#475569);border-radius:12px;padding:12px;margin:12px 0;background:var(--surface,#111827)}.coach-financial-table td{display:flex;align-items:center;justify-content:space-between;gap:12px;border:0!important;padding:7px 0!important;text-align:left!important;white-space:normal!important}.coach-financial-table td:before{content:attr(data-label);font-size:.85rem;font-weight:700;flex:0 0 42%;color:var(--muted,#94a3b8)}.coach-financial-table td.coach-financial-rule{display:block;padding:8px 0!important}.coach-financial-table td.coach-financial-rule:before{display:none}.coach-financial-table td.coach-financial-rule strong{font-size:1.05rem}.coach-financial-table td input,.coach-financial-table td select{width:100%!important;min-width:0;max-width:56%;min-height:46px;box-sizing:border-box;font-size:16px}.coach-financial-table td.coach-financial-rule small{white-space:normal}.coach-macro-table-scroll{overscroll-behavior-x:contain}.coach-macro-table{min-width:760px}.coach-limits-table{width:100%!important}.coach-accept-button{width:100%;min-height:48px}}
.coach-macro-table-scroll{overflow-x:auto;max-width:100%;margin:1rem 0}.coach-macro-table{width:100%;min-width:900px;border-collapse:collapse;table-layout:fixed}.coach-macro-table th,.coach-macro-table td{text-align:center!important;vertical-align:middle;padding:.65rem .35rem;white-space:nowrap;font-variant-numeric:tabular-nums}.coach-macro-table th:first-child,.coach-macro-table td:first-child{text-align:left!important;width:110px;padding-left:.75rem}.coach-limits-panel{margin:1rem 0}.coach-limits-table{width:min(100%,440px)!important;max-width:440px;table-layout:fixed;margin:0!important}.coach-limits-table th,.coach-limits-table td{text-align:left!important;padding:.5rem .75rem!important}.coach-limits-table th:first-child,.coach-limits-table td:first-child{width:70%}.coach-limits-table th:last-child,.coach-limits-table td:last-child{width:30%;text-align:left!important}.coach-accept-button{display:inline-flex!important;align-items:center;justify-content:center;min-height:44px;padding:12px 20px!important;font-size:1rem!important;font-weight:700!important;border-radius:12px!important;cursor:pointer}
</style>
@{ViewData["Title"]="Coach workspace";}
<h1>@Model.CoachName · Coach workspace</h1>
<p><a class="button" asp-controller="MyCoach" asp-action="Index">My Coach</a> <a class="button" asp-controller="AccountabilityLedger" asp-action="Index" asp-route-clientId="@Model.ClientId" asp-route-coachUserId="@Model.CoachId">This coach's fees &amp; payments</a> <a class="button" asp-controller="SimpleSnap" asp-action="Index" asp-route-clientId="@Model.ClientId">Snap Workouts</a></p>
@if(TempData["CoachWorkspaceStatus"] is string status){<p role="status">@status</p>}
@using System.Text.Json
<section class="card">
<h2>Coach assignments and macro targets</h2>
<p>Review the system recommendation alongside your coach's prescription. Values are grams per day; calories are calculated from protein, carbohydrates and fat. Targets depend on the saved weekly workouts; a week of rest or unscheduled days may have identical targets.</p>
@if(Model.MacroOffers.Count==0){<p>This coach has not saved a macro prescription yet.</p>}
@foreach(var offer in Model.MacroOffers){
<details class="card" open="@(!offer.Accepted)">
<summary><strong>Effective @offer.EffectiveWeek.ToString("MMM d, yyyy")</strong> · @(offer.Accepted?"Accepted":"Review and accept")</summary>
@if(!string.IsNullOrWhiteSpace(offer.Reason)){<p>@offer.Reason</p>}
@if(offer.EngineJson is not null && offer.AdjustedJson is not null){
try{
using var engine=JsonDocument.Parse(offer.EngineJson);
using var adjusted=JsonDocument.Parse(offer.AdjustedJson);
var engineDays=engine.RootElement.EnumerateArray().ToArray();
var coachDays=adjusted.RootElement.EnumerateArray().ToArray();
<div class="coach-macro-table-scroll"><table class="coach-macro-table"><thead><tr><th>Day</th><th>System protein</th><th>Coach protein</th><th>System carbs</th><th>Coach carbs</th><th>System fat</th><th>Coach fat</th><th>System calories</th><th>Coach calories</th></tr></thead><tbody>
@for(var i=0;i<Math.Min(engineDays.Length,coachDays.Length);i++){
var s=engineDays[i];var a=coachDays[i];
decimal number(JsonElement x,string name){return x.TryGetProperty(name,out var v)&&v.ValueKind==JsonValueKind.Number?v.GetDecimal():0m;}
var sp=number(s,"ProteinG");var sc=number(s,"RecommendedCarbsG");var sf=number(s,"FatG");
var cp=number(a,"ProteinG");var cc=number(a,"RecommendedCarbsG");var cf=number(a,"FatG");
<tr><td>@(s.TryGetProperty("Date",out var d)?d.GetString():"Day "+(i+1))</td><td>@sp.ToString("0.#") g</td><td><strong>@cp.ToString("0.#") g</strong></td><td>@sc.ToString("0.#") g</td><td><strong>@cc.ToString("0.#") g</strong></td><td>@sf.ToString("0.#") g</td><td><strong>@cf.ToString("0.#") g</strong></td><td>@((sp*4+sc*4+sf*9).ToString("0"))</td><td><strong>@((cp*4+cc*4+cf*9).ToString("0"))</strong></td></tr>
}
</tbody></table></div>
}catch(JsonException){<p>The saved prescription could not be displayed. Please contact support.</p>}
}
@{var limits=JsonDocument.Parse(offer.RulesJson);}
<details class="coach-limits-panel"><summary>Coach limits and detailed rules</summary><table class="coach-limits-table"><thead><tr><th>Setting</th><th>Value</th></tr></thead><tbody>
@foreach(var rule in limits.RootElement.EnumerateObject().Where(x=>x.Name.EndsWith("Min")||x.Name.EndsWith("Max")||x.Name.EndsWith("Target"))){
<tr><td>@System.Text.RegularExpressions.Regex.Replace(rule.Name,"([a-z])([A-Z])","$1 $2")</td><td>@rule.Value.ToString()</td></tr>
}</tbody></table></details>
@{limits.Dispose();}
<p><strong>Penalties and incentives:</strong> @(offer.FinancialOptIn?"Requested by coach; subject to a separately accepted financial agreement":"Not requested for this prescription")</p>
@if(offer.Accepted){<p>Accepted @offer.AcceptedUtc?.ToString("MMM d, yyyy h:mm tt") UTC</p>}
else if(!Model.IsCoach){<form asp-action="AcceptMacros" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">@Html.AntiForgeryToken()<input type="hidden" name="versionId" value="@offer.VersionId" /><input type="hidden" name="fingerprint" value="@offer.Fingerprint" /><button class="button coach-accept-button" type="submit">Accept this prescription</button></form>}
else{<p>Waiting for client acceptance.</p>}
</details>}
</section>
<section class="card">
<h2>Penalties, incentives &amp; agreement</h2>
<p>Each coach and client have a separate agreement. Amounts are USD. Rules are proposals until the client accepts them; existing ledger entries remain unchanged.</p>
@{var financial=Model.FinancialAgreement!;}
<p><strong>Payment terms:</strong> @(financial.PaymentSchedule=="next-day"?"Due the following day":financial.PaymentSchedule=="monthly"?"Due on the first day of the following month":$"Due every {financial.PaymentDay}")</p>
<p><strong>Status:</strong> @financial.Status.Replace("-", " ") · Revision @financial.Revision @if(financial.AcceptedUtc is DateTime accepted){<span> · Accepted @accepted.ToString("MMM d, yyyy h:mm tt") UTC</span>}</p>
@if(!string.IsNullOrWhiteSpace(financial.ClientNote)){<p><strong>Client response:</strong> @financial.ClientNote</p>}
@if(Model.IsCoach)
{
<details open="@(financial.Status!="accepted")"><summary>Edit and send financial proposal</summary>
<form asp-action="FinancialProposal" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">
@Html.AntiForgeryToken()
<input type="hidden" name="ExpectedRevision" value="@financial.Revision" />
<div class="coach-financial-editor"><table class="coach-financial-table"><thead><tr><th>Enable</th><th>Rule</th><th>Amount ($)</th><th>Assess</th><th>Minimum per period ($)</th><th>Maximum per period ($)</th></tr></thead><tbody>
@for(var i=0;i<financial.Rules.Count;i++){
var rule=financial.Rules[i];
var ruleTitle=i<8?(rule.Name.EndsWith(" penalty")?rule.Name:rule.Name+" penalty"):(rule.Name.EndsWith(" coaches incentive")?rule.Name:rule.Name.Replace(" bonus","")+" coaches incentive");
<tr>
<td data-label="Enabled"><select name="Enabled[@i]" aria-label="Enable @ruleTitle"><option value="false" selected="@(!rule.Enabled)">Off</option><option value="true" selected="@rule.Enabled">On</option></select></td>
<td class="coach-financial-rule"><strong>@ruleTitle</strong><small style="display:block">@rule.Criterion</small></td>
<td data-label="Amount ($)"><input type="number" name="Amount[@i]" value="@rule.Amount" min="0" max="10000" step="1" required style="width:90px" /></td>
<td data-label="Assess"><select name="Frequency[@i]"><option value="daily" selected="@(rule.Frequency=="daily")">Daily</option><option value="weekly" selected="@(rule.Frequency=="weekly")">Weekly</option><option value="monthly" selected="@(rule.Frequency=="monthly")">Monthly</option></select></td>
<td data-label="Minimum ($)"><input type="number" name="Minimum[@i]" value="@rule.Minimum" min="0" max="10000" step="1" required style="width:90px" /></td>
<td data-label="Maximum ($)"><input type="number" name="Maximum[@i]" value="@rule.Maximum" min="0" max="10000" step="1" required style="width:90px" /></td>
</tr>
}
</tbody></table></div>
<p>For macro penalties, coach-defined nutrition minimums and maximums override the default system thresholds. Financial minimums and maximums above are dollar settlement thresholds and caps, not nutrition targets. The compliance thresholds below follow the coach's prescribed minimum and maximum where present; otherwise they default to 90%–110% of the system's daily target.</p>
@{
    var latestPrescription = Model.MacroOffers.OrderByDescending(x=>x.EffectiveWeek).FirstOrDefault();
}
@if(latestPrescription is not null)
{
    try
    {
        using var prescriptionRules = JsonDocument.Parse(latestPrescription.RulesJson);
        <details><summary>Nutrition compliance limits used for penalties</summary>
        <table><thead><tr><th>Metric</th><th>Lower limit</th><th>Upper limit</th></tr></thead><tbody>
        @foreach(var metric in new[]{("Protein","ProteinMin","ProteinMax"),("Carbs","CarbsMin","CarbsMax"),("Fat","FatMin","FatMax"),("Daily calories","DailyCaloriesMin","DailyCaloriesMax")})
        {
            var lower=prescriptionRules.RootElement.TryGetProperty(metric.Item2,out var low)&&low.ValueKind==JsonValueKind.Number?low.ToString():null;
            var upper=prescriptionRules.RootElement.TryGetProperty(metric.Item3,out var high)&&high.ValueKind==JsonValueKind.Number?high.ToString():null;
            <tr><td>@metric.Item1</td><td>@(lower??"90% of system target")</td><td>@(upper??"110% of system target")</td></tr>
        }
        </tbody></table>
        <p>Coach limits take precedence independently for each bound. A missing lower or upper bound uses the corresponding ±10% system fallback. These limits are displayed for review; automatic financial assessments remain disabled until the assessment engine is integrated.</p>
        </details>
    }
    catch(JsonException){<p>Nutrition prescription limits could not be read.</p>}
}
else
{
    <p>No coach nutrition prescription found: default compliance range is 90%–110% of the system target for protein, carbs, fat and calories.</p>
}
<p>Minimum is a settlement threshold, not a minimum charge. Maximum is a cap for the selected assessment period. Excused days should not generate adherence penalties. A changed proposal requires fresh client approval.</p>
<fieldset><legend>Payment schedule</legend>
<label>Payment due
<select name="PaymentSchedule">
<option value="next-day" selected="@(financial.PaymentSchedule=="next-day")">Next day</option>
<option value="weekly" selected="@(financial.PaymentSchedule=="weekly")">Weekly</option>
<option value="monthly" selected="@(financial.PaymentSchedule=="monthly")">Monthly (first day of following month)</option>
</select></label>
<label>Weekly due day
<select name="PaymentDay">
@foreach(var day in Enum.GetValues<DayOfWeek>()){<option value="@day" selected="@(financial.PaymentDay==day)">@day</option>}
</select></label>
</fieldset>
<details><summary>Preview agreement the client will receive</summary>
<p><strong>Coach:</strong> @Model.CoachName · <strong>Agreement revision:</strong> @(financial.Revision+1)</p>
<p>The client agrees to the enabled penalties and incentives below, subject to coach-prescribed nutrition limits (or ±10% of system targets where no coach limit is set), excused days, and the agreed payment schedule.</p>
<table><thead><tr><th>Rule</th><th>Amount</th><th>Assessment</th><th>Minimum</th><th>Maximum</th></tr></thead><tbody>
@for(var previewIndex=0;previewIndex<financial.Rules.Count;previewIndex++){
var previewRule=financial.Rules[previewIndex];
var previewTitle=previewIndex<8?(previewRule.Name.EndsWith(" penalty")?previewRule.Name:previewRule.Name+" penalty"):(previewRule.Name.EndsWith(" coaches incentive")?previewRule.Name:previewRule.Name.Replace(" bonus","")+" coaches incentive");
<tr><td>@previewTitle</td><td colspan="4">Use the amounts and enabled selections in the editable table above; the client sees the saved values after submission.</td></tr>
}
</tbody></table>
<p>The client will see Accept, Request Changes and Decline options. Accept requires their account email and password.</p>
</details>
<button class="button coach-accept-button" type="submit">Send proposal for client approval</button>
</form></details>
}
else
{
<h3>Financial agreement presented to the client</h3>
<p>The following rules and payment terms are the agreement the client reviews and accepts with their account credentials. Acceptance authorizes only the displayed version.</p>
@if(financial.Status=="draft"){<p>Your coach has not sent a financial proposal.</p>}
else{
<div style="overflow-x:auto"><table><thead><tr><th>Rule</th><th>Amount</th><th>Period</th><th>Minimum</th><th>Maximum</th></tr></thead><tbody>
@foreach(var rule in financial.Rules.Where(x=>x.Enabled)){
var ruleIndex=financial.Rules.ToList().IndexOf(rule);
var ruleTitle=ruleIndex<8?(rule.Name.EndsWith(" penalty")?rule.Name:rule.Name+" penalty"):(rule.Name.EndsWith(" coaches incentive")?rule.Name:rule.Name.Replace(" bonus","")+" coaches incentive");
<tr><td>@ruleTitle <small>@rule.Criterion</small></td><td>@rule.Amount.ToString("C")</td><td>@rule.Frequency</td><td>@rule.Minimum.ToString("C")</td><td>@rule.Maximum.ToString("C")</td></tr>
}</tbody></table></div>
@if(financial.Status=="pending"){
<form asp-action="FinancialResponse" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">
@Html.AntiForgeryToken()
<input type="hidden" name="expectedRevision" value="@financial.Revision" />
<label>Comments or requested changes<textarea name="note" rows="3" maxlength="2000" placeholder="Explain what you would like changed (required if not accepting)"></textarea></label>
<fieldset><legend>One-time agreement verification</legend>
<p>To accept this version of the coach's fees, enter your account username and password. A revised agreement requires another acceptance.</p>
<label>Account username (email)<input type="email" name="username" maxlength="320" autocomplete="username" /></label>
<label>Current password<input type="password" name="password" maxlength="1024" autocomplete="current-password" /></label>
</fieldset>
<button type="submit" name="decision" value="accepted">Verify and accept agreement</button>
<button type="submit" name="decision" value="changes-requested" class="secondary" formnovalidate>Request changes</button>
<button type="submit" name="decision" value="declined" class="secondary" formnovalidate>Decline</button>
</form>
}
}
}
<p><a class="button" asp-controller="CoachWorkspace" asp-action="Index" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" asp-fragment="agreement-discussion">Discuss agreement with coach</a></p>
</section>
<section class="card" id="agreement-discussion"><h2>Start a discussion</h2><p>Either person can start a topic, and replies stay together in the same conversation. The recipient receives an email notification when available.</p>
<form asp-action="Send" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">@Html.AntiForgeryToken()
<input type="hidden" name="Kind" value="message" />
<label>Subject<input name="Subject" maxlength="120" required placeholder="What would you like to discuss?" /></label>
<label>Message<textarea name="Body" maxlength="2000" rows="4" required></textarea></label>
<button class="button" type="submit">Start discussion</button></form></section>
<section class="card"><h2>Discussions</h2>
@{var discussions=Model.Messages.Where(m=>m.Kind=="message").GroupBy(m=>m.ThreadId??m.Id).OrderByDescending(g=>g.Max(m=>m.CreatedUtc)).ToList();}
@if(discussions.Count==0){<p>No discussions yet. Start one above.</p>}
@foreach(var thread in discussions){
var first=thread.OrderBy(m=>m.CreatedUtc).First();
var last=thread.OrderByDescending(m=>m.CreatedUtc).First();
<details class="card" id="thread-@thread.Key">
<summary><strong>@(first.Subject??"Earlier conversation")</strong> · @thread.Count() @(thread.Count()==1?"message":"messages") · Last reply @last.CreatedUtc.ToString("MMM d, yyyy")</summary>
@foreach(var m in thread.OrderBy(m=>m.CreatedUtc)){
<article style="border-bottom:1px solid #ffffff22;padding:.8rem 0"><strong>@m.AuthorName</strong> <small>@m.CreatedUtc.ToString("MMM d, yyyy h:mm tt") UTC</small><p style="white-space:pre-wrap;overflow-wrap:anywhere">@m.Body</p></article>
}
<form asp-action="Send" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">@Html.AntiForgeryToken()
<input type="hidden" name="Kind" value="message" /><input type="hidden" name="ThreadId" value="@thread.Key" />
<label>Reply<textarea name="Body" maxlength="2000" rows="3" required></textarea></label><button class="button" type="submit">Post reply</button></form>
</details>}
</section>
<section class="card"><h2>Snap Workout notes</h2><p>Both coach and client can add notes associated with a specific workout. Notes do not change completed results or fees.</p>
@if(Model.Workouts.Count==0){<p>No Snap Workouts available.</p>}else{
<form asp-action="Send" asp-route-clientId="@Model.ClientId" asp-route-coachId="@Model.CoachId" method="post">
@Html.AntiForgeryToken()
<input type="hidden" name="Kind" value="snap-note" />
<label for="workout-id">Workout</label><select id="workout-id" name="WorkoutId" required>@foreach(var w in Model.Workouts){<option value="@w.Id">@w.Name</option>}</select>
<label for="note-body">@(Model.IsCoach?"Coach's note to client":"Client's note to coach")</label><textarea id="note-body" name="Body" maxlength="2000" rows="3" required></textarea>
<button type="submit">Save note and notify</button></form>}
</section>
<section class="card"><h2>Snap Workout note history</h2>
@{var notes=Model.Messages.Where(m=>m.Kind=="snap-note").OrderByDescending(m=>m.CreatedUtc).ToList();}
@if(notes.Count==0){<p>No workout notes yet.</p>}
@foreach(var note in notes){<article style="border-bottom:1px solid #ffffff22;padding:.75rem 0"><strong>@note.AuthorName</strong> · <small>@note.CreatedUtc.ToString("MMM d, yyyy h:mm tt") UTC</small> · Workout @note.WorkoutId<p style="white-space:pre-wrap;overflow-wrap:anywhere">@note.Body</p></article>}
</section>
<section class="card"><h2>Coach activity history</h2>
@if(Model.Activity.Count==0){<p>No coaching activity recorded yet.</p>}
@foreach(var a in Model.Activity){<p><small>@a.CreatedUtc.ToString("MMM d, yyyy h:mm tt") UTC</small> · @a.Description</p>}
</section>