@{
    Layout = null;
    ViewData["Title"] = "12 Week Recomp — Break Free";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#02070b" />
    <title>12 Week Recomp — Break Free</title>
    <link rel="stylesheet" href="~/css/welcome-portal-stable-v1012.css" asp-append-version="true" />
</head>
<body>
<main class="wr-page" data-wr-page>
    <header class="wr-nav">
        <a class="wr-brand" href="/welcome-portal"><span>12 WEEK</span> <em>RECOMP</em></a>
        <nav aria-label="12 Week Recomp">
            <a class="active" href="/welcome-portal">Home</a>
            <a href="/recomp/what">What is Recomp</a>
            <a href="/recomp/how">How it Works</a>
            <a href="/recomp/evidence">Evidence</a>
        </nav>
        <a class="wr-account" href="/recomp/start">Create Free Account</a>
    </header>

    <section class="wr-hero">
        <div class="wr-hero-bg" aria-hidden="true"></div>
        <div class="wr-grid" aria-hidden="true"></div>
        <div class="wr-glow wr-glow-cyan" aria-hidden="true"></div>
        <div class="wr-glow wr-glow-green" aria-hidden="true"></div>

        <div class="wr-copy">
            <p class="wr-kicker">SCIENCE-DRIVEN WELLNESS FOR REAL LIFE</p>
            <h1>BREAK FREE.<br /><span>REBUILD STRONGER.</span></h1>
            <p class="wr-lead">One coordinated system for training, nutrition, recovery and real-world consistency — built around you.</p>
            <div class="wr-actions">
                <a class="wr-primary" href="/recomp/start">START YOUR 12 WEEKS <span>→</span></a>
                <a class="wr-secondary" href="/recomp/how">SEE HOW IT WORKS</a>
            </div>
            <div class="wr-signals" aria-label="Program pillars">
                <span>TRAIN</span><i></i><span>FUEL</span><i></i><span>RECOVER</span><i></i><span>ADAPT</span>
            </div>
        </div>

        <div class="wr-hero-mark" aria-hidden="true">
            <div class="wr-ring"></div>
            <div class="wr-mark">12<span>WEEK</span><strong>RECOMP</strong><small>UNBOUND · ENERGIZED · ALIVE</small></div>
        </div>

        <div class="wr-break-left" aria-hidden="true">NO MORE<br /><strong>NOISE</strong></div>
        <div class="wr-break-right" aria-hidden="true">BUILD A<br /><strong>STRONGER YOU</strong></div>
    </section>

    <section class="wr-paths" aria-label="Explore 12 Week Recomp">
        <a class="wr-card cyan" href="/recomp/what">
            <span class="wr-card-art art-what" aria-hidden="true"></span>
            <span class="wr-card-shade" aria-hidden="true"></span>
            <span class="wr-card-content"><small>01</small><strong>WHAT IS<br />RECOMP?</strong><em>Real change. Real you.</em><b>→</b></span>
        </a>
        <a class="wr-card green" href="/recomp/how">
            <span class="wr-card-art art-how" aria-hidden="true"></span>
            <span class="wr-card-shade" aria-hidden="true"></span>
            <span class="wr-card-content"><small>02</small><strong>HOW DOES<br />IT WORK?</strong><em>Simple system. Clear signals.</em><b>→</b></span>
        </a>
        <a class="wr-card gold" href="/recomp/evidence">
            <span class="wr-card-art art-evidence" aria-hidden="true"></span>
            <span class="wr-card-shade" aria-hidden="true"></span>
            <span class="wr-card-content"><small>03</small><strong>THE<br />EVIDENCE</strong><em>Less hype. More signal.</em><b>→</b></span>
        </a>
        <a class="wr-card purple" href="/recomp/start">
            <span class="wr-card-art art-plan" aria-hidden="true"></span>
            <span class="wr-card-shade" aria-hidden="true"></span>
            <span class="wr-card-content"><small>04</small><strong>BUILD YOUR<br />FREE PLAN</strong><em>Your plan. Your future.</em><b>→</b></span>
        </a>
    </section>

    <section class="wr-bottom">
        <div><strong>MORE ENERGY</strong><span>Build capacity for real life.</span></div>
        <div><strong>BETTER HEALTH</strong><span>Support sustainable habits.</span></div>
        <div><strong>CLEARER DIRECTION</strong><span>Know what matters today.</span></div>
        <div><strong>A STRONGER YOU</strong><span>Progress you can actually use.</span></div>
    </section>

    <button class="wr-energy" type="button" data-wr-energy aria-pressed="false">ENERGY +</button>
</main>
<script>
(() => {
    const page = document.querySelector('[data-wr-page]');
    const button = document.querySelector('[data-wr-energy]');
    const cards = [...document.querySelectorAll('.wr-card')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    button?.addEventListener('click', () => {
        const on = page.classList.toggle('energy-max');
        button.setAttribute('aria-pressed', on ? 'true' : 'false');
        button.textContent = on ? 'ENERGY MAX' : 'ENERGY +';
    });

    if (!reduced) {
        cards.forEach(card => {
            card.addEventListener('pointermove', e => {
                const r = card.getBoundingClientRect();
                const x = (e.clientX - r.left) / r.width - .5;
                const y = (e.clientY - r.top) / r.height - .5;
                card.style.transform = `perspective(850px) rotateX(${(-y * 5).toFixed(2)}deg) rotateY(${(x * 7).toFixed(2)}deg) translateY(-7px)`;
            });
            card.addEventListener('pointerleave', () => card.style.transform = '');
        });
    }
})();
</script>
@await Component.InvokeAsync("FreeUseOverlay")</body>
</html>
