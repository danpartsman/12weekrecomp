@{
    Layout = null;
    ViewData["Title"] = "12 Week Recomp — Break Free";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#02070b" />
    <title>12 Week Recomp — Break Free</title>
    <link rel="stylesheet" href="~/css/welcome-img-main-v1012.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/welcome-img-strength-v1012.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/welcome-portal-v1012.css" asp-append-version="true" />
</head>
<body class="wp-page">
<main class="wp-stage" data-wp-stage>
    <div class="wp-hero-media" data-wp-hero aria-hidden="true"></div>
    <div class="wp-hero-shade" aria-hidden="true"></div>
    <div class="wp-hero-bloom wp-bloom-cyan" aria-hidden="true"></div>
    <div class="wp-hero-bloom wp-bloom-green" aria-hidden="true"></div>
    <div class="wp-grid" aria-hidden="true"></div>
    <div class="wp-sweep" aria-hidden="true"></div>
    <div class="wp-cursor" data-wp-cursor aria-hidden="true"></div>

    <header class="wp-nav">
        <a class="wp-brand" href="/welcome-portal"><span>12 WEEK</span> <em>RECOMP</em></a>
        <nav aria-label="12 Week Recomp">
            <a href="/recomp/what">What Is Recomp</a>
            <a href="/recomp/how">How It Works</a>
            <a href="/recomp/evidence">Evidence</a>
        </nav>
        <a class="wp-nav-cta" href="/recomp/start">CREATE FREE ACCOUNT</a>
    </header>

    <section class="wp-copy" aria-labelledby="wp-title">
        <p class="wp-kicker">UNBOUND · ENERGIZED · ALIVE</p>
        <h1 id="wp-title"><span>BREAK</span><strong>FREE.</strong></h1>
        <p class="wp-sub">TRAIN. FUEL. RECOVER. BECOME.</p>
        <div class="wp-actions">
            <a class="wp-primary" href="/recomp/start">START YOUR 12 WEEKS <b>→</b></a>
            <button class="wp-energy" type="button" data-wp-energy aria-pressed="false">ENERGY +</button>
        </div>
    </section>

    <aside class="wp-rail" aria-label="Change scene">
        <button type="button" class="is-active" data-wp-scene="main" aria-label="Together">01</button>
        <button type="button" data-wp-scene="strength" aria-label="Strength">02</button>
        <button type="button" data-wp-scene="power" aria-label="Power">03</button>
        <button type="button" data-wp-scene="team" aria-label="Community">04</button>
    </aside>

    <section class="wp-paths" aria-label="Explore 12 Week Recomp">
        <a class="wp-path cyan" href="/recomp/what" data-wp-preview="strength">
            <span class="wp-path-tint"></span>
            <div><small>01</small><strong>WHAT IS RECOMP?</strong><em>REAL CHANGE. REAL YOU.</em></div><b>→</b>
        </a>
        <a class="wp-path green" href="/recomp/how" data-wp-preview="rope">
            <span class="wp-path-tint"></span>
            <div><small>02</small><strong>HOW IT WORKS</strong><em>TRAIN. FUEL. ADAPT.</em></div><b>→</b>
        </a>
        <a class="wp-path gold" href="/recomp/evidence" data-wp-preview="team">
            <span class="wp-path-tint"></span>
            <div><small>03</small><strong>THE EVIDENCE</strong><em>LESS HYPE. MORE SIGNAL.</em></div><b>→</b>
        </a>
        <a class="wp-path purple" href="/recomp/start" data-wp-preview="dumbbell">
            <span class="wp-path-tint"></span>
            <div><small>04</small><strong>BUILD YOUR PLAN</strong><em>FREE. INDIVIDUALIZED. YOURS.</em></div><b>→</b>
        </a>
    </section>

    <div class="wp-mantra" aria-hidden="true"><span>MORE ENERGY</span><span>MORE STRENGTH</span><span>MORE YOU</span></div>
</main>
<script src="~/js/welcome-portal-v1012.js" asp-append-version="true"></script>
</body>
</html>
