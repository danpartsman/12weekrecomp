@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    Layout = null;
    ViewData["Title"] = "12 Week Recomp — Break Free";

    var heroDirectory = System.IO.Path.Combine(Env.WebRootPath, "images", "marketing-v17");
    var heroBase64 = new System.Text.StringBuilder(105000);
    for (var part = 1; part <= 12; part++)
    {
        var heroPart = System.IO.Path.Combine(heroDirectory, $"hero900.part{part:00}.b64");
        heroBase64.Append(System.IO.File.ReadAllText(heroPart));
    }
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="theme-color" content="#02070b" />
    <title>12 Week Recomp — Break Free</title>
    <link rel="stylesheet" href="~/css/welcome-portal-final-v1012.css" asp-append-version="true" />
</head>
<body>
<main class="portal-stage" data-portal-stage aria-label="12 Week Recomp Break Free welcome portal">
    <div class="portal-free-banner">
        <strong>NOW — THE ENTIRE PROGRAM IS COMPLETELY FREE!</strong>
        <span>Donate a little something if you feel it was worthwhile.</span>
        <a href="/recomp/start">START FREE →</a>
    </div>

    <div class="portal-canvas">
        <img class="portal-art"
             src="data:image/jpeg;base64,@heroBase64"
             alt="12 Week Recomp — Break Free from programming, narratives, toxins, environmental pressures, depression, ailments, aging and medications"
             width="900" height="507" fetchpriority="high" decoding="sync" />
        <div class="portal-sheen" aria-hidden="true"></div>

        <a class="portal-hit hit-what-top" href="/recomp/what" aria-label="What is Recomp"></a>
        <a class="portal-hit hit-how-top" href="/recomp/how" aria-label="How it works"></a>
        <a class="portal-hit hit-evidence-top" href="/recomp/evidence" aria-label="Evidence"></a>
        <a class="portal-hit hit-account-top" href="/recomp/start" aria-label="Create free account"></a>
        <a class="portal-hit hit-start" href="/recomp/start" aria-label="Start your 12 weeks"></a>
        <button class="portal-hit hit-energy" type="button" data-portal-energy aria-label="Toggle Energy Max"></button>
        <a class="portal-hit hit-card-what" href="/recomp/what" aria-label="What is Recomp"></a>
        <a class="portal-hit hit-card-how" href="/recomp/how" aria-label="How it works"></a>
        <a class="portal-hit hit-card-evidence" href="/recomp/evidence" aria-label="The evidence"></a>
        <a class="portal-hit hit-card-plan" href="/recomp/start" aria-label="Build your plan"></a>
        <a class="portal-hit hit-dot-1" href="/recomp/what" aria-label="What is Recomp"></a>
        <a class="portal-hit hit-dot-2" href="/recomp/how" aria-label="How it works"></a>
        <a class="portal-hit hit-dot-3" href="/recomp/evidence" aria-label="The evidence"></a>
        <a class="portal-hit hit-dot-4" href="/recomp/start" aria-label="Build your plan"></a>
    </div>

    <div class="portal-mobile" aria-label="Mobile navigation">
        <a href="/recomp/what">What is Recomp? <span>→</span></a>
        <a href="/recomp/how">How it works <span>→</span></a>
        <a href="/recomp/evidence">The evidence <span>→</span></a>
        <a href="/recomp/start">Build your plan <span>→</span></a>
        <a class="primary" href="/recomp/start">Start your 12 weeks</a>
    </div>
</main>
<script>
(() => {
    const stage = document.querySelector('[data-portal-stage]');
    const energy = document.querySelector('[data-portal-energy]');
    if (!stage || !energy) return;
    energy.addEventListener('click', () => stage.classList.toggle('energy-max'));
})();
</script>
</body>
</html>
