@{
    Layout = null;
    ViewData["Title"] = "12 Week Recomp — Ascend Scene";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>12 Week Recomp — Ascend Scene</title>
    <link rel="stylesheet" href="~/css/welcome-scenes-v1012.css" asp-append-version="true" />
</head>
<body class="ws-page">
<header class="ws-top">
    <a class="ws-brand" href="/welcome-lab">12 WEEK <em>RECOMP</em></a>
    <nav class="ws-nav" aria-label="Concept navigation">
        <a href="/welcome-lab/break-free">Poster</a>
        <a href="/welcome-lab/hotspots">Hotspots</a>
        <a href="/welcome-lab/cards">Cards</a>
        <a class="primary" href="/trial/start">Start</a>
    </nav>
</header>
<main class="ws-scene ws-ascend-page">
    <div class="ws-bg" aria-hidden="true"></div>
    <div class="ws-vignette" aria-hidden="true"></div>
    <div class="ws-noise" aria-hidden="true"></div>
    <div class="ws-beam a" aria-hidden="true"></div><div class="ws-beam b" aria-hidden="true"></div>
    <div class="ws-cursor" aria-hidden="true"></div>

    <section class="ws-freedom-title">
        <p class="ws-eyebrow">NO CARDS · NO BOXES · JUST THE MOMENT</p>
        <h1><span data-ws-phrase>UNBOUND.</span><br /><span>ALIVE.</span></h1>
        <p>Stronger. Clearer. Moving forward.</p>
        <a class="ws-cta" href="/trial/start">Build what comes next →</a>
    </section>

    <aside class="ws-phrase-rail" aria-label="Change the main message">
        <button class="active" type="button" data-ws-phrase-button="UNBOUND.">Unbound</button>
        <button type="button" data-ws-phrase-button="BREAK FREE.">Break free</button>
        <button type="button" data-ws-phrase-button="REBUILD DRIVE.">Rebuild drive</button>
        <button type="button" data-ws-phrase-button="CLAIM YOUR LIFE.">Claim your life</button>
    </aside>

    <button class="ws-hotspot cyan" style="left:47%;top:30%" type="button" data-ws-drag data-ws-panel data-label="MOVE" data-title="Make the interface yours" data-copy="Drag this point anywhere. The page should feel alive, not like a brochure."><span><strong>MOVE ME</strong><small>drag</small></span></button>
    <button class="ws-hotspot gold" style="left:60%;bottom:20%" type="button" data-ws-drag data-ws-panel data-label="MOMENTUM" data-title="Stack the next win" data-copy="Momentum comes from repeatable wins, not from perfect days."><span><strong>NEXT WIN</strong><small>drag</small></span></button>
    <button class="ws-hotspot" style="right:22%;top:43%" type="button" data-ws-drag data-ws-panel data-label="ASCEND" data-title="Live stronger" data-copy="The end point is not a smaller life. It is more strength, more energy and more capability."><span><strong>ASCEND</strong><small>drag</small></span></button>

    <div class="ws-panel" aria-live="polite">
        <button class="close" type="button" aria-label="Close">×</button>
        <span class="label">ASCEND</span>
        <h2>Choose the message</h2>
        <p>Use the right-side controls or move the glowing nodes.</p>
    </div>

    <nav class="ws-dock" aria-label="Concept navigation"><a href="/welcome-lab/break-free">Poster</a><a href="/welcome-lab/hotspots">Hotspots</a><a href="/welcome-lab/cards">Cards</a><a href="/welcome-lab/ascend">Ascend</a></nav>
</main>
<script src="~/js/welcome-scenes-v1012.js" asp-append-version="true"></script>
</body>
</html>
