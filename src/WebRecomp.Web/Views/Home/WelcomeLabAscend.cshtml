@{
    Layout = null;
    ViewData["Title"] = "12 Week Recomp — Ascend Scene";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>12 Week Recomp — Ascend Scene</title>
    <link rel="stylesheet" href="~/css/welcome-scenes-v1012.css" asp-append-version="true" />
</head>
<body class="ws-page">
<header class="ws-top">
    <a class="ws-brand" href="/welcome-lab">12 WEEK <em>RECOMP</em></a>
    <nav class="ws-nav" aria-label="Explore 12 Week Recomp">
        <a href="/recomp/what">What is Recomp?</a>
        <a href="/recomp/how">How it Works</a>
        <a href="/recomp/evidence">Evidence</a>
        <a class="primary" href="/recomp/start">Start Free</a>
    </nav>
</header>
<main class="ws-scene ws-ascend-page">
    <div class="ws-bg" aria-hidden="true"></div>
    <div class="ws-vignette" aria-hidden="true"></div>
    <div class="ws-noise" aria-hidden="true"></div>
    <div class="ws-beam a" aria-hidden="true"></div><div class="ws-beam b" aria-hidden="true"></div>
    <div class="ws-cursor" aria-hidden="true"></div>

    <section class="ws-freedom-title">
        <p class="ws-eyebrow">NO CARDS · NO BOXES · JUST THE MOMENT</p>
        <h1><span data-ws-phrase>UNBOUND.</span><br /><span>ALIVE.</span></h1>
        <p>Stronger. Clearer. Moving forward.</p>
        <a class="ws-cta" href="/recomp/start">Build what comes next →</a>
    </section>

    <aside class="ws-phrase-rail" aria-label="Change the main message">
        <button class="active" type="button" data-ws-phrase-button="UNBOUND.">Unbound</button>
        <button type="button" data-ws-phrase-button="BREAK FREE.">Break free</button>
        <button type="button" data-ws-phrase-button="REBUILD DRIVE.">Rebuild drive</button>
        <button type="button" data-ws-phrase-button="CLAIM YOUR LIFE.">Claim your life</button>
    </aside>

    <a class="ws-hotspot cyan" style="left:47%;top:30%" href="/recomp/what" data-ws-drag><span><strong>WHAT</strong><small>open</small></span></a>
    <a class="ws-hotspot gold" style="left:60%;bottom:20%" href="/recomp/how" data-ws-drag><span><strong>HOW</strong><small>open</small></span></a>
    <a class="ws-hotspot" style="right:22%;top:43%" href="/recomp/evidence" data-ws-drag><span><strong>EVIDENCE</strong><small>open</small></span></a>

    <nav class="ws-dock" aria-label="Concept navigation"><a href="/welcome-lab/break-free">Poster</a><a href="/welcome-lab/hotspots">Hotspots</a><a href="/welcome-lab/cards">Cards</a><a href="/welcome-lab/ascend">Ascend</a></nav>
</main>
<script src="~/js/welcome-scenes-v1012.js" asp-append-version="true"></script>
@await Component.InvokeAsync("FreeUseOverlay")</body>
</html>
