@{
    Layout = null;
    ViewData["Title"] = "12 Week Recomp — Ascend";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>12 Week Recomp — Ascend</title>
    <link rel="stylesheet" href="~/css/welcome-lab-v1012.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/welcome-lab-art-v1012.css" asp-append-version="true" />
</head>
<body class="wl-page">
<header class="wl-topbar">
    <a class="wl-brand" href="/welcome-lab">12 WEEK <em>RECOMP</em></a>
    <a class="wl-back" href="/welcome-lab">← All concepts</a>
    <a class="wl-cta-mini" href="/trial/start">Begin</a>
</header>
<main class="wl-borderless" data-wl-parallax>
    <div class="wl-bg wl-art-4" aria-hidden="true"></div>
    <div class="wl-vignette" style="background:linear-gradient(90deg,rgba(0,0,0,.80) 0%,rgba(0,0,0,.48) 33%,rgba(0,0,0,.06) 67%,rgba(0,0,0,.28)),linear-gradient(180deg,rgba(0,0,0,.12),rgba(0,0,0,.58))"></div>
    <div class="wl-scan"></div>
    <div class="wl-motion-line one"></div><div class="wl-motion-line two"></div>

    <section class="wl-borderless-copy">
        <p class="wl-kicker">CONCEPT D · NO CARDS · NO BOXES</p>
        <h1><span data-wl-phrase>UNBOUND.</span><br /><span class="green">ALIVE.</span></h1>
        <p class="wl-sub">Not smaller. Not punished. Not trapped in another restart. Stronger, clearer, moving forward.</p>
        <div class="wl-actions"><a class="wl-btn primary" href="/trial/start">Build what comes next →</a></div>
    </section>

    <aside class="wl-side-rail" aria-label="Change the message">
        <button type="button" data-phrase="BREAK FREE.">Break free</button>
        <button type="button" data-phrase="REBUILD DRIVE.">Rebuild drive</button>
        <button type="button" data-phrase="GET STRONG.">Get strong</button>
        <button type="button" data-phrase="CLAIM YOUR LIFE.">Claim your life</button>
    </aside>

    <div class="wl-hotspot cyan wl-drag" style="left:47%;top:22%" tabindex="0" data-title="MOVE IT" data-copy="This concept treats the interface like a living poster. Drag this node anywhere you want."><div><strong>MOVE ME</strong><small>drag</small></div></div>
    <div class="wl-hotspot gold wl-drag" style="left:62%;bottom:18%" tabindex="0" data-title="THE NEXT WIN" data-copy="Momentum is built from repeatable wins, not perfect days."><div><strong>NEXT WIN</strong><small>drag</small></div></div>
    <div class="wl-tooltip" role="status"></div>
    <nav class="wl-dock" aria-label="Concept navigation"><a href="/welcome-lab/break-free">Poster</a><a href="/welcome-lab/hotspots">Hotspots</a><a href="/welcome-lab/cards">Cards</a><a href="/welcome-lab/ascend">Ascend</a></nav>
</main>
<script src="~/js/welcome-lab-v1012.js" asp-append-version="true"></script>
</body>
</html>