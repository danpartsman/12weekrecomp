@{
    ViewData["Title"] = "Welcome";
}

<div class="simple-marketing welcome-v12" data-marketing-page="welcome">

    <section class="wv10-hero">
        <div class="wv10-hero-copy">
            <div class="sm-kicker">12 WEEK RECOMP</div>
            <h1>Stop Dieting.<br /><span>Start Recomposing.</span></h1>
            <p class="sm-lede">
                Build or preserve lean muscle while reducing body fat.
                Learn how to train, refuel and recover without turning food into the enemy.
            </p>
        </div>

        <div class="wv10-hero-picture sm-picture-card">
            <img src="~/images/marketing-v4/welcome-a-community.jpg"
                 alt="Adults enjoying fitness together outdoors" />
            <div class="sm-picture-caption">
                <strong>Real life. Real food. Real training.</strong>
                <span>A system you can actually live with.</span>
            </div>
        </div>
    </section>

    <section class="wv10-toning">
        <div class="wv10-toning-copy">
            <div class="sm-kicker">TONING IS RECOMP</div>
            <h2>A toned body does not happen without more muscle and less fat.</h2>

            <p>
                The look people call toned comes from building or preserving lean muscle
                while reducing body fat.
            </p>

            <div class="sm-highlight sm-highlight-exact">
                <strong>That is exactly 12 Week Recomp!</strong>
            </div>
        </div>

        <div class="wv10-toning-picture sm-picture-card">
            <img src="~/images/marketing-v10/welcome-toned-woman-v10.png"
                 alt="A toned younger woman after a workout in a bright gym" />
        </div>
    </section>

    <section class="wv10-steps">
        <div class="sm-kicker">THE BASIC IDEA IN 3 STEPS</div>
        <h2>12 Week Recomp makes it simple.</h2>

        <div class="wv10-steps-grid">
            <article class="wv10-step-card">
                <div class="wv10-step-number">1</div>
                <h3>Work the muscle</h3>
                <p>Lift hard enough to use glycogen and create the muscle-building signal.</p>
            </article>

            <article class="wv10-step-card">
                <div class="wv10-step-number wv10-step-number-green">2</div>
                <h3>Refuel the muscle</h3>
                <p>Use carbs to refill glycogen and keep protein high to support lean muscle.</p>
            </article>

            <article class="wv10-step-card">
                <div class="wv10-step-number wv10-step-number-gold">3</div>
                <h3>Burn body fat over the week</h3>
                <p>Keep the overall weekly calorie deficit so stored body fat comes down.</p>
            </article>
        </div>
    </section>

    <section class="wv10-food">
        <div class="wv10-food-picture sm-picture-card">
            <img src="~/images/marketing-v4/welcome-c-food.jpg"
                 alt="A protein rich meal with fruit and a dessert" />
        </div>

        <div class="wv10-food-copy">
            <div class="sm-kicker">CARBS ARE FUEL</div>
            <h2>Carbs are fuel.</h2>

            <p>
                After demanding training, carbohydrate helps replace the glycogen your muscles used.
                Some of those carbs can come from foods you enjoy, including dessert,
                when the food still fits your calorie, protein and nutrition targets for the day.
            </p>

            <div class="wv10-food-quote">
                Whole foods do most of the nutritional heavy lifting, but Recomp simply does not require
                pretending that a cookie, pie or brownie suddenly stops becoming a carbohydrate.
            </div>
        </div>
    </section>

    <section class="wv12-coaches sm-section">
        <div class="wv10-coach-copy">
            <div class="sm-kicker">THE DETAILS ARE PERSONAL</div>
            <h2>Your coaches + the individualized Recomp planning engine.</h2>

            <p class="sm-coach-lead">
                Your 12 Week Recomp coaches walk you through every day's exercise and nutrition plan
                to help you make it happen.
            </p>

            <p>
                The individualized Recomp planning engine helps determine what to do,
                how to fuel it, and how to adjust as you go.
            </p>
        </div>

        <div class="wv12-coach-visual sm-picture-card">
            <img src="~/images/marketing-v12/coach-duo-gym.png"
                 alt="Coach Cassie and Coach Marisol standing together in a bright gym" />
            <div class="sm-picture-caption">
                <strong>Cassie and Marisol</strong>
                <span>Real coaches helping turn the science into a practical daily plan.</span>
            </div>
        </div>
    </section>

    <section class="wv10-final">
        <div class="sm-kicker">THE SCIENCE IN ONE LINE</div>

        <h2>Use the Muscle. Refill the Muscle.</h2>
        <h3>Keep protein high. Cycle the carbs.</h3>

        <p>
            Recomp helps with the how much, the when, and the adjustments
            that make those principles usable in real life.
        </p>

        <div class="sm-actions">
            <a class="sm-primary"
               href="/trial/start"
               data-track="CLICK_START_FREE">
                Start Free Trial
            </a>

            <a class="sm-secondary"
               asp-controller="Home"
               asp-action="Evidence"
               data-track="CLICK_EVIDENCE">
                Read the Evidence
            </a>

            <a class="sm-secondary"
               href="/tips">
                Recomp Tips
            </a>
        </div>
    </section>

</div>

<link rel="stylesheet"
      href="~/css/marketing-simple.css"
      asp-append-version="true" />

<script src="~/js/marketing-simple.js"
        asp-append-version="true"
        defer></script>

<!-- 12WR-MARKETING-SIMPLE -->
<!-- 12WR-WELCOME-V12 -->
