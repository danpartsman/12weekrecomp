@{
    Layout = null;
    ViewData["Title"] = "12 Week Recomp — Break Free Scene";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>12 Week Recomp — Break Free Scene</title>
    <link rel="stylesheet" href="~/css/welcome-scenes-v1012.css" asp-append-version="true" />
</head>
<body class="ws-page">
<header class="ws-top">
    <a class="ws-brand" href="/welcome-lab">12 WEEK <em>RECOMP</em></a>
    <nav class="ws-nav" aria-label="Concept navigation">
        <a href="/welcome-lab/hotspots">Hotspots</a>
        <a href="/welcome-lab/cards">Cards</a>
        <a href="/welcome-lab/ascend">Ascend</a>
        <a class="primary" href="/trial/start">Start</a>
    </nav>
</header>
<main class="ws-scene ws-breakfree">
    <div class="ws-bg" aria-hidden="true"></div>
    <div class="ws-vignette" aria-hidden="true"></div>
    <div class="ws-noise" aria-hidden="true"></div>
    <div class="ws-beam a" aria-hidden="true"></div><div class="ws-beam b" aria-hidden="true"></div>
    <div class="ws-glow cyan" aria-hidden="true"></div><div class="ws-glow green" aria-hidden="true"></div>
    <div class="ws-cursor" aria-hidden="true"></div>

    <section class="ws-hero">
        <p class="ws-eyebrow">BREAK FREE · BUILD FORWARD</p>
        <h1>BREAK<br /><span class="c">THE LOOP.</span><br /><span class="g">BUILD YOU.</span></h1>
        <p class="ws-tagline">Train. Fuel. Recover. Keep moving.</p>
        <a class="ws-cta" href="/trial/start">Start the rebuild →</a>
    </section>

    <button class="ws-hotspot cyan" style="right:28%;top:24%" type="button" data-ws-panel data-label="TRAIN" data-title="Build the signal" data-copy="Use progressive resistance work and conditioning to create a reason for your body to adapt."><span><strong>TRAIN</strong><small>tap</small></span></button>
    <button class="ws-hotspot gold" style="right:14%;top:43%" type="button" data-ws-panel data-label="FUEL" data-title="Fuel the work" data-copy="Protein supports lean tissue. Carbohydrate supports demanding training. Food serves the plan."><span><strong>FUEL</strong><small>tap</small></span></button>
    <button class="ws-hotspot" style="right:30%;bottom:18%" type="button" data-ws-panel data-label="RECOVER" data-title="Come back ready" data-copy="Sleep, soreness, energy and recent workload help decide when to push and when to recover."><span><strong>RECOVER</strong><small>tap</small></span></button>

    <div class="ws-panel" aria-live="polite">
        <button class="close" type="button" aria-label="Close">×</button>
        <span class="label">EXPLORE</span>
        <h2>12 Week Recomp</h2>
        <p>Click a glowing point.</p>
    </div>

    <div class="ws-breakfree-zone" aria-label="Break free actions">
        <button type="button" data-ws-ripple>Cut the noise</button>
        <button type="button" data-ws-ripple>Build momentum</button>
        <button type="button" data-ws-ripple>Live stronger</button>
    </div>

    <nav class="ws-dock" aria-label="Concept navigation">
        <a href="/welcome-lab/break-free">Poster</a><a href="/welcome-lab/hotspots">Hotspots</a><a href="/welcome-lab/cards">Cards</a><a href="/welcome-lab/ascend">Ascend</a>
    </nav>
</main>
<script src="~/js/welcome-scenes-v1012.js" asp-append-version="true"></script>
</body>
</html>
