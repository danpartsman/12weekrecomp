@{
    Layout = null;
    ViewData["Title"] = "12 Week Recomp — Break Free";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>12 Week Recomp — Break Free</title>
    <link rel="stylesheet" href="~/css/welcome-lab-v1012.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/welcome-lab-art-v1012.css" asp-append-version="true" />
</head>
<body class="wl-page">
<header class="wl-topbar">
    <a class="wl-brand" href="/welcome-lab">12 WEEK <em>RECOMP</em></a>
    <a class="wl-back" href="/welcome-lab">← All concepts</a>
    <a class="wl-cta-mini" href="/trial/start">Start 12 Weeks</a>
</header>
<main class="wl-stage" data-wl-parallax>
    <div class="wl-bg wl-art-1" aria-hidden="true"></div>
    <div class="wl-vignette" aria-hidden="true"></div>
    <div class="wl-scan" aria-hidden="true"></div>
    <div class="wl-float-orb a"></div><div class="wl-float-orb b"></div>
    <div class="wl-motion-line one"></div><div class="wl-motion-line two"></div>
    <section class="wl-overlay">
        <div class="wl-copy">
            <p class="wl-kicker">CONCEPT A · FULL-SCREEN POSTER</p>
            <h1 class="wl-title">BREAK<br /><span class="cyan">THE LOOP.</span><br /><span class="green">BUILD YOU.</span></h1>
            <p class="wl-sub">Cut through the noise. Train with purpose. Fuel the work. Recover. Repeat. Build a body and a life that feel like yours.</p>
            <div class="wl-actions">
                <a class="wl-btn primary" href="/trial/start">Start the rebuild <span>→</span></a>
                <a class="wl-btn secondary" href="/welcome-lab/hotspots">Try interactive mode <span>◎</span></a>
            </div>
            <div class="wl-chipline">
                <span class="wl-chip">Evidence over hype</span>
                <span class="wl-chip">Strength over punishment</span>
                <span class="wl-chip">Fuel over fear</span>
                <span class="wl-chip">Momentum over perfection</span>
            </div>
        </div>
    </section>
    <nav class="wl-dock" aria-label="Concept navigation">
        <a href="/welcome-lab/break-free">Poster</a><a href="/welcome-lab/hotspots">Hotspots</a><a href="/welcome-lab/cards">Cards</a><a href="/welcome-lab/ascend">Ascend</a>
    </nav>
</main>
<script src="~/js/welcome-lab-v1012.js" asp-append-version="true"></script>
</body>
</html>