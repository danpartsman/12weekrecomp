@{
    ViewData["Title"] = "Evidence";
}

<div class="simple-marketing evidence-v13" data-marketing-page="evidence">

    <section class="ev10-hero">
        <div class="ev10-hero-photo">
            <img src="~/images/marketing-v13/evidence-gym-group-clean.jpg"
                 alt="A mixed group of fit adult women and men training together in a bright gym" />
        </div>

        <div class="ev10-hero-copy">
            <div class="sm-kicker">REAL RESEARCH. REAL RESULTS.</div>
            <h1>Studies show that Body Recomp produces amazing results!</h1>
            <p>
                Resistance-based carb cycling programs built around strength training,
                protein, carbohydrate timing and an overall weekly deficit can reduce fat
                while preserving or increasing lean mass.
            </p>
        </div>
    </section>

    <section class="ev10-study-grid">
        <article class="ev10-study-card">
            <div class="ev10-study-head">
                <span class="ev10-study-chip">STUDY 1</span>
                <span class="ev10-study-name">VARGAS-MOLINA ET AL. (2026)</span>
            </div>

            <div class="ev10-study-stats">
                <div class="ev10-stat ev10-stat-duration">
                    <strong>10</strong>
                    <span>WEEKS</span>
                </div>

                <div class="ev10-stat ev10-stat-fat">
                    <strong>-6.5 lb</strong>
                    <span>FAT MASS</span>
                </div>

                <div class="ev10-stat ev10-stat-muscle">
                    <strong>+2.3 lb</strong>
                    <span>FAT-FREE MASS</span>
                </div>
            </div>

            <p class="ev10-study-summary">
                Resistance-trained adults followed the same four-day-per-week lifting program.
                The calorie-deficit group averaged about 2.94 kg less fat mass
                and 1.04 kg more fat-free mass.
            </p>

            <aside class="ev13-coach-note">
                <img src="~/images/marketing-v12/coach-cassie-gym.png"
                     alt="Coach Cassie" />
                <div>
                    <strong>Cassie</strong>
                    <span>
                        Notice the combination: resistance training, high protein and controlled calories.
                    </span>
                </div>
            </aside>

            <div class="ev10-study-footer">
                <a class="sm-source"
                   href="https://pubmed.ncbi.nlm.nih.gov/41940947/"
                   target="_blank"
                   rel="noopener">
                    Read the 2026 study on PubMed
                </a>

                <span>Group averages. Individual results vary.</span>
            </div>
        </article>

        <article class="ev10-study-card ev10-study-card-warm">
            <div class="ev10-study-head">
                <span class="ev10-study-chip ev10-study-chip-warm">STUDY 2</span>
                <span class="ev10-study-name">McMASTER UNIVERSITY - SHORT, AGGRESSIVE PROTOCOL</span>
            </div>

            <div class="ev10-study-stats">
                <div class="ev10-stat ev10-stat-duration ev10-stat-duration-warm">
                    <strong>4</strong>
                    <span>WEEKS</span>
                </div>

                <div class="ev10-stat ev10-stat-fat">
                    <strong>-10.6 lb</strong>
                    <span>FAT MASS</span>
                </div>

                <div class="ev10-stat ev10-stat-muscle">
                    <strong>+2.6 lb</strong>
                    <span>LEAN BODY MASS</span>
                </div>
            </div>

            <p class="ev10-study-summary">
                Young men used roughly a 40 percent energy deficit, high protein,
                resistance training and high-intensity exercise six days per week.
            </p>

            <div class="sm-caution">
                This was a short, tightly controlled research protocol in young men.
                It demonstrates what is physiologically possible, not a normal weekly expectation.
            </div>

            <aside class="ev13-coach-note">
                <img src="~/images/marketing-v12/coach-marisol-gym.png"
                     alt="Coach Marisol" />
                <div>
                    <strong>Marisol</strong>
                    <span>
                        The value of this study is the proof of possibility, not the pace everyone should chase.
                    </span>
                </div>
            </aside>

            <div class="ev10-study-footer">
                <a class="sm-source"
                   href="https://pubmed.ncbi.nlm.nih.gov/26817506/"
                   target="_blank"
                   rel="noopener">
                    Read the McMaster study on PubMed
                </a>

                <span>Shorter study. Much harder protocol.</span>
            </div>
        </article>
    </section>

    <section class="ev10-big-picture">
        <div class="ev10-big-stats">
            <div class="ev10-big-stat">
                <strong>114</strong>
                <span>RANDOMIZED TRIALS</span>
            </div>

            <div class="ev10-big-stat">
                <strong>4,184</strong>
                <span>PARTICIPANTS</span>
            </div>
        </div>

        <div class="ev10-big-copy">
            <div class="sm-kicker">THE BIG PICTURE</div>
            <h2>Resistance-based carb cycling programs improve body composition.</h2>
            <p>
                A large systematic review found that resistance training combined
                with calorie restriction is especially effective for reducing fat mass,
                while resistance training helps preserve lean tissue during weight loss.
            </p>

            <a class="sm-source"
               href="https://pmc.ncbi.nlm.nih.gov/articles/PMC9285060/"
               target="_blank"
               rel="noopener">
                Read the systematic review
            </a>
        </div>
    </section>

    <section class="sm-simple-science sm-evidence-final">
        <div class="sm-kicker">TRY IT FOR A WEEK</div>
        <h2>Seven days free. No credit card. No automatic billing.</h2>
        <p>
            The 12 Week Recomp coaches walk you through each day's exercise
            and nutrition plan so you can put these principles into practice.
        </p>

        <div class="sm-actions">
            <a class="sm-primary"
               href="/trial/start"
               data-track="EVIDENCE_START_FREE">
                Start Free Trial
            </a>

            <a class="sm-secondary"
               asp-controller="Home"
               asp-action="Index">
                Back to Welcome
            </a>
        </div>
    </section>

</div>

<link rel="stylesheet"
      href="~/css/marketing-simple.css"
      asp-append-version="true" />

<script src="~/js/marketing-simple.js"
        asp-append-version="true"
        defer></script>

