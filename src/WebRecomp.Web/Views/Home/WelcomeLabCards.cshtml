@{
    Layout = null;
    ViewData["Title"] = "12 Week Recomp — Live Card Deck";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>12 Week Recomp — Live Card Deck</title>
    <link rel="stylesheet" href="~/css/welcome-scenes-v1012.css" asp-append-version="true" />
</head>
<body class="ws-page">
<header class="ws-top">
    <a class="ws-brand" href="/welcome-lab">12 WEEK <em>RECOMP</em></a>
    <nav class="ws-nav" aria-label="Concept navigation">
        <a href="/welcome-lab/break-free">Poster</a>
        <a href="/welcome-lab/hotspots">Hotspots</a>
        <a href="/welcome-lab/ascend">Ascend</a>
        <a class="primary" href="/trial/start">Start</a>
    </nav>
</header>
<main class="ws-scene ws-cards-page">
    <div class="ws-bg" aria-hidden="true"></div>
    <div class="ws-vignette" aria-hidden="true"></div>
    <div class="ws-noise" aria-hidden="true"></div>
    <div class="ws-glow cyan" aria-hidden="true"></div><div class="ws-glow green" aria-hidden="true"></div>
    <div class="ws-cursor" aria-hidden="true"></div>

    <section class="ws-hero" style="top:32%;max-width:620px">
        <p class="ws-eyebrow">DRAG THE STACK · CHANGE THE ORDER</p>
        <h1>BUILD<br /><span class="g">YOUR STACK.</span></h1>
        <p class="ws-tagline">Four levers. One stronger life.</p>
    </section>

    <section class="ws-carddeck" data-ws-deck aria-label="Draggable Recomp pillars">
        <article class="ws-card" style="--a:#19ddff"><span>01 · BREAK</span><h2>Cut the noise</h2><p>Drop the restart cycle. Keep what works.</p><div class="mini">drag me ↔</div></article>
        <article class="ws-card" style="--a:#7dff24"><span>02 · TRAIN</span><h2>Build strength</h2><p>Create the signal your body can adapt to.</p><div class="mini">drag me ↔</div></article>
        <article class="ws-card" style="--a:#f3ff31"><span>03 · FUEL</span><h2>Eat to perform</h2><p>Protein high. Carbs with purpose.</p><div class="mini">drag me ↔</div></article>
        <article class="ws-card" style="--a:#a865ff"><span>04 · LIVE</span><h2>Reclaim momentum</h2><p>Let progress spill into the rest of life.</p><div class="mini">drag me ↔</div></article>
    </section>

    <button class="ws-hotspot cyan" style="right:8%;top:22%" type="button" data-ws-drag data-ws-panel data-label="COACHING" data-title="What changes today?" data-copy="The system can connect training, fuel and recovery so the plan responds instead of pretending every day is identical."><span><strong>COACH</strong><small>drag</small></span></button>

    <div class="ws-panel" aria-live="polite">
        <button class="close" type="button" aria-label="Close">×</button>
        <span class="label">COACHING</span>
        <h2>Build your stack</h2>
        <p>Move the cards. Click the coach node.</p>
    </div>

    <nav class="ws-dock" aria-label="Concept navigation"><a href="/welcome-lab/break-free">Poster</a><a href="/welcome-lab/hotspots">Hotspots</a><a href="/welcome-lab/cards">Cards</a><a href="/welcome-lab/ascend">Ascend</a></nav>
</main>
<script src="~/js/welcome-scenes-v1012.js" asp-append-version="true"></script>
</body>
</html>
