@{
    Layout = null;
    ViewData["Title"] = "12 Week Recomp — Hotspot Experience";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>12 Week Recomp — Hotspot Experience</title>
    <link rel="stylesheet" href="~/css/welcome-scenes-v1012.css" asp-append-version="true" />
</head>
<body class="ws-page">
<header class="ws-top">
    <a class="ws-brand" href="/welcome-lab">12 WEEK <em>RECOMP</em></a>
    <nav class="ws-nav" aria-label="Explore 12 Week Recomp">
        <a href="/recomp/what">What is Recomp?</a>
        <a href="/recomp/how">How it Works</a>
        <a href="/recomp/evidence">Evidence</a>
        <a class="primary" href="/recomp/start">Start Free</a>
    </nav>
</header>
<main class="ws-scene ws-hotspot-page">
    <div class="ws-bg" aria-hidden="true"></div>
    <div class="ws-vignette" aria-hidden="true"></div>
    <div class="ws-noise" aria-hidden="true"></div>
    <div class="ws-beam a" aria-hidden="true"></div><div class="ws-beam b" aria-hidden="true"></div>
    <div class="ws-cursor" aria-hidden="true"></div>

    <section class="ws-freedom-title">
        <p class="ws-eyebrow">THE IMAGE IS THE INTERFACE</p>
        <h1>CHOOSE.<br /><span>YOUR PATH.</span></h1>
        <p>Four doors. No lecture. Pick what you want to know.</p>
    </section>

    <a class="ws-hotspot cyan" style="left:39%;top:26%" href="/recomp/what" data-ws-drag><span><strong>WHAT IS RECOMP?</strong><small>open</small></span></a>
    <a class="ws-hotspot" style="left:48%;top:48%" href="/recomp/how" data-ws-drag><span><strong>HOW IT WORKS</strong><small>open</small></span></a>
    <a class="ws-hotspot gold" style="left:66%;top:44%" href="/recomp/evidence" data-ws-drag><span><strong>EVIDENCE</strong><small>open</small></span></a>
    <a class="ws-hotspot cyan" style="left:57%;top:69%" href="/recomp/start" data-ws-drag><span><strong>START FREE</strong><small>open</small></span></a>

    <p class="ws-small-note">DRAG THE NODES · CLICK A PATH · MAKE IT YOURS</p>
    <nav class="ws-dock" aria-label="Concept navigation"><a href="/welcome-lab/break-free">Poster</a><a href="/welcome-lab/hotspots">Hotspots</a><a href="/welcome-lab/cards">Cards</a><a href="/welcome-lab/ascend">Ascend</a></nav>
</main>
<script src="~/js/welcome-scenes-v1012.js" asp-append-version="true"></script>
@await Component.InvokeAsync("FreeUseOverlay")</body>
</html>
