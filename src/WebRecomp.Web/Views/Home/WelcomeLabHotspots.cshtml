@{
    Layout = null;
    ViewData["Title"] = "12 Week Recomp — Hotspot Experience";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>12 Week Recomp — Hotspot Experience</title>
    <link rel="stylesheet" href="~/css/welcome-scenes-v1012.css" asp-append-version="true" />
</head>
<body class="ws-page">
<header class="ws-top">
    <a class="ws-brand" href="/welcome-lab">12 WEEK <em>RECOMP</em></a>
    <nav class="ws-nav" aria-label="Concept navigation">
        <a href="/welcome-lab/break-free">Poster</a>
        <a href="/welcome-lab/cards">Cards</a>
        <a href="/welcome-lab/ascend">Ascend</a>
        <a class="primary" href="/trial/start">Start</a>
    </nav>
</header>
<main class="ws-scene ws-hotspot-page">
    <div class="ws-bg" aria-hidden="true"></div>
    <div class="ws-vignette" aria-hidden="true"></div>
    <div class="ws-noise" aria-hidden="true"></div>
    <div class="ws-beam a" aria-hidden="true"></div><div class="ws-beam b" aria-hidden="true"></div>
    <div class="ws-cursor" aria-hidden="true"></div>

    <section class="ws-freedom-title">
        <p class="ws-eyebrow">THE IMAGE IS THE INTERFACE</p>
        <h1>CLICK.<br /><span>EXPLORE.</span></h1>
        <p>Drag the glowing points. Build your own route.</p>
    </section>

    <button class="ws-hotspot cyan" style="left:39%;top:24%" type="button" data-ws-drag data-ws-panel data-label="MINDSET" data-title="Own the signal" data-copy="Question noise, keep useful evidence, and build a plan you can actually live with."><span><strong>MINDSET</strong><small>drag</small></span></button>
    <button class="ws-hotspot" style="left:47%;top:46%" type="button" data-ws-drag data-ws-panel data-label="TRAINING" data-title="Get stronger" data-copy="Build muscle, strength and capacity with progressive work that earns recovery."><span><strong>TRAIN</strong><small>drag</small></span></button>
    <button class="ws-hotspot gold" style="left:64%;top:45%" type="button" data-ws-drag data-ws-panel data-label="NUTRITION" data-title="Fuel the work" data-copy="Use protein and carbohydrate intentionally. Eat to support training, recovery and the weekly energy goal."><span><strong>FUEL</strong><small>drag</small></span></button>
    <button class="ws-hotspot cyan" style="left:55%;top:66%" type="button" data-ws-drag data-ws-panel data-label="RECOVERY" data-title="Come back ready" data-copy="Sleep, soreness, energy and workload guide the next move instead of forcing the same answer every day."><span><strong>RECOVER</strong><small>drag</small></span></button>
    <button class="ws-hotspot" style="left:72%;top:69%" type="button" data-ws-drag data-ws-panel data-label="FREEDOM" data-title="Live stronger" data-copy="The goal is not to live for the plan. The goal is to build a stronger life with the plan."><span><strong>FREEDOM</strong><small>drag</small></span></button>

    <div class="ws-panel" aria-live="polite">
        <button class="close" type="button" aria-label="Close">×</button>
        <span class="label">EXPLORE</span>
        <h2>Tap a signal</h2>
        <p>Every glowing point is live.</p>
    </div>

    <p class="ws-small-note">DRAG THE NODES · CLICK TO OPEN · MAKE IT YOURS</p>
    <nav class="ws-dock" aria-label="Concept navigation"><a href="/welcome-lab/break-free">Poster</a><a href="/welcome-lab/hotspots">Hotspots</a><a href="/welcome-lab/cards">Cards</a><a href="/welcome-lab/ascend">Ascend</a></nav>
</main>
<script src="~/js/welcome-scenes-v1012.js" asp-append-version="true"></script>
</body>
</html>
