    <link rel="stylesheet" href="~/css/welcome-lab-main-v1012.css" asp-append-version="true" />
</head>
<body class="wlx-page">
    <header class="wlx-nav">
        <a class="wlx-brand" href="/welcome-lab">12 WEEK <em>RECOMP</em></a>
        <nav aria-label="Explore 12 Week Recomp">
