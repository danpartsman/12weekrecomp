@model MyCoachesViewModel
@{ ViewData["Title"] = "My Trainer"; }
<h1>My Trainer</h1>
@foreach (var coach in Model.Coaches) { <section class="card"><h2>@coach.Name</h2><p>@coach.Specialties</p><p>@coach.Bio</p><form asp-action="Disconnect" asp-route-relationshipId="@coach.RelationshipId" method="post"><button type="submit">Disconnect trainer</button></form></section> }
<section class="card"><h2>Connect with your trainer</h2><p>Enter the connection code your trainer gives you. Connecting lets that trainer view your goal, latest body measurements, and completed workouts, and assign nutrition prescription rules. You can disconnect here at any time.</p><form asp-action="Connect" method="post"><div asp-validation-summary="All"></div><label for="Code">Trainer connection code</label><input id="Code" name="Code" value="@Model.Input.Code" minlength="64" maxlength="64" required autocomplete="off" /><button type="submit">Connect trainer</button></form></section>
