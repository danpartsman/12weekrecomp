@model MyCoachesViewModel
@{ ViewData["Title"] = "My Coach"; }
<h1>My Coach</h1>
<section class="card" aria-labelledby="coaching-overview">
    <h2 id="coaching-overview">Personal support for your recomp goals</h2>
    <p>Connect with a coach to plan your training, review your progress, and stay accountable together.</p>
    <ul>
        <li><strong>A shared view of your progress.</strong> Your coach can review your goals, nutrition logs, body measurements, training schedule, and completed workouts.</li>
        <li><strong>Guidance that fits you.</strong> Your coach can adjust nutrition targets, plan future workouts, and assign Snap Workouts with instructions and completion notes.</li>
        <li><strong>Stay in touch.</strong> Use your coach's workspace for messages and updates. Each coach has a separate connection with you.</li>
    </ul>
    <p>Financial penalties and incentives between the client and coach can be accommodated if desired.</p>
    <p>You choose who to connect with and can disconnect at any time.</p>
</section>
@if (Model.Coaches.Count > 0)
{
    <h2>Your coaches</h2>
    @foreach (var coach in Model.Coaches)
    {
        <section class="card">
            <h3><a asp-controller="CoachWorkspace" asp-action="Index" asp-route-clientId="@Model.ClientId" asp-route-coachId="@coach.CoachUserId">@coach.Name</a></h3>
            <p>@coach.Specialties</p><p>@coach.Bio</p>
            <form asp-action="Disconnect" asp-route-relationshipId="@coach.RelationshipId" method="post"><button type="submit">Disconnect coach</button></form>
        </section>
    }
}
<section class="card">
    <h2>Connect with your coach</h2>
    @if (Model.ClientId.HasValue)
    {
        <p>Ask your coach for a connection code, then enter it here.</p>
        <form asp-action="Connect" method="post">
            <div asp-validation-summary="All"></div>
            <label for="Code">Coach connection code</label>
            <input id="Code" name="Code" value="@Model.Input.Code" minlength="6" maxlength="64" required autocomplete="off" placeholder="PINE42" style="text-transform:uppercase;width:100%;max-width:24rem;box-sizing:border-box" />
            <button type="submit">Connect coach</button>
        </form>
    }
    else
    {
        <p>Set up your personal profile, then use your coach's connection code to get started.</p>
        <a class="button" asp-controller="Intake" asp-action="Index">Set up my profile</a>
    }
</section>
@if (Model.ClientId.HasValue)
{
    <p><a class="button" asp-controller="Notifications" asp-action="Index">Coach email &amp; phone notifications</a></p>
}
