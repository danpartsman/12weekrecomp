@model WebRecomp.Web.ViewModels.AdminNutritionProvidersViewModel
@{
    ViewData["Title"] = "Nutrition Data Providers";
    Layout = "_AdminLayout";
}

<section class="admin-home">
    <header class="admin-heading">
        <span class="admin-eyebrow">NUTRITION INTELLIGENCE</span>
        <h1>Nutrition Data Providers</h1>
        <p>
            Choose which external food database is searched first.
            Primary and secondary ordering affects new provider searches only.
            Existing foods, logged meals, Daily Entry values, and Engine data
            are not rewritten.
        </p>
    </header>

    @if (TempData["NutritionProviderSuccess"] is string success)
    {
        <div class="alert success">@success</div>
    }

    @if (TempData["NutritionProviderError"] is string error)
    {
        <div class="alert error">@error</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert error" asp-validation-summary="All"></div>
    }

    <section class="card" id="usda-key-setup">
        <h2>USDA FoodData Central API key</h2>
        <p role="status"><strong>@(Model.UsdaKeyConfigured?"Key configured":"Key needed")</strong> · @Model.UsdaKeySource</p>
        <p><a href="https://fdc.nal.usda.gov/api-key-signup/" target="_blank" rel="noopener">Get a free USDA API key</a>. Saving a key here makes it available to food search and barcode lookup in this environment.</p>
        <form asp-action="SaveUsdaKey" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <label for="usda-api-key">USDA API key</label>
            <input id="usda-api-key" name="apiKey" type="password" value="" maxlength="128" autocomplete="new-password" spellcheck="false" placeholder="Paste a new key; leave blank to keep the current key" style="width:100%;max-width:640px;box-sizing:border-box;font-size:16px;min-height:44px" />
            <p class="muted">The key is encrypted on the server and is never displayed. A saved administration key takes precedence over the Azure setting. TEST and LIVE keep separate credentials.</p>
            <button type="submit" class="button primary">Save USDA key</button>
        </form>
        <form asp-action="TestProvider" method="post" style="margin-top:12px">
            @Html.AntiForgeryToken()<input type="hidden" name="providerCode" value="USDA_FDC" />
            <button type="submit" class="button" disabled="@(!Model.UsdaKeyConfigured)">Test saved USDA key</button>
        </form>
    </section>

    <section class="card">
        <h2>Provider Order</h2>

        <form asp-action="SaveSettings"
              method="post">
            @Html.AntiForgeryToken()

            <div class="form-grid">
                <div>
                    <label asp-for="PrimaryProviderCode">
                        Primary provider
                    </label>
                    <select asp-for="PrimaryProviderCode">
                        @foreach (var provider in Model.Providers)
                        {
                            <option value="@provider.ProviderCode">
                                @provider.DisplayName
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <label asp-for="SecondaryProviderCode">
                        Secondary provider
                    </label>
                    <select asp-for="SecondaryProviderCode">
                        @foreach (var provider in Model.Providers)
                        {
                            <option value="@provider.ProviderCode">
                                @provider.DisplayName
                            </option>
                        }
                    </select>
                </div>
            </div>

            <p class="muted">
                Food matches are ranked by relevance across history, custom foods, and external providers. Provider priority breaks ties between equally relevant external matches.
            </p>

            <button type="submit" class="button primary">
                Save Provider Order
            </button>
        </form>
    </section>

    <section class="card">
        <h2>Provider Status</h2>

        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>Provider</th>
                    <th>Role</th>
                    <th>Cache</th>
                    <th>Attribution</th>
                    <th>Status</th>
                    <th>Test</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var provider in
                    Model.Providers.OrderBy(x => x.SearchPriority))
                {
                    var role =
                        provider.ProviderCode == Model.PrimaryProviderCode
                            ? "Primary"
                            : provider.ProviderCode == Model.SecondaryProviderCode
                                ? "Secondary"
                                : "Inactive";

                    var cacheText =
                        provider.CachePolicyCode == "TEMPORARY"
                            ? $"{provider.CacheTtlMinutes ?? 0} min"
                            : provider.CachePolicyCode;

                    <tr>
                        <td>
                            <strong>@provider.DisplayName</strong>
                            <div class="muted">@provider.ProviderCode</div>
                        </td>
                        <td>@role</td>
                        <td>@cacheText</td>
                        <td>
                            @(provider.RequiresAttribution ? "Required" : "No")
                        </td>
                        <td>
                            @(provider.IsEnabled ? "Enabled" : "Disabled")
                        </td>
                        <td>
                            <form asp-action="TestProvider"
                                  method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden"
                                       name="providerCode"
                                       value="@provider.ProviderCode" />
                                <button type="submit"
                                        class="button">
                                    Test
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

    <section class="card">
        <h2>FatSecret Premier Cache</h2>
        <p>
            FatSecret provider content is cached for up to 24 hours.
            Durable FatSecret identifiers are retained so expired content can
            be refreshed from the provider. USDA FoodData Central remains
            persistently cached under its existing policy.
        </p>
    </section>
</section>
