<!-- B2.30.1 NUTRITION PICKER CLEANUP -->

<!-- ================================================================
     B2.30.2 NUTRITION ASCII-ONLY CLEANUP
     This Razor source intentionally contains ASCII characters only.
     ================================================================ -->

<!-- B2.30.3 REMOVE LARGE CUP PRESETS -->
<style>
/* ================================================================
   B2.30.2 NUTRITION DISPLAY POLISH
   Display-only formatting. Full stored precision is unchanged.
   ================================================================ */
.nutrition-picker-amount-preset-field[hidden] {
    display: none !important;
}
</style>

<!-- B2.30.2 NUTRITION DISPLAY POLISH -->
<script>
(() => {
    const dashboard =
        document.querySelector(
            ".nutrition-dashboard-card");

    if (dashboard) {
        const legacyLabels =
            new Set([
                "+ Add food",
                "Add food",
                "Add previous meal"
            ]);

        dashboard.querySelectorAll(
            "a, button"
        ).forEach(control => {
            const label =
                (control.textContent || "")
                    .replace(/\s+/g, " ")
                    .trim();

            if (legacyLabels.has(label)
                && !control.closest(
                    ".nutrition-meal-summary-grid")
                && !control.closest("dialog")) {
                control.remove();
            }
        });

        const todayFoods =
            dashboard.querySelector(
                "details.nutrition-today-foods");

        if (todayFoods) {
            todayFoods.open = true;
        }
    }
    const dialog =
        document.getElementById(
            "nutrition-food-picker-dialog");

    const customDialog =
        document.getElementById(
            "nutrition-custom-food-dialog");

    if (!(dialog instanceof HTMLDialogElement)) {
        return;
    }

    const openers =
        Array.from(
            document.querySelectorAll(
                "[data-food-picker-open]"));

    const closeButtons =
        Array.from(
            dialog.querySelectorAll(
                "[data-picker-close]"));

    const addButton =
        dialog.querySelector(
            "[data-picker-add]");

    const mealSelect =
        dialog.querySelector(
            "[data-picker-meal]");

    const title =
        dialog.querySelector(
            "[data-picker-title]");

    const searchInput =
        dialog.querySelector(
            "[data-picker-search]");

    const searchField =
        dialog.querySelector(
            "[data-picker-search-field]");

    const pastSection =
        dialog.querySelector(
            "[data-picker-past-section]");

    const foodSection =
        dialog.querySelector(
            "[data-picker-food-section]");

    const pastMealsHost =
        dialog.querySelector(
            "[data-picker-past-meals]");

    const foodsHost =
        dialog.querySelector(
            "[data-picker-foods]");

    const warning =
        dialog.querySelector(
            "[data-picker-warning]");

    const resultsPanel =
        dialog.querySelector(
            "[data-picker-results]");

    const selectedPanel =
        dialog.querySelector(
            "[data-picker-selected]");

    const changeButton =
        dialog.querySelector(
            "[data-picker-change]");

    const selectionHost =
        dialog.querySelector(
            "[data-picker-selection]");

    const providerControls =
        dialog.querySelector(
            "[data-picker-provider-controls]");

    const measureField =
        dialog.querySelector(
            ".nutrition-picker-measure-field");

    const amountLabel =
        dialog.querySelector(
            "[data-picker-amount-label]");

    const amountInput =
        dialog.querySelector(
            "[data-picker-amount]");
    const amountPresetField =
        dialog.querySelector(
            "[data-picker-amount-preset-field]");

    const amountPresetSelect =
        dialog.querySelector(
            "[data-picker-amount-preset]");

    const amountPresets =
        dialog.querySelector(
            "[data-picker-amount-presets]");

    const amountHint =
        dialog.querySelector(
            "[data-picker-amount-hint]");

    const measureSelect =
        dialog.querySelector(
            "[data-picker-measure]");

    const pastFoodForm =
        dialog.querySelector(
            "[data-picker-past-food-form]");

    const pastMealForm =
        dialog.querySelector(
            "[data-picker-past-meal-form]");

    const providerForm =
        dialog.querySelector(
            "[data-picker-provider-form]");

    const customFoodForm =
        dialog.querySelector(
            "[data-picker-custom-food-form]");

    const customFoodOpen =
        dialog.querySelector(
            "[data-picker-custom-open]");
    const pastMealOpen =
        dialog.querySelector(
            "[data-picker-past-open]");

    const prepMealOpen =
        dialog.querySelector(
            "[data-picker-prep-open]");

    const customFoodMeal =
        customDialog?.querySelector(
            "[data-custom-food-meal]");

    const customFoodName =
        customDialog?.querySelector(
            "input[name='foodName']");

    const customFoodCloseButtons =
        customDialog instanceof HTMLDialogElement
            ? Array.from(
                customDialog.querySelectorAll(
                    "[data-custom-food-close]"))
            : [];

    const dataUrl =
        dialog.dataset.pickerDataUrl;

    const measuresUrl =
        dialog.dataset.pickerMeasuresUrl;

    const pickerDate =
        dialog.dataset.pickerDate;

    if (!mealSelect
        || !searchInput
        || !pastMealsHost
        || !foodsHost
        || !addButton
        || !selectionHost
        || !resultsPanel
        || !selectedPanel
        || !dataUrl
        || !measuresUrl
        || !pickerDate) {
        return;
    }

    let selected = null;
    let pickerMode = "food";
    let requestVersion = 0;
    let searchTimer = null;
    let activeMealOpener = null;
    const measureCache = new Map();

    const setActiveMealOpener = opener => {
        if (activeMealOpener) {
            activeMealOpener.classList.remove(
                "is-active");
            activeMealOpener.setAttribute(
                "aria-pressed",
                "false");
        }

        activeMealOpener =
            opener?.classList?.contains(
                "nutrition-meal-summary-button")
                ? opener
                : null;

        if (activeMealOpener) {
            activeMealOpener.classList.add(
                "is-active");
            activeMealOpener.setAttribute(
                "aria-pressed",
                "true");
        }
    };

    const mealLabel = code =>
        code === "BREAKFAST"
            ? "Breakfast"
            : code === "LUNCH"
                ? "Lunch"
                : code === "DINNER"
                    ? "Dinner"
                    : "Snack";

    const cupAmounts = [
        ["0.125", "1/8 cup"],
        ["0.25", "1/4 cup"],
        ["0.3333", "1/3 cup"],
        ["0.5", "1/2 cup"],
        ["0.6667", "2/3 cup"],
        ["0.75", "3/4 cup"],
        ["1", "1 cup"]
    ];

    const servingAmounts = [
        ["0.125", "1/8 serving"],
        ["0.25", "1/4 serving"],
        ["0.3333", "1/3 serving"],
        ["0.5", "1/2 serving"],
        ["0.6667", "2/3 serving"],
        ["0.75", "3/4 serving"],
        ["1", "1 serving"],
        ["1.5", "1 1/2 servings"],
        ["2", "2 servings"]
    ];

    const ounceAmounts = [
        ["2", "2 oz"],
        ["3", "3 oz"],
        ["4", "4 oz"],
        ["5", "5 oz"],
        ["6", "6 oz"],
        ["8", "8 oz"],
        ["12", "12 oz"],
        ["16", "16 oz"]
    ];

    const fluidOunceAmounts = [
        ["2", "2 fl oz"],
        ["4", "4 fl oz"],
        ["6", "6 fl oz"],
        ["8", "8 fl oz"],
        ["10", "10 fl oz"],
        ["12", "12 fl oz"],
        ["14", "14 fl oz"],
        ["16", "16 fl oz"]
    ];

    const teaspoonAmounts = [
        ["0.25", "1/4 tsp"],
        ["0.5", "1/2 tsp"],
        ["1", "1 tsp"],
        ["2", "2 tsp"],
        ["3", "3 tsp"]
    ];

    const tablespoonAmounts = [
        ["0.5", "1/2 tbsp"],
        ["1", "1 tbsp"],
        ["2", "2 tbsp"],
        ["3", "3 tbsp"],
        ["4", "4 tbsp"]
    ];

    const getAmountPresetsForUnit = unit =>
        unit === "cup"
            ? cupAmounts
            : unit === "serving"
                ? servingAmounts
                : unit === "oz"
                    ? ounceAmounts
                    : unit === "fl oz"
                        ? fluidOunceAmounts
                        : unit === "tsp"
                            ? teaspoonAmounts
                            : unit === "tbsp"
                                ? tablespoonAmounts
                                : [];

    const refreshAmountPresetDropdown = () => {
        if (!amountPresetField
            || !amountPresetSelect) {
            return;
        }

        const unit =
            (
                measureSelect
                    ?.selectedOptions?.[0]
                    ?.dataset.unitCode
                || ""
            ).trim().toLowerCase();

        const presets =
            getAmountPresetsForUnit(unit);

        amountPresetSelect.replaceChildren();

        const placeholder =
            document.createElement("option");

        placeholder.value = "";
        placeholder.textContent =
            presets.length > 0
                ? "Choose an amount"
                : "No quick amounts";

        amountPresetSelect.appendChild(
            placeholder);

        for (const [value,label] of presets) {
            const option =
                document.createElement("option");

            option.value = value;
            option.textContent = label;

            amountPresetSelect.appendChild(
                option);
        }

        amountPresetField.hidden =
            presets.length === 0;

        if (!amountInput) {
            return;
        }

        const current =
            Number.parseFloat(
                amountInput.value);

        const matching =
            [...amountPresetSelect.options]
                .find(option => {
                    const value =
                        Number.parseFloat(
                            option.value);

                    return (
                        Number.isFinite(current)
                        && Number.isFinite(value)
                        && Math.abs(
                            current - value)
                            < 0.0002
                    );
                });

        amountPresetSelect.value =
            matching?.value || "";
    };
    const syncAmountPresetSelection = () => {
        if (!amountPresets || !amountInput) {
            return;
        }

        const current =
            Number.parseFloat(
                amountInput.value);

        for (
            const button of
            amountPresets.querySelectorAll(
                "[data-amount-value]")
        ) {
            const value =
                Number.parseFloat(
                    button.dataset.amountValue || "");

            button.classList.toggle(
                "is-selected",
                Number.isFinite(current)
                && Number.isFinite(value)
                && Math.abs(current - value) < 0.0002);
        }
    };

    const refreshAmountPresets = () => {
        if (!amountPresets) {
            return;
        }

        amountPresets.replaceChildren();

        const unit =
            (
                measureSelect
                    ?.selectedOptions?.[0]
                    ?.dataset.unitCode
                || ""
            ).trim().toLowerCase();

        const presets =
            unit === "cup"
                ? cupAmounts
                : unit === "serving"
                    ? servingAmounts
                    : unit === "oz"
                        ? ounceAmounts
                        : unit === "fl oz"
                            ? fluidOunceAmounts
                            : unit === "tsp"
                                ? teaspoonAmounts
                                : unit === "tbsp"
                                    ? tablespoonAmounts
                                    : [];

        for (const [value, label] of presets) {
            const button =
                document.createElement(
                    "button");

            button.type = "button";
            button.className =
                "nutrition-picker-amount-chip";
            button.dataset.amountValue =
                value;
            button.textContent =
                label;

            button.addEventListener(
                "click",
                () => {
                    if (amountInput) {
                        amountInput.value =
                            value;
                        syncAmountPresetSelection();
                    }
                });

            amountPresets.appendChild(
                button);
        }

        const hasPresets =
            presets.length > 0;

        amountPresets.hidden =
            !hasPresets;

        refreshAmountPresetDropdown();

        if (amountHint) {
            amountHint.hidden =
                !hasPresets;

            amountHint.textContent =
                unit === "cup"
                    ? "Choose a cup amount or type another value."
                    : unit === "serving"
                        ? "Choose a serving amount or type another value."
                        : unit === "oz"
                            ? "Choose a weight-ounce amount or type another value."
                        : unit === "fl oz"
                            ? "Choose a fluid-ounce amount or type another value."
                            : unit === "tsp"
                                ? "Choose a teaspoon amount or type another value."
                                : unit === "tbsp"
                                    ? "Choose a tablespoon amount or type another value."
                                    : "";
        }

        syncAmountPresetSelection();
    };

    const syncPickerMode = () => {
        const pastMealMode =
            pickerMode === "pastMeal";

        dialog.dataset.pickerMode =
            pickerMode;

        if (searchField) {
            searchField.hidden =
                pastMealMode;
        }

        if (pastSection) {
            pastSection.hidden =
                !pastMealMode;
        }

        if (foodSection) {
            foodSection.hidden =
                pastMealMode;
        }

        if (title) {
            title.textContent =
                pastMealMode
                    ? `Add previous meal to ${mealLabel(mealSelect.value)}`
                    : `Add food to ${mealLabel(mealSelect.value)}`;
        }
    };

    const clearSelection = () => {
        selected = null;
        addButton.disabled = true;

        resultsPanel.hidden = false;
        selectedPanel.hidden = true;

        if (providerControls) {
            providerControls.hidden = true;
        }

        if (measureField) {
            measureField.hidden = false;
        }

        if (amountLabel) {
            amountLabel.textContent = "Amount";
        }

        if (amountInput) {
            amountInput.value = "1";
        }

        if (amountPresets) {
            amountPresets.hidden = true;
            amountPresets.replaceChildren();
        }

        if (amountHint) {
            amountHint.hidden = true;
            amountHint.textContent = "";
        }

        selectionHost.innerHTML =
            "<strong>Selected food</strong>";

        for (
            const choice of
            dialog.querySelectorAll(
                ".nutrition-picker-choice.is-selected")
        ) {
            choice.classList.remove(
                "is-selected");
        }
    };

    const formatMacro = value => {
        const number =
            Number.parseFloat(value);

        return Number.isFinite(number)
            ? number.toFixed(1)
            : "-";
    };
    const showSelection = () => {
        resultsPanel.hidden = true;
        selectedPanel.hidden = false;
    };

    const selectChoice = async (
        button,
        choice) => {
        clearSelection();
        selected = choice;
        button.classList.add(
            "is-selected");
        showSelection();

        if (choice.kind === "pastMeal") {
            selectionHost.innerHTML =
                `<strong>Copy ${choice.label}</strong>` +
                `<span class="small">${choice.summary}</span>`;

            addButton.disabled = false;
            return;
        }

        if (choice.kind === "pastFood") {
            selectionHost.innerHTML =
                `<strong>${choice.description}</strong>` +
                `<span class="small">Repeat ${choice.quantity} ${choice.quantityUnitCode}  |  used ${choice.usageCount} time${choice.usageCount === 1 ? "" : "s"}</span>`;

            addButton.disabled = false;
            return;
        }

        if (choice.kind === "customFood") {
            selectionHost.innerHTML =
                `<strong>${choice.description}</strong>` +
                `<span class="small">1 serving = ${choice.servingSize} ${choice.servingUnitCode}  |  ${choice.energyKcal ?? "-"} kcal  |  P ${formatMacro(choice.proteinG)}  |  C ${formatMacro(choice.carbohydrateG)}  |  F ${formatMacro(choice.fatG)}</span>`;

            if (providerControls) {
                providerControls.hidden = false;
            }

            if (measureField) {
                measureField.hidden = true;
            }

            if (amountLabel) {
                amountLabel.textContent = "Servings";
            }

            if (amountInput) {
                amountInput.value = "1";
            }

            if (amountPresets) {
                amountPresets.hidden = false;
                amountPresets.replaceChildren();

                for (const [value, label] of servingAmounts) {
                    const presetButton =
                        document.createElement(
                            "button");

                    presetButton.type = "button";
                    presetButton.className =
                        "nutrition-picker-amount-chip";
                    presetButton.dataset.amountValue =
                        value;
                    presetButton.textContent =
                        label;

                    presetButton.addEventListener(
                        "click",
                        () => {
                            if (amountInput) {
                                amountInput.value =
                                    value;
                                syncAmountPresetSelection();
                            }
                        });

                    amountPresets.appendChild(
                        presetButton);
                }

                syncAmountPresetSelection();
            }

            if (amountHint) {
                amountHint.hidden = false;
                amountHint.textContent =
                    "Choose a serving amount or type another value.";
            }

            addButton.disabled = false;
            return;
        }

        if (measureField) {
            measureField.hidden = false;
        }

        if (amountLabel) {
            amountLabel.textContent = "Amount";
        }

        selectionHost.innerHTML =
            `<strong>${choice.description}</strong>` +
            `<span class="small">Loading serving choices...</span>`;

        if (providerControls) {
            providerControls.hidden = false;
        }

        addButton.disabled = true;

        if (amountInput) {
            amountInput.value = "1";
        }

        if (!measureSelect) {
            return;
        }

        measureSelect.replaceChildren();

        const loading =
            document.createElement("option");

        loading.value = "";
        loading.textContent =
            "Loading serving choices...";

        measureSelect.appendChild(
            loading);

        const key =
            `${choice.providerCode}|${choice.sourceFoodId}`;

        try {
            let payload =
                measureCache.get(key);

            if (!payload) {
                const url =
                    new URL(
                        measuresUrl,
                        window.location.origin);

                url.searchParams.set(
                    "providerCode",
                    choice.providerCode);

                url.searchParams.set(
                    "sourceFoodId",
                    choice.sourceFoodId);

                const response =
                    await fetch(
                        url,
                        {
                            credentials: "same-origin",
                            cache: "no-store",
                            headers: {
                                "Accept": "application/json"
                            }
                        });

                payload =
                    await response.json();

                if (!response.ok
                    || payload?.success !== true) {
                    throw new Error(
                        payload?.message
                        || "Unable to load serving choices.");
                }

                measureCache.set(
                    key,
                    payload);
            }

            if (selected !== choice) {
                return;
            }

            measureSelect.replaceChildren();

            for (
                const measure of
                payload.measures ?? []
            ) {
                const option =
                    document.createElement(
                        "option");

                option.value =
                    measure.code;

                option.dataset.unitCode =
                    measure.unitCode || "";

                option.textContent =
                    `${measure.description}  |  ${measure.energyKcal ?? "-"} kcal  |  ` +
                    `P ${formatMacro(measure.proteinG)}  |  C ${formatMacro(measure.carbohydrateG)}  |  F ${formatMacro(measure.fatG)}`;

                if (
                    measure.code
                    === payload.defaultMeasureCode
                ) {
                    option.selected = true;
                }

                measureSelect.appendChild(
                    option);
            }

            if (
                measureSelect.options.length
                === 0
            ) {
                throw new Error(
                    "No compatible serving choices were returned.");
            }

            refreshAmountPresets();

            selectionHost.innerHTML =
                `<strong>${choice.description}</strong>` +
                `<span class="small">Choose the amount and serving, then Add.</span>`;

            addButton.disabled = false;
        }
        catch (error) {
            if (selected !== choice) {
                return;
            }

            selectionHost.innerHTML =
                `<strong>${choice.description}</strong>` +
                `<span class="small">${error instanceof Error ? error.message : "Unable to load serving choices."}</span>`;

            addButton.disabled = true;
        }
    };

    const choiceButton = (
        html,
        choice) => {
        const button =
            document.createElement(
                "button");

        button.type = "button";
        button.className =
            "nutrition-picker-choice";

        button.innerHTML = html;

        button.addEventListener(
            "click",
            () => selectChoice(
                button,
                choice));

        return button;
    };

    const renderPastMeals = meals => {
        pastMealsHost.replaceChildren();

        if (!meals?.length) {
            const empty =
                document.createElement("p");

            empty.className = "small";
            empty.textContent =
                "No earlier complete meals for this meal slot yet.";

            pastMealsHost.appendChild(
                empty);

            return;
        }

        for (const meal of meals) {
            const date =
                new Date(
                    `${meal.logDate}T12:00:00`);

            const label =
                date.toLocaleDateString(
                    undefined,
                    {
                        month: "short",
                        day: "numeric"
                    });

            const choice = {
                kind: "pastMeal",
                dailyLogId:
                    meal.dailyLogId,
                sourceMealSlotCode:
                    meal.mealSlotCode,
                label,
                summary:
                    meal.summary
            };

            const button =
                choiceButton(
                    `<strong>${label}</strong>` +
                    `<span>${meal.summary}</span>` +
                    `<small>${meal.itemCount} item${meal.itemCount === 1 ? "" : "s"}  |  ${meal.energyKcal ?? "-"} kcal</small>`,
                    choice);

            pastMealsHost.appendChild(
                button);
        }
    };

    const renderFoods = foods => {
        foodsHost.replaceChildren();

        if (!foods?.length) {
            const empty =
                document.createElement("p");

            empty.className = "small";
            empty.textContent =
                searchInput.value.trim().length >= 2
                    ? "No matching foods found."
                    : "Your frequent foods and saved custom foods appear here. Type at least 2 characters to search USDA.";

            foodsHost.appendChild(
                empty);

            return;
        }

        for (const food of foods) {
            const isPast =
                food.kind === "pastFood";

            const isCustom =
                food.kind === "customFood";

            let choice;
            let badge;
            let details;

            if (isPast) {
                choice = {
                    kind: "pastFood",
                    sourceDailyLogItemId:
                        food.sourceDailyLogItemId,
                    description:
                        food.description,
                    usageCount:
                        food.usageCount,
                    quantity:
                        food.quantity,
                    quantityUnitCode:
                        food.quantityUnitCode
                };

                badge =
                    `Past food  |  used ${food.usageCount}x`;

                details =
                    `${food.quantity} ${food.quantityUnitCode}`;
            }
            else if (isCustom) {
                choice = {
                    kind: "customFood",
                    customFoodId:
                        food.customFoodId,
                    description:
                        food.description,
                    servingSize:
                        food.servingSize,
                    servingUnitCode:
                        food.servingUnitCode,
                    energyKcal:
                        food.energyKcal,
                    proteinG:
                        food.proteinG,
                    carbohydrateG:
                        food.carbohydrateG,
                    fatG:
                        food.fatG
                };

                badge = "My custom food";

                details =
                    `${food.brandName || ""}` +
                    `${food.brandName ? "  |  " : ""}` +
                    `1 serving = ${food.servingSize} ${food.servingUnitCode}`;
            }
            else {
                choice = {
                    kind: "provider",
                    providerCode:
                        food.providerCode,
                    sourceFoodId:
                        food.sourceFoodId,
                    description:
                        food.description
                };

                badge =
                    `${food.providerCode ?? "Food"}${food.dataType ? `  |  ${food.dataType}` : ""}`;

                details =
                    food.brandName || "";
            }

            const button =
                choiceButton(
                    `<strong>${food.description}</strong>` +
                    `<span>${details}</span>` +
                    `<small>${badge}  |  ${food.energyKcal ?? "-"} kcal  |  P ${formatMacro(food.proteinG)}  |  C ${formatMacro(food.carbohydrateG)}  |  F ${formatMacro(food.fatG)}</small>`,
                    choice);

            foodsHost.appendChild(
                button);
        }
    };

    const loadPickerData = async () => {
        const version =
            ++requestVersion;

        clearSelection();

        pastMealsHost.innerHTML =
            "<p class=\"small\">Loading past meals...</p>";

        foodsHost.innerHTML =
            "<p class=\"small\">Loading foods...</p>";

        if (warning) {
            warning.hidden = true;
            warning.textContent = "";
        }

        try {
            const url =
                new URL(
                    dataUrl,
                    window.location.origin);

            url.searchParams.set(
                "date",
                pickerDate);

            url.searchParams.set(
                "mealSlotCode",
                mealSelect.value);

            const query =
                searchInput.value.trim();

            if (query) {
                url.searchParams.set(
                    "query",
                    query);
            }

            const response =
                await fetch(
                    url,
                    {
                        credentials:
                            "same-origin",
                        cache:
                            "no-store",
                        headers: {
                            "Accept":
                                "application/json"
                        }
                    });

            const payload =
                await response.json();

            if (version !== requestVersion) {
                return;
            }

            if (!response.ok
                || payload?.success !== true) {
                throw new Error(
                    payload?.message
                    || "Unable to load the food picker.");
            }

            renderPastMeals(
                payload.pastMeals);

            renderFoods(
                payload.foods);

            if (
                warning
                && payload.warning
            ) {
                warning.textContent =
                    payload.warning;

                warning.hidden = false;
            }
        }
        catch (error) {
            if (version !== requestVersion) {
                return;
            }

            const message =
                error instanceof Error
                    ? error.message
                    : "Unable to load the food picker.";

            pastMealsHost.innerHTML =
                `<p class="small">${message}</p>`;

            foodsHost.innerHTML =
                `<p class="small">${message}</p>`;
        }
    };

    const openPicker = (opener, query = "") => {
        const slot =
            opener.dataset.mealSlot
            || "BREAKFAST";

        pickerMode =
            opener.dataset.pickerMode
            || "food";

        setActiveMealOpener(
            opener);

        mealSelect.value = slot;
        searchInput.value = query;

        clearSelection();
        syncPickerMode();

        dialog.showModal();
        loadPickerData();

        window.setTimeout(
            () => {
                if (pickerMode === "food") {
                    searchInput.focus();
                }
                else {
                    mealSelect.focus();
                }
            },
            50);
    };

    const resumeKey = "12wr-food-picker-resume";
    const rememberMeal = () => {
        try {
            sessionStorage.setItem(resumeKey, JSON.stringify({
                date: dialog.dataset.pickerDate,
                meal: mealSelect.value,
                query: searchInput.value
            }));
        } catch (_) {}
    };
    for (const form of [pastMealForm, pastFoodForm, customFoodForm, providerForm,
        customDialog?.querySelector("form")]) {
        form?.addEventListener("submit", rememberMeal);
    }
    try {
        const saved = JSON.parse(sessionStorage.getItem(resumeKey) || "null");
        sessionStorage.removeItem(resumeKey);
        if (saved?.date === dialog.dataset.pickerDate) {
            const opener = openers.find(x => x.dataset.mealSlot === saved.meal && (x.dataset.pickerMode || "food") === "food");
            if (opener) openPicker(opener, typeof saved.query === "string" ? saved.query : "");
        }
    } catch (_) {}

    for (const opener of openers) {
        opener.addEventListener(
            "click",
            () => openPicker(
                opener));
    }

    for (const closeButton of closeButtons) {
        closeButton.addEventListener(
            "click",
            () => dialog.close());
    }

    dialog.addEventListener(
        "close",
        () => setActiveMealOpener(
            null));

    pastMealOpen?.addEventListener(
        "click",
        () => {
            pickerMode = "pastMeal";
            clearSelection();
            syncPickerMode();
            loadPickerData();
        });

    dialog.querySelector("[data-picker-food-open]")?.addEventListener(
        "click",
        () => {
            pickerMode = "food";
            clearSelection();
            syncPickerMode();
            searchInput.focus();
        });

    prepMealOpen?.addEventListener(
        "click",
        () => {
            dialog.close();
            document.getElementById("nutrition-meal-prep-dialog")?.showModal();
        });

    customFoodOpen?.addEventListener(
        "click",
        () => {
            if (!(customDialog instanceof HTMLDialogElement)) {
                return;
            }

            if (customFoodMeal) {
                customFoodMeal.value =
                    mealSelect.value;
            }

            dialog.close();
            customDialog.showModal();

            window.setTimeout(
                () => customFoodName?.focus(),
                40);
        });

    for (const closeButton of customFoodCloseButtons) {
        closeButton.addEventListener(
            "click",
            () => customDialog?.close());
    }

    customDialog?.addEventListener(
        "click",
        event => {
            if (event.target === customDialog) {
                customDialog.close();
            }
        });

    measureSelect?.addEventListener(
        "change",
        refreshAmountPresets);

    amountInput?.addEventListener(
        "input",
        syncAmountPresetSelection);

    amountPresetSelect?.addEventListener(
        "change",
        () => {
            if (!amountInput
                || !amountPresetSelect.value) {
                return;
            }

            amountInput.value =
                amountPresetSelect.value;

            amountInput.dispatchEvent(
                new Event(
                    "input",
                    {
                        bubbles: true
                    }));
        });

    amountInput?.addEventListener(
        "input",
        refreshAmountPresetDropdown);
    changeButton?.addEventListener(
        "click",
        () => {
            clearSelection();
            syncPickerMode();

            window.setTimeout(
                () => {
                    if (pickerMode === "food") {
                        searchInput.focus();
                    }
                    else {
                        mealSelect.focus();
                    }
                },
                25);
        });

    mealSelect.addEventListener(
        "change",
        () => {
            syncPickerMode();
            loadPickerData();
        });

    searchInput.addEventListener(
        "input",
        () => {
            if (pickerMode !== "food") {
                return;
            }

            if (searchTimer) {
                window.clearTimeout(
                    searchTimer);
            }

            searchTimer =
                window.setTimeout(
                    loadPickerData,
                    350);
        });

    addButton.addEventListener(
        "click",
        () => {
            if (!selected) {
                return;
            }

            const meal =
                mealSelect.value;

            if (
                selected.kind
                === "pastMeal"
            ) {
                pastMealForm.elements
                    .sourceDailyLogId.value =
                        selected.dailyLogId;

                pastMealForm.elements
                    .sourceMealSlotCode.value =
                        selected.sourceMealSlotCode;

                pastMealForm.elements
                    .targetMealSlotCode.value =
                        meal;

                pastMealForm.requestSubmit();
                return;
            }

            if (
                selected.kind
                === "pastFood"
            ) {
                pastFoodForm.elements
                    .sourceDailyLogItemId.value =
                        selected.sourceDailyLogItemId;

                pastFoodForm.elements
                    .mealSlotCode.value =
                        meal;

                pastFoodForm.requestSubmit();
                return;
            }

            if (
                selected.kind
                === "customFood"
            ) {
                if (!customFoodForm) {
                    return;
                }

                customFoodForm.elements
                    .customFoodId.value =
                        selected.customFoodId;

                customFoodForm.elements
                    .servings.value =
                        amountInput?.value || "1";

                customFoodForm.elements
                    .mealSlotCode.value =
                        meal;

                customFoodForm.requestSubmit();
                return;
            }

            if (!measureSelect?.value) {
                return;
            }

            providerForm.elements
                .providerCode.value =
                    selected.providerCode;

            providerForm.elements
                .sourceFoodId.value =
                    selected.sourceFoodId;

            providerForm.elements
                .amount.value =
                    amountInput?.value || "1";

            providerForm.elements
                .measureCode.value =
                    measureSelect.value;

            providerForm.elements
                .mealSlotCode.value =
                    meal;

            providerForm.requestSubmit();
        });

    dialog.addEventListener(
        "click",
        event => {
            if (event.target === dialog) {
                dialog.close();
            }
        });
})();
</script>

