@model CoachWorkoutPage
@{ Layout="_CoachLayout";ViewData["Title"]="Adjust client workout"; }
<p><a class="button" asp-controller="Coach" asp-action="Client" asp-route-clientId="@Model.ClientId">← @Model.ClientName’s plan</a></p>
<h1>Adjust workout · @Model.Input.Date.ToString("ddd, MMM d")</h1>
<p>Changes update the client's weekly plan. Preview includes the resulting nutrition targets for the whole week. Started and completed sessions stay locked. Targets for the following week also recalculate after saving.</p>
<form method="get" class="card"><input type="hidden" name="date" value="@Model.Input.Date.ToString("yyyy-MM-dd")" /><label for="choice">Choose a workout</label><select name="choice" id="choice">@foreach(var option in Model.Options){<option value="@option.Value" selected="@(option.Value==Model.Input.Choice)">@option.Name</option>}</select><button>Load workout</button></form>
<form asp-action="Preview" asp-route-clientId="@Model.ClientId" method="post" class="card" id="coach-workout-editor">
<div asp-validation-summary="All" class="app-message"></div>
<input type="hidden" name="Date" value="@Model.Input.Date.ToString("yyyy-MM-dd")" /><input type="hidden" name="Choice" value="@Model.Input.Choice" /><input type="hidden" name="PreviewToken" value="@Model.PreviewToken" />
<p><strong>@Model.Input.Name</strong></p>
<label for="Minutes">Workout minutes</label><input id="Minutes" name="Minutes" type="number" value="@Model.Input.Minutes.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="0" max="360" step="any" required />
<label for="Rpe">Planned effort · RPE 1–10</label><input id="Rpe" name="Rpe" type="number" value="@Model.Input.Rpe.ToString(System.Globalization.CultureInfo.InvariantCulture)" min="1" max="10" step="any" required />
@if(Model.CanCustomize){<label><input type="checkbox" name="Customize" value="true" checked="@Model.Input.Customize" /> Save a client-specific routine with these exercise adjustments</label><input type="hidden" name="Customize" value="false" />}
else {<p>This workout retains its original timed/class format. You can change duration and effort, or load a rep-based workout to customize exercises.</p>}
<label for="Name">Routine name · used when saving a custom routine</label><input name="Name" id="Name" value="@Model.Input.Name" maxlength="150" required />
@if(Model.Input.Exercises.Count>0 || Model.CanCustomize){<div style="overflow-x:auto"><table><thead><tr><th>Exercise</th><th>Sets</th><th>Reps per set</th><th>Weight (lb)</th><th></th></tr></thead><tbody id="coach-exercises">
@for(var i=0;i<Model.Input.Exercises.Count;i++){var exercise=Model.Input.Exercises[i];<tr><td><span>@exercise.Name</span><input type="hidden" data-field="ExerciseId" name="Exercises[@i].ExerciseId" value="@exercise.ExerciseId" /><input type="hidden" data-field="Name" name="Exercises[@i].Name" value="@exercise.Name" /></td><td><input data-field="Sets" name="Exercises[@i].Sets" type="number" min="1" max="20" value="@exercise.Sets" style="width:5em" /></td><td><input data-field="Reps" name="Exercises[@i].Reps" value="@exercise.Reps" maxlength="150" style="width:10em" /></td><td><input data-field="WeightLb" name="Exercises[@i].WeightLb" type="number" min="0" max="2000" step="any" value="@exercise.WeightLb?.ToString(System.Globalization.CultureInfo.InvariantCulture)" style="width:6em" /></td><td>@if(Model.CanCustomize){<button type="button" data-remove-exercise>Remove</button>}</td></tr>}
</tbody></table></div><p>Use one rep count for all sets, or a comma-separated count for every set, such as 10, 8, 6. Exercise edits take effect when the custom-routine option is checked.</p>}
@if(Model.CanCustomize){<label for="exercise-picker">Add or replace an exercise</label><select id="exercise-picker"><option value="">Choose an exercise</option>@foreach(var option in Model.Catalog){<option value="@option.Value">@option.Name</option>}</select><button type="button" id="add-coach-exercise">Add exercise</button><p>To replace an exercise, remove its row and add the replacement.</p>}
<label for="Reason">Reason for this change</label><textarea id="Reason" name="Reason" rows="3" maxlength="1000" required>@Model.Input.Reason</textarea>
<button>Preview adjustment</button>
@if(Model.After is not null && ViewData.ModelState.IsValid){<button formaction="@Url.Action("Save",new {clientId=Model.ClientId})">Save reviewed workout</button>}
@if(Model.After is not null && Model.Before is not null){<h2>Current plan → adjusted plan</h2><p>Weekly calories: @Model.Before.Values.Sum(x=>x.PrescribedEnergyKcal).ToString("0") → @Model.After.Values.Sum(x=>x.PrescribedEnergyKcal).ToString("0")</p><div style="overflow-x:auto"><table><thead><tr><th>Day</th><th>Protein (g)</th><th>Carbs (g)</th><th>Fat (g)</th><th>Calories</th></tr></thead><tbody>@foreach(var after in Model.After.Values.OrderBy(x=>x.Date)){var before=Model.Before[after.Date];<tr><td>@after.Date.ToString("ddd, MMM d")</td><td>@before.ProteinG.ToString("0.#") → @after.ProteinG.ToString("0.#")</td><td>@before.RecommendedCarbsG.ToString("0.#") → @after.RecommendedCarbsG.ToString("0.#")</td><td>@before.FatG.ToString("0.#") → @after.FatG.ToString("0.#")</td><td>@before.PrescribedEnergyKcal.ToString("0") → @after.PrescribedEnergyKcal.ToString("0")</td></tr>}</tbody></table></div>}
</form>
<script src="~/js/coach-workout-editor.js" asp-append-version="true" defer></script>
