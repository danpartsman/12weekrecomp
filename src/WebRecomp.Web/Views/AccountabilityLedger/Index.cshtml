@model WebRecomp.Web.Controllers.AccountabilityLedgerPage
@{
    ViewData["Title"]="Fees, incentives & payments";
    if(Model.CanRecord){Layout="_CoachLayout";}
    var balance=Model.Entries.Sum(x=>x.Amount);
    string Money(decimal value)=>value.ToString("C2",System.Globalization.CultureInfo.GetCultureInfo("en-US"));
    string Kind(string value)=>value switch{"fee"=>"Fee","incentive"=>"Incentive","payment-client"=>"Client paid coach","payment-coach"=>"Coach paid client",_=>value};
    decimal running=0;
    TimeZoneInfo zone;
    try{zone=TimeZoneInfo.FindSystemTimeZoneById(Model.TimeZone);}
    catch(TimeZoneNotFoundException){zone=TimeZoneInfo.Utc;}
    catch(InvalidTimeZoneException){zone=TimeZoneInfo.Utc;}
}
<link rel="stylesheet" href="~/css/coach-ledger.css" asp-append-version="true" />
<section class="page-header"><p class="eyebrow">SHARED COACH ACCOUNT</p><h1>@Model.ClientName · Fees &amp; incentives</h1><p>A shared record of assessments and payments. Entries remain in posting order, including later corrections.</p></section>
<p class="ledger-links"><a class="button" asp-controller="AccountabilityPreview" asp-action="Snap" asp-route-clientId="@Model.ClientId">Snap Workouts</a> <a class="button" asp-controller="AccountabilityPreview" asp-action="Index" asp-route-clientId="@Model.ClientId">Agreement</a>@if(Model.CanRecord){<a class="button" asp-controller="Coach" asp-action="Index">Client list</a>}</p>
@if(TempData["LedgerStatus"] is string status){<div class="app-message" role="status">@status</div>}
<section class="card ledger-summary" aria-label="Account balance">
    <div><span>Running balance</span><strong>@Money(Math.Abs(balance))</strong><p>@(balance>0?"Client owes coach":balance<0?"Coach owes client":"Account is settled")</p></div>
    <div><span>Fees assessed</span><strong>@Money(Model.Entries.Where(x=>x.Kind=="fee").Sum(x=>x.Amount))</strong></div>
    <div><span>Incentives earned</span><strong>@Money(-Model.Entries.Where(x=>x.Kind=="incentive").Sum(x=>x.Amount))</strong></div>
</section>
@if(!Model.Approved){<div class="app-message">Automatic assessments are waiting for the client's approval of the current agreement. Previously posted entries and payments stay in the account.</div>}
@if(Model.CanRecord)
{
<details class="card ledger-entry-form" open><summary>Record a payment or adjustment</summary>
<form asp-action="Entry" asp-route-clientId="@Model.ClientId" method="post">
    <input type="hidden" name="ExpectedRevision" value="@Model.Revision" /><input type="hidden" name="RequestId" value="@Guid.NewGuid()" />
    <div class="ledger-fields"><label>Entry type<select name="Kind"><option value="payment-client" selected="@(balance>=0)">Client paid coach</option><option value="payment-coach" selected="@(balance<0)">Coach paid client</option><option value="fee">Fee / charge</option><option value="incentive">Incentive / credit</option></select></label>
    <label>Date<input name="Date" type="date" value="@Model.Today.ToString("yyyy-MM-dd")" required /></label><label>Amount ($)<input name="Amount" type="number" min=".01" max="10000" step=".01" required /></label>
    <label class="ledger-description">Description / payment reference<input name="Description" maxlength="300" required placeholder="e.g. Payment received by bank transfer" /></label></div>
    <p>Enter the amount received or paid. A client payment reduces an amount owed to the coach; a coach payment settles an incentive balance. Manual charges and credits are recorded with your description.</p><button type="submit">Record entry</button>
</form></details>
}
<section class="card"><h2>Account history</h2><p>Fees increase the balance; incentives and client payments reduce it. A negative balance is an amount the coach owes the client. Contract charges and late-fee adjustments can be entered by the coach. No money is transferred by this page.</p>
@if(Model.Entries.Count==0){<p>No entries have been posted yet.</p>}
else{<div class="ledger-table-scroll" tabindex="0" role="region" aria-label="Account history; scroll horizontally"><table class="ledger-table"><thead><tr><th>Posted (@Model.TimeZone)</th><th>Effective date</th><th>Type</th><th>Description</th><th>Increase ($)</th><th>Decrease ($)</th><th>Running balance</th></tr></thead><tbody>
@foreach(var entry in Model.Entries){running+=entry.Amount;<tr><td>@TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(entry.CreatedAtUtc,DateTimeKind.Utc),zone).ToString("MMM d, yyyy HH:mm")</td><td>@entry.Date.ToString("MMM d, yyyy")</td><td>@Kind(entry.Kind)</td><td>@entry.Description</td><td>@(entry.Amount>0?Money(entry.Amount):"—")</td><td>@(entry.Amount<0?Money(-entry.Amount):"—")</td><td>@Money(running)</td></tr>}
</tbody></table></div>}
@if(Model.CanRecord && Model.Entries.Any(x=>!x.Automatic && !x.SourceKey.StartsWith("reverse:") && Model.Entries.All(y=>y.SourceKey!="reverse:"+x.Id.ToString("N"))))
{
<details class="ledger-correction"><summary>Correct a manual entry</summary><form asp-action="Reverse" asp-route-clientId="@Model.ClientId" method="post"><input name="expectedRevision" type="hidden" value="@Model.Revision" /><label>Entry<select name="entryId">@foreach(var entry in Model.Entries.Where(x=>!x.Automatic && !x.SourceKey.StartsWith("reverse:") && Model.Entries.All(y=>y.SourceKey!="reverse:"+x.Id.ToString("N")))){<option value="@entry.Id">@entry.Date.ToString("MMM d") · @Kind(entry.Kind) · @Money(Math.Abs(entry.Amount)) · @entry.Description</option>}</select></label><label>Reason<input name="reason" maxlength="300" required /></label><button type="submit">Record reversal</button></form></details>
}
<p class="muted">Automatic adherence assessments use complete, reviewed evidence from the last 12 weeks. Posted history is retained. When a result or excused date is corrected under the same terms, a new adjustment line records the difference.</p>
</section>
