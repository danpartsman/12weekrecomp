@model OnboardingSetupViewModel
@{
    ViewData["Title"] = "Quick Setup";
    ViewData["OnboardingPage"] = true;
}

<style>
.ob-shell{min-height:calc(100vh - 88px);display:grid;place-items:center;padding:24px 14px 46px;background:radial-gradient(circle at 15% 12%,rgba(24,185,255,.17),transparent 34%),radial-gradient(circle at 88% 20%,rgba(80,255,156,.12),transparent 31%),linear-gradient(160deg,#04101d 0%,#071827 48%,#050b14 100%);color:#f4f8ff}.ob-wrap{width:min(620px,100%)}.ob-brand{text-align:center;margin-bottom:16px}.ob-kicker{font-size:.74rem;letter-spacing:.2em;font-weight:900;color:#50d8ff}.ob-brand h1{margin:7px 0 7px;font-size:clamp(1.75rem,5vw,2.7rem);line-height:1.04;font-weight:950}.ob-brand p{margin:0 auto;max-width:540px;color:#afc0d0;font-size:.95rem;line-height:1.45}.ob-progress{display:flex;gap:6px;margin:18px auto 13px;max-width:430px}.ob-progress span{height:5px;flex:1;border-radius:99px;background:#263b4d;transition:.2s}.ob-progress span.active{background:linear-gradient(90deg,#27c9ff,#46ef9d);box-shadow:0 0 14px rgba(39,201,255,.3)}
.ob-card{display:none;background:linear-gradient(145deg,rgba(14,35,55,.98),rgba(7,18,31,.99));border:1px solid rgba(78,205,255,.32);border-radius:22px;padding:clamp(24px,5vw,36px);box-shadow:0 28px 75px rgba(0,0,0,.42),inset 0 1px rgba(255,255,255,.04)}.ob-card.active{display:block;animation:obIn .22s ease-out}@@keyframes obIn{from{opacity:0;transform:translateY(9px) scale(.99)}to{opacity:1;transform:none}}.ob-step-label{font-size:.7rem;letter-spacing:.16em;font-weight:900;color:#50d8ff}.ob-card h2{font-size:clamp(1.45rem,4vw,2.15rem);margin:7px 0 8px}.ob-sub{color:#aebfd0;margin:0 0 22px;line-height:1.45}.ob-field{display:flex;flex-direction:column;gap:7px}.ob-field+.ob-field{margin-top:16px}.ob-field label{font-size:.86rem;font-weight:850;color:#eaf5ff}.ob-required{color:#62ed9c}.ob-help{font-size:.79rem;color:#8fa5b9;line-height:1.4}.ob-field input,.ob-field select{width:100%;box-sizing:border-box;border:1px solid #315874;background:#071829;color:#f7fbff;border-radius:13px;padding:14px 15px;font:inherit;font-size:1.02rem;outline:none;transition:.2s}.ob-field input:focus,.ob-field select:focus{border-color:#42d5ff;box-shadow:0 0 0 3px rgba(66,213,255,.12)}.ob-two{display:grid;grid-template-columns:1fr 1fr;gap:15px}.ob-two .ob-field+.ob-field{margin-top:0}.ob-age{font-size:.82rem;color:#5ce8a4;font-weight:800;min-height:1.1em}
.ob-plans{display:grid;gap:11px}.ob-plan{position:relative;display:block;cursor:pointer}.ob-plan input{position:absolute;opacity:0;pointer-events:none}.ob-plan-body{display:flex;align-items:center;gap:13px;padding:15px 16px;border-radius:14px;border:1px solid #294b64;background:#091c2c;transition:.18s}.ob-plan-icon{display:grid;place-items:center;width:38px;height:38px;flex:0 0 38px;border-radius:50%;background:#0d2a40;font-size:1.15rem}.ob-plan-copy strong{display:block;font-size:1rem}.ob-plan-copy small{display:block;color:#97aec1;margin-top:3px;line-height:1.32}.ob-plan input:checked+.ob-plan-body{border-color:#53f29e;background:linear-gradient(145deg,rgba(30,102,84,.38),rgba(8,34,45,.96));box-shadow:0 0 0 2px rgba(83,242,158,.12),0 0 22px rgba(83,242,158,.09)}.ob-callout{background:rgba(70,239,157,.08);border:1px solid rgba(70,239,157,.2);border-radius:13px;padding:13px 14px;margin:18px 0;color:#cfeede;line-height:1.4}.ob-callout strong{color:#66f3a7}.ob-actions{display:flex;justify-content:space-between;gap:10px;margin-top:25px}.ob-btn{border:1px solid #35566f;border-radius:999px;padding:12px 20px;background:#0a2033;color:#eef8ff;font-weight:900;cursor:pointer}.ob-btn.primary{margin-left:auto;border:0;background:linear-gradient(90deg,#2ecbff,#43eb96);color:#031019;box-shadow:0 10px 28px rgba(46,203,255,.17)}.ob-summary{display:grid;gap:9px;margin-top:17px}.ob-summary div{display:flex;justify-content:space-between;gap:16px;align-items:center;background:#081a29;border:1px solid #233f55;border-radius:11px;padding:11px 13px}.ob-summary span{font-size:.74rem;text-transform:uppercase;letter-spacing:.07em;color:#7892a8}.ob-summary strong{text-align:right}.validation-summary-errors{background:rgba(255,78,94,.1);border:1px solid rgba(255,78,94,.4);border-radius:12px;padding:12px 16px;margin-bottom:14px;color:#ffb9c0}.field-validation-error{color:#ff9aa6;font-size:.78rem}.input-validation-error{border-color:#ff6676!important}.ob-mini{font-size:.78rem;color:#8199ad;text-align:center;margin-top:11px}.ob-hidden{display:none!important}@@media(max-width:560px){.ob-shell{padding:18px 9px 38px;place-items:start center}.ob-card{border-radius:18px;padding:22px 17px}.ob-two{grid-template-columns:1fr}.ob-two .ob-field+.ob-field{margin-top:15px}.ob-actions{position:sticky;bottom:7px;background:linear-gradient(180deg,transparent,#071523 30%);padding-top:19px}.ob-btn{padding:12px 17px}}
</style>

<div class="ob-shell">
    <div class="ob-wrap">
        <div class="ob-brand">
            <div class="ob-kicker">12 WEEK RECOMP · QUICK START</div>
            <h1>A few simple answers. Then Recomp takes over.</h1>
            <p>We only need the information the system cannot safely guess. You can add body-fat, waist, sleep, steps and other detail later.</p>
        </div>

        <div class="ob-progress" aria-label="Setup progress">
            <span class="active"></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>

        <form asp-controller="Onboarding" asp-action="Index" method="post" id="onboarding-form">
            <div asp-validation-summary="All"></div>
            <input asp-for="TimeZone" type="hidden" />

            @* Preserve optional information already stored on an interrupted/legacy profile.
               Quick Start does not make people answer these before entering the app. *@
            <input asp-for="StartingBodyFatPercent" type="hidden" />
            <input asp-for="StartingMuscleMassLb" type="hidden" />
            <input asp-for="StartingBodyWaterLb" type="hidden" />
            <input asp-for="StartingWaistIn" type="hidden" />
            <input asp-for="StartingHipsIn" type="hidden" />
            <input asp-for="StartingVisceralFatRating" type="hidden" />
            <input asp-for="LifestyleActivityCode" type="hidden" />
            <input asp-for="BaselineStepsDay" type="hidden" />
            <input asp-for="BaselineSleepHours" type="hidden" />

            <section class="ob-card active" data-step="0">
                <div class="ob-step-label">1 OF 7</div>
                <h2>What should we call you?</h2>
                <p class="ob-sub">This is just the name shown inside your Recomp account.</p>
                <div class="ob-field">
                    <label asp-for="ClientName">Name <span class="ob-required">*</span></label>
                    <input asp-for="ClientName" autocomplete="name" autofocus data-required-step />
                    <span asp-validation-for="ClientName"></span>
                </div>
                <div class="ob-actions"><button class="ob-btn primary" type="button" data-next>Next →</button></div>
            </section>

            <section class="ob-card" data-step="1">
                <div class="ob-step-label">2 OF 7 · REQUIRED FOR CALCULATION</div>
                <h2>What do you weigh today?</h2>
                <p class="ob-sub">Your current weight anchors the first energy, protein, carbohydrate and fat prescription.</p>
                <div class="ob-field">
                    <label asp-for="StartingWeightLb">Current weight (lb) <span class="ob-required">*</span></label>
                    <input asp-for="StartingWeightLb" type="number" step="0.1" min="75" max="700" inputmode="decimal" data-required-step />
                    <span asp-validation-for="StartingWeightLb"></span>
                </div>
                <div class="ob-actions"><button class="ob-btn" type="button" data-back>← Back</button><button class="ob-btn primary" type="button" data-next>Next →</button></div>
            </section>

            <section class="ob-card" data-step="2">
                <div class="ob-step-label">3 OF 7 · REQUIRED FOR CALCULATION</div>
                <h2>Age and sex</h2>
                <p class="ob-sub">These are used only where the physiology calculations require them.</p>
                <div class="ob-two">
                    <div class="ob-field">
                        <label asp-for="DateOfBirth">Date of birth <span class="ob-required">*</span></label>
                        <input asp-for="DateOfBirth" type="date" data-required-step />
                        <div class="ob-age" id="age-preview"></div>
                        <span asp-validation-for="DateOfBirth"></span>
                    </div>
                    <div class="ob-field">
                        <label asp-for="SexCode">Sex used for calculations <span class="ob-required">*</span></label>
                        <select asp-for="SexCode" data-required-step>
                            <option value="">Choose…</option>
                            <option value="FEMALE">Female</option>
                            <option value="MALE">Male</option>
                        </select>
                        <span asp-validation-for="SexCode"></span>
                    </div>
                </div>
                <div class="ob-actions"><button class="ob-btn" type="button" data-back>← Back</button><button class="ob-btn primary" type="button" data-next>Next →</button></div>
            </section>

            <section class="ob-card" data-step="3">
                <div class="ob-step-label">4 OF 7 · REQUIRED FOR CALCULATION</div>
                <h2>How tall are you?</h2>
                <p class="ob-sub">Height is part of the starting metabolic estimate. Recomp replaces estimates with your real data as you use the system.</p>
                <div class="ob-field">
                    <label asp-for="HeightIn">Height (inches) <span class="ob-required">*</span></label>
                    <input asp-for="HeightIn" type="number" step="0.1" min="48" max="90" inputmode="decimal" data-required-step />
                    <div class="ob-help">Example: 5 ft 10 in = 70 inches.</div>
                    <span asp-validation-for="HeightIn"></span>
                </div>
                <div class="ob-actions"><button class="ob-btn" type="button" data-back>← Back</button><button class="ob-btn primary" type="button" data-next>Next →</button></div>
            </section>

            <section class="ob-card" data-step="4">
                <div class="ob-step-label">5 OF 7 · YOUR OUTCOME</div>
                <h2>What do you want most from the next 12 weeks?</h2>
                <p class="ob-sub">Choose the primary direction. The system still protects muscle and adapts from your actual results.</p>
                <div class="ob-plans" id="goal-options">
                    <label class="ob-plan">
                        <input asp-for="GoalCode" type="radio" value="FAT_LOSS_RECOMP" data-required-step />
                        <span class="ob-plan-body"><span class="ob-plan-icon">↘↗</span><span class="ob-plan-copy"><strong>Lose Fat + Gain Muscle</strong><small>Recomposition: reduce fat while building or preserving useful lean mass.</small></span></span>
                    </label>
                    <label class="ob-plan">
                        <input asp-for="GoalCode" type="radio" value="FAT_LOSS" data-required-step />
                        <span class="ob-plan-body"><span class="ob-plan-icon">↘</span><span class="ob-plan-copy"><strong>Lose Fat</strong><small>Prioritize fat loss while protecting strength and lean mass.</small></span></span>
                    </label>
                    <label class="ob-plan">
                        <input asp-for="GoalCode" type="radio" value="MUSCLE_BUILD" data-required-step />
                        <span class="ob-plan-body"><span class="ob-plan-icon">↗</span><span class="ob-plan-copy"><strong>Gain Muscle</strong><small>Prioritize muscle and strength with body composition still monitored.</small></span></span>
                    </label>
                </div>
                <span asp-validation-for="GoalCode"></span>
                <div class="ob-actions"><button class="ob-btn" type="button" data-back>← Back</button><button class="ob-btn primary" type="button" data-next>Next →</button></div>
            </section>

            <section class="ob-card" data-step="5">
                <div class="ob-step-label">6 OF 7 · REAL-LIFE SCHEDULE</div>
                <h2>How much training fits your normal week?</h2>
                <p class="ob-sub">Use a realistic week, not a perfect one. You can move individual workouts around after setup.</p>
                <div class="ob-two">
                    <div class="ob-field">
                        <label asp-for="AvailableTrainingDaysWeek">Training / movement days <span class="ob-required">*</span></label>
                        <select asp-for="AvailableTrainingDaysWeek" data-required-step>
                            <option value="1">1 day</option><option value="2">2 days</option><option value="3">3 days</option><option value="4">4 days</option><option value="5">5 days</option><option value="6">6 days</option><option value="7">7 days</option>
                        </select>
                        <span asp-validation-for="AvailableTrainingDaysWeek"></span>
                    </div>
                    <div class="ob-field">
                        <label asp-for="TrainingExperienceCode">Resistance-training experience <span class="ob-required">*</span></label>
                        <select asp-for="TrainingExperienceCode" data-required-step>
                            <option value="BEGINNER">Beginner</option>
                            <option value="INTERMEDIATE">Intermediate</option>
                            <option value="ADVANCED">Advanced</option>
                        </select>
                        <span asp-validation-for="TrainingExperienceCode"></span>
                    </div>
                </div>
                <div class="ob-actions"><button class="ob-btn" type="button" data-back>← Back</button><button class="ob-btn primary" type="button" data-next>Review →</button></div>
            </section>

            <section class="ob-card" data-step="6">
                <div class="ob-step-label">7 OF 7 · READY</div>
                <h2>That’s all we need to start.</h2>
                <p class="ob-sub">No long intake form. Recomp can now create the first prescription, and you can add optional detail later as it becomes useful.</p>
                <div class="ob-summary">
                    <div><span>Weight</span><strong id="summary-weight">—</strong></div>
                    <div><span>Age</span><strong id="summary-age">—</strong></div>
                    <div><span>Goal</span><strong id="summary-plan">—</strong></div>
                    <div><span>Weekly availability</span><strong id="summary-days">—</strong></div>
                </div>
                <div class="ob-callout"><strong>Next:</strong> Recomp builds your recommended starting week. You can rearrange it before anything becomes your working plan.</div>
                <div class="ob-actions"><button class="ob-btn" type="button" data-back>← Back</button><button class="ob-btn primary" type="submit">Build my starting plan →</button></div>
                <div class="ob-mini">Optional measurements and lifestyle details can be added later from your profile and daily check-ins.</div>
            </section>
        </form>
    </div>
</div>

<script>
(() => {
    const cards = [...document.querySelectorAll('.ob-card')];
    const bars = [...document.querySelectorAll('.ob-progress span')];
    const form = document.getElementById('onboarding-form');
    const tz = document.getElementById('TimeZone');
    const dob = document.getElementById('DateOfBirth');
    let step = 0;

    try {
        const browserZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        if (browserZone && tz) tz.value = browserZone;
    } catch (_) { }

    const ageFromDob = value => {
        if (!value) return null;
        const birth = new Date(value + 'T00:00:00');
        if (Number.isNaN(birth.getTime())) return null;
        const now = new Date();
        let age = now.getFullYear() - birth.getFullYear();
        const month = now.getMonth() - birth.getMonth();
        if (month < 0 || (month === 0 && now.getDate() < birth.getDate())) age--;
        return age >= 0 ? age : null;
    };

    const updateAge = () => {
        const age = ageFromDob(dob?.value);
        const preview = document.getElementById('age-preview');
        if (preview) preview.textContent = age === null ? '' : `Age ${age}`;
    };

    const show = n => {
        step = Math.max(0, Math.min(cards.length - 1, n));
        cards.forEach((card, i) => card.classList.toggle('active', i === step));
        bars.forEach((bar, i) => bar.classList.toggle('active', i <= step));
        if (step === cards.length - 1) updateSummary();
        const first = cards[step]?.querySelector('input:not([type="hidden"]),select');
        if (first) setTimeout(() => first.focus({ preventScroll: true }), 80);
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    const stepValid = () => {
        const card = cards[step];
        if (!card) return true;
        const fields = [...card.querySelectorAll('[data-required-step]')];
        const radios = fields.filter(x => x.type === 'radio');
        if (radios.length && !radios.some(x => x.checked)) {
            document.getElementById('goal-options')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return false;
        }
        for (const field of fields.filter(x => x.type !== 'radio')) {
            if (!String(field.value ?? '').trim() || !field.checkValidity()) {
                field.reportValidity();
                field.focus();
                return false;
            }
        }
        return true;
    };

    const goalLabel = value => ({
        FAT_LOSS_RECOMP: 'Lose Fat + Gain Muscle',
        FAT_LOSS: 'Lose Fat',
        MUSCLE_BUILD: 'Gain Muscle'
    })[value] || '—';

    const updateSummary = () => {
        const weight = document.getElementById('StartingWeightLb')?.value;
        const goal = document.querySelector('input[name="GoalCode"]:checked')?.value;
        const days = document.getElementById('AvailableTrainingDaysWeek')?.value;
        const age = ageFromDob(dob?.value);
        document.getElementById('summary-weight').textContent = weight ? `${weight} lb` : '—';
        document.getElementById('summary-age').textContent = age === null ? '—' : String(age);
        document.getElementById('summary-plan').textContent = goalLabel(goal);
        document.getElementById('summary-days').textContent = days ? `${days} days` : '—';
    };

    document.querySelectorAll('[data-next]').forEach(button => button.addEventListener('click', () => {
        if (stepValid()) show(step + 1);
    }));
    document.querySelectorAll('[data-back]').forEach(button => button.addEventListener('click', () => show(step - 1)));
    dob?.addEventListener('change', updateAge);
    updateAge();

    form?.addEventListener('keydown', event => {
        if (event.key === 'Enter' && step < cards.length - 1 && event.target?.tagName !== 'TEXTAREA') {
            event.preventDefault();
            if (stepValid()) show(step + 1);
        }
    });

    const serverError = document.querySelector('.input-validation-error,.field-validation-error');
    if (serverError) {
        const containingCard = serverError.closest('.ob-card');
        const index = cards.indexOf(containingCard);
        if (index >= 0) show(index);
    }
})();
</script>
