@model OnboardingSetupViewModel
@{
    ViewData["Title"] = "Quick Setup";
    ViewData["OnboardingPage"] = true;
}
<style>
.ob-shell{min-height:calc(100vh - 88px);display:grid;place-items:center;padding:24px 14px 46px;background:radial-gradient(circle at 15% 12%,rgba(24,185,255,.17),transparent 34%),linear-gradient(160deg,#04101d,#071827 48%,#050b14);color:#f4f8ff}.ob-wrap{width:min(690px,100%)}.ob-brand{text-align:center;margin-bottom:16px}.ob-kicker{font-size:.74rem;letter-spacing:.18em;font-weight:900;color:#50d8ff}.ob-brand h1{margin:7px 0;font-size:clamp(1.8rem,5vw,2.7rem)}.ob-brand p,.ob-sub{color:#afc0d0;line-height:1.45}.ob-progress{display:flex;gap:7px;margin:18px auto 14px;max-width:340px}.ob-progress span{height:5px;flex:1;border-radius:99px;background:#263b4d}.ob-progress span.active{background:linear-gradient(90deg,#27c9ff,#46ef9d)}.ob-card{display:none;background:linear-gradient(145deg,#0e2337,#07121f);border:1px solid rgba(78,205,255,.32);border-radius:22px;padding:clamp(22px,5vw,36px);box-shadow:0 28px 75px rgba(0,0,0,.42)}.ob-card.active{display:block}.ob-step-label{font-size:.7rem;letter-spacing:.16em;font-weight:900;color:#50d8ff}.ob-card h2{margin:8px 0;font-size:clamp(1.4rem,4vw,2rem)}.ob-sub{margin:0 0 20px}.ob-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.ob-field{display:flex;flex-direction:column;gap:6px}.ob-field.wide{grid-column:1/-1}.ob-field label{font-size:.86rem;font-weight:850}.ob-field input,.ob-field select{width:100%;box-sizing:border-box;border:1px solid #315874;background:#071829;color:#f7fbff;border-radius:12px;padding:12px 14px;font:inherit}.ob-field input:focus,.ob-field select:focus{outline:2px solid #42d5ff}.ob-help{font-size:.79rem;color:#a9c0d1;line-height:1.4}.ob-plans{display:grid;gap:9px}.ob-plan{display:flex;gap:11px;align-items:flex-start;background:#091c2c;border:1px solid #294b64;border-radius:13px;padding:12px;cursor:pointer}.ob-plan:has(input:checked){border-color:#53f29e;background:#103b37}.ob-plan strong,.ob-plan small{display:block}.ob-plan small{color:#aebfd0;margin-top:3px}.ob-ack{display:flex;align-items:flex-start;gap:11px;padding:12px;margin-top:10px;background:#091c2c;border:1px solid #294b64;border-radius:12px;line-height:1.4}.ob-ack input{margin-top:4px;flex:0 0 auto;accent-color:#53f29e}.ob-actions{display:flex;justify-content:space-between;gap:10px;margin-top:25px}.ob-btn{border:1px solid #35566f;border-radius:999px;padding:12px 20px;background:#0a2033;color:#eef8ff;font-weight:900;cursor:pointer}.ob-btn.primary{margin-left:auto;border:0;background:linear-gradient(90deg,#2ecbff,#43eb96);color:#031019}.field-validation-error,.validation-summary-errors{color:#ffadb7}.validation-summary-errors{padding:12px;background:#3b2028;border-radius:12px;margin-bottom:12px}.ob-note{font-size:.82rem;color:#b0c5d1;margin-top:12px}@media(max-width:560px){.ob-grid{grid-template-columns:1fr}.ob-field.wide{grid-column:auto}.ob-card{padding:22px 17px}}
</style>
<div class="ob-shell"><div class="ob-wrap">
    <div class="ob-brand"><div class="ob-kicker">12 WEEK RECOMP · QUICK START</div><h1>Three short steps to get started.</h1><p>Give Recomp the information needed for a starting plan. You can add more detail later.</p></div>
    <div class="ob-progress" aria-label="Setup progress"><span class="active"></span><span></span><span></span></div>
    <form asp-controller="Onboarding" asp-action="Index" method="post" id="onboarding-form" novalidate>
        <div asp-validation-summary="All"></div>
        <input asp-for="TimeZone" type="hidden" />
        <input asp-for="StartingBodyFatPercent" type="hidden" />
        <input asp-for="StartingMuscleMassLb" type="hidden" />
        <input asp-for="StartingBodyWaterLb" type="hidden" />
        <input asp-for="StartingWaistIn" type="hidden" />
        <input asp-for="StartingHipsIn" type="hidden" />
        <input asp-for="StartingVisceralFatRating" type="hidden" />
        <input asp-for="LifestyleActivityCode" type="hidden" />
        <input asp-for="BaselineStepsDay" type="hidden" />
        <input asp-for="BaselineSleepHours" type="hidden" />
        <section class="ob-card active" data-step="0">
            <div class="ob-step-label">1 OF 3 · YOUR STARTING POINT</div>
            <h2>Tell us about yourself</h2>
            <p class="ob-sub">Your weight, age, calculation sex and height help estimate your starting daily targets.</p>
            <div class="ob-grid">
                <div class="ob-field wide"><label asp-for="ClientName">Name</label><input asp-for="ClientName" required autocomplete="name" autofocus data-required-step /><span asp-validation-for="ClientName"></span></div>
                <div class="ob-field"><label asp-for="StartingWeightLb">Current weight (lb)</label><input asp-for="StartingWeightLb" type="number" required step="0.1" min="75" max="700" inputmode="decimal" data-required-step /><span asp-validation-for="StartingWeightLb"></span></div>
                <div class="ob-field"><label asp-for="Age">Your age today</label><input asp-for="Age" type="number" required min="18" max="120" step="1" inputmode="numeric" data-required-step /><span asp-validation-for="Age"></span></div>
                <div class="ob-field"><label asp-for="SexCode">Sex used for calculations</label><select asp-for="SexCode" required data-required-step><option value="">Choose…</option><option value="FEMALE">Female</option><option value="MALE">Male</option></select><span asp-validation-for="SexCode"></span></div>
                <div class="ob-field"><label asp-for="HeightIn">Height (inches)</label><input asp-for="HeightIn" type="number" required step="0.1" min="48" max="90" inputmode="decimal" data-required-step /><span asp-validation-for="HeightIn"></span></div>
            </div>
            <p class="ob-note">We do not need your exact birth date. Recomp estimates one from the age you give on your local setup day so age-based calculations can run.</p>
            <div class="ob-actions"><button class="ob-btn primary" type="button" data-next>Next →</button></div>
        </section>
        <section class="ob-card" data-step="1">
            <div class="ob-step-label">2 OF 3 · YOUR DIRECTION</div>
            <h2>Choose a goal and a realistic week</h2>
            <p class="ob-sub">Your choice sets a starting direction. You can change your schedule as you use Recomp.</p>
            <div class="ob-plans">
                <label class="ob-plan"><input asp-for="GoalCode" type="radio" value="FAT_LOSS_RECOMP" /><span><strong>Lose fat + gain muscle</strong><small>Prioritize body recomposition and useful strength.</small></span></label>
                <label class="ob-plan"><input asp-for="GoalCode" type="radio" value="FAT_LOSS" /><span><strong>Lose fat</strong><small>Prioritize fat loss while protecting lean mass.</small></span></label>
                <label class="ob-plan"><input asp-for="GoalCode" type="radio" value="MUSCLE_BUILD" /><span><strong>Gain muscle</strong><small>Prioritize muscle and strength while monitoring body composition.</small></span></label>
            </div>
            <span asp-validation-for="GoalCode"></span>
            <div class="ob-grid" style="margin-top:16px">
                <div class="ob-field"><label asp-for="AvailableTrainingDaysWeek">Training / movement days per week</label><select asp-for="AvailableTrainingDaysWeek" required data-required-step><option value="1">1 day</option><option value="2">2 days</option><option value="3">3 days</option><option value="4">4 days</option><option value="5">5 days</option><option value="6">6 days</option><option value="7">7 days</option></select><span asp-validation-for="AvailableTrainingDaysWeek"></span></div>
                <div class="ob-field"><label asp-for="TrainingExperienceCode">Resistance-training experience</label><select asp-for="TrainingExperienceCode" required data-required-step><option value="BEGINNER">Beginner</option><option value="INTERMEDIATE">Intermediate</option><option value="ADVANCED">Advanced</option></select><span asp-validation-for="TrainingExperienceCode"></span></div>
            </div>
            <div class="ob-actions"><button class="ob-btn" type="button" data-back>← Back</button><button class="ob-btn primary" type="button" data-next>Next →</button></div>
        </section>
        <section class="ob-card" data-step="2">
            <div class="ob-step-label">3 OF 3 · BEFORE YOU BEGIN</div>
            <h2>Use Recomp with care</h2>
            <p class="ob-sub">This free educational program uses research-informed nutrition and resistance-training methods. Individual results vary; it cannot diagnose or address medical conditions.</p>
            <label class="ob-ack"><input asp-for="MedicalAcknowledged" type="checkbox" required data-required-step /><span>I understand Recomp is not medical advice. I will coordinate changes to my nutrition or exercise with a qualified healthcare professional when appropriate, especially if I have a medical condition, take medication or develop concerning symptoms.</span></label><span asp-validation-for="MedicalAcknowledged"></span>
            <label class="ob-ack"><input asp-for="TrainingAcknowledged" type="checkbox" required data-required-step /><span>I understand physical training has risks. I will work within my abilities, use appropriate form and progression, and stop and seek appropriate care if concerning symptoms occur.</span></label><span asp-validation-for="TrainingAcknowledged"></span>
            <label class="ob-ack"><input asp-for="TrackingAcknowledged" type="checkbox" required data-required-step /><span>I understand food logs and activity estimates can be substantially inaccurate—sometimes by 20% or more. Results are not guaranteed. I will use Recomp to learn from nutrition, training and trends, rather than treat any daily prescription as a promise of fat loss or muscle gain.</span></label><span asp-validation-for="TrackingAcknowledged"></span>
            <div class="ob-actions"><button class="ob-btn" type="button" data-back>← Back</button><button class="ob-btn primary" type="submit">Build my starting plan →</button></div>
        </section>
    </form>
</div></div>
<script>
(() => {
    const cards = [...document.querySelectorAll('.ob-card')];
    const bars = [...document.querySelectorAll('.ob-progress span')];
    const form = document.getElementById('onboarding-form');
    const tz = document.getElementById('TimeZone');
    try { const zone = Intl.DateTimeFormat().resolvedOptions().timeZone; if (zone && tz) tz.value = zone; } catch (_) {}
    let step = 0;
    function show(index) {
        step = Math.max(0, Math.min(cards.length - 1, index));
        cards.forEach((card, i) => card.classList.toggle('active', i === step));
        bars.forEach((bar, i) => bar.classList.toggle('active', i <= step));
        cards[step]?.querySelector('input:not([type="hidden"]),select')?.focus({ preventScroll: true });
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    function valid() {
        const card = cards[step];
        const checkedGoal = card.querySelector('input[name="GoalCode"]');
        if (checkedGoal && !card.querySelector('input[name="GoalCode"]:checked')) {
            checkedGoal.setCustomValidity('Choose a primary goal.');
            checkedGoal.reportValidity();
            checkedGoal.setCustomValidity('');
            return false;
        }
        for (const field of card.querySelectorAll('[data-required-step]')) {
            if (!field.checkValidity()) { field.reportValidity(); field.focus(); return false; }
        }
        return true;
    }
    document.querySelectorAll('[data-next]').forEach(button => button.addEventListener('click', () => { if (valid()) show(step + 1); }));
    document.querySelectorAll('[data-back]').forEach(button => button.addEventListener('click', () => show(step - 1)));
    form?.addEventListener('keydown', event => {
        if (event.key === 'Enter' && step < cards.length - 1 && event.target?.tagName !== 'TEXTAREA') {
            event.preventDefault(); if (valid()) show(step + 1);
        }
    });
    form?.addEventListener('submit', event => {
        for (let i = 0; i < cards.length; i++) {
            show(i);
            if (!valid()) { event.preventDefault(); return; }
        }
    });
    const serverError = document.querySelector('.input-validation-error,.field-validation-error');
    if (serverError) { const index = cards.indexOf(serverError.closest('.ob-card')); if (index >= 0) show(index); }
})();
</script>
