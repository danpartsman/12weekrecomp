@model WeekPlanViewModel
<!-- V1006_GUIDED_SCHEDULE_CLEAN -->
@await Html.PartialAsync(
    "_GuidedDemoCalloutSections",
    new[]
    {
        "Built for full-body recomposition",
        "The goal is not simply weight loss. Recomp is built to help you lose fat while preserving - and when possible building - lean muscle across your whole body.",

        "A weekly template that fits real life",
        "We build your workout template for the week in advance using the days you can actually train. You can move workouts when your schedule changes, and Recomp keeps checking the plan against the program guidelines."
    })
@using System.Linq
@functions {
    private static string CategoryFromDay(string? code, string? role)
    {
        if (string.IsNullOrWhiteSpace(code))
            return "unplanned";

        var normalizedRole = (role ?? "").ToUpperInvariant();

        if (normalizedRole.Contains("HEAVY"))
            return "major";

        if (normalizedRole.Contains("LIGHT_STRENGTH"))
            return "accessory";

        // Match the Workout Actual selector grouping: conditioning/cardio is
        // evaluated before recovery, so Zone 2 / RECOVERY_CARDIO appears here.
        if (normalizedRole.Contains("CONDITION") || normalizedRole.Contains("CARDIO"))
            return "cardio";

        if (normalizedRole.Contains("RECOVERY"))
            return "recovery";

        return CategoryFromCode(code);
    }

    private static string CategoryFromCode(string? code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return "unplanned";

        var c = code.ToUpperInvariant();

        if (c.StartsWith("MAJOR_")
            || c == "FULL_BODY_STRENGTH")
            return "major";

        if (c == "ACCESSORY"
            || c == "RESISTANCE_CIRCUIT")
            return "accessory";

        if (c is "GENERAL_CARDIO"
            or "EASY_CARDIO"
            or "ZONE2_CARDIO"
            or "WALKING"
            or "RUNNING"
            or "TREADMILL"
            or "CYCLING"
            or "ROWING"
            or "ELLIPTICAL"
            or "STAIR_CLIMBER"
            or "SWIMMING"
            or "RUNNING_INTERVALS"
            or "CYCLING_INTERVALS"
            or "ROWING_INTERVALS"
            or "MIXED_CONDITIONING"
            or "TRUE_HIIT"
            or "ORANGETHEORY"
            or "MIXED_GYM_SESSION"
            or "CUSTOM_COMPOSITE")
            return "cardio";

        if (c is "REST" or "MOBILITY_RECOVERY")
            return "recovery";

        return "unplanned";
    }

    private static string CategoryLabel(string category) => category switch
    {
        "major" => "Major / hard strength",
        "accessory" => "Accessory strength",
        "cardio" => "Conditioning / cardio",
        "recovery" => "Recovery / rest",
        _ => "Unplanned"
    };

    private static string CarbCycleLabel(string category) => category switch
    {
        "major" => "HIGH-CARB CYCLE",
        "accessory" => "MODERATE-CARB CYCLE",
        "cardio" => "LOW–MODERATE-CARB CYCLE",
        "recovery" => "LOW-CARB CYCLE",
        _ => "PLAN ALL 7 DAYS"
    };
}
@{
    ViewData["Title"] = "Weekly Plan";
    var previous = Model.WeekStart.AddDays(-7).ToString("yyyy-MM-dd");
    var next = Model.WeekStart.AddDays(7).ToString("yyyy-MM-dd");

    var majorCount = Model.Days.Count(x => CategoryFromDay(x.WorkoutTypeCode, x.WeeklyRole) == "major");
    var accessoryCount = Model.Days.Count(x => CategoryFromDay(x.WorkoutTypeCode, x.WeeklyRole) == "accessory");
    var cardioCount = Model.Days.Count(x => CategoryFromDay(x.WorkoutTypeCode, x.WeeklyRole) == "cardio");
    var recoveryCount = Model.Days.Count(x => CategoryFromDay(x.WorkoutTypeCode, x.WeeklyRole) == "recovery");
    var unplannedCount = Model.Days.Count(x => CategoryFromDay(x.WorkoutTypeCode, x.WeeklyRole) == "unplanned");

    var recommendedMajorCount = Model.RecommendedDays.Count(x => CategoryFromCode(x.WorkoutTypeCode) == "major");
    var recommendedAccessoryCount = Model.RecommendedDays.Count(x => CategoryFromCode(x.WorkoutTypeCode) == "accessory");
    var recommendedCardioCount = Model.RecommendedDays.Count(x => CategoryFromCode(x.WorkoutTypeCode) == "cardio");
    var recommendedRecoveryCount = Model.RecommendedDays.Count(x => CategoryFromCode(x.WorkoutTypeCode) == "recovery");

    var systemCategoryOrder =
        WebRecomp.Web.Services.WorkoutIntelligence
            .SystemWorkoutRecipeCatalog
            .PresentationCategoryOrder;

    string SystemWorkoutCategory(string engineWorkoutTypeCode) =>
        WebRecomp.Web.Services.WorkoutIntelligence
            .SystemWorkoutRecipeCatalog
            .PresentationCategoryForEngineWorkoutType(
                engineWorkoutTypeCode);
    var statusMessage = TempData["ScheduleStatus"] as string ?? TempData["StatusMessage"] as string;
}
<div class="app-page app-page-workout">
    <header class="app-page-head weekly-plan-hero-head">
        <div class="weekly-plan-hero-copy">
            <div class="app-kicker">WEEKLY • PLAN ONCE, ADJUST ANY TIME</div>
            <h1>Weekly Workout Plan</h1>
            <p class="lede">Start with the workouts you already do, then build a realistic seven-day mix around them.</p>

            <div class="week-nav">
                <a class="button"
                   asp-action="Index"
                   asp-route-weekStart="@previous"
                   asp-route-previewGoalCode="@(Model.IsGoalPreview ? Model.PreviewGoalCode : null)">&larr; Prior week</a>
                <a class="button"
                   asp-action="Index"
                   asp-route-weekStart="@next"
                   asp-route-previewGoalCode="@(Model.IsGoalPreview ? Model.PreviewGoalCode : null)">Next week →</a>
                <form asp-action="CopyToNextWeek" method="post" class="inline-week-action">
                    <input type="hidden" name="weekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                    <button class="button copy-week-button" type="submit" disabled="@(Model.NextWeekHasPlan ? "disabled" : null)"
                            title="@(Model.NextWeekHasPlan ? "Next week already has a plan. Recomp will not overwrite it." : "Copy this saved week into next week")">
                        Copy this week → next
                    </button>
                </form>
            </div>
        </div>

        <div class="weekly-plan-hero-image" aria-hidden="true">
            <img src="~/images/marketing-v13/evidence-gym-group-clean.jpg"
                 alt=""
                 loading="eager" />
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="schedule-status-message">@statusMessage</div>
    }

    @if (Model.ShowRecommendedPlanPrompt)
    {
        <section class="recommended-week-review" aria-labelledby="recommended-week-title">
            <div>
                <div class="app-kicker">PLAN CHANGED • REVIEW BEFORE APPLYING</div>
                <h2 id="recommended-week-title">Recommended week for @Model.PlanDisplayName</h2>
                <p>@Model.PlanGuidance</p>
                <p><strong>Your current week has not been overwritten.</strong> Apply the recommendation only if you want Recomp to replace today and the remaining days of this week. Earlier days stay intact.</p>
            </div>
            <div class="recommended-week-grid">
                @foreach (var day in Model.RecommendedDays)
                {
                    <div class="recommended-day">
                        <strong>@day.DayName</strong>
                        <span>@day.WorkoutDisplayName</span>
                    </div>
                }
            </div>
            <div class="app-action-row">
                <a class="button" asp-action="Index" asp-route-weekStart="@Model.WeekStart.ToString("yyyy-MM-dd")">Keep my current week</a>
                <form asp-action="ApplyRecommendedWeek" method="post" class="inline-week-action">
                    <input type="hidden" name="weekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                    <button class="primary" type="submit">Apply recommended week from today forward</button>
                </form>
            </div>
        </section>
    }

    @if (Model.SeededFromPlan)
    {
        <div class="plan-source-note"><strong>Recomp built this starting week for you.</strong> It is based on @Model.PlanDisplayName and your available training days. Move or replace anything that does not fit your life.</div>
    }
    else if (Model.AutoRolled)
    {
        <div class="plan-source-note"><strong>This week was carried forward automatically.</strong> The new week was blank, so Recomp copied your prior week. Review it and change anything that is different.</div>
    }

    <section class="app-status @(Model.WeeklyStatus == "GOOD" ? "good" : "review")">
        <div class="app-status-dot"></div>
        <div>
            <strong>@(Model.WeeklyStatus == "GOOD" ? "Week looks balanced" : "Week needs review")</strong>
            <span>@Model.WeeklyNote</span>
        </div>
        <button type="button" class="help-tip status-help" aria-label="About weekly balance"
                data-tooltip="This status is a quick check of the planned training mix. It is guidance, not a pass/fail grade. Recomp still calculates each day's targets from the workouts you save.">?</button>
    </section>

    @if (Model.CanChangeGoal)
    {
        <section class="plan-goal-preview @(Model.IsGoalPreview ? "is-previewing" : "")"
                 aria-labelledby="plan-goal-preview-title">
            <div class="plan-goal-preview-copy">
                <div class="app-kicker">PRIMARY GOAL • LIVE WEEKLY PREVIEW</div>
                <div class="plan-goal-title-row">
                    <h2 id="plan-goal-preview-title">
                        Based on your selection of @Model.PreviewGoalDisplayName, here are Recomp's recommended days.
                    </h2>
                    <button type="button"
                            class="help-tip plan-goal-info"
                            aria-label="About @Model.PreviewGoalDisplayName"
                            data-tooltip="@Model.PreviewGoalDescription">?</button>
                </div>

                @if (Model.IsGoalPreview)
                {
                    <p>
                        <strong>Preview only.</strong>
                        Your saved Primary Goal is still @Model.CurrentGoalDisplayName, and none of your planned workouts have been changed.
                        The Recommended numbers below show how the weekly mix would change.
                    </p>
                }
                else
                {
                    <p>
                        Preview another Primary Goal to compare its recommended workout mix and fueling pattern.
                        Your planned week will not change unless you explicitly apply a new goal and then choose to apply its recommended schedule.
                    </p>
                }

                <p class="plan-goal-engine-note">
                    Engine 3.0 still calculates the actual calories and macros for each day; the high/moderate/low-carb labels summarize the fueling pattern.
                </p>
            </div>

            <div class="plan-goal-preview-controls">
                <form asp-action="Index"
                      method="get"
                      class="plan-goal-preview-form">
                    <input type="hidden"
                           name="weekStart"
                           value="@Model.WeekStart.ToString("yyyy-MM-dd")" />

                    <label for="preview-goal-code">Preview another goal</label>
                    <select id="preview-goal-code"
                            name="previewGoalCode"
                            asp-items="Model.GoalOptions"
                            onchange="this.form.submit()">
                    </select>
                    <noscript>
                        <button class="button" type="submit">Preview goal</button>
                    </noscript>
                </form>

                @if (Model.IsGoalPreview)
                {
                    <div class="plan-goal-preview-actions">
                        <form asp-action="ApplyGoal"
                              method="post">
                            <input type="hidden"
                                   name="goalCode"
                                   value="@Model.PreviewGoalCode" />
                            <input type="hidden"
                                   name="weekStart"
                                   value="@Model.WeekStart.ToString("yyyy-MM-dd")" />
                            <button class="primary"
                                    type="submit">
                                Use this goal from today
                            </button>
                        </form>

                        <a class="button"
                           asp-action="Index"
                           asp-route-weekStart="@Model.WeekStart.ToString("yyyy-MM-dd")">
                            Return to current goal
                        </a>
                    </div>
                }
                else
                {
                    <span class="plan-goal-current-pill">
                        Current goal
                    </span>
                }
            </div>

            <div class="plan-goal-outlook" aria-label="Expected body composition direction">
                <div class="plan-goal-outlook-head">
                    <div>
                        <span class="plan-mix-section-label">Expected direction this week</span>
                        <strong>What this goal is trying to produce</strong>
                    </div>
                    <button type="button"
                            class="help-tip"
                            aria-label="About expected weekly direction"
                            data-tooltip="The energy estimate uses this week's currently planned workouts with the selected goal. The Recommended cards below show the proposed training mix. Fat-loss pounds are an energy equivalent, not a guaranteed scale or body-fat change. Muscle change cannot be predicted precisely week to week.">?</button>
                </div>

                <div class="plan-goal-outlook-grid">
                    <div>
                        <span>Fat direction</span>
                        <strong>@(string.IsNullOrWhiteSpace(Model.PreviewFatDirection) ? "CALCULATES WITH WEIGHT DATA" : Model.PreviewFatDirection)</strong>
                    </div>
                    <div>
                        <span>Weekly energy balance</span>
                        <strong>
                            @(Model.PreviewWeeklyDeficitKcal.HasValue
                                ? $"{Model.PreviewWeeklyDeficitKcal.Value:0} kcal deficit"
                                : "—")
                        </strong>
                    </div>
                    <div>
                        <span>Fat-loss energy equivalent</span>
                        <strong>
                            @(Model.PreviewFatLossEnergyEquivalentLb.HasValue
                                ? $"{Model.PreviewFatLossEnergyEquivalentLb.Value:0.00} lb"
                                : "—")
                        </strong>
                    </div>
                    <div>
                        <span>Muscle stimulus</span>
                        <strong>@Model.PreviewMuscleStimulus</strong>
                    </div>
                    <div class="plan-goal-outlook-wide">
                        <span>Lean-mass direction</span>
                        <strong>@Model.PreviewMuscleDirection</strong>
                    </div>
                </div>

                <p>
                    These are directional expectations, not guaranteed tissue changes. After you apply a different weekly mix, Engine 3.0 recalculates the actual daily targets.
                </p>
            </div>
        </section>
    }

    <div class="plan-week-mix-heading">
        <div>
            <div class="app-kicker">THIS WEEK AT A GLANCE</div>
            <strong>Recommended vs planned workout mix</strong>
        </div>
        <button type="button" class="help-tip" aria-label="About workout categories"
                data-tooltip="The darker top section shows Recomp's recommended weekly mix and fueling cycle. The lighter lower section shows what you actually planned. Hard/major is typically high-carb, accessory is moderate-carb, cardio is generally low-to-moderate carb, and recovery/rest is low-carb. Hard interval or Orangetheory-style cardio can still receive more carbohydrate because Engine 3.0 determines the actual grams from glycogen demand.">?</button>
    </div>
    <section class="plan-week-mix" aria-label="Recommended versus planned weekly workout mix">
        <div class="plan-mix-item plan-mix-major" data-count-category="major">
            <div class="plan-mix-recommended">
                <span class="plan-mix-section-label">Recommended</span>
                <div class="plan-mix-value-line">
                    <strong>@recommendedMajorCount</strong>
                    <span>Hard / Major workouts</span>
                </div>
                <em>@CarbCycleLabel("major")</em>
            </div>
            <div class="plan-mix-planned">
                <span class="plan-mix-section-label">Planned</span>
                <div class="plan-mix-value-line">
                    <strong data-count-value>@majorCount</strong>
                    <span>Hard / Major</span>
                </div>
            </div>
        </div>

        <div class="plan-mix-item plan-mix-accessory" data-count-category="accessory">
            <div class="plan-mix-recommended">
                <span class="plan-mix-section-label">Recommended</span>
                <div class="plan-mix-value-line">
                    <strong>@recommendedAccessoryCount</strong>
                    <span>Accessory workouts</span>
                </div>
                <em>@CarbCycleLabel("accessory")</em>
            </div>
            <div class="plan-mix-planned">
                <span class="plan-mix-section-label">Planned</span>
                <div class="plan-mix-value-line">
                    <strong data-count-value>@accessoryCount</strong>
                    <span>Accessory</span>
                </div>
            </div>
        </div>

        <div class="plan-mix-item plan-mix-cardio" data-count-category="cardio">
            <div class="plan-mix-recommended">
                <span class="plan-mix-section-label">Recommended</span>
                <div class="plan-mix-value-line">
                    <strong>@recommendedCardioCount</strong>
                    <span>Cardio workouts</span>
                </div>
                <em>@CarbCycleLabel("cardio")</em>
            </div>
            <div class="plan-mix-planned">
                <span class="plan-mix-section-label">Planned</span>
                <div class="plan-mix-value-line">
                    <strong data-count-value>@cardioCount</strong>
                    <span>Cardio</span>
                </div>
            </div>
        </div>

        <div class="plan-mix-item plan-mix-recovery" data-count-category="recovery">
            <div class="plan-mix-recommended">
                <span class="plan-mix-section-label">Recommended</span>
                <div class="plan-mix-value-line">
                    <strong>@recommendedRecoveryCount</strong>
                    <span>Recovery / Rest days</span>
                </div>
                <em>@CarbCycleLabel("recovery")</em>
            </div>
            <div class="plan-mix-planned">
                <span class="plan-mix-section-label">Planned</span>
                <div class="plan-mix-value-line">
                    <strong data-count-value>@recoveryCount</strong>
                    <span>Recovery / Rest</span>
                </div>
            </div>
        </div>

        <div class="plan-mix-item plan-mix-unplanned" data-count-category="unplanned">
            <div class="plan-mix-recommended">
                <span class="plan-mix-section-label">Recommended</span>
                <div class="plan-mix-value-line">
                    <strong>0</strong>
                    <span>Unplanned days</span>
                </div>
                <em>@CarbCycleLabel("unplanned")</em>
            </div>
            <div class="plan-mix-planned">
                <span class="plan-mix-section-label">Planned</span>
                <div class="plan-mix-value-line">
                    <strong data-count-value>@unplannedCount</strong>
                    <span>Unplanned</span>
                </div>
            </div>
        </div>
    </section>

    <form asp-action="Save" method="post" id="weekly-autosave-form">
        <input type="hidden" name="WeekStart" value="@Model.WeekStart.ToString("yyyy-MM-dd")" />

        <div class="plan-week-list">
            @for (var i = 0; i < Model.Days.Count; i++)
            {
                var day = Model.Days[i];
                var category = CategoryFromDay(day.ActualWorkoutTypeCode ?? day.WorkoutTypeCode, day.HasActualWorkout ? null : day.WeeklyRole);
                var selectedTemplate =
                    day.WorkoutTemplateId.HasValue
                        ? Model.MyWorkouts.SingleOrDefault(
                            x =>
                                x.WorkoutTemplateId
                                    == day.WorkoutTemplateId.Value)
                        : null;
                var selectedSystemWorkout =
                    selectedTemplate is null
                    && !string.IsNullOrWhiteSpace(
                        day.SystemWorkoutCode)
                        ? Model.SystemWorkouts
                            .SingleOrDefault(
                                x => x.SystemCode.Equals(
                                    day.SystemWorkoutCode,
                                    StringComparison.OrdinalIgnoreCase))
                        : null;

                var pickerValue =
                    selectedTemplate is not null
                        ? $"TEMPLATE:{selectedTemplate.WorkoutTemplateId}"
                        : selectedSystemWorkout is not null
                            ? $"SYSTEM:{selectedSystemWorkout.SystemCode}"
                            : day.WorkoutTypeCode ?? "";
                var createCustomUrl =
                    Url.Action(
                        "Index",
                        "DetailedWorkout",
                        new
                        {
                            mode = "new",
                            date = day.Date.ToString("yyyy-MM-dd"),
                            returnContext = "schedule",
                            weekStart = Model.WeekStart.ToString("yyyy-MM-dd")
                        });

                <section class="card plan-day-row plan-cat-@category"
                         data-plan-day
                         data-category="@category"
                         data-create-custom-url="@createCustomUrl">
                    <input type="hidden" name="Days[@i].Date" value="@day.Date.ToString("yyyy-MM-dd")" />

                    <div class="plan-day-heading">
                        <div class="plan-day-date">
                            <strong>@day.DayName</strong>
                            <span>@day.Date.ToString("MMM d")</span>
                            @if(day.CoachAdjusted){<strong>Adjusted by your trainer</strong>}
                        </div>
                        <span class="plan-category-badge" data-category-label>@CategoryLabel(category)</span>
                    </div>

                    @if (day.HasActualWorkout)
                    {
                        <div class="plan-actual-summary"><strong>✓ Completed: @day.ActualWorkoutSummary</strong><p>@day.ActualDurationMin.ToString("0.#") minutes total · Actual workouts drive nutrition.</p>
                        @foreach (var id in day.ActualWorkoutIds) { <a asp-controller="Workouts" asp-action="New" asp-route-editId="@id">Correct workout</a> }
                        </div>
                    }
                    else if (!day.CanEditPlan)
                    {
                        <p>Past day · No completed workout recorded. <a asp-controller="Workouts" asp-action="New" asp-route-date="@day.Date.ToString("yyyy-MM-dd")">Record or correct in Workouts</a></p>
                    }
                    <div class="plan-day-workout">
                        <label for="workout-@i">
                            Originally planned workout
                            <button type="button"
                                    class="help-tip small-tip"
                                    aria-label="Planned workout help"
                                    data-tooltip="Choose a system workout, open My Workouts, or create a reusable custom workout for this day.">
                                ?
                            </button>
                        </label>

                        <select id="workout-@i"
                                disabled="@(!day.CanEditPlan ? "disabled" : null)"
                                class="plan-workout-select"
                                data-collapsible-workout-picker
                                data-no-autosave
                                data-original-value="@pickerValue">
                            <option value=""
                                    data-category="unplanned"
                                    selected="@(string.IsNullOrWhiteSpace(pickerValue) ? "selected" : null)">
                                Not planned
                            </option>

                            @if (selectedTemplate is not null)
                            {
                                <option value="@pickerValue"
                                        data-category="@category"
                                        data-template-option
                                        data-template-id="@selectedTemplate.WorkoutTemplateId"
                                        data-workout-type-code="@selectedTemplate.WorkoutTypeCode"
                                        selected="selected">
                                    My Workout: @selectedTemplate.TemplateName
                                </option>
                            }

                            @foreach (var categoryName in systemCategoryOrder)
                            {
                                var groupedWorkouts =
                                    Model.SystemWorkouts
                                        .Where(
                                            x => SystemWorkoutCategory(
                                                x.EngineWorkoutTypeCode).Equals(
                                                categoryName,
                                                StringComparison.OrdinalIgnoreCase))
                                        .OrderBy(
                                            x => x.DisplayName,
                                            StringComparer.OrdinalIgnoreCase)
                                        .ToList();

                                if (groupedWorkouts.Count == 0)
                                {
                                    continue;
                                }

                                <optgroup label="@categoryName">
                                    @foreach (var option in groupedWorkouts)
                                    {
                                        var optionCategory =
                                            CategoryFromCode(
                                                option.EngineWorkoutTypeCode);

                                        <option value="@($"SYSTEM:{option.SystemCode}")"
                                                data-system-code="@option.SystemCode"
                                                data-workout-type-code="@option.EngineWorkoutTypeCode"
                                                data-category="@optionCategory"
                                                data-default-minutes="@option.DefaultMinutes"
                                                data-default-rpe="@option.DefaultRpe"
                                                selected="@(selectedTemplate is null && selectedSystemWorkout?.SystemCode == option.SystemCode ? "selected" : null)">
                                            @option.DisplayName
                                        </option>
                                    }
                                </optgroup>
                            }

                            <option value="__MY_WORKOUTS__"
                                    data-special="my-workouts">
                                ▶ My Workouts
                            </option>
                            <option value="__CREATE_CUSTOM__"
                                    data-special="create-custom">
                                + Create Custom Workout
                            </option>
                        </select>

                        <input type="hidden"
                               name="Days[@i].WorkoutTypeCode"
                               value="@(day.WorkoutTypeCode ?? "")"
                               data-plan-workout-type />

                        <input type="hidden"
                               name="Days[@i].WorkoutTemplateId"
                               value="@(day.WorkoutTemplateId?.ToString() ?? "")"
                               data-plan-template-id />

                        <input type="hidden"
                               name="Days[@i].SystemWorkoutCode"
                               value="@(day.SystemWorkoutCode ?? "")"
                               data-plan-system-code />
                    </div>

                    <div class="plan-day-details" data-plan-details>
                        @if (day.Calories.HasValue)
                        {
                            <div class="plan-targets">
                                <span class="plan-target-cal"><strong>@day.Calories.Value.ToString("0")</strong> kcal</span>
                                <span><strong>P</strong> @day.ProteinG?.ToString("0")</span>
                                <span><strong>C</strong> @day.BaseCarbsG?.ToString("0")</span>
                                <span><strong>F</strong> @day.FatG?.ToString("0")</span>
                            </div>

                            <div class="plan-day-context">
                                <span>@day.WeeklyRole</span>
                                @if (!string.IsNullOrWhiteSpace(day.Region))
                                {
                                    <span> • @day.Region</span>
                                }
                                <span class="plan-fuel-demand" title="Estimated workout glycogen demand used to help set carbohydrate and recovery targets."> • Fuel demand @day.ScaledGlycogenBurnG?.ToString("0") g</span>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(day.TimingNote))
                            {
                                <p class="plan-timing-note">@day.TimingNote</p>
                            }
                        }
                        else if (!string.IsNullOrWhiteSpace(day.WorkoutTypeCode))
                        {
                            <p class="plan-timing-note">Targets will appear when a usable body weight is available.</p>
                        }
                        else
                        {
                            <p class="plan-timing-note">No workout planned.</p>
                        }

                        <p class="plan-recalc-note" data-recalc-note hidden>Saving this change and recalculating targets…</p>
                    </div>
                </section>
            }
        </div>

        <div class="weekly-save-row" aria-live="polite">
            <span id="weekly-autosave-status" class="autosave-status" hidden></span>
            <noscript>
                <button class="primary" type="submit">Save weekly plan and recalculate</button>
            </noscript>
        </div>
    </form>

    <dialog id="plan-my-workouts-dialog"
            class="workout-template-dialog">
        <div class="workout-template-dialog-head">
            <div>
                <div class="app-kicker">MY WORKOUTS</div>
                <h2>Choose a custom workout</h2>
            </div>
            <button type="button"
                    class="workout-template-dialog-close"
                    data-template-dialog-close
                    aria-label="Close">
                ×
            </button>
        </div>

        @if (Model.MyWorkouts.Count == 0)
        {
            <p class="workout-template-empty">
                No custom workouts saved yet.
            </p>
        }
        else
        {
            <div class="workout-template-choice-list">
                @foreach (var template in Model.MyWorkouts)
                {
                    <button type="button"
                            class="workout-template-choice"
                            data-plan-template-choice
                            data-template-id="@template.WorkoutTemplateId"
                            data-template-name="@template.TemplateName"
                            data-workout-type-code="@template.WorkoutTypeCode">
                        <strong>@template.TemplateName</strong>
                        <span>
                            @template.ExerciseCount exercises
                            • @template.DefaultDurationMin.ToString("0") min
                        </span>
                    </button>
                }
            </div>
        }

        <button type="button"
                class="primary workout-template-create"
                data-plan-create-custom>
            + Create Custom Workout
        </button>
    </dialog>
</div>

<script src="~/js/system-workout-picker.js"
        asp-append-version="true"></script>

<script>
(() => {
    const labels = {
        major: "Major / hard strength",
        accessory: "Accessory strength",
        cardio: "Conditioning / cardio",
        recovery: "Recovery / rest",
        unplanned: "Unplanned"
    };

    const categories = Object.keys(labels);
    const selects = Array.from(
        document.querySelectorAll(".plan-workout-select"));

    const dialog =
        document.getElementById(
            "plan-my-workouts-dialog");

    let activeSelect = null;

    function selectedCategory(select) {
        const option =
            select.options[select.selectedIndex];

        return option?.dataset.category
            || "unplanned";
    }

    function updateRow(select) {
        const row =
            select.closest("[data-plan-day]");

        if (!row) return;

        const category = select.disabled && row.dataset.category
            ? row.dataset.category : selectedCategory(select);

        categories.forEach(
            value =>
                row.classList.remove(
                    `plan-cat-${value}`));

        row.classList.add(
            `plan-cat-${category}`);

        row.dataset.category =
            category;

        const badge =
            row.querySelector(
                "[data-category-label]");

        if (badge) {
            badge.textContent =
                labels[category]
                || labels.unplanned;
        }

        const isChanged =
            select.value
                !== select.dataset.originalValue;

        row.classList.toggle(
            "plan-pending-change",
            isChanged);

        const recalc =
            row.querySelector(
                "[data-recalc-note]");

        if (recalc) {
            recalc.hidden = !isChanged;
        }
    }

    function syncHiddenSelection(select) {
        const row =
            select.closest("[data-plan-day]");

        if (!row) return;

        const option =
            select.options[select.selectedIndex];

        const typeInput =
            row.querySelector(
                "[data-plan-workout-type]");

        const templateInput =
            row.querySelector(
                "[data-plan-template-id]");

        const systemInput =
            row.querySelector(
                "[data-plan-system-code]");

        if (!typeInput
            || !templateInput
            || !systemInput) {
            return;
        }

        if (option?.dataset.templateId) {
            typeInput.value =
                option.dataset.workoutTypeCode
                || "";

            templateInput.value =
                option.dataset.templateId;

            systemInput.value = "";
        }
        else if (option?.dataset.systemCode) {
            typeInput.value =
                option.dataset.workoutTypeCode
                || "";

            templateInput.value = "";
            systemInput.value =
                option.dataset.systemCode;
        }
        else {
            typeInput.value =
                select.value || "";

            templateInput.value = "";
            systemInput.value = "";
        }
    }

    function refreshCounts() {
        const counts =
            Object.fromEntries(
                categories.map(
                    value => [value, 0]));

        selects.forEach(select => {
            const category = select.disabled
                ? select.closest("[data-plan-day]")?.dataset.category || selectedCategory(select)
                : selectedCategory(select);

            counts[category] =
                (counts[category] || 0) + 1;
        });

        document.querySelectorAll(
            "[data-count-category]"
        ).forEach(item => {
            const category =
                item.dataset.countCategory;

            const target =
                item.querySelector(
                    "[data-count-value]");

            if (target) {
                target.textContent =
                    counts[category] || 0;
            }
        });
    }

    function restoreSelection(select) {
        const previous =
            select.dataset.previousValue
            || select.dataset.originalValue
            || "";

        select.value = previous;

        if (select.value !== previous) {
            select.value = "";
        }
    }

    function openMyWorkouts(select) {
        activeSelect = select;

        if (dialog?.showModal) {
            dialog.showModal();
        }
        else if (dialog) {
            dialog.setAttribute(
                "open",
                "open");
        }
    }

    function closeMyWorkouts() {
        if (dialog?.close) {
            dialog.close();
        }
        else {
            dialog?.removeAttribute(
                "open");
        }
    }

    selects.forEach(select => {
        select.dataset.previousValue =
            select.value;

        select.addEventListener(
            "change",
            event => {
                const selected =
                    select.value;

                if (selected === "__MY_WORKOUTS__") {
                    event.stopImmediatePropagation();
                    restoreSelection(select);
                    openMyWorkouts(select);
                    return;
                }

                if (selected === "__CREATE_CUSTOM__") {
                    event.stopImmediatePropagation();

                    const row =
                        select.closest(
                            "[data-plan-day]");

                    const url =
                        row?.dataset
                            .createCustomUrl;

                    restoreSelection(select);

                    if (url) {
                        window.location.href = url;
                    }

                    return;
                }

                syncHiddenSelection(select);
                updateRow(select);
                refreshCounts();

                select.dataset.previousValue =
                    select.value;

                // The visible picker is data-no-autosave so special
                // My Workouts choices can open without a pending page reload.
                // Real plan changes submit only after hidden Engine/template
                // fields have been synchronized above.
                form?.requestSubmit();
            });
    });

    dialog?.querySelectorAll(
        "[data-template-dialog-close]"
    ).forEach(button => {
        button.addEventListener(
            "click",
            closeMyWorkouts);
    });

    dialog?.addEventListener(
        "click",
        event => {
            if (event.target === dialog) {
                closeMyWorkouts();
            }
        });

    dialog?.querySelectorAll(
        "[data-plan-template-choice]"
    ).forEach(button => {
        button.addEventListener(
            "click",
            () => {
                if (!activeSelect) {
                    return;
                }

                const templateId =
                    button.dataset.templateId;

                const templateName =
                    button.dataset.templateName;

                const workoutTypeCode =
                    button.dataset.workoutTypeCode;

                if (!templateId
                    || !templateName
                    || !workoutTypeCode) {
                    return;
                }

                const systemOption =
                    Array.from(
                        activeSelect.options)
                        .find(
                            option =>
                                option.dataset
                                    .workoutTypeCode
                                    === workoutTypeCode
                                && !option.dataset
                                    .templateId);

                const category =
                    systemOption?.dataset.category
                    || "unplanned";

                activeSelect
                    .querySelectorAll(
                        "[data-template-option]")
                    .forEach(option =>
                        option.remove());

                const option =
                    document.createElement(
                        "option");

                option.value =
                    `TEMPLATE:${templateId}`;

                option.textContent =
                    `My Workout: ${templateName}`;

                option.dataset.templateOption =
                    "";

                option.dataset.templateId =
                    templateId;

                option.dataset.workoutTypeCode =
                    workoutTypeCode;

                option.dataset.category =
                    category;

                activeSelect.insertBefore(
                    option,
                    activeSelect.firstChild);

                activeSelect.value =
                    option.value;

                closeMyWorkouts();

                activeSelect.dispatchEvent(
                    new Event(
                        "change",
                        {
                            bubbles: true
                        }));
            });
    });

    dialog?.querySelector(
        "[data-plan-create-custom]"
    )?.addEventListener(
        "click",
        () => {
            const row =
                activeSelect?.closest(
                    "[data-plan-day]");

            const url =
                row?.dataset
                    .createCustomUrl;

            if (url) {
                window.location.href = url;
            }
        });

    const form =
        document.getElementById(
            "weekly-autosave-form");

    window.RecompAutosave?.bind(
        form,
        {
            statusSelector:
                "#weekly-autosave-status",
            delay: 800,
            reloadAfterSaveMs: 1200,
            afterSave: () => {
                selects.forEach(select => {
                    select.dataset.originalValue =
                        select.value;

                    select.dataset.previousValue =
                        select.value;

                    const row =
                        select.closest(
                            "[data-plan-day]");

                    row?.classList.remove(
                        "plan-pending-change");

                    const recalc =
                        row?.querySelector(
                            "[data-recalc-note]");

                    if (recalc
                        && !recalc.hidden) {
                        recalc.textContent =
                            "Saved. Recalculating targets…";
                    }
                });
            }
        });

    refreshCounts();
})();
</script>




