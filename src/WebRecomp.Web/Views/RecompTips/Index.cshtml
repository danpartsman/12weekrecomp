@model RecompTipsIndexViewModel
@{
    ViewData["Title"] = "Recomp Tips";
}

<link rel="stylesheet" href="~/css/recomp-tips.css" asp-append-version="true" />

<!-- 12WR-RECOMP-TIPS-PUBLIC -->
<section class="tips-page">
    <header class="tips-hero">
        <div>
            <span class="tips-eyebrow">12 WEEK RECOMP</span>
            <h1>Recomp Tips &amp; Practical Guides</h1>
            <p>
                Short, useful ideas on training, nutrition, recovery, and the
                small decisions that make body recomposition easier to sustain.
            </p>
            @if (User.IsInRole("Administrator"))
            {
                <p><a class="tips-read-more" href="/admin/tips">Manage Recomp Tips →</a></p>
            }
        </div>

        <form class="tips-search" method="get" asp-action="Index" role="search">
            <label for="tips-search-input">Search tips</label>
            <div class="tips-search-row">
                <input id="tips-search-input"
                       type="search"
                       name="q"
                       value="@Model.Search"
                       placeholder="Protein, carbs, recovery, workouts..." />
                <button class="primary" type="submit">Search</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a class="tips-clear-search" asp-action="Index">Clear search</a>
            }
        </form>
    </header>

    @if (Model.Posts.Count == 0)
    {
        <div class="card tips-empty">
            @if (string.IsNullOrWhiteSpace(Model.Search))
            {
                <h2>New tips are coming.</h2>
                <p>This page is ready for the first 12 Week Recomp post.</p>
            }
            else
            {
                <h2>No posts matched “@Model.Search”.</h2>
                <p>Try a broader search or browse all recomp tips.</p>
                <a class="button" asp-action="Index">Show all tips</a>
            }
        </div>
    }
    else
    {
        <div class="tips-feed">
            @foreach (var post in Model.Posts)
            {
                var published = post.PublishedAtUtc ?? post.CreatedAtUtc;
                var tags = (post.Tags ?? string.Empty)
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                <article class="tips-card">
                    <div class="tips-card-copy">
                        <div class="tips-meta">
                            <time>@published.ToLocalTime().ToString("MMM d, yyyy")</time>
                            @if (!string.IsNullOrWhiteSpace(post.SourceUrl))
                            {
                                <span>Source included</span>
                            }
                        </div>

                        <h2>
                            <a asp-action="Details" asp-route-id="@post.Id">
                                @post.Title
                            </a>
                        </h2>

                        <p class="tips-summary">@post.Summary</p>

                        @if (tags.Length > 0)
                        {
                            <div class="tips-tags" aria-label="Topics">
                                @foreach (var tag in tags)
                                {
                                    <span>@tag</span>
                                }
                            </div>
                        }

                        <a class="tips-read-more"
                           asp-action="Details"
                           asp-route-id="@post.Id">
                            Read tip <span aria-hidden="true">→</span>
                        </a>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(post.ImageUrl))
                    {
                        <a class="tips-card-image"
                           asp-action="Details"
                           asp-route-id="@post.Id"
                           aria-label="Read @post.Title">
                            <img src="@post.ImageUrl"
                                 alt=""
                                 loading="lazy"
                                 referrerpolicy="no-referrer" />
                        </a>
                    }
                </article>
            }
        </div>
    }
</section>
