@using System.Globalization
@model DailyViewModel
<!-- V1006_GUIDED_WEIGHIN_CLEAN -->
@await Html.PartialAsync(
    "_GuidedDemoCalloutSections",
    new[]
    {
        "Body composition tells a better story",
        "A biometric or body-composition scale is helpful because it can show whether weight change is coming from fat or lean mass. A regular scale still works - consistent body weight alone is enough to use the program.",

        "Recomp looks beyond the scale",
        "Sleep, resting heart rate, energy, soreness, and other daily check-in signals give the analytical engine context. Those inputs help the system decide whether to keep, adjust, or recover from the planned workout."
    })
@{
    ViewData["Title"] = "Daily Weigh-In";
    string N(decimal? value) => value?.ToString("0.##", CultureInfo.InvariantCulture) ?? "";
}
<div class="app-page app-page-recovery">
    <header class="app-page-head">
        <div>
            <div class="app-kicker">DAILY • WEIGH-IN & RECOVERY</div>
            <h1>Daily Weigh-In</h1>
            <p class="lede app-date-heading">@Model.Date.ToString("dddd, MMMM d")</p>
        </div>

        <form asp-action="Index" method="get" class="app-date-picker">
            <label>Date
                <input name="date" value="@Model.Date.ToString("yyyy-MM-dd")" type="date" onchange="this.form.submit()" />
            </label>
                <div class="app-adjacent-days"><a asp-action="Index" asp-route-date="@(Model.Date.AddDays(-1).ToString("yyyy-MM-dd"))" aria-label="Previous day" class="button app-day-nav-button">← Previous day</a><a asp-action="Index" asp-route-date="@(Model.Date.AddDays(1).ToString("yyyy-MM-dd"))" aria-label="Next day" class="button app-day-nav-button">Next day →</a></div>
        </form>
    </header>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="app-message success">@statusMessage</div>
    }

    <form asp-action="Index" method="post" class="stack" id="daily-autosave-form">
        <input asp-for="Date" type="hidden" />
        <div asp-validation-summary="All" class="validation"></div>

        <section class="card app-section app-section-blue">
            <div class="app-section-label"><span class="app-number">1</span><span>BODY</span></div>
            <h2>Morning measurements</h2>
            <p class="required-note"><span class="required-mark">*</span> Required for today’s Dashboard</p>
            <p class="small">Enter what your scale or tape measure reports. Blank fields stay unknown rather than becoming zero.</p>
            <div class="grid-3">
                <label><span class="field-label-line">Weight (lb) <span class="required-mark">*</span></span><input id="WeightLb" name="WeightLb" value="@N(Model.WeightLb)" type="number" step="0.1" /></label>
                <label>Body fat (%)<input id="BodyFatPercent" name="BodyFatPercent" value="@N(Model.BodyFatPercent)" type="number" step="0.1" /></label>
                <label>Muscle mass (lb)<input id="MuscleMassLb" name="MuscleMassLb" value="@N(Model.MuscleMassLb)" type="number" step="0.1" /></label>
                <label>Body water (lb)<input id="BodyWaterLb" name="BodyWaterLb" value="@N(Model.BodyWaterLb)" type="number" step="0.1" /></label>
                <label>Visceral fat<input id="VisceralFatRating" name="VisceralFatRating" value="@N(Model.VisceralFatRating)" type="number" step="0.1" /></label>
                <label>Waist (in)<input id="WaistIn" name="WaistIn" value="@N(Model.WaistIn)" type="number" step="0.1" /></label>
                <label>Hips (in)<input id="HipsIn" name="HipsIn" value="@N(Model.HipsIn)" type="number" step="0.1" /></label>
            </div>
        </section>

        <section class="card app-section app-section-purple">
            <div class="app-section-label"><span class="app-number">2</span><span>RECOVERY</span></div>
            <h2>How you feel today</h2>
            <div class="grid-3">
                <label>Sleep hours<input asp-for="SleepHours" type="number" step="0.1" /></label>
                <label>Resting HR<input asp-for="RestingHr" type="number" /></label>
                <label>Steps<input asp-for="Steps" type="number" /></label>
                <label>Energy 1–10<input asp-for="EnergyScore" type="number" min="1" max="10" /></label>
                <label>Soreness 1–10<input asp-for="SorenessScore" type="number" min="1" max="10" /></label>
            </div>
            <div class="checks option4-checks">
                <label><input asp-for="PainFlag" /> Pain/injury issue today</label>
                <label><input asp-for="IllnessFlag" /> Illness/systemic fatigue today</label>
            </div>
        </section>

        <section class="card app-section app-section-amber">
            <div class="app-section-label"><span class="app-number">3</span><span>CONTEXT</span></div>
            <h2>Daily notes</h2>
            <p class="small">Workout intention comes from Weekly Plan. Add anything about recovery, pain, energy, or context Recomp should consider.</p>
            <label>Notes<textarea asp-for="Notes" rows="3"></textarea></label>
        </section>

        <div class="autosave-row" aria-live="polite">
            <span id="daily-autosave-status" class="autosave-status" hidden></span>
        </div>
        <noscript>
            <div class="app-action-row">
                <button class="primary" type="submit">Save Daily Weigh-In</button>
            </div>
        </noscript>
    </form>
</div>

<script>
(() => {
    const form = document.getElementById("daily-autosave-form");
    window.RecompAutosave?.bind(form, {
        statusSelector: "#daily-autosave-status",
        delay: 650
    });
})();
</script>





