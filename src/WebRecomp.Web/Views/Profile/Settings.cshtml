@model SettingsViewModel
@{
    ViewData["Title"] = "Settings";
}

<div class="page-head">
    <div>
        <div class="eyebrow">ACCOUNT</div>
        <h1>Settings</h1>
        <p class="lede">Choose how Recomp looks and where account communications should go.</p>
    </div>
    <a class="button" asp-action="Index">Back to profile</a>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="status-card good">@statusMessage</div>
}

<form asp-action="Settings" method="post" class="stack narrow" id="settings-form">
    <div asp-validation-summary="All" class="validation"></div>
    <p class="required-note"><span class="required-mark">*</span> Required</p>

    <section class="card stack">
        <div>
            <div class="profile-panel-label">RECOMP PROFILE</div>
            <h2>Display & contact</h2>
        </div>
        <label>Preferred display name<input asp-for="PreferredDisplayName" /></label>
        <label>Contact email<input asp-for="ContactEmail" type="email" /></label>
        <p class="small">The contact email is for Recomp communication and can differ from the account used to sign in.</p>
    </section>

    <section class="card stack">
        <div>
            <div class="profile-panel-label">APPEARANCE</div>
            <h2>Theme</h2>
        </div>
        <label><span class="field-label-line">Color theme <span class="required-mark">*</span></span>
            <select asp-for="ThemeCode" id="theme-select">
                <option value="SYSTEM">System</option>
                <option value="LIGHT">Light</option>
                <option value="DARK">Dark</option>
            </select>
        </label>
        <p class="small">System follows the light/dark preference of the device. This preference is saved to your Recomp account and to this browser.</p>
    </section>

    <section class="card stack">
        <div>
            <div class="profile-panel-label">YOUR COACH</div>
            <h2>Choose who teaches you</h2>
            <p class="small">Your selected coach appears throughout Dashboard learning, nutrition topics, workout topics and “The Why” series.</p>
        </div>
        <div class="coach-choice-grid">
            <label class="coach-choice">
                <input asp-for="PreferredCoachCode" type="radio" value="MARISOL" />
                <img src="/images/coach/marisol-coach-avatar.webp" alt="Marisol" />
                <span class="coach-choice-copy"><strong>Marisol</strong><em>Strong + supportive</em><small>Warm, encouraging, consistency-focused.</small></span>
            </label>
            <label class="coach-choice">
                <input asp-for="PreferredCoachCode" type="radio" value="CASSIE" />
                <img src="/images/coach/cassie-coach-avatar.webp" alt="Cassie" />
                <span class="coach-choice-copy"><strong>Cassie</strong><em>Energetic + athletic</em><small>Upbeat, performance-minded coaching.</small></span>
            </label>
            <label class="coach-choice">
                <input asp-for="PreferredCoachCode" type="radio" value="MARCUS" />
                <span class="coach-choice-avatar" aria-hidden="true">M</span>
                <span class="coach-choice-copy"><strong>Marcus</strong><em>Calm + technical</em><small>Methodical, technique-and-progression focused.</small></span>
            </label>
            <label class="coach-choice">
                <input asp-for="PreferredCoachCode" type="radio" value="NINA" />
                <span class="coach-choice-avatar" aria-hidden="true">N</span>
                <span class="coach-choice-copy"><strong>Nina</strong><em>Direct + focused</em><small>Clear, disciplined, habit-centered coaching.</small></span>
            </label>
        </div>
    </section>

    <section class="card stack">
        <div>
            <div class="profile-panel-label">TRACKING DETAIL</div>
            <h2>Optional detailed entry</h2>
        </div>

        @if (Model.HasActiveProgram)
        {
            <label class="check">
                <input asp-for="DetailedWorkoutEntryEnabled" type="checkbox" />
                <span>
                    <strong>Detailed workout entry</strong><br />
                    <small>
                        When enabled, 12 Week Recomp can collect exercise/set-level workout detail.
                        Manual workout entry remains available and is never added to detailed values.
                    </small>
                </span>
            </label>

            <label class="check">
                <input asp-for="NutritionFoodLogEnabled" type="checkbox" />
                <span>
                    <strong>12WR food log</strong><br />
                    <small>
                        When enabled, foods and servings can build the day's nutrition totals.
                        Manual calorie and macro entry remains available as a supported path.
                    </small>
                </span>
            </label>

            <p class="small">
                These options are independent. Turning one off does not delete previously
                entered detailed data. OFF/OFF preserves the original manual-entry workflow.
            </p>
        }
        else
        {
            <p class="small">
                Tracking-detail options become available after an active 12-week program is created.
            </p>
        }
    </section>

    <section class="card stack">
        <div>
            <div class="profile-panel-label">SIGN-IN & SECURITY</div>
            <h2>Sign-in account</h2>
        </div>
        <label>Signed in as<input value="@(Model.SignInEmail ?? "Signed-in account")" readonly /></label>
        <p class="small">
            Recomp does not store your password. Your password, security methods, and other sign-in settings are managed by the account provider you used to sign in.
        </p>
        <a class="button" href="https://myaccount.microsoft.com/" target="_blank" rel="noopener">Manage sign-in account</a>
    </section>

    <button class="primary" type="submit">Save settings</button>
</form>

<script>
    (() => {
        const form = document.getElementById('settings-form');
        const select = document.getElementById('theme-select');
        if (!form || !select) return;

        const serverPreference = '@Model.ThemeCode.ToLowerInvariant()';
        localStorage.setItem('recomp-theme', serverPreference || 'system');

        form.addEventListener('submit', () => {
            localStorage.setItem('recomp-theme', (select.value || 'SYSTEM').toLowerCase());
        });
    })();
</script>
