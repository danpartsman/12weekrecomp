            </a>

            <a asp-controller="RecompTips"
               asp-action="Index">
                Recomp Tips &amp; Guides
            </a>

            @if (isGuidedDemo)
            {
                <a class="guided-demo-nav-link is-active"
                   asp-controller="GuidedDemo"
                   asp-action="Index">
                    Guided Demo Home
                </a>

                <a asp-controller="Profile"
                   asp-action="Index">
                    Profile / Strategy
                </a>

                <form class="guided-demo-menu-exit"
                      asp-controller="Demo"
                      asp-action="Exit"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit">
                        End Guided Demo
                    </button>
                </form>
            }
            else
            {
                <a href="/recomp/how-it-works">
                    How It Works
                </a>

                <a asp-controller="Home"
                   asp-action="Evidence">
                    Evidence
                </a>

                <a asp-controller="Profile"
                   asp-action="Index">
                    Profile
                </a>

                <a asp-controller="Profile"
                   asp-action="Settings">
                    Settings
                </a>

                <a asp-controller="MyCoach" asp-action="Index">My Trainer</a>
                @if (User.IsInRole("Coach") || User.IsInRole("Administrator"))
                {
                    <a asp-controller="Coach"
                       asp-action="Index">
                        Coach Center
                    </a>
                }

                @if (User.IsInRole("Administrator"))
                {
                    <a asp-controller="Admin"
                       asp-action="Index">
                        Administration
                    </a>
                }

                <a class="nav-signout"
                   asp-controller="Account"
                   asp-action="Logout">
                    Sign Out
                </a>
            }

        </nav>
    }

</header>

@if (isGuidedDemo)
{
    <section class="guided-demo-modebar"
             aria-label="Guided Demo mode">

        <div class="guided-demo-modebar-main">
            <div class="guided-demo-modebar-copy">
                <strong>GUIDED DEMO</strong>
                <span>
                    Explore the full program in this temporary demo workspace.
                </span>
            </div>

            <div class="guided-demo-daily-guide"
                 aria-label="Daily Entries">
                <span class="guided-demo-daily-badge">DAILY INPUT</span>
                <span class="guided-demo-daily-arrow">&rarr;</span>

                <a asp-controller="DailyEntry"
                   asp-action="Index">
                    Daily Entries
                </a>

                <span class="guided-demo-daily-result">
                    Body, recovery, training, and nutrition are entered in one
                    place. Recomp's analytical engine turns those inputs into
                    the program details on your Dashboard.
                </span>
            </div>
        </div>

        <form class="guided-demo-modebar-exit"
              asp-controller="Demo"
              asp-action="Exit"
              method="post">
            @Html.AntiForgeryToken()
            <button type="submit">
                End Demo
            </button>
        </form>
    </section>
}


<main class="container">
    @RenderBody()
</main>


<footer class="footer recomp-footer">

    <div>
        <strong>Built on evidence. Simple enough for real life.</strong>
        <span>
            Web Recomp @appVersion &bull; Engine @engineVersion &bull; Plan &bull; Train &bull; Recover &bull; Adapt
            &bull;
            <a asp-controller="Contact"
               asp-action="Index">
                Contact Us
            </a>
        </span>
    </div>

    @if (isPublicPage)
    {
        <div style="margin-top:.75rem;">
            <a href="https://platform.fatsecret.com"
               target="_blank"
               rel="noopener noreferrer">
                <img alt="Nutrition information provided by fatsecret Platform API"
                     src="https://platform.fatsecret.com/api/static/images/powered_by_fatsecret_horizontal_brand.png"
                     srcset="https://platform.fatsecret.com/api/static/images/powered_by_fatsecret_horizontal_brand@2x.png 2x, https://platform.fatsecret.com/api/static/images/powered_by_fatsecret_horizontal_brand@3x.png 3x"
                     style="max-width:190px;height:auto;"
                     border="0" />
            </a>
        </div>
    }

</footer>


@if ((!isPublicPage && !isOnboardingPage) || isGuidedDemo)
{
    <script>
        (() => {
            const toggle = document.querySelector('.nav-toggle');
            const nav = document.getElementById('app-nav');

            if (!toggle || !nav) {
                return;
            }

            const closeMenu = () => {
                toggle.setAttribute('aria-expanded', 'false');
                toggle.setAttribute('aria-label', 'Open navigation menu');
                nav.classList.remove('is-open');
            };

            toggle.addEventListener('click', () => {
                const opening =
                    toggle.getAttribute('aria-expanded') !== 'true';

                toggle.setAttribute(
                    'aria-expanded',
                    opening ? 'true' : 'false'
                );

                toggle.setAttribute(
                    'aria-label',
                    opening
                        ? 'Close navigation menu'
                        : 'Open navigation menu'
                );

                nav.classList.toggle('is-open', opening);
            });

            nav.addEventListener('click', event => {
                if (event.target.closest('a')) {
                    closeMenu();
                }
            });

            document.addEventListener('keydown', event => {
                if (event.key === 'Escape') {
                    closeMenu();
                }
            });

            window.addEventListener('resize', () => {
                if (window.innerWidth > 820) {
                    closeMenu();
                }
            });
        })();
    </script>
}

    <script src="~/js/learning-v1015c.js" asp-append-version="true"></script>
    <script src="~/js/recent-workout-picker.js" asp-append-version="true"></script>
    <script src="~/js/live-workout-notes.js" asp-append-version="true"></script>
@if (User.Identity?.IsAuthenticated == true && WebRecomp.Web.Services.ExternalConnections.ExternalConnectionFeatures.IsEnabled && !isPublicPage && !isOnboardingPage && string.Equals(Context.Request.RouteValues["controller"]?.ToString(), "DailyEntry", StringComparison.OrdinalIgnoreCase) && (string.Equals(Context.Request.RouteValues["action"]?.ToString(), "CheckIn", StringComparison.OrdinalIgnoreCase) || string.Equals(Context.Request.RouteValues["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase)))
{
    var deviceToken = DeviceAntiforgery.GetAndStoreTokens(Context);
    <div id="device-sync-on-open" hidden data-url="@Url.Action("SyncOnOpen", "ExternalConnections")" data-field="@deviceToken.FormFieldName" data-token="@deviceToken.RequestToken"></div>
    <script src="~/js/external-connections.js" asp-append-version="true"></script>
}
</body>
</html>
