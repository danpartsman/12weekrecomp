            </a>

            <a asp-controller="Home"
               asp-action="Evidence">
                Evidence
            </a>

            <a class="nav-signout"
               asp-controller="Account"
               asp-action="Logout">
                Sign Out
            </a>

        </nav>
    }
    else
    {
        <nav class="app-quick-nav"
             aria-label="Quick application navigation">

            <a href="/CommandCenter">Command Center</a>
            <a class="quick-nav-dashboard"
               asp-controller="Dashboard"
               asp-action="Index">
                Dashboard
            </a>

            <a asp-controller="Schedule"
               asp-action="Index">
                Weekly Plan
            </a>

            <a asp-controller="DailyEntry"
               asp-action="Index">
                Daily Entries
            </a>
            <a asp-controller="Nutrition"
               asp-action="Index">
                Nutrition
            </a>
            <a asp-controller="DailyEntry" asp-action="CheckIn">Recomp Tracking</a>

            <a asp-controller="DetailedWorkout"
               asp-action="Index">
                Workouts
            </a>

            <a asp-controller="Progress"
               asp-action="Index">
                Progress
            </a>

            @if (isGuidedDemo)
            {
                <a class="guided-demo-nav-link is-active"
                   asp-controller="GuidedDemo"
                   asp-action="Index">
                    Guided Demo
                </a>
            }

        </nav>


        <button class="nav-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="app-nav"
                aria-label="Open navigation menu"
                title="All pages">

            <span class="nav-toggle-line"></span>
            <span class="nav-toggle-line"></span>
            <span class="nav-toggle-line"></span>

        </button>


        <nav id="app-nav"
             class="app-nav app-menu"
             aria-label="All application pages">

            <a href="/CommandCenter">Command Center</a>
            <a asp-controller="Dashboard"
               asp-action="Index">
                Dashboard
            </a>

            <a asp-controller="Schedule"
               asp-action="Index">
                Weekly Plan
            </a>

            <a asp-controller="TodayWorkout" asp-action="Index">Today’s Workout</a>

            <a asp-controller="DailyEntry"
               asp-action="Index">
                Daily Entries
            </a>
            <a asp-controller="Nutrition"
               asp-action="Index">
                Nutrition
            </a>
            <a asp-controller="DailyEntry" asp-action="CheckIn">Recomp Tracking</a>

            <a asp-controller="DetailedWorkout"
               asp-action="Index">
