@inject WebRecomp.Web.Services.AppUserContextService AppUserContextService
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery DeviceAntiforgery
@using System.Reflection
@{
    var assembly = Assembly.GetExecutingAssembly();

    var appVersion =
        assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()
            ?.InformationalVersion
        ?? "unknown";

    var engineVersion =
        assembly.GetCustomAttributes<AssemblyMetadataAttribute>()
            .FirstOrDefault(x => x.Key == "RecompEngineVersion")
            ?.Value
        ?? "unknown";
}
@{
    var isPublicPage = ViewData["PublicPage"] is bool publicPage && publicPage;
    var isOnboardingPage = ViewData["OnboardingPage"] is bool onboardingPage && onboardingPage;

    var isGuidedDemo =
        User.FindFirst("recomp_demo")?.Value == "true"
        && User.FindFirst("recomp_demo_type")?.Value == "GUIDED";

    var baseShellClass =
        isPublicPage
            ? "public-shell"
            : (isOnboardingPage ? "onboarding-shell" : "app-shell");

    var shellClass =
        isGuidedDemo
            ? $"{baseShellClass} guided-demo-dark-theme"
            : baseShellClass;

    var detailedWorkoutEntryEnabled = false;

    if (!isPublicPage
        && (!isOnboardingPage || isGuidedDemo))
    {
        var navContext =
            await AppUserContextService.GetAsync(
                Context,
                Context.RequestAborted);

        detailedWorkoutEntryEnabled =
            navContext.Program?.DetailedWorkoutEntryEnabled
            ?? false;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 12 Week Recomp</title>

    <script>
        (() => {
            const media = window.matchMedia('(prefers-color-scheme: dark)');

            const applyTheme = () => {
                const preference = localStorage.getItem('recomp-theme') || 'system';
                const effective =
                    preference === 'system'
                        ? (media.matches ? 'dark' : 'light')
                        : preference;

                document.documentElement.dataset.theme = effective;
            };

            applyTheme();

            if (media.addEventListener) {
                media.addEventListener('change', () => {
                    if ((localStorage.getItem('recomp-theme') || 'system') === 'system') {
                        applyTheme();
                    }
                });
            }
        })();
    </script>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/workout-intelligence.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/live-workout-notes.css"
          asp-append-version="true" />

    @if (isGuidedDemo)
    {
        <link rel="stylesheet"
              href="~/css/guided-demo.css"
              asp-append-version="true" />

        <link rel="stylesheet"
              href="~/css/guided-demo-cleanup.css"
              asp-append-version="true" />
    }

    @* TEST-wide production-look staging layer.
       Loaded last so all TEST pages preview the intended LIVE design. *@
    <link rel="stylesheet"
          href="~/css/test-live-preview.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/learning-v1015c.css"
          asp-append-version="true" />

    <script src="~/js/recomp-autosave.js" asp-append-version="true"></script>
    <script src="~/js/test-live-vibrance.js"
            asp-append-version="true"
            defer></script>
<link rel="stylesheet" href="~/css/free-stamps.css" asp-append-version="true" />
</head>

@{
    var appThemeClass =
        baseShellClass == "app-shell"
            ? "test-live-preview"
            : "";
}
<body class="@shellClass @appThemeClass @(ViewData["BodyClass"] as string)">

<header class="topbar">

    <div class="brand brand-logo-wrap">

