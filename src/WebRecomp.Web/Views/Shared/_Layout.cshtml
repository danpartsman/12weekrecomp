                <img class="brand-logo brand-logo-dark"
                     src="~/images/recomp/recomp-logo-dark.png"
                     alt="12 Week Recomp" />

            </a>
        }
        else
        {
            <a asp-controller="Dashboard"
               asp-action="CommandCenter"
               aria-label="12 Week Recomp Command Center">

                <img class="brand-logo brand-logo-light"
                     src="~/images/recomp/recomp-logo-light.png"
                     alt="12 Week Recomp" />

                <img class="brand-logo brand-logo-dark"
                     src="~/images/recomp/recomp-logo-dark.png"
                     alt="12 Week Recomp" />

            </a>
        }

        <a class="free-stamp free-stamp--brand" href="/recomp/why-free" aria-label="Completely free — read why">FREE</a>
    </div>


    @if (isPublicPage)
    {
        <nav class="public-nav"
             aria-label="Public navigation">

            <a asp-controller="Home"
               asp-action="Index">
                Welcome
            </a>

            <a href="/recomp/how-it-works">
                How It Works
            </a>

            <a asp-controller="Home"
               asp-action="Evidence">
                Evidence
            </a>

            <a href="/request-more-information">
                Request More Information
            </a>

            <a asp-controller="GuidedDemo"
               asp-action="Index"
               class="guided-demo-nav-link">
                Guided Demo
            </a>

            <a asp-controller="Access"
               asp-action="Index">
                 Redeem Code
            </a>

            <a asp-controller="Account"
               asp-action="SignIn">
                Sign In
            </a>

            <a class="free-signup-note"
               href="/recomp/why-free">
                <span class="free-stamp free-stamp--small">100% FREE</span>
                <span class="free-signup-note__copy">
                    No credit card. No hidden fees.
                    <small>Why it’s free ↗</small>
                </span>
            </a>

            <a class="public-nav-create"
               asp-controller="Account"
               asp-action="CreateAccount">
                Create Account
            </a>

        </nav>
    }
    else if (isOnboardingPage && !isGuidedDemo)
    {
        <nav class="public-nav onboarding-nav"
             aria-label="Onboarding navigation">

