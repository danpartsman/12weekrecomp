<style>
.free-use-panel {
    position: fixed;
    z-index: 40;
    right: clamp(12px, 2vw, 28px);
    bottom: clamp(12px, 2vw, 28px);
    width: min(340px, calc(100vw - 24px));
    overflow: hidden;
    border: 1px solid rgba(255, 204, 115, .42);
    border-radius: 22px;
    background: linear-gradient(145deg, rgba(120, 38, 16, .72) 0%, rgba(95, 28, 20, .67) 56%, rgba(62, 21, 29, .72) 100%);
    box-shadow: 0 20px 55px rgba(31, 9, 4, .23), 0 3px 14px rgba(31, 9, 4, .16);
    color: #fff8ed;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
}
.free-use-panel::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, #ffdf76, #ff914d, #f04b4b);
}
.free-use-panel__content { padding: 24px 24px 22px; }
.free-use-panel__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 12px;
    color: #ffe8a3;
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .13em;
    text-transform: uppercase;
}
.free-use-panel__eyebrow::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ffad61;
    box-shadow: 0 0 0 4px rgba(255, 173, 97, .2);
}
.free-use-panel h2 {
    margin: 0;
    max-width: 280px;
    color: #fff;
    font-size: clamp(1.45rem, 2.3vw, 1.72rem);
    font-weight: 830;
    letter-spacing: -.035em;
    line-height: 1.14;
}
.free-use-panel h2 span { color: #ffdf76; }
.free-use-panel__intro {
    margin: 11px 0 17px;
    color: #fff0df;
    font-size: .88rem;
    line-height: 1.48;
}
.free-use-panel__points {
    display: grid;
    gap: 10px;
    margin: 0 0 21px;
    padding: 0;
    list-style: none;
}
.free-use-panel__points li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    color: #fff7ea;
    font-size: .84rem;
    line-height: 1.35;
}
.free-use-panel__points li::before {
    content: "✓";
    display: grid;
    flex: 0 0 19px;
    place-items: center;
    height: 19px;
    border-radius: 50%;
    background: rgba(255, 173, 97, .22);
    color: #ffdf76;
    font-size: .75rem;
    font-weight: 900;
}
.free-use-panel__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 46px;
    padding: 11px 14px;
    border: 1px solid rgba(255, 225, 144, .55);
    border-radius: 12px;
    background: linear-gradient(100deg, #ffe27b, #ffae64);
    color: #552019;
    font-size: .85rem;
    font-weight: 800;
    line-height: 1.25;
    text-decoration: none;
    transition: background .2s ease, transform .2s ease;
}
.free-use-panel__link::after { content: "↗"; font-size: 1.2rem; line-height: 1; }
.free-use-panel__link:hover { background: #ffe6a4; transform: translateY(-2px); }
.free-use-panel__link:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
@@media (max-width: 650px) {
    .free-use-panel {
        position: relative;
        right: auto;
        bottom: auto;
        width: min(100%, 420px);
        margin: 18px auto 26px;
    }
}
@@media (prefers-reduced-motion: reduce) {
    .free-use-panel__link { transition: none; }
}
</style>
<aside class="free-use-panel" aria-label="Free use announcement">
    <div class="free-use-panel__content">
        <p class="free-use-panel__eyebrow">An open invitation</p>
        <h2>Completely <span>free</span> to use.</h2>
        <p class="free-use-panel__intro">Explore your training and nutrition with tools designed to help you understand your body.</p>
        <ul class="free-use-panel__points">
            <li>No credit card or hidden fees</li>
            <li>No marketing or strings attached</li>
            <li>Just use it, learn, and keep moving</li>
        </ul>
        <a class="free-use-panel__link" href="/recomp/why-free">Why would I give this away for free?</a>
    </div>
</aside>
