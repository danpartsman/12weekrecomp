@model AccountabilityPreviewViewModel
<section class="snap-workout" data-snap-workout id="snap-workout">
    <div class="accountability-heading"><div><p class="accountability-tag">QUICK ASSIGNMENT</p><h3>Snap Workout</h3></div><a asp-controller="AccountabilityPreview" asp-action="Snap" asp-route-clientId="@Model.ClientId">Open in client portal →</a></div>
    <p>Assign exercises with sets, reps and weight. Rates apply to prescribed completed or incomplete reps or sets. Extra reps never increase the assessed units. A set qualifies only when its recorded weight meets the assigned weight.</p>
    @if (Model.Editable || Model.CanAssignSnap)
    {
        <details class="snap-editor" open><summary>Assign a quick workout</summary>
        <form data-snap-assign>
            <div class="accountability-fields"><label>Workout name<input name="snapName" maxlength="100" value="Snap Workout" required /></label><label>Assignment date<input name="snapDate" type="date" required /></label><label>Assessment cap per workout ($)<input name="snapCap" type="number" min="0" max="10000" step=".01" value="100" required /></label></div>
            <p>The cap applies separately to this workout’s total fines and total incentives. Assignment rates and targets become part of the client’s approval terms.</p>
            <div class="snap-picker"><label>Find an exercise<input data-snap-search maxlength="80" placeholder="Search the exercise catalog" /></label><button type="button" data-snap-search-button>Search</button><label>Exercise<select data-snap-picker><option value="">Search to choose an exercise</option></select></label><button type="button" data-snap-add>Add exercise</button></div>
            <p data-snap-catalog-status role="status"></p>
            <div class="accountability-scroll"><table><caption>Quick workout assignment · weight in lb</caption><thead><tr><th>Exercise</th><th>Sets</th><th>Reps/set</th><th>Weight (lb)</th><th>Fine or incentive</th><th>Fee basis</th><th>$/unit</th><th></th></tr></thead><tbody data-snap-draft></tbody></table></div>
            <p>Use 0 lb for bodyweight or unloaded movements. No exercise is added to the regular training plan or macro prescription in this preview.</p>
            <button type="submit">Assign Snap Workout</button>
        </form></details>
    }
    <p data-snap-status role="status" aria-live="polite"></p>
    <div data-snap-assignments></div>
    <p data-snap-weekly-total></p>
    <p class="snap-preview-note">Selected-week preview only. Completion records and assignments stay in this browser. No real fees, credits or permanent workout entries are created.</p>
</section>
