@model DashboardViewModel

<div
    class="coach-today-detail"
    id="coachTodayDetail"
    hidden
    aria-hidden="true">

    <div
        class="coach-today-detail__backdrop"
        data-coach-guide-close>
    </div>

    <section
        class="coach-today-detail__shell"
        role="dialog"
        aria-modal="true"
        aria-label="Workout coaching guide">

        <div class="coach-today-detail__controls">
            <button
                type="button"
                class="coach-today-detail__control"
                data-coach-guide-expand
                aria-label="Expand coaching guide"
                title="Expand">
                <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false">
                    <path d="M8 3H3v5M16 3h5v5M8 21H3v-5M16 21h5v-5"></path>
                    <path d="M3 8l6-6M21 8l-6-6M3 16l6 6M21 16l-6 6"></path>
                </svg>
            </button>

            <button
                type="button"
                class="coach-today-detail__control"
                data-coach-guide-close
                aria-label="Close coaching guide"
                title="Close">
                <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false">
                    <path d="M5 5l14 14M19 5L5 19"></path>
                </svg>
            </button>
        </div>

        <div class="coach-today-detail__content">
            <img
                id="coachWorkoutGuideImage"
                src=""
                alt=""
                class="coach-today-detail__poster" />
        </div>
    </section>
</div>
