@inject Microsoft.Extensions.Configuration.IConfiguration AppEnvironmentConfiguration
@using System.Reflection
@{
    var testApp=WebRecomp.Web.Middleware.AppInstallIdentity.IsTest(AppEnvironmentConfiguration,Context.Request.Host.Host);
    var assembly = Assembly.GetExecutingAssembly();

    var appVersion =
        assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()
            ?.InformationalVersion
        ?? "unknown";

    var engineVersion =
        assembly.GetCustomAttributes<AssemblyMetadataAttribute>()
            .FirstOrDefault(x => x.Key == "RecompEngineVersion")
            ?.Value
        ?? "unknown";
}
@{
    var title = ViewData["Title"]?.ToString() ?? "Coach";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(testApp?"[TEST] ":"")@title - 12 Week Recomp</title>

    <script>
        (() => {
            const media = window.matchMedia('(prefers-color-scheme: dark)');

            const applyTheme = () => {
                const preference =
                    localStorage.getItem('recomp-theme') || 'system';

                const effective =
                    preference === 'system'
                        ? (media.matches ? 'dark' : 'light')
                        : preference;

                document.documentElement.dataset.theme = effective;
            };

            applyTheme();
        })();
    </script>

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
<link rel="stylesheet" href="~/css/free-stamps.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/coach-center.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/app-navigation.css" asp-append-version="true" />
<script src="~/js/app-navigation.js" asp-append-version="true" defer></script>
<partial name="_AppInstallMetadata" />
</head>

<body class="app-shell coach-shell">
<partial name="_AppEnvironmentNotice" />

<header class="topbar">

    <div class="brand brand-logo-wrap">
        <a asp-controller="Coach"
           asp-action="Index"
           aria-label="12 Week Recomp Coach">

            <img class="brand-logo brand-logo-dark"
                 src="~/images/recomp/recomp-logo-dark.png"
                 alt="12 Week Recomp" />
        </a>
        <a class="free-stamp free-stamp--brand" href="/recomp/why-free" aria-label="Completely free — read why">FREE</a>
    </div>

    @await Html.PartialAsync("_AppNavigation", false)

</header>

<main class="container">
    @RenderBody()
</main>

<footer class="footer recomp-footer">
    <div>
        <strong>12 Week Recomp Coach Center</strong>
        <span>Web Recomp @appVersion &bull; Engine @engineVersion</span>
    </div>
</footer>

</body>
</html>

