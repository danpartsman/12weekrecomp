@model WebRecomp.Web.Controllers.SimpleSnapPage
@using WebRecomp.Web.Services.Coaching
@{ViewData["Title"]="Snap Workouts";if(Model.Coach){Layout="_CoachLayout";}var workouts=Model.State.SnapWorkouts.Where(w=>w.Simple).Reverse().ToList();}
<link rel="stylesheet" href="~/css/coaching-actions.css" asp-append-version="true" />
<div class="coaching-actions">
<link rel="stylesheet" href="~/css/snap-completion.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/coach-center.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/simple-coaching.css" asp-append-version="true" />
<section class="page-header snap-hero"><div><span class="snap-eyebrow">TRAIN WITH PURPOSE</span><h1>@(Model.CoachName ?? Model.Name) · Snap Workouts</h1><p>Assign a workout, record the results, and track fees and payments in this client's account.</p></div><img src="/images/workout-detail-gym-20260929.jpg" alt="Strength training in the gym" /></section>
<p>@if(!Model.Coach){<a class="button" asp-controller="Availability" asp-action="Index" asp-route-clientId="@Model.ClientId">My Calendar</a>} <a class="button" asp-controller="AccountabilityLedger" asp-action="Index" asp-route-clientId="@Model.ClientId" asp-route-coachUserId="@Model.CoachUserId">Fees &amp; payments</a> @if(Model.Coach){<a class="button" asp-controller="Coach" asp-action="Index">Client list</a>}</p>
<p class="muted">Sleep, work, timed planned workouts, illness and pain days pause the completion clock. Assignments received during protected time wait until you are available. Record workout results whenever you choose.</p>
@if(TempData["SimpleStatus"] is string status){<div class="app-message" role="status">@status</div>}
<div asp-validation-summary="All" class="app-message" tabindex="-1" role="alert" data-snap-validation></div>
@if(Model.Coach)
{
<details class="card" id="snap-assignment-form" open><summary>@(Model.Draft.EditWorkoutId is null?"Assign a Snap Workout":"Edit assigned Snap Workout")</summary>
<form asp-action="Assign" asp-route-clientId="@Model.ClientId" method="post" data-estimate-url="@Url.Action("Estimate",new{clientId=Model.ClientId})" data-simple-assignment data-conflict-required="@((ViewData["SnapConflictRequired"] is true).ToString().ToLowerInvariant())" data-timing-url="@Url.Action("Timing",new{clientId=Model.ClientId})" data-exercise-search-url="@Url.Action("Exercises",new{clientId=Model.ClientId})">
<input type="hidden" name="EditWorkoutId" value="@Model.Draft.EditWorkoutId" />
@if(Model.Draft.EditWorkoutId is not null){<p>Saving updates this assignment and restarts its completion window from now, or the selected future date. Recorded progress is kept for unchanged exercise rows.</p><a class="button secondary" asp-action="Index" asp-route-clientId="@Model.ClientId">Discard edits</a>}
<input type="hidden" name="Revision" value="@Model.Revision" /><input type="hidden" name="RequestId" value="@Model.Draft.RequestId" />
<div class="simple-fields snap-assignment-row">
<div class="snap-workout-picker"><label for="snap-workout-name">Workout</label><div class="snap-workout-input"><input id="snap-workout-name" name="Name" value="@Model.Draft.Name" maxlength="100" required /><button type="button" data-workout-toggle aria-label="Show previous Snap Workouts" aria-expanded="false" aria-controls="snap-workout-history">▾</button></div><div id="snap-workout-history" class="snap-workout-history" hidden>@foreach(var template in Model.RecentTemplates){<a href="@Url.Action("Template",new{clientId=Model.ClientId,workoutId=template.Id})#snap-assignment-form">@template.Name</a>}@if(Model.RecentTemplates.Count==0){<span>No previous Snap Workouts yet.</span>}</div></div><label>Date<input name="Date" type="date" min="@Model.Today.ToString("yyyy-MM-dd")" value="@Model.Draft.Date.ToString("yyyy-MM-dd")" required /></label><label>Available workout time (hours)<input name="TimeAllowed" type="number" min="0.0166666667" max="168" step="any" value="@Model.Draft.TimeAllowed" required /></label><label>Required Completion Time<output data-required-completion data-time-zone="@Model.ClientTimeZone" data-client-today="@Model.Today.ToString("yyyy-MM-dd")" data-server-now="@DateTimeOffset.UtcNow.ToString("O")">Calculated when assigned</output></label></div>
<input type="hidden" name="OverrideSchedule" value="false" />
<input type="hidden" name="ConflictChoice" value="" />
<p class="muted">Reserved time extends the deadline while preserving the available workout hours. Conflicts are reviewed when you assign the workout.</p>
<section class="snap-schedule-preview" aria-label="Client workout and reserved time">
<h3>Client schedule</h3><p class="muted">Daily workout and reserved hours · @Model.ClientTimeZone</p>
<div data-schedule-days aria-live="polite">Loading the client’s schedule…</div>
</section>
<p class="muted">Suggested amounts—edit these to your desired fees and incentives.</p>
<div class="simple-fields snap-assignment-row snap-fee-rates"><label>Late Fee ($)<input name="LatePenalty" data-snap-fee-default="20" type="number" min="0" max="10000" step=".01" value="@Model.Draft.LatePenalty" required /></label><label>Incomplete Exercise Fee ($)<input name="IncompleteExerciseFee" data-snap-fee-default="5" type="number" min="0" max="10000" step=".01" value="@Model.Draft.IncompleteExerciseFee" required /></label><label>Extra rep coach incentive ($)<input name="CoachIncentivePerRep" data-snap-fee-default="1" type="number" min="0" max="100" step=".01" value="@Model.Draft.CoachIncentivePerRep" required /></label></div>
<div class="simple-fields snap-charge-bounds"><label>On-time minimum coach charge ($)<input name="MinimumCharge" data-snap-fee-default="10" type="number" min="0" max="10000" step=".01" value="@Model.Draft.MinimumCharge" required /></label><label>Maximum total charges ($)<input name="Cap" data-snap-fee-default="30" type="number" min="0" max="10000" step=".01" value="@Model.Draft.Cap" required /></label></div>
<label class="snap-assignment-note">Note to client (optional)<textarea name="CoachNote" rows="3" maxlength="1000" placeholder="Instructions or encouragement for this workout">@Model.Draft.CoachNote</textarea></label>
<p class="muted">All fees, penalties and extra-rep incentives are paid by the client to the coach. The minimum applies when all prescribed work is completed on time. Extra-rep incentives count toward that minimum. The maximum caps the combined total for this workout, including the late fee. Shared exercise fees apply to each incomplete exercise; the incentive applies to each qualifying extra rep.</p>
<div data-simple-exercises>
@for(var i=0;i<Model.Draft.Exercises.Count;i++){
 var exercise=Model.Draft.Exercises[i];
 <section class="simple-exercise" data-exercise><input type="hidden" name="Exercises[@i].Id" value="@exercise.Id" /><div class="simple-fields snap-exercise-row"><label><span class="snap-field-label">Exercise · search or type your own</span><input name="Exercises[@i].Name" value="@exercise.Name" maxlength="250" required /></label><label><span class="snap-field-label">Sets</span><input name="Exercises[@i].Sets" type="number" min="1" max="10" value="@exercise.Sets" required /></label><label><span class="snap-field-label">Reps per set</span><input name="Exercises[@i].Reps" type="number" min="1" max="100" value="@exercise.Reps" required /></label><label><span class="snap-field-label">Max weight (lb, optional)</span><input aria-label="Max weight in pounds (optional)" name="Exercises[@i].MaxWeight" type="number" min="0" max="2000" step=".01" value="@exercise.MaxWeight" placeholder="No limit" /></label>
 <label><span class="snap-field-label">RPE (optional)</span><input name="Exercises[@i].Rpe" type="number" min="1" max="10" step=".1" value="@exercise.Rpe" /></label><label class="snap-muscle-focus"><span class="snap-field-label">Muscle focus (optional)</span><input name="Exercises[@i].MuscleFocus" value="@exercise.MuscleFocus" maxlength="250" placeholder="chest, shoulders, triceps" /></label><button class="button secondary" type="button" data-remove-exercise>Remove exercise</button></div></section>
}
</div>
<p class="snap-engine-estimate" data-snap-estimate role="status">Calorie and glycogen estimates are optional. You can assign any free-form exercise name.</p>
<div class="snap-form-actions"><button type="button" class="button secondary" data-add-exercise>Add exercise</button><button type="submit" class="button">@(Model.Draft.EditWorkoutId is null?"Assign workout":"Save changes")</button></div>
</form></details>
<dialog class="snap-conflict-dialog" data-snap-conflict-dialog aria-labelledby="snap-conflict-title" aria-describedby="snap-conflict-description">
<h2 id="snap-conflict-title">Schedule conflict</h2>
<p id="snap-conflict-description">The selected completion window overlaps reserved time. Review the conflict before assigning this Snap Workout.</p>
<ul data-conflict-list></ul>
<label>Available workout hours<input type="number" min="0.0166666667" max="168" step="any" data-conflict-hours /></label>
<p data-conflict-extension></p><p data-conflict-status role="status"></p>
<p class="muted">Extending keeps the full available workout time and moves the deadline past reserved hours. Override conflict applies to this Snap only, including illness and pain conflicts.</p>
<div class="snap-conflict-actions">
<button type="button" class="button" data-conflict-extend>Extend until after conflict</button>
<button type="button" class="button secondary" data-conflict-override>Override conflict</button>
<button type="button" class="button secondary" data-conflict-cancel>Cancel</button>
</div>
</dialog>
}
<section class="card"><h2>@(Model.Coach?"Assigned workouts & results":"Your assigned workouts")</h2>
@if(Model.Coach){<p class="muted">Tap a workout to review its results. The assignment editor above can be collapsed when you are finished.</p>}
@if(workouts.Count==0){<p>No active Snap Workouts yet.</p>}
@foreach(var w in workouts){
 var previous=Model.State.SnapResults.GetValueOrDefault(w.Id);var completed=SnapWorkoutLibrary.Completed(w,previous);var canRecord=true;Guid? assigningCoach=Model.AssignmentOwners.TryGetValue(w.Id,out var ownerId)?ownerId:null;
 <details class="simple-workout snap-mobile-workout" id="snap-@w.Id" open="@(Context.Request.Query["assignment"]==w.Id)"><summary>@w.Name · @Model.AssignedBy.GetValueOrDefault(w.Id) · @w.Date · @(completed?"Completed":previous?.Finalized==true?"Finished · penalties applied":previous is null?"Assigned":"Progress saved")</summary>
 @if(Model.Coach){
<div class="snap-review-actions" style="display:flex;flex-wrap:wrap;gap:.65rem;align-items:center;margin:.8rem 0">
@if(previous?.Finalized!=true){<a class="button" asp-action="Edit" asp-route-clientId="@Model.ClientId" asp-route-workoutId="@w.Id" asp-fragment="snap-assignment-form">Edit assignment</a>}
<form asp-action="Cancel" asp-route-clientId="@Model.ClientId" asp-route-workoutId="@w.Id" method="post"><input type="hidden" name="revision" value="@Model.Revision" /><button class="button secondary" type="submit">Cancel workout</button></form>
<a class="button" asp-action="Reuse" asp-route-clientId="@Model.ClientId" asp-route-workoutId="@w.Id" asp-fragment="snap-assignment-form">Copy to new Snap</a>
<form asp-action="Repeat" asp-route-clientId="@Model.ClientId" asp-route-workoutId="@w.Id" method="post" style="display:inline">@Html.AntiForgeryToken()<button type="submit" class="button">Assign again</button></form>
</div>
<p><strong>Assigned by:</strong> @Model.AssignedBy.GetValueOrDefault(w.Id)</p>
<p><strong>Workout summary:</strong> @w.Exercises.Count exercises · @w.Exercises.Sum(e=>e.Sets) prescribed sets · @(previous?.Finalized==true?"Results submitted":"Not finished").
<strong>Assessed fees and incentives:</strong> @Model.AssessedCharges.GetValueOrDefault(w.Id).ToString("C2") · <strong>Posted net charges:</strong> @Model.PostedCharges.GetValueOrDefault(w.Id).ToString("C2").
Payments are tracked at the coach/client account level rather than allocated to individual workouts; see <a asp-controller="AccountabilityLedger" asp-action="Index" asp-route-clientId="@Model.ClientId">fees and payments</a>.</p>
}
@if(w.OverrideSchedule){<p class="app-message">Schedule override: @(w.OverrideHealthConflicts?"this Snap ignores reserved time, including illness and pain flags.":"this earlier Snap ignores sleep, work and workout reservations; its original illness protection is retained.")</p>}
@if(!string.IsNullOrWhiteSpace(w.CoachNote)){<p class="snap-saved-note"><strong>@Model.AssignedBy.GetValueOrDefault(w.Id)'s note:</strong> @w.CoachNote</p>}
@if(previous?.Finalized==true){
    <p><a class="button" asp-action="Completion" asp-route-clientId="@Model.ClientId" asp-route-workoutId="@w.Id">View fee summary &amp; notes</a></p>
}
<div class="snap-charge-summary">@if(w.MinimumCharge.HasValue){<span>On-time minimum coach charge <strong>@w.MinimumCharge.Value.ToString("C2")</strong></span>}<span>Maximum total charges <strong>@w.Cap.ToString("C2")</strong></span>
 @if(w.DeadlineUtc.HasValue){<span class="snap-deadline-card">Required Completion Time <strong data-snap-deadline="@w.DeadlineUtc.Value.ToString("O")" data-time-zone="@Model.ClientTimeZone">@TimeZoneInfo.ConvertTime(w.DeadlineUtc.Value,TimeZoneInfo.FindSystemTimeZoneById(Model.ClientTimeZone)).ToString("MMM d, yyyy h:mm tt") (@Model.ClientTimeZone)</strong></span>}
 @if(w.DeadlineUtc.HasValue||w.Timing is not null){<span class="snap-countdown-card" data-snap-countdown data-workout-id="@w.Id" data-deadline="@w.DeadlineUtc?.ToString("O")" data-server-now="@DateTimeOffset.UtcNow.ToString("O")" data-finished="@((previous?.Finalized==true).ToString().ToLowerInvariant())" data-remaining-seconds="@w.Timing?.RemainingSeconds.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-paused-until="@w.Timing?.PausedUntilUtc?.ToString("O")" data-available-from="@w.Timing?.AvailableFromUtc?.ToString("O")" data-pause-reason="@w.Timing?.Reason">Available time remaining <strong data-time-remaining>@if(previous?.Finalized==true){<text>Finished @(previous.CompletedAtUtc<=w.DeadlineUtc?"on time":"after the deadline")</text>}else{<text>Loading…</text>}</strong></span>}

 </div>
 @if(w.CompletionReward>0){<p>Previously assigned whole-workout completion fee: @w.CompletionReward.Value.ToString("C2").</p>}
 @if(w.DeadlineUtc.HasValue){<p class="muted">Late fee: @((w.LatePenalty??0).ToString("C2")), applied once if not finished by the deadline.</p>}
 @if(Model.Estimates.TryGetValue(w.Id,out var estimate)){
 if(estimate is not null){<p class="snap-engine-estimate">@(estimate.Actual?"Recorded work estimate":"Assigned work estimate"): <strong>@estimate.Calories.ToString("0") active calories</strong> · <strong>@estimate.Glycogen.ToString("0.0") g glycogen</strong>.</p>}
 else{<p class="muted">Energy estimate needs the client’s weight, height, date of birth and sex.</p>}
 }
 <form asp-action="Result" asp-route-clientId="@Model.ClientId" asp-route-coachUserId="@Model.CoachUserId" method="post" data-snap-results data-finished="@((previous?.Finalized==true).ToString().ToLowerInvariant())" data-can-record="@canRecord.ToString().ToLowerInvariant()"><input name="Revision" type="hidden" value="@Model.Revision" /><input name="WorkoutId" type="hidden" value="@w.Id" />
 @for(var e=0;e<w.Exercises.Count;e++){
 var exercise=w.Exercises[e];var records=previous?.Sets.GetValueOrDefault(exercise.Id);
 <section class="snap-result-exercise"><h3 class="snap-exercise-title">@exercise.Name</h3><p>@exercise.Sets × @exercise.Reps reps · max @exercise.MaxWeight lb. @if(exercise.CompletionReward>0){<span>Completion fee @exercise.CompletionReward.Value.ToString("C2") · </span>}Incomplete exercise fee @((exercise.Penalty??exercise.Rate).ToString("C2"))@(exercise.Penalty.HasValue?"":" per "+exercise.Basis.Replace('-',' ')) · extra-rep incentive @((exercise.ExtraRepRate??0).ToString("C2")) per rep. Paid by the client to the coach.</p>
 <p class="muted">Muscle focus: @(string.IsNullOrWhiteSpace(exercise.MuscleFocus)?"Not specified by coach":exercise.MuscleFocus) · Coach RPE: @(exercise.Rpe?.ToString("0.#")??"Engine default")</p>
 <input name="Exercises[@e].Id" type="hidden" value="@exercise.Id" />
 <div class="simple-table-scroll"><table><thead><tr><th>Set</th><th>Completed reps</th><th>Weight used (lb)</th></tr></thead><tbody>
 @for(var n=0;n<Math.Max(exercise.Sets,records?.Count??0);n++){
 var saved=records is not null&&n<records.Count?records[n]:null;
 <tr><th>@(n+1)</th><td><input aria-label="@exercise.Name set @(n+1) reps" name="Exercises[@e].Sets[@n].Reps" type="number" min="0" max="1000" value="@saved?.Reps" disabled="@(!canRecord)" /></td><td><input aria-label="@exercise.Name set @(n+1) weight" name="Exercises[@e].Sets[@n].Weight" type="number" min="0" max="2000" step=".01" value="@(saved?.WeightRecorded==false?null:(saved?.Weight??(exercise.MaxWeight==0?0:(decimal?)null)))" disabled="@(!canRecord)" /></td></tr>
 }
 </tbody></table></div>
 <label class="snap-rpe">Actual RPE (optional)<input name="Exercises[@e].Rpe" type="number" min="1" max="10" step=".1" value="@(records?.FirstOrDefault()?.Rpe)" placeholder="1–10" disabled="@(!canRecord)" /></label>
</section>
 }
 @if(canRecord){<p>Finish workout submits the final results even if targets were missed. Blank entries count as unfinished work and the assigned penalties apply. Extra reps add an incentive payable to the coach after the prescribed sets are complete.</p><div class="snap-result-actions"><button name="SubmitMode" value="progress" type="submit" class="button">Save progress</button> <button name="SubmitMode" value="finish" type="submit" class="button">Finish workout</button></div>}
 else{<p>Results can be recorded on or after @w.Date.</p>}
 <p class="snap-wake-status" data-snap-wake-status role="status"></p><button type="button" class="button" data-snap-wake-retry hidden>Keep screen awake</button>
 </form>
 @if(previous?.Finalized==true){<p>Results saved. Calculated fees and incentives appear in <a asp-controller="AccountabilityLedger" asp-action="Index" asp-route-clientId="@Model.ClientId" asp-route-coachUserId="@assigningCoach">Fees &amp; payments</a>.</p>}
 </details>
}
</section>

</div>
<script src="~/js/simple-coaching.js" asp-append-version="true" defer></script>

<script src="~/js/snap-countdown.js" asp-append-version="true" defer></script>

<script src="~/js/snap-assignment-time.js" asp-append-version="true" defer></script>

<script src="~/js/snap-engine-estimate.js" asp-append-version="true" defer></script>

<script src="~/js/snap-wake-lock.js" asp-append-version="true" defer></script>

<script src="~/js/snap-exercise-search.js" asp-append-version="true" defer></script>
