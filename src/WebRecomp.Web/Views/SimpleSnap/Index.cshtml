@model WebRecomp.Web.Controllers.SimpleSnapPage
@using WebRecomp.Web.Services.Coaching
@{ViewData["Title"]="Snap Workouts";if(Model.Coach){Layout="_CoachLayout";}var workouts=Model.State.SnapWorkouts.Where(w=>w.Simple).Reverse().ToList();}
<link rel="stylesheet" href="~/css/coach-center.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/simple-coaching.css" asp-append-version="true" />
<section class="page-header"><h1>@Model.Name · Snap Workouts</h1><p>Assign a workout, record the results, and track fees and payments in this client's account.</p></section>
<p><a class="button" asp-controller="AccountabilityLedger" asp-action="Index" asp-route-clientId="@Model.ClientId">Fees &amp; payments</a> @if(Model.Coach){<a class="button" asp-controller="Coach" asp-action="Index">Client list</a>}</p>
@if(TempData["SimpleStatus"] is string status){<div class="app-message" role="status">@status</div>}
<div asp-validation-summary="All" class="app-message"></div>
@if(Model.Coach)
{
<details class="card" open><summary>Assign a Snap Workout</summary>
<form asp-action="Assign" asp-route-clientId="@Model.ClientId" method="post" data-simple-assignment>
<input type="hidden" name="Revision" value="@Model.Revision" /><input type="hidden" name="RequestId" value="@Model.Draft.RequestId" />
<div class="simple-fields"><label>Workout name<input name="Name" value="@Model.Draft.Name" maxlength="100" required /></label><label>Date<input name="Date" type="date" min="@Model.Today.ToString("yyyy-MM-dd")" value="@Model.Draft.Date.ToString("yyyy-MM-dd")" required /></label><label>Time allowed<input name="TimeAllowed" type="number" min="1" max="10080" step="1" value="@Model.Draft.TimeAllowed" required /></label><label>Time unit<select name="TimeUnit"><option value="hours" selected="@(Model.Draft.TimeUnit=="hours")">Hours</option><option value="minutes" selected="@(Model.Draft.TimeUnit=="minutes")">Minutes</option></select></label><label>Fine if not finished on time ($)<input name="LatePenalty" type="number" min="0" max="10000" step=".01" value="@Model.Draft.LatePenalty" required /></label><label>Maximum total workout charge ($)<input name="Cap" type="number" min="0" max="10000" step=".01" value="@Model.Draft.Cap" required /></label></div>
<p class="muted">All fees, penalties and extra-rep incentives are paid by the client to the coach. The cap limits their combined total for this workout, including the late fine. The timer starts when assigned; a future workout date starts at midnight in the client’s time zone.</p>
<div data-simple-exercises>
@for(var i=0;i<Model.Draft.Exercises.Count;i++){
 var exercise=Model.Draft.Exercises[i];
 <section class="simple-exercise" data-exercise><div class="simple-fields"><label>Exercise<input name="Exercises[@i].Name" value="@exercise.Name" maxlength="250" required /></label><label>Sets<input name="Exercises[@i].Sets" type="number" min="1" max="10" value="@exercise.Sets" required /></label><label>Reps per set<input name="Exercises[@i].Reps" type="number" min="1" max="100" value="@exercise.Reps" required /></label><label>Max weight (lb)<input name="Exercises[@i].MaxWeight" type="number" min="0" max="2000" step=".01" value="@exercise.MaxWeight" required /></label></div>
 <div class="simple-fields"><label>Fee if completed ($)<input name="Exercises[@i].CompletionReward" type="number" min="0" max="10000" step=".01" value="@exercise.CompletionReward" required /></label><label>Penalty if unfinished ($)<input name="Exercises[@i].Penalty" type="number" min="0" max="10000" step=".01" value="@(exercise.Penalty??0)" required /></label><label>Incentive per extra rep ($)<input name="Exercises[@i].ExtraRepRate" type="number" min="0" max="100" step=".01" value="@exercise.ExtraRepRate" required /></label></div>
 <button class="secondary" type="button" data-remove-exercise>Remove exercise</button></section>
}
</div>
<p><button type="button" class="secondary" data-add-exercise>Add exercise</button></p>
<button type="submit">Assign workout</button>
</form></details>
}
<section class="card"><h2>@(Model.Coach?"Assigned workouts & results":"Your assigned workouts")</h2>
@if(workouts.Count==0){<p>No active Snap Workouts yet.</p>}
@foreach(var w in workouts){
 var previous=Model.State.SnapResults.GetValueOrDefault(w.Id);var completed=SnapWorkoutLibrary.Completed(w,previous);var canRecord=AccountabilityDocument.Date(w.Date)<=Model.Today;
 <details class="simple-workout" id="snap-@w.Id" open="@(Context.Request.Query["assignment"]==w.Id)"><summary>@w.Name · @w.Date · @(completed?"Completed":previous?.Finalized==true?"Finished · penalties applied":previous is null?"Assigned":"Progress saved")</summary>
 <p>Maximum total charge @w.Cap.ToString("C2")</p>
 @if(w.CompletionReward>0){<p>Previously assigned whole-workout completion fee: @w.CompletionReward.Value.ToString("C2").</p>}
 @if(w.DeadlineUtc.HasValue){<p data-snap-countdown data-workout-id="@w.Id" data-deadline="@w.DeadlineUtc.Value.ToString("O")" data-server-now="@DateTimeOffset.UtcNow.ToString("O")" data-finished="@((previous?.Finalized==true).ToString().ToLowerInvariant())">@if(previous?.Finalized==true){<span>Finished @(previous.CompletedAtUtc<=w.DeadlineUtc?"on time":"after the deadline")</span>}else{<span data-time-remaining>Loading time remaining…</span>}</p><p>Late-completion fine: @((w.LatePenalty??0).ToString("C2")), applied once if not finished by the deadline.</p>}
 <form asp-action="Result" asp-route-clientId="@Model.ClientId" method="post"><input name="Revision" type="hidden" value="@Model.Revision" /><input name="WorkoutId" type="hidden" value="@w.Id" />
 @for(var e=0;e<w.Exercises.Count;e++){
 var exercise=w.Exercises[e];var records=previous?.Sets.GetValueOrDefault(exercise.Id);
 <h3>@exercise.Name</h3><p>@exercise.Sets × @exercise.Reps reps · max @exercise.MaxWeight lb. Completion fee @((exercise.CompletionReward??0).ToString("C2")) · unfinished penalty @((exercise.Penalty??exercise.Rate).ToString("C2"))@(exercise.Penalty.HasValue?"":" per "+exercise.Basis.Replace('-',' ')) · extra-rep incentive @((exercise.ExtraRepRate??0).ToString("C2")) per rep. Paid by the client to the coach.</p>
 <input name="Exercises[@e].Id" type="hidden" value="@exercise.Id" />
 <div class="simple-table-scroll"><table><thead><tr><th>Set</th><th>Completed reps</th><th>Weight used (lb)</th></tr></thead><tbody>
 @for(var n=0;n<Math.Max(exercise.Sets,records?.Count??0);n++){
 var saved=records is not null&&n<records.Count?records[n]:null;
 <tr><th>@(n+1)</th><td><input aria-label="@exercise.Name set @(n+1) reps" name="Exercises[@e].Sets[@n].Reps" type="number" min="0" max="1000" value="@saved?.Reps" disabled="@(!canRecord)" /></td><td><input aria-label="@exercise.Name set @(n+1) weight" name="Exercises[@e].Sets[@n].Weight" type="number" min="0" max="2000" step=".01" value="@(saved?.WeightRecorded==false?null:(saved?.Weight??(exercise.MaxWeight==0?0:(decimal?)null)))" disabled="@(!canRecord)" /></td></tr>
 }
 </tbody></table></div>
 }
 @if(canRecord){<p>Finish workout submits the final results even if targets were missed. Blank entries count as unfinished work and the assigned penalties apply. Extra reps add an incentive payable to the coach after the prescribed sets are complete.</p><button name="SubmitMode" value="progress" type="submit" class="secondary">Save progress</button> <button name="SubmitMode" value="finish" type="submit">Finish workout</button>}
 else{<p>Results can be recorded on or after @w.Date.</p>}
 </form>
 @if(previous?.Finalized==true){<p>Results saved. Calculated fees and incentives appear in <a asp-controller="AccountabilityLedger" asp-action="Index" asp-route-clientId="@Model.ClientId">Fees &amp; payments</a>.</p>}
 </details>
}
</section>
@if(Model.Coach){<p><a class="button secondary" asp-controller="Coach" asp-action="Old">Old coaching screens · reference only</a></p>}
<script src="~/js/simple-coaching.js" asp-append-version="true" defer></script>

<script src="~/js/snap-countdown.js" asp-append-version="true" defer></script>
