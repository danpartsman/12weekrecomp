@model WebRecomp.Web.Controllers.CoachTasksPage
@using System.Globalization
@using WebRecomp.Web.Services.Coaching
@{
    ViewData["Title"] = "Task assignments";
    if (Model.IsCoach) { Layout = "_CoachLayout"; }
    var party = Model.Party;
    ViewData["SnapCoachScope"] = party.CoachId;
    var zone = SnapAvailabilityClock.Zone(party.TimeZone);
    string Money(decimal value) => value.ToString("C", CultureInfo.GetCultureInfo("en-US"));
    string Number(decimal value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    string Local(DateTimeOffset value) => TimeZoneInfo.ConvertTime(value, zone).ToString("MMM d, yyyy h:mm tt zzz");
}
<link rel="stylesheet" href="~/css/coach-tasks.css" asp-append-version="true" />
<header class="page-header">
    <h1>Task assignments</h1>
    <p>@(Model.IsCoach ? party.ClientName : party.CoachName)</p>
    <nav class="task-actions" aria-label="Coaching links">
        <a class="button" asp-controller="CoachWorkspace" asp-action="Index" asp-route-clientId="@party.ClientId" asp-route-coachId="@party.CoachId">Coach workspace</a>
        <a class="button" asp-controller="AccountabilityLedger" asp-action="Index" asp-route-clientId="@party.ClientId" asp-route-coachUserId="@party.CoachId">Fees &amp; payments</a>
    </nav>
</header>
@if (TempData["TaskStatus"] is string status) { <p class="app-message success" role="status">@status</p> }
@if (TempData["TaskError"] is string error) { <p class="app-message" role="alert">@error</p> }
@if (Model.IsCoach)
{
    <details class="card task-editor" open="@(Model.Tasks.Count == 0 || !ViewData.ModelState.IsValid)">
        <summary>Assign a task</summary>
        <form asp-action="Assign" asp-route-clientId="@party.ClientId" asp-route-coachId="@party.CoachId" method="post" data-task-editor>
            <div asp-validation-summary="All" role="alert"></div>
            <input asp-for="Input.RequestId" type="hidden" />
            <div class="task-fields">
                <label>Assignment title<input asp-for="Input.Title" maxlength="120" required /></label>
                <label>Complete by (@zone.Id)<input asp-for="Input.DueLocal" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" required /></label>
                <label class="task-full">Notes<textarea asp-for="Input.Notes" rows="4" maxlength="2000"></textarea></label>
                <label>Fee type<select asp-for="Input.Billing" data-task-billing>
                    <option value="fixed">Flat fee</option>
                    <option value="quantity">Per unit completed</option>
                    <option value="minute">Per active minute</option>
                    <option value="hour">Per active hour</option>
                </select></label>
                <label data-task-unit>Quantity unit<input asp-for="Input.Unit" maxlength="40" placeholder="e.g. pages" /></label>
                <label data-task-bounds><span data-task-minimum>Minimum quantity</span><input asp-for="Input.Minimum" type="number" min="0" max="100000" step="0.01" /></label>
                <label data-task-bounds><span data-task-maximum>Maximum quantity</span><input asp-for="Input.Maximum" type="number" min="0.01" max="100000" step="0.01" /></label>
                <label><span data-task-rate>Fee (USD)</span><input asp-for="Input.Rate" type="number" min="0" max="10000" step="0.01" required /></label>
                <label>Late penalty (USD)<input asp-for="Input.LateFee" type="number" min="0" max="10000" step="0.01" required /></label>
            </div>
            <button type="submit">Assign task</button>
        </form>
    </details>
}
@if (Model.Tasks.Count == 0) { <p>No tasks assigned for this coaching relationship.</p> }
@foreach (var task in Model.Tasks)
{
    var open = !task.CompletedUtc.HasValue;
    var running = open && task.RunningSinceUtc.HasValue;
    var late = (task.CompletedUtc ?? Model.Now) > task.DueUtc;
    var ticks = task.ActiveTicks(Model.Now);
    var elapsed = TimeSpan.FromTicks(ticks);
    var capped = task.IsTimed && elapsed.TotalMinutes >= (double)task.Maximum;
    var timer = $"{(long)elapsed.TotalHours:00}:{elapsed.Minutes:00}:{elapsed.Seconds:00}";
    var rateUnit = task.Billing switch { "quantity" => task.Unit, "minute" => "minute", "hour" => "hour", _ => "task" };
    <article class="card task-card" id="@($"task-{task.Id:N}")">
        <header class="task-heading">
            <h2>@task.Title</h2>
            <strong>@(open ? late ? "Overdue" : running ? "In progress" : task.FirstStartedUtc.HasValue ? "Stopped" : "Assigned" : late ? "Completed late" : "Completed")</strong>
        </header>
        @if (!string.IsNullOrWhiteSpace(task.Notes)) { <p class="task-notes">@task.Notes</p> }
        <dl class="task-terms">
            <div><dt>Due</dt><dd>@Local(task.DueUtc)</dd></div>
            <div><dt>Fee</dt><dd>@Money(task.Rate) per @rateUnit</dd></div>
            <div><dt>Late penalty</dt><dd>@Money(task.LateFee)@(task.LateFeePosted ? " posted" : "")</dd></div>
            @if (task.Billing != "fixed")
            {
                <div><dt>Minimum</dt><dd>@Number(task.Minimum) @task.Unit</dd></div>
                <div><dt>Maximum</dt><dd>@Number(task.Maximum) @task.Unit</dd></div>
            }
            @if (task.FirstStartedUtc is { } started) { <div><dt>First start</dt><dd>@Local(started)</dd></div> }
            @if (task.LastStoppedUtc is { } stopped) { <div><dt>Last stop</dt><dd>@Local(stopped)</dd></div> }
            @if (task.CompletedUtc is { } completed) { <div><dt>Completed</dt><dd>@Local(completed)</dd></div> }
            @if (task.Quantity is { } quantity) { <div><dt>Reported quantity</dt><dd>@Number(quantity) @task.Unit</dd></div> }
        </dl>
        @if (task.FirstStartedUtc.HasValue)
        {
            <p class="task-clock" data-task-clock data-running="@running.ToString().ToLowerInvariant()"
               data-seconds="@((elapsed.TotalSeconds).ToString(CultureInfo.InvariantCulture))"
               data-cap="@(task.IsTimed ? Number(task.Maximum * 60) : "")"
               data-rate="@(task.IsTimed ? Number(task.Rate) : "")"
               data-seconds-per-unit="@(task.Billing == "hour" ? 3600 : 60)">
                Active time <strong data-elapsed>@timer</strong>
                @if (task.IsTimed) { <span>· Accrued <strong data-accrued>@Money(task.WorkFee(Model.Now))</strong></span> }
                @if (task.WorkFeePosted > 0) { <span>· Posted @Money(task.WorkFeePosted)</span> }
            </p>
        }
        @if (!Model.IsCoach && open)
        {
            <div class="task-actions">
                @if (running || !capped)
                {
                    <form asp-action="Update" asp-route-clientId="@party.ClientId" asp-route-coachId="@party.CoachId" asp-route-id="@task.Id" method="post">
                        <input type="hidden" name="version" value="@task.Version" />
                        <button type="submit" name="command" value="@(running ? "stop" : "start")">@(running ? "Stop" : task.FirstStartedUtc.HasValue ? "Resume" : "Start")</button>
                    </form>
                }
                @if (task.FirstStartedUtc.HasValue)
                {
                    <form asp-action="Update" asp-route-clientId="@party.ClientId" asp-route-coachId="@party.CoachId" asp-route-id="@task.Id" method="post">
                        <input type="hidden" name="version" value="@task.Version" />
                        @if (task.Billing == "quantity")
                        {
                            <label>Completed @task.Unit<input name="quantity" type="number" min="@Number(task.Minimum)" max="@Number(task.Maximum)" step="0.01" required /></label>
                        }
                        <button type="submit" name="command" value="complete">@(running ? "Stop and complete" : "Complete task")</button>
                    </form>
                }
            </div>
        }
    </article>
}
<script src="~/js/coach-tasks.js" asp-append-version="true" defer></script>
