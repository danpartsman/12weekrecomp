@using WebRecomp.Web.Services.Dashboard2
@using WebRecomp.Web.Services.Dashboard3
@using WebRecomp.Web.Services.Learning
@using System.Text.Json
@model DashboardViewModel
@{
    ViewData["Title"] = "Command Center";
    ViewData["BodyClass"] = "command-center-page";
    var plan = (MacroDayPlan)ViewData["MacroDayPlan"]!;
    var cockpit = ViewData["RecompCockpit"] as RecompCockpit;
    var coach = CoachCatalog.Resolve(Model.PreferredCoachCode);
    var coachImage = coach.Code == "MARISOL" ? "/images/coach/marisol-coach-avatar.webp" : CoachCatalog.ResolveImage(coach, 1);
    var analysis = Model.Engine30Analysis;
    var today = ViewData["DashboardToday"] is DateOnly current ? current : Model.ActionDate;
    var start = ViewData["DashboardStart"] is DateOnly first ? first : Model.ActionDate;
    var historical = Model.ActionDate < today;
}
<link rel="stylesheet" href="~/css/dashboard2.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/dashboard3.css" asp-append-version="true" />
<main class="d3 d2" data-dashboard3 data-coach-code="@coach.Code">
    <header class="d3-heading d3-team-header">
        <button type="button" class="d3-team-photo d3-team-open" data-open-team aria-haspopup="dialog" aria-label="Meet your Recomp coaches"><img src="~/images/coach/recomp-trainer-team.webp" asp-append-version="true" alt="All eight Recomp trainers together in the gym: Grant, Owen, Cassie, Marcus, Marisol, Aisha, Lucía and Nina" width="1536" height="512" fetchpriority="high" /><span>Meet your coaches ↗</span></button>
        <div class="d3-date-panel"><div class="d3-title-block"><p class="d3-eyebrow">YOUR RECOMP TEAM</p><h1>Command Center</h1><p>Week @Model.ProgramWeek · <time datetime="@Model.ActionDate.ToString("yyyy-MM-dd")">@Model.ActionDate.ToString("ddd, MMM d")</time> · @(historical ? "Saved day" : "Today")</p></div>
            <div class="d3-date-controls">
            <form action="/CommandCenter" method="get" class="d3-date-form"><label for="d3-date">Choose a day</label><input id="d3-date" name="date" type="date" value="@Model.ActionDate.ToString("yyyy-MM-dd")" min="@start.ToString("yyyy-MM-dd")" max="@today.ToString("yyyy-MM-dd")" required /><button class="button" type="submit">View day</button></form>
            <nav class="d3-date-nav" aria-label="Browse dashboard days">
                @if (Model.ActionDate > start) { <a href="/CommandCenter?date=@Model.ActionDate.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Previous day">← Previous</a> }
                @if (historical) { <a href="/CommandCenter?date=@Model.ActionDate.AddDays(1).ToString("yyyy-MM-dd")" aria-label="Next day">Next →</a><a href="/CommandCenter">Today</a> }
            </nav>
            </div>
        </div>
    </header>
    <dialog class="d3-team-dialog" data-team-dialog aria-labelledby="d3-team-title">
        <div class="d3-team-dialog-head"><h2 id="d3-team-title">Meet your Recomp coaches</h2><button type="button" class="button" data-close-team aria-label="Close coach gallery">Close ×</button></div>
        <img class="d3-team-large" src="~/images/coach/recomp-trainer-team.webp" asp-append-version="true" alt="The eight Recomp coaches together" />
        <p>See a coach you like? <a asp-controller="Profile" asp-action="Settings" asp-fragment="your-coach">Change your coach in Settings</a>. Your choice follows you through workouts, nutrition, and learning.</p>
        <div class="d3-coach-roster">
        @foreach (var trainer in CoachCatalog.All) {
            <article>@await Html.PartialAsync("_CoachPhoto", (trainer.GalleryImages[0]!, trainer.Name))<div><h3>@trainer.Name</h3><p><strong>@trainer.Style</strong></p><p>@trainer.Tagline</p><p class="d3-voice-sample">@CoachVoice.Speak(trainer, "Protect your muscle, train with purpose, and choose food that supports the work.")</p></div></article>
        }
        </div>
    </dialog>
    @if (cockpit is null || Model.NeedsCurrentWeight)
    {
        <section class="d2-panel"><h2>Your personal plan needs a current weight</h2><a class="button" href="/DailyEntry">Open Daily Entry</a></section>
    }
    else
    {
    <section class="d3-hero d3-cockpit" aria-label="Recomp gauge grid">
        <div class="d3-row-heading"><h2>@(cockpit.RollingScore ? "Last 7 completed days" : "Saved calendar week")</h2><span>@cockpit.WeekStart.ToString("MMM d")–@cockpit.ScoreEnd.ToString("MMM d")</span></div>
        <div class="d3-overview-grid">
        @foreach (var instrument in new[] { (Key: "score", Label: "Recomp Plan Score", Description: "Overall execution", Value: cockpit.Score.DisplayScore), (Key: "nutrition", Label: "Nutrition", Description: "Completed evidence", Value: cockpit.Score.NutritionScore), (Key: "workout", Label: "Workout", Description: "Completed evidence", Value: cockpit.Score.WorkoutScore) })
        {
            var band = !instrument.Value.HasValue ? "gray" : instrument.Value >= 80 ? "green" : instrument.Value >= 60 ? "yellow" : "red";
            <button type="button" class="d3-instrument d3-gauge-button" data-open-coach="@instrument.Key" aria-haspopup="dialog" aria-label="@instrument.Label gauge: @instrument.Value out of 100. Open trainer explanation"><div class="d3-gauge-heading"><h3>@instrument.Label</h3><p class="d3-measure-description">@instrument.Description</p></div><div class="d3-dial" data-dial="@instrument.Key"></div><span class="d3-status d3-@band">@(!instrument.Value.HasValue ? "Awaiting completed evidence" : instrument.Value >= 80 ? "On track" : instrument.Value >= 60 ? "Build momentum" : "Reset your course")</span><span class="d3-gauge-caption">Trainer details ↗</span></button>
        }
        </div>
        @if (cockpit.BodyComposition is not null) { @await Html.PartialAsync("_RecompBodyCompositionTrends", cockpit.BodyComposition) }
        <div class="d3-row-heading d3-daily-heading"><h2>Daily Nutrition</h2><span>@Model.ActionDate.ToString("ddd, MMM d")</span></div>
        <div class="d3-macro-grid">@foreach (var band in plan.Bands) {
            <button type="button" class="d3-instrument d3-macro d3-gauge-button" style="--macro:@band.Color" data-open-coach="@band.Key" aria-haspopup="dialog" aria-label="@band.Name gauge. Open trainer explanation"><h3><span class="d3-macro-dot" aria-hidden="true"></span>@band.Name</h3><div class="d3-dial" data-dial="@band.Key"></div><span class="d3-gauge-caption">@band.Target.ToString("0") g target · @band.Low.ToString("0")–@band.High.ToString("0") green ↗</span></button>
        }</div>
        <button type="button" class="d3-energy d3-gauge-button" data-open-coach="energy" aria-haspopup="dialog" aria-label="Calories compared with plan. Open trainer explanation"><span class="d3-energy-label"><span>Calories · Daily plan</span><strong>@(plan.EnergyEaten?.ToString("0") ?? "—") / @plan.EnergyTarget.ToString("0") kcal · Predicted @(plan.PredictedEnergy?.ToString("0") ?? "—") ↗</strong></span><span class="d3-energy-track" role="img" aria-label="Combined calories compared with the daily plan"><span class="d3-energy-low"></span><span class="d3-energy-good"></span><span class="d3-energy-high"></span><span class="d3-energy-needle" data-energy-needle hidden></span><span class="d3-energy-predicted" data-energy-predicted hidden></span></span></button>
    </section>
    <div class="d3-quick-actions"><span><b>@(historical ? "Selected day:" : "Today:")</b> @Model.PlannedWorkout</span><a class="button secondary" asp-controller="DetailedWorkout" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Open workout</a><a class="button" asp-controller="Nutrition" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Log food</a></div>
    @if (cockpit.HistoryNotice is not null) { <p class="d3-notice" role="status">@cockpit.HistoryNotice</p> }
    @if (cockpit.StorageNotice is not null) { <p class="d3-notice" role="alert">@cockpit.StorageNotice</p> }
    <section class="d2-panel d3-training-section" aria-labelledby="d3-training-title"><p class="d3-eyebrow">@(historical ? "SAVED DAY" : "TODAY") · @Model.ActionDate.ToString("dddd, MMM d")</p><h2 id="d3-training-title">@(historical ? "Your training that day." : "Make today count.")</h2>
        <div class="d3-training-grid">
            <article class="d3-workout-card d3-planned-card"><div class="d3-card-label"><h3>Planned</h3><span class="d3-chip">Your mission</span></div><h4>@Model.PlannedWorkout</h4><p>@Model.WorkoutFocus</p><div class="d3-workout-metrics"><strong>@Model.WorkoutDurationMin.ToString("0") <small>min</small></strong><span>@Model.WorkoutEffort</span></div><details><summary>Session details</summary><p>@Model.WorkoutDescription</p></details><a class="button" asp-controller="DetailedWorkout" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Open planned workout ↗</a></article>
            <article class="d3-workout-card d3-actual-card"><div class="d3-card-label"><h3>Actual</h3><span class="d3-chip">@(Model.ActualWorkoutDurationMin.HasValue ? "Completed" : "Not recorded yet")</span></div>
                @if (Model.ActualWorkoutDurationMin.HasValue) { <h4>@Model.WorkoutActual</h4><div class="d3-workout-metrics"><strong>@Model.ActualWorkoutDurationMin.Value.ToString("0") <small>min</small></strong><span>RPE @(Model.ActualWorkoutRpe?.ToString("0.#") ?? "not entered")</span></div> }
                else { <h4>Your next win starts here.</h4><p>Complete and record today's session to see your actual training.</p> }
                <a class="button secondary" asp-controller="DailyEntry" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Review actual training ↗</a>
            </article>
        </div>
        @if (Model.ScheduleChangeRecommended && historical) { <div class="d2-next"><h3>Suggested adjustment: @Model.RecommendedWorkout</h3><p>@Model.WorkoutRecommendationRationale</p>@{ var recommended = WebRecomp.Web.Services.WorkoutIntelligence.SystemWorkoutRecipeCatalog.GetDefaultPresentationForEngine(Model.RecompRecommendation?.RecommendedWorkoutTypeCode); }
            @if (recommended is not null) { <a class="button secondary" asp-controller="DetailedWorkout" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")" asp-route-mode="system" asp-route-systemCode="@recommended.SystemCode">Open recommended workout ↗</a> }
            @if (!historical) { @await Component.InvokeAsync("DashboardPlanDecision", new { date = Model.ActionDate, originalWorkout = Model.PlannedWorkout, recommendedWorkout = Model.RecommendedWorkout, originalCalories = Model.Calories, originalProteinG = Model.ProteinG, originalCarbsG = Model.CarbsG, originalFatG = Model.FatG, showDecision = true }) }</div> }
    </section>
    @await Component.InvokeAsync("WorkoutRecommendations", new { date = Model.ActionDate })
    <section class="d2-panel d3-next-section" aria-labelledby="d3-next-title"><p class="d3-eyebrow">LOOK AHEAD · NEXT TWO DAYS</p><h2 id="d3-next-title">Your next moves.</h2><div class="d3-training-grid">
        @foreach (var upcoming in cockpit.UpcomingWorkouts) {
            <article class="d3-workout-card d3-upcoming-card d3-load-@upcoming.Tone"><p class="d3-eyebrow">@(upcoming.Date == Model.ActionDate.AddDays(1) ? "Tomorrow" : "Coming next")</p><h3>@upcoming.Date.ToString("dddd, MMM d")</h3><h4>@upcoming.Name</h4>
                @if (upcoming.Planned) {
                    <div class="d3-workout-metrics">@if (upcoming.Minutes.HasValue && upcoming.Minutes > 0) { <strong>@upcoming.Minutes.Value.ToString("0") <small>min</small></strong> } @if (upcoming.Rpe.HasValue) { <span>RPE @upcoming.Rpe.Value.ToString("0.#")</span> }</div>
                    <details><summary>Workout focus</summary><p>@upcoming.Description</p></details>
                    @if (upcoming.SampleCode is not null) { <a class="button secondary" asp-controller="DetailedWorkout" asp-action="Index" asp-route-mode="system" asp-route-systemCode="@upcoming.SampleCode" asp-route-date="@upcoming.Date.ToString("yyyy-MM-dd")" asp-route-returnContext="schedule">@(upcoming.Tone == "recovery" && upcoming.SampleCode == "REST" ? "View recovery guide ↗" : "View sample workout ↗")</a> }
                    else { <a class="button secondary" asp-controller="DetailedWorkout" asp-action="Index" asp-route-date="@upcoming.Date.ToString("yyyy-MM-dd")">Explore workout type ↗</a> }
                } else { <p>@upcoming.Description</p><a class="button secondary" asp-controller="Schedule" asp-action="Index" asp-route-weekStart="@WebRecomp.Web.Services.PlanningWeek.Start(upcoming.Date).ToString("yyyy-MM-dd")">Plan this day ↗</a> }
            </article>
        }
    </div></section>

    <section class="d2-panel d3-coaches-section" aria-labelledby="d2-coach"><p class="d3-eyebrow">COACHES CORNER · KEEP BUILDING</p><div class="d2-coach"><div class="d2-portrait">@await Html.PartialAsync("_CoachPhoto", (coachImage, coach.Name))</div><div><h2 id="d2-coach">@coach.Name's corner</h2><h3>@Model.CoachTitle</h3><p>@CoachVoice.Speak(coach, Model.CoachRecommendation)</p><p>@plan.Advice</p><details><summary>Why today's advice?</summary><p>@CoachVoice.Speak(coach, Model.CoachWhy)</p><p>Energy @(Model.EnergyScore?.ToString() ?? "not entered") / 10 · Soreness @(Model.SorenessScore?.ToString() ?? "not entered") / 10 · Sleep @(Model.SleepHours?.ToString("0.#") ?? "not entered") hours</p></details></div></div>
        <div class="d2-lesson" aria-live="polite"><p class="d2-eyebrow">RECOMP STRATEGY · <span id="d2-lesson-count">1 of 6</span></p><h3 id="d2-lesson-title">Protein protects the training investment</h3><p id="d2-lesson-body">Resistance training provides a reason to retain and build muscle; protein supplies material for that response. In Mettler's two-week restriction experiment, athletes eating 1.04 g/lb lost less lean mass than those eating 0.45 g/lb. That supports protecting protein while reducing food, but does not establish your exact optimum or mean unlimited protein is useful. Reach your personal target, then consider the other demands on today's food allocation.</p><p id="d2-lesson-limit" class="d2-muted">20 young trained athletes; short study; lean mass is not exclusively muscle.</p><a id="d2-lesson-source" href="https://pubmed.ncbi.nlm.nih.gov/19927027/" target="_blank" rel="noopener">Read the original experiment</a><button type="button" id="d2-next-lesson" class="button secondary">Next recomp strategy →</button></div>
    </section>
    @await Html.PartialAsync("~/Views/Dashboard/_Dashboard3Pattern.cshtml", Model)

    <dialog class="d3-coach-dialog" data-coach-dialog data-coach-name="@coach.Name" aria-labelledby="d3-coach-title"><div class="d3-dialog-heading"><h2 id="d3-coach-title">@coach.Name explains your Recomp score</h2><button type="button" class="button secondary" data-close-coach aria-label="Close coach briefing">Close</button></div>
        <div class="d3-dialog-coach"><div class="d3-dialog-photo">@await Html.PartialAsync("_CoachPhoto", (coachImage, coach.Name))</div><div><p class="d3-eyebrow">YOUR TRAINER · @coach.Name</p><strong data-coach-summary-output></strong><p data-coach-intro-output></p><p class="d3-encourage">One useful next step builds momentum.</p></div></div>
        <section data-coach-panel="score" data-coach-title="Recomp score" data-coach-summary="@cockpit.Score.Score / 100 · @cockpit.Score.Status" data-coach-intro="@cockpit.NextAction" hidden>
            <p>Recomp combines nutrition, glycogen work and resistance, mobility, recovery, and your flexible-food allowance. Weight loss and muscle gain are reviewed separately.</p>
            <p>@(cockpit.Change.HasValue ? cockpit.Change == 0 ? "Steady since your last check." : $"{cockpit.Change:+0;-0} points since your last check." : "First check with this score version.") @cockpit.Score.KnownNutritionDays / @cockpit.Score.CompletedNutritionDays completed days have known macros.@(cockpit.RollingScore && cockpit.Score.CompletedNutritionDays < 7 ? $" Building baseline: {cockpit.Score.CompletedNutritionDays} of 7 completed days available." : "") Today's unfinished nutrition and unknown categories are excluded.</p>
            @if (cockpit.DataNotice is not null) { <p class="d3-notice">@cockpit.DataNotice</p> }
            <div class="d3-history" aria-label="Recorded score history">@foreach (var point in cockpit.History) { <span><small>@point.Date.ToString("ddd")</small><b>@point.Score</b>@if (point.Version != RecompScoreResult.Version) { <small>Earlier rubric</small> }</span> }</div>
<div class="d3-components">@foreach (var part in cockpit.Score.Components) { <article><div><h3>@part.Label</h3><strong>@part.Earned.ToString("0.#") / @part.Weight.ToString("0") points</strong></div><p>@part.Explanation</p></article> }</div><details><summary>Daily evidence behind your score</summary><div class="d2-table-wrap"><table><thead><tr><th>Day</th><th>Protein</th><th>Carbs</th><th>Fat</th><th>Flexible items</th><th>Target source</th></tr></thead><tbody>@foreach (var entry in cockpit.Days.Where(x => x.Date <= Model.ActionDate)) { <tr><th>@entry.Date.ToString("ddd")</th><td>@(entry.Protein?.ToString("0") ?? "?") / @entry.ProteinTarget.ToString("0") g</td><td>@(entry.Carbs?.ToString("0") ?? "?") / @entry.CarbsTarget.ToString("0") g</td><td>@(entry.Fat?.ToString("0") ?? "?") / @entry.FatTarget.ToString("0") g</td><td>@(entry.FlexibleItems?.ToString() ?? "?")</td><td>@entry.TargetSource</td></tr> }</tbody></table></div></details>        @if (!historical) {
        <details class="d3-flex-entry"><summary>Record or correct daily cheat / flexible items</summary><p>Treat portions are detected from food names, protein, carbs, fat, and sugar when available. Review the count: recipes split into ingredients, missing sugar, or ambiguous portions may need correction. Your saved count overrides detection. Enter 0 to confirm none.</p><form action="/CommandCenter/FlexibleItems" method="post" class="d3-flex-form">@Html.AntiForgeryToken()<label for="d3-flex-date">Day</label><select id="d3-flex-date" name="date">@foreach (var entry in cockpit.EditableDays.Where(x => x.Date <= Model.ActionDate)) { <option value="@entry.Date.ToString("yyyy-MM-dd")" selected="@(entry.Date == Model.ActionDate)">@entry.Date.ToString("ddd, MMM d") · @(entry.FlexibleItems?.ToString() ?? "unconfirmed")</option> }</select><label for="d3-flex-count">Items that day</label><input id="d3-flex-count" name="count" type="number" min="0" max="50" required value="@cockpit.TodayFlexibleItems" /><button type="submit" class="button">Save daily count</button></form><p class="d3-sub">Across the last seven completed days: first 2 portions free; portions 3–4 each receive half penalty; every additional portion receives full penalty. Each full treat penalty costs 1 point from the 5-point flexibility component. Macro penalties are separate.</p></details>
        }
    <details class="d3-method"><summary>How your Recomp Score works</summary><p>Only completed evidence counts. Future workouts, today's unfinished nutrition, unknown macros, and unconfirmed flexibility are excluded from both earned points and the denominator. No completed evidence means no score, shown as a dash.</p><p>Each macro has one central target. Protein green: 95–115%; below or above is red, with no yellow band. Carbs and fat green: 95–105%; yellow: 85% to below 95%; red: below 85% or above 105%. Green has no penalty, yellow half, red full. Upper bands are allowances, not instructions to eat more.</p><p>The gauges use the last seven completed days and do not reset on Monday. Today joins after the day ends. New programs use the available completed days. Weights: protein 25, carbohydrate 20, fat 10, glycogen work plus resistance 25, cardio/mobility 8, recovery/Zone 2 7, flexibility 5. Active weights are normalized to 100. Non-rest days with no workout or glycogen use below 10% of prescription receive a full daily penalty; other below-prescription workouts receive half. Each missing prescribed workout category day adds half a daily penalty. Scheduled future work earns no points. Earlier score history keeps its original rubric. These product weights measure adherence, not a validated biological outcome.</p></details>

            <p class="d3-sub">High adherence with disappointing results is a reason to review inputs and the prescription. <a href="/Progress">Review your results →</a></p>
        </section>
        <section data-coach-panel="nutrition" data-coach-title="nutrition" data-coach-summary="@cockpit.Score.NutritionScore / 100 · Rolling macro adherence" data-coach-intro="@plan.Advice" hidden>
            <p>Protein, training-day carbohydrate, and fat balance combine into this gauge. It uses the same daily target bands as your plan. Each green day keeps full credit, yellow keeps half, and red loses that day's credit. Today's unfinished meals and unknown categories are excluded.</p><p>@cockpit.Score.KnownNutritionDays / @cockpit.Score.CompletedNutritionDays completed days have known macros.@(cockpit.RollingScore && cockpit.Score.CompletedNutritionDays < 7 ? $" Building baseline: {cockpit.Score.CompletedNutritionDays} of 7 completed days available." : "") Unknown intake is excluded, not treated as perfect or zero.</p>
            <div class="d3-components">@foreach (var part in cockpit.Score.Components.Take(3)) { <article><h3>@part.Label · @part.Earned.ToString("0.#") / @part.Weight points</h3><p>@part.Explanation</p></article> }</div>
        @if (!historical) {
        <details class="d3-food-next"><summary>Plan the rest of today</summary><p>@plan.Advice</p><form method="get" action="/CommandCenter" class="d2-form"><input type="hidden" name="date" value="@Model.ActionDate.ToString("yyyy-MM-dd")" /><label for="d3-occasions">Eating occasions remaining</label><input id="d3-occasions" name="occasions" type="number" min="1" max="4" value="@plan.Occasions" /><button type="submit" class="button secondary">Refresh meal plan</button></form>
            @if (plan.Suggestions.Count > 0) { <div class="d2-meal-plan">@foreach (var meal in plan.Suggestions) { <article><h4>@meal.Label</h4><strong>@meal.Protein.ToString("0") g protein</strong><p>@meal.Carbs.ToString("0") g carbs · @meal.Fat.ToString("0") g fat</p></article> }</div> }
            <p class="d3-sub">@plan.SourceNote @ViewData["MealLogNotice"]</p>
        </details>
        }

        </section>
        <section data-coach-panel="workout" data-coach-title="workout plan" data-coach-summary="@cockpit.Score.WorkoutScore / 100 · Glycogen work, mobility & recovery" data-coach-intro="@cockpit.NextAction" hidden>
            <p>Follow the planned workload while protecting mobility and recovery. Modeled glycogen burn contributes to the work score; it is an estimate, not a direct measurement. Resistance completion must also stay on course, so extra cardio cannot replace missed strength sessions.</p>
            @if (cockpit.Glycogen is not null) { <div class="d3-work-totals"><span><b>@cockpit.Glycogen.CompletedG.ToString("0") g</b> modeled work completed</span><span><b>@cockpit.Glycogen.TargetG.ToString("0") g</b> planned work in this period</span><span><b>@cockpit.Glycogen.RemainingPlannedG.ToString("0") g</b> future credit (excluded)</span></div> }
            <div class="d3-components">@foreach (var gauge in cockpit.Training) { <article><h3>@gauge.Label · @gauge.Completed / @gauge.Target sessions</h3><p>@gauge.Status · @gauge.RemainingPlanned scheduled opportunities left.</p></article> }</div><p>Rest counts after an explicit completion, or a check-in on a finished planned rest day without hard training. Extra work earns no bonus above the plan.</p><a class="button" href="/Schedule">Review weekly plan</a>
        </section>
        @foreach (var band in plan.Bands) {
            <section data-coach-panel="@band.Key" data-coach-title="@band.Name.ToLower()" data-coach-summary="@(band.Eaten?.ToString("0") ?? "Not logged")@(band.Eaten.HasValue ? " g eaten" : "") · Target @band.Low.ToString("0")–@band.High.ToString("0") g" data-coach-intro="@(band.Eaten.HasValue ? band.Eaten > band.High ? "You are over today's range. Review the combined intake, then return to your next planned day." : band.Remaining > 0 ? $"About {band.Remaining:0} g brings you into today's range. Plan your remaining meals." : "You have reached today's range. Keep following the rest of your plan." : "Enter your intake to see where you stand. Missing entries are not assumed to be zero food eaten.")" hidden>
                <p>@(band.Key == "protein" ? "Protein supports the training and recovery in your plan. Meet the prescribed range across your meals." : band.Key == "carbs" ? "Carbohydrate follows today's workload and recovery needs. Follow this day's target rather than chasing extra burn." : "Fat balance belongs alongside protein and carbohydrate. Stay within today's prescribed range.")</p><p>Yellow means building toward the target, green means within range, and bright red means over. Today's nutrition joins the rolling score once the day is complete. Protein has a wider green range; calories still include every gram eaten.</p><p>@plan.Advice</p><a class="button" asp-controller="Nutrition" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Log food</a>
            </section>
        }
        <section data-coach-panel="energy" data-coach-title="calorie plan" data-coach-summary="@(plan.EnergyEaten?.ToString("0") ?? "Not logged") / @plan.EnergyTarget.ToString("0") kcal" data-coach-intro="Your macro plan drives this supporting energy bar." hidden><p>Maintenance estimate @Model.Engine30MaintenanceKcal.ToString("0") kcal. Today's central plan is @plan.EnergyTarget.ToString("0") kcal. All macro intake contributes to the total.</p><p>The green display band is ±5% of the central plan, a display tolerance rather than a biological threshold. Meal suggestions use the central target. Yellow means building toward plan; red means over the display band.</p><p>@plan.PredictionNotice</p><p>@Model.EnergyCarryoverSummary</p></section>
    </dialog>
    }
</main>
@if (cockpit is not null)
{
<script type="application/json" id="d3-data">@Html.Raw(JsonSerializer.Serialize(new { cockpit.Score, cockpit.Training, plan.Bands, plan.EnergyEaten, plan.EnergyTarget, plan.PredictedEnergy }))</script>
<script src="~/js/dashboard3.js" asp-append-version="true" defer></script>
