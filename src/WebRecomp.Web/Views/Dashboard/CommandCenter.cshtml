@using WebRecomp.Web.Services.Dashboard2
@using WebRecomp.Web.Services.Dashboard3
@using WebRecomp.Web.Services.Learning
@using System.Text.Json
@model DashboardViewModel
@{
    ViewData["Title"] = "Command Center";
    ViewData["BodyClass"] = "command-center-page";
    var plan = (MacroDayPlan)ViewData["MacroDayPlan"]!;
    var cockpit = ViewData["RecompCockpit"] as RecompCockpit;
    var coach = CoachCatalog.Resolve(Model.PreferredCoachCode);
    var coachImage = coach.Code == "MARISOL" ? "/images/coach/marisol-coach-avatar.webp" : CoachCatalog.ResolveImage(coach, 1);
    var analysis = Model.Engine30Analysis;
    var today = ViewData["DashboardToday"] is DateOnly current ? current : Model.ActionDate;
    var start = ViewData["DashboardStart"] is DateOnly first ? first : Model.ActionDate;
    var historical = Model.ActionDate < today;
}
<link rel="stylesheet" href="~/css/dashboard2.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/dashboard3.css" asp-append-version="true" />
<main class="d3 d2" data-dashboard3 data-coach-code="@coach.Code">
    <header class="d3-heading d3-team-header">
        <button type="button" class="d3-team-photo d3-team-open" data-open-team aria-haspopup="dialog" aria-label="Meet your Recomp coaches"><img src="~/images/coach/recomp-trainer-team.webp" asp-append-version="true" alt="All eight Recomp trainers together in the gym: Grant, Owen, Cassie, Marcus, Marisol, Aisha, Lucía and Nina" width="1536" height="512" fetchpriority="high" /><span>Meet your coaches ↗</span></button>
        <div class="d3-date-panel"><div class="d3-title-block"><p class="d3-eyebrow">YOUR RECOMP TEAM</p><h1>Command Center</h1><p>Week @Model.ProgramWeek · <time datetime="@Model.ActionDate.ToString("yyyy-MM-dd")">@Model.ActionDate.ToString("ddd, MMM d")</time> · @(historical ? "Saved day" : "Today")</p></div>
            <div class="d3-date-controls">
            <form action="/CommandCenter" method="get" class="d3-date-form"><label for="d3-date">Choose a day</label><input id="d3-date" name="date" type="date" value="@Model.ActionDate.ToString("yyyy-MM-dd")" min="@start.ToString("yyyy-MM-dd")" max="@today.ToString("yyyy-MM-dd")" required /><button class="button" type="submit">View day</button></form>
            <nav class="d3-date-nav" aria-label="Browse dashboard days">
                @if (Model.ActionDate > start) { <a href="/CommandCenter?date=@Model.ActionDate.AddDays(-1).ToString("yyyy-MM-dd")" aria-label="Previous day">← Previous</a> }
                @if (historical) { <a href="/CommandCenter?date=@Model.ActionDate.AddDays(1).ToString("yyyy-MM-dd")" aria-label="Next day">Next →</a><a href="/CommandCenter">Today</a> }
            </nav>
            </div>
        </div>
    </header>
    <dialog class="d3-team-dialog" data-team-dialog aria-labelledby="d3-team-title">
        <div class="d3-team-dialog-head"><h2 id="d3-team-title">Meet your Recomp coaches</h2><button type="button" class="button" data-close-team aria-label="Close coach gallery">Close ×</button></div>
        <img class="d3-team-large" src="~/images/coach/recomp-trainer-team.webp" asp-append-version="true" alt="The eight Recomp coaches together" />
        <p>See a coach you like? <a asp-controller="Profile" asp-action="Settings" asp-fragment="your-coach">Change your coach in Settings</a>. Your choice follows you through workouts, nutrition, and learning.</p>
        <div class="d3-coach-roster">
        @foreach (var trainer in CoachCatalog.All) {
            <article>@await Html.PartialAsync("_CoachPhoto", (trainer.GalleryImages[0]!, trainer.Name))<div><h3>@trainer.Name</h3><p><strong>@trainer.Style</strong></p><p>@trainer.Tagline</p><p class="d3-voice-sample">@CoachVoice.Speak(trainer, "Protect your muscle, train with purpose, and choose food that supports the work.")</p></div></article>
        }
        </div>
    </dialog>
    @if (ViewData["AccountabilityCanApprove"] is true && ViewData["AccountabilityClientId"] is Guid accountabilityClientId)
    { @await Html.PartialAsync("_AccountabilityPreview", new AccountabilityPreviewViewModel(accountabilityClientId, Model.ClientName, CanApprove: ViewData["AccountabilityCanApprove"] is true)) }
    @if (cockpit is null || Model.NeedsCurrentWeight)
    {
        <section class="d2-panel"><h2>Your personal plan needs a current weight</h2><a class="button" href="/DailyEntry">Open Daily Entry</a></section>
    }
    else
    {
    <section class="d3-hero d3-cockpit" aria-label="Recomp gauge grid">
        <div class="d3-row-heading"><h2>@(cockpit.RollingScore ? "Rolling seven-day review" : "Saved calendar week")</h2><span>Nutrition: @cockpit.WeekStart.ToString("MMM d")–@cockpit.ScoreEnd.ToString("MMM d")</span></div>
        <div class="d3-overview-grid">
        @foreach (var instrument in new[] { (Key: "score", Label: "Recomp Plan Score", Description: "Overall execution", Value: cockpit.Score.DisplayScore), (Key: "nutrition", Label: "Nutrition", Description: "Completed evidence", Value: cockpit.Score.NutritionScore), (Key: "workout", Label: "Workout", Description: "7-day strength, cardio & rest", Value: cockpit.Score.WorkoutScore) })
        {
            var review = instrument.Key == "workout" ? cockpit.Score.WorkoutReview : null;
            var band = !instrument.Value.HasValue ? "gray" : review is not null ? review.Deductions == 0 ? "green" : review.Deductions <= 15 ? "yellow" : "red" : instrument.Value >= 80 ? "green" : instrument.Value >= 60 ? "yellow" : "red";
            var missing = review?.Requirements.Where(x => !x.Met).ToArray();
            var status = review is not null ? !review.FullWindow ? "Building baseline" : missing!.Length == 0 ? "All covered" : missing.Length == 1 ? $"Missing {(missing[0].Key.StartsWith("cardio") ? "cardio" : missing[0].Key == "rest" ? "rest" : missing[0].Key)}" : $"Missing {missing.Length} items"
                : !instrument.Value.HasValue ? "Awaiting completed evidence" : instrument.Value >= 80 ? "On track" : instrument.Value >= 60 ? "Build momentum" : "Review the plan";
            <button type="button" class="d3-instrument d3-gauge-button" data-open-coach="@instrument.Key" aria-haspopup="dialog" aria-label="@instrument.Label gauge: @instrument.Value out of 100. Open trainer explanation"><div class="d3-gauge-heading"><h3>@instrument.Label</h3><p class="d3-measure-description">@instrument.Description</p></div><div class="d3-dial" data-dial="@instrument.Key"></div><span class="d3-status d3-@band">@status</span><span class="d3-gauge-caption">Trainer details ↗</span></button>
        }
        </div>
        @if (cockpit.BodyComposition is not null) { @await Html.PartialAsync("_RecompBodyCompositionTrends", cockpit.BodyComposition) }
        @if (cockpit.WeeklyTrend is not null) { @await Html.PartialAsync("_RecompWeeklyTrend", cockpit.WeeklyTrend) }
        @if(!string.IsNullOrWhiteSpace(Model.CoachPrescriptionNotice)){<p class="app-message">@Model.CoachPrescriptionNotice</p>}
        <div class="d3-row-heading d3-daily-heading"><h2>Daily Nutrition</h2><span>@Model.ActionDate.ToString("ddd, MMM d")</span></div>
        <div class="d3-macro-grid">@foreach (var band in plan.Bands) {
            <button type="button" class="d3-instrument d3-macro d3-gauge-button" style="--macro:@band.Color" data-open-coach="@band.Key" aria-haspopup="dialog" aria-label="@band.Name gauge. Open trainer explanation"><h3><span class="d3-macro-dot" aria-hidden="true"></span>@band.Name</h3><div class="d3-dial" data-dial="@band.Key"></div><span class="d3-gauge-caption">@band.Target.ToString("0") g @(band.Key == "protein" ? "upper end" : "reference") · @band.Low.ToString("0")–@band.High.ToString("0") green ↗</span></button>
        }</div>
        <button type="button" class="d3-energy d3-gauge-button" data-open-coach="energy" aria-haspopup="dialog" aria-label="Calories compared with plan. Open trainer explanation"><span class="d3-energy-label"><span>Calories · Daily plan</span><strong>@(plan.EnergyEaten?.ToString("0") ?? "—") / @plan.EnergyTarget.ToString("0") kcal · Predicted @(plan.PredictedEnergy?.ToString("0") ?? "—") ↗</strong></span><span class="d3-energy-track" role="img" aria-label="Combined calories compared with the daily plan"><span class="d3-energy-low"></span><span class="d3-energy-good"></span><span class="d3-energy-high"></span><span class="d3-energy-needle" data-energy-needle hidden></span><span class="d3-energy-predicted" data-energy-predicted hidden></span></span></button>
    </section>
    @if (Model.RollingGlycogen is { } fuel) {
        <section class="d2-panel" aria-labelledby="rolling-fuel-title"><h2 id="rolling-fuel-title">Rolling glycogen estimate</h2>
            <p><strong>Estimated available stores: @fuel.LowG.ToString("0")–@fuel.HighG.ToString("0") g</strong> · readiness reference @fuel.TargetLowG.ToString("0")–@fuel.TargetHighG.ToString("0") g</p>
            <p>@fuel.Confidence · @fuel.EvidenceDays / @fuel.WindowDays completed days have food and training/check-in evidence.</p>
            <p>Today's carb adjustment: @fuel.CarbAdjustmentG.ToString("+0;-0;0") g. Missing food stays unknown.</p>
            <details><summary>Four-day evidence and model limits</summary><p>@fuel.Method</p><table><thead><tr><th>Day</th><th>Carbs logged</th><th>Modeled exercise use</th></tr></thead><tbody>
            @foreach (var item in fuel.Days) { <tr><td>@item.Date.ToString("MMM d")</td><td>@(item.CarbsG?.ToString("0") ?? "Unknown") g</td><td>@item.DemandG.ToString("0") g</td></tr> }
            </tbody></table><p>Fuel readiness uses estimates. Coach overrides take priority.</p></details>
        </section>
    }
    <div class="d3-quick-actions"><a class="button secondary" asp-controller="Availability" asp-action="Index">Schedule</a><span><b>@(historical ? "Selected day:" : "Today:")</b> @Model.PlannedWorkout</span><a class="button secondary" asp-controller="DetailedWorkout" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Open workout</a><a class="button" asp-controller="Nutrition" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Log food</a></div>
    @if (cockpit.HistoryNotice is not null) { <p class="d3-notice" role="status">@cockpit.HistoryNotice</p> }
    @if (cockpit.StorageNotice is not null) { <p class="d3-notice" role="alert">@cockpit.StorageNotice</p> }
    <section class="d2-panel d3-training-section" aria-labelledby="d3-training-title"><p class="d3-eyebrow">@(historical ? "SAVED DAY" : "TODAY") · @Model.ActionDate.ToString("dddd, MMM d")</p><h2 id="d3-training-title">@(historical ? "Your training that day." : "Make today count.")</h2>
        <div class="d3-training-grid">
            <article class="d3-workout-card d3-planned-card"><div class="d3-card-label"><h3>Planned</h3><span class="d3-chip">Your mission</span></div><h4>@Model.PlannedWorkout</h4>@if(Model.CoachAdjustedWorkout){<p>Adjusted by your trainer</p>}<p>@Model.WorkoutFocus</p><div class="d3-workout-metrics"><strong>@Model.WorkoutDurationMin.ToString("0") <small>min</small></strong><span>@Model.WorkoutEffort</span></div>
                    <dl class="d3-workout-burn" aria-label="Estimated planned workout burn">
                        <div><dt>Calorie burn</dt><dd>@(Model.PlannedWorkoutCaloriesKcal.HasValue ? $"~{Model.PlannedWorkoutCaloriesKcal.Value:0} kcal" : "—")</dd></div>
                        <div><dt>Glycogen burn</dt><dd>@(Model.PlannedWorkoutGlycogenG.HasValue ? $"~{Model.PlannedWorkoutGlycogenG.Value:0} g" : "—")</dd></div>
                    </dl>
                    <p class="d3-workout-burn-note">Estimated from your planned session.</p><details><summary>Session details</summary><p>@Model.WorkoutDescription</p></details><a class="button" asp-controller="DetailedWorkout" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Open planned workout ↗</a></article>
            <article class="d3-workout-card d3-actual-card"><div class="d3-card-label"><h3>Actual</h3><span class="d3-chip">@(Model.ActualWorkoutDurationMin.HasValue ? "Completed" : "Not recorded yet")</span></div>
                @if (Model.ActualWorkoutDurationMin.HasValue) { <h4>@Model.WorkoutActual</h4><div class="d3-workout-metrics"><strong>@Model.ActualWorkoutDurationMin.Value.ToString("0") <small>min</small></strong><span>RPE @(Model.ActualWorkoutRpe?.ToString("0.#") ?? "not entered")</span></div>
                    <dl class="d3-workout-burn" aria-label="Estimated actual workout burn">
                        <div><dt>Calorie burn</dt><dd>@(Model.ActualWorkoutCaloriesKcal.HasValue ? $"~{Model.ActualWorkoutCaloriesKcal.Value:0} kcal" : "—")</dd></div>
                        <div><dt>Glycogen burn</dt><dd>@(Model.ActualWorkoutGlycogenG.HasValue ? $"~{Model.ActualWorkoutGlycogenG.Value:0} g" : "—")</dd></div>
                    </dl>
                    <p class="d3-workout-burn-note">Estimated from your completed training.</p> }
                else { <h4>Your next win starts here.</h4><p>Complete and record today's session to see your actual training.</p> }
                <a class="button secondary" asp-controller="DailyEntry" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Review actual training ↗</a>
            </article>
        </div>
        @if (Model.ScheduleChangeRecommended && historical) { <div class="d2-next"><h3>Suggested adjustment: @Model.RecommendedWorkout</h3><p>@Model.WorkoutRecommendationRationale</p>@{ var recommended = WebRecomp.Web.Services.WorkoutIntelligence.SystemWorkoutRecipeCatalog.GetDefaultPresentationForEngine(Model.RecompRecommendation?.RecommendedWorkoutTypeCode); }
            @if (recommended is not null) { <a class="button secondary" asp-controller="DetailedWorkout" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")" asp-route-mode="system" asp-route-systemCode="@recommended.SystemCode">Open recommended workout ↗</a> }
            @if (!historical) { @await Component.InvokeAsync("DashboardPlanDecision", new { date = Model.ActionDate, originalWorkout = Model.PlannedWorkout, recommendedWorkout = Model.RecommendedWorkout, originalCalories = Model.Calories, originalProteinG = Model.ProteinG, originalCarbsG = Model.CarbsG, originalFatG = Model.FatG, showDecision = true }) }</div> }
    </section>
    @await Component.InvokeAsync("WorkoutRecommendations", new { date = Model.ActionDate })
    <section class="d2-panel d3-next-section" aria-labelledby="d3-next-title"><p class="d3-eyebrow">LOOK AHEAD · NEXT TWO DAYS</p><h2 id="d3-next-title">Your next moves.</h2><div class="d3-training-grid">
        @foreach (var upcoming in cockpit.UpcomingWorkouts) {
            <article class="d3-workout-card d3-upcoming-card d3-load-@upcoming.Tone"><p class="d3-eyebrow">@(upcoming.Date == Model.ActionDate.AddDays(1) ? "Tomorrow" : "Coming next")</p><h3>@upcoming.Date.ToString("dddd, MMM d")</h3><h4>@upcoming.Name</h4>
                @if (upcoming.Planned) {
                    <div class="d3-workout-metrics">@if (upcoming.Minutes.HasValue && upcoming.Minutes > 0) { <strong>@upcoming.Minutes.Value.ToString("0") <small>min</small></strong> } @if (upcoming.Rpe.HasValue) { <span>RPE @upcoming.Rpe.Value.ToString("0.#")</span> }</div>
                    <details><summary>Workout focus</summary><p>@upcoming.Description</p></details>
                    @if (upcoming.SampleCode is not null) { <a class="button secondary" asp-controller="DetailedWorkout" asp-action="Index" asp-route-mode="system" asp-route-systemCode="@upcoming.SampleCode" asp-route-date="@upcoming.Date.ToString("yyyy-MM-dd")" asp-route-returnContext="schedule">@(upcoming.Tone == "recovery" && upcoming.SampleCode == "REST" ? "View recovery guide ↗" : "View sample workout ↗")</a> }
                    else { <a class="button secondary" asp-controller="DetailedWorkout" asp-action="Index" asp-route-date="@upcoming.Date.ToString("yyyy-MM-dd")">Explore workout type ↗</a> }
                } else { <p>@upcoming.Description</p><a class="button secondary" asp-controller="Schedule" asp-action="Index" asp-route-weekStart="@WebRecomp.Web.Services.PlanningWeek.Start(upcoming.Date).ToString("yyyy-MM-dd")">Plan this day ↗</a> }
            </article>
        }
    </div></section>

    <section class="d2-panel d3-coaches-section" aria-labelledby="d2-coach"><p class="d3-eyebrow">COACHES CORNER · KEEP BUILDING</p><div class="d2-coach"><div class="d2-portrait">@await Html.PartialAsync("_CoachPhoto", (coachImage, coach.Name))</div><div><h2 id="d2-coach">@coach.Name's corner</h2><h3>@Model.CoachTitle</h3><p>@CoachVoice.Speak(coach, Model.CoachRecommendation)</p><p>@plan.Advice</p><details><summary>Why today's advice?</summary><p>@CoachVoice.Speak(coach, Model.CoachWhy)</p><p>Energy @(Model.EnergyScore?.ToString() ?? "not entered") / 10 · Soreness @(Model.SorenessScore?.ToString() ?? "not entered") / 10 · Sleep @(Model.SleepHours?.ToString("0.#") ?? "not entered") hours</p></details></div></div>
        <div class="d2-lesson" aria-live="polite"><p class="d2-eyebrow">RECOMP STRATEGY · <span id="d2-lesson-count">1 of 6</span></p><h3 id="d2-lesson-title">Protein protects the training investment</h3><p id="d2-lesson-body">Resistance training and adequate protein help preserve lean mass during a calorie deficit.</p><p id="d2-lesson-limit" class="d2-muted">20 young trained athletes; short study; lean mass is not exclusively muscle.</p><a id="d2-lesson-source" href="https://pubmed.ncbi.nlm.nih.gov/19927027/" target="_blank" rel="noopener">Read the original experiment</a><button type="button" id="d2-next-lesson" class="button secondary">Next recomp strategy →</button></div>
    </section>
    @await Html.PartialAsync("~/Views/Dashboard/_Dashboard3Pattern.cshtml", Model)

    <dialog class="d3-coach-dialog" data-coach-dialog data-coach-name="@coach.Name" aria-labelledby="d3-coach-title"><div class="d3-dialog-heading"><h2 id="d3-coach-title">@coach.Name explains your Recomp score</h2><button type="button" class="button secondary" data-close-coach aria-label="Close coach briefing">Close</button></div>
        <div class="d3-dialog-coach"><div class="d3-dialog-photo">@await Html.PartialAsync("_CoachPhoto", (coachImage, coach.Name))</div><div><p class="d3-eyebrow">YOUR TRAINER · @coach.Name</p><strong data-coach-summary-output></strong><p data-coach-intro-output></p><p class="d3-encourage">One useful next step builds momentum.</p></div></div>
        <section data-coach-panel="score" data-coach-title="Recomp score" data-coach-summary="@cockpit.Score.Score / 100 · @cockpit.Score.Status" data-coach-intro="@cockpit.NextAction" hidden>
            @if(cockpit.Score.WorkoutReview is { } scoreReview) {
                @if(cockpit.Score.NutritionBaseScore.HasValue) {<div class="d3-score-equation"><strong>@cockpit.Score.NutritionBaseScore</strong><span>nutrition &amp; flexibility base</span><strong>−@scoreReview.Deductions</strong><span>workout deductions</span><strong>= @cockpit.Score.Score</strong></div>}
                else {<p>Nutrition is pending. The overall score uses workout results when available.</p>}
                <p>Each missing workout requirement deducts five points from your nutrition and flexibility score.</p>
            } else { <p>This saved score uses its original nutrition, workload and recovery rubric.</p> }
            <p>@(cockpit.Change.HasValue ? cockpit.Change == 0 ? "Steady since your last check." : $"{cockpit.Change:+0;-0} points since your last check." : "First check with this score version.") @cockpit.Score.KnownNutritionDays / @cockpit.Score.CompletedNutritionDays completed days have known macros.@(cockpit.RollingScore && cockpit.Score.CompletedNutritionDays < 7 ? $" Building baseline: {cockpit.Score.CompletedNutritionDays} of 7 completed days available." : "") Unfinished nutrition and unknown food entries are excluded.</p>
            @if (cockpit.DataNotice is not null) { <p class="d3-notice">@cockpit.DataNotice</p> }
            <div class="d3-history" aria-label="Recorded score history">@foreach (var point in cockpit.History) { <span><small>@point.Date.ToString("ddd")</small><b>@point.Score</b>@if (point.Version != RecompScoreResult.Version) { <small>Earlier rubric</small> }</span> }</div>
<div class="d3-components">@foreach (var item in cockpit.Score.Components.Select((part,index)=>(Part:part,Index:index))) { var part=item.Part; <article><div><h3>@part.Label</h3><strong>@(cockpit.Score.WorkoutReview is not null && part.Label is "Upper push" or "Upper pull" or "Legs" or "Cardio session 1" or "Cardio session 2" or "Rest / recovery day" ? !part.Included ? "Baseline pending" : part.Earned >= part.Weight ? "Covered · no deduction" : "−5 workout points" : $"{part.Earned:0.#} / {part.Weight:0} evidence weight")</strong></div><p>@part.Explanation</p></article> }</div><details><summary>Daily evidence behind your score</summary><div class="d2-table-wrap"><table><thead><tr><th>Day</th><th>Protein</th><th>Carbs</th><th>Fat</th><th>Flexible items</th><th>Target source</th></tr></thead><tbody>@foreach (var entry in cockpit.Days.Where(x => x.Date <= Model.ActionDate)) { <tr><th>@entry.Date.ToString("ddd")</th><td>@(entry.Protein?.ToString("0") ?? "?") / @entry.ProteinTarget.ToString("0") g</td><td>@(entry.Carbs?.ToString("0") ?? "?") / @entry.CarbsTarget.ToString("0") g</td><td>@(entry.Fat?.ToString("0") ?? "?") / @entry.FatTarget.ToString("0") g</td><td>@(entry.FlexibleItems?.ToString() ?? "?")</td><td>@entry.TargetSource</td></tr> }</tbody></table></div></details>        @if (!historical) {
        <details class="d3-flex-entry"><summary>Record or correct daily cheat / flexible items</summary><p>Review detected treats. Save the correct count, or enter 0 if you had none.</p><form action="/CommandCenter/FlexibleItems" method="post" class="d3-flex-form">@Html.AntiForgeryToken()<label for="d3-flex-date">Day</label><select id="d3-flex-date" name="date">@foreach (var entry in cockpit.EditableDays.Where(x => x.Date <= Model.ActionDate)) { <option value="@entry.Date.ToString("yyyy-MM-dd")" selected="@(entry.Date == Model.ActionDate)">@entry.Date.ToString("ddd, MMM d") · @(entry.FlexibleItems?.ToString() ?? "unconfirmed")</option> }</select><label for="d3-flex-count">Items that day</label><input id="d3-flex-count" name="count" type="number" min="0" max="50" required value="@cockpit.TodayFlexibleItems" /><button type="submit" class="button">Save daily count</button></form><p class="d3-sub">Weekly treat deductions: first two free, next two half a point each, then one point each.</p></details>
        }
    <details class="d3-method"><summary>How your Recomp Score works</summary><p>@(cockpit.Score.WorkoutReview is not null ? "Version 9" : "Saved rubric"): seven completed days. Protein 80–100%, fat 20–35% of energy, carbs within ±20%.</p><ul><li>Weekly targets: push, pull, legs, two cardio sessions, and one rest day.</li><li>Each missing target costs five points. Completed workouts count today.</li><li>Strength requires 60 working reps per group or a qualifying 20-minute session.</li><li>Cardio requires 20 minutes. Standard Orangetheory 2G/3G counts as cardio.</li><li>Warm-ups, unfinished workouts, and future plans earn zero credit.</li></ul></details>

            <p class="d3-sub">High adherence with disappointing results is a reason to review inputs and the prescription. <a href="/Progress">Review your results →</a></p>
        </section>
        <section data-coach-panel="nutrition" data-coach-title="nutrition" data-coach-summary="@cockpit.Score.NutritionScore / 100 · Rolling macro adherence" data-coach-intro="@plan.Advice" hidden>
            <p>The gauge uses protein range, average fat, and carb consistency across completed days with nutrition data.</p><p>@cockpit.Score.KnownNutritionDays / @cockpit.Score.CompletedNutritionDays completed days have known macros.@(cockpit.RollingScore && cockpit.Score.CompletedNutritionDays < 7 ? $" Building baseline: {cockpit.Score.CompletedNutritionDays} of 7 completed days available." : "") Unlogged days are excluded.</p>
            <div class="d3-components">@foreach (var part in cockpit.Score.Components.Take(3)) { <article><h3>@part.Label · @part.Earned.ToString("0.#") / @part.Weight points</h3><p>@part.Explanation</p></article> }</div>
            <div class="d3-components"><article><h3>Cheat meals / treats · @(cockpit.Score.FlexibleItems?.ToString() ?? "Not confirmed") portions</h3>
                <p>@(cockpit.Score.Components.First(x => x.Label == "Planned flexibility").Explanation)</p>
                <p>Treats affect your overall score. Nutrition measures macro consistency.</p>
                <details><summary>Daily cheat-meal counts</summary><div class="d2-table-wrap"><table><thead><tr><th>Day</th><th>Cheat / treat portions</th></tr></thead><tbody>@foreach (var entry in cockpit.Days.Where(x => x.Date < Model.ActionDate)) { <tr><th>@entry.Date.ToString("ddd, MMM d")</th><td>@(entry.FlexibleItems?.ToString() ?? "Unconfirmed")@if (cockpit.DetectedTreatFoods.TryGetValue(entry.Date, out var foods) && !string.IsNullOrWhiteSpace(foods)) { <span> — @foods</span> } else if (entry.FlexibleItems > 0) { <span> — Food names unavailable from the food log</span> }@if (cockpit.TreatCountOverrides.Contains(entry.Date)) { <small> (saved count)</small> }</td></tr> }</tbody></table></div><p class="d3-sub">Food names show detected treats. Saved counts take priority.</p></details>
                <p class="d3-sub">Correct counts under Recomp Plan Score → Trainer details.</p>
            </article></div>
        @if (!historical) {
        <details class="d3-food-next"><summary>Plan the rest of today</summary><p>@plan.Advice</p><form method="get" action="/CommandCenter" class="d2-form"><input type="hidden" name="date" value="@Model.ActionDate.ToString("yyyy-MM-dd")" /><label for="d3-occasions">Eating occasions remaining</label><input id="d3-occasions" name="occasions" type="number" min="1" max="4" value="@plan.Occasions" /><button type="submit" class="button secondary">Refresh meal plan</button></form>
            @if (plan.Suggestions.Count > 0) { <div class="d2-meal-plan">@foreach (var meal in plan.Suggestions) { <article><h4>@meal.Label</h4><strong>@meal.Protein.ToString("0") g protein</strong><p>@meal.Carbs.ToString("0") g carbs · @meal.Fat.ToString("0") g fat</p></article> }</div> }
            <p class="d3-sub">@plan.SourceNote @ViewData["MealLogNotice"]</p>
        </details>
        }

        </section>
        <section data-coach-panel="workout" data-coach-title="seven-day workout coverage" data-coach-summary="@cockpit.Score.WorkoutScore / 100 · Strength, cardio &amp; rest" data-coach-intro="@(cockpit.Score.WorkoutReview?.NextAction ?? cockpit.NextAction)" hidden>
        @if(cockpit.Score.WorkoutReview is { } workoutReview) {
            <p><strong>@workoutReview.Start.ToString("MMM d")–@workoutReview.End.ToString("MMM d")</strong> · Completed workouts count today. Each missing requirement costs five points.</p>
            <h3>What gets you back on track</h3>
            <div class="d3-requirement-list">@foreach(var requirement in workoutReview.Requirements) {
                <article class="@(requirement.Met ? "covered" : "missing")"><div><h4>@requirement.Label</h4><strong>@(requirement.Met ? "✓ Covered" : workoutReview.FullWindow ? "−5 points" : "Baseline pending")</strong></div><p>@requirement.Evidence</p><p>@requirement.NextAction</p></article>
            }</div>
            <ul><li>Count working reps only.</li><li>Strength 50 counts toward the muscle groups covered.</li><li>Standard 2G/3G and HIIT count as cardio.</li></ul>
            @if(workoutReview.UnmappedExercises > 0) {<p class="d3-notice">@workoutReview.UnmappedExercises exercises need a strength group before they can count.</p>}
            @if(!workoutReview.FullWindow) {<p class="d3-notice">Your first seven-day baseline is still building. Requirements are visible, but no workout deductions apply yet.</p>}
            <p>Spread sessions across the week. Record your rest day.</p>
        } else {
            <p>This saved workout score retains its original rubric.</p>
            <div class="d3-components">@foreach(var gauge in cockpit.Training) {<article><h3>@gauge.Label · @gauge.Completed / @gauge.Target</h3><p>@gauge.Status</p></article>}</div>
        }
            <a class="button" href="/DetailedWorkout">Record a workout</a> <a class="button secondary" href="/Schedule">Review weekly plan</a>
        </section>
        @foreach (var band in plan.Bands) {
            <section data-coach-panel="@band.Key" data-coach-title="@band.Name.ToLower()" data-coach-summary="@(band.Eaten?.ToString("0") ?? "Not logged")@(band.Eaten.HasValue ? " g eaten" : "") · Target @band.Low.ToString("0")–@band.High.ToString("0") g" data-coach-intro="@(band.Eaten.HasValue ? band.Eaten > band.High ? "You are over today's range. Review the combined intake, then return to your next planned day." : band.Remaining > 0 ? $"About {band.Remaining:0} g brings you into today's range. Plan your remaining meals." : "You have reached today's range. Keep following the rest of your plan." : "Enter your intake to see where you stand. Missing entries are not assumed to be zero food eaten.")" hidden>
                <p>@(band.Key == "protein" ? "Spread your protein target across meals." : band.Key == "carbs" ? "Use your recent fuel history and upcoming training to plan carbs." : "Balance fat intake with protein, carbs, and total calories.")</p><p>Today’s nutrition counts when the day closes. Carb scoring uses the rolling seven-day range.</p><p>@plan.Advice</p><a class="button" asp-controller="Nutrition" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Log food</a>
            </section>
        }
        <section data-coach-panel="energy" data-coach-title="calorie plan" data-coach-summary="@(plan.EnergyEaten?.ToString("0") ?? "Not logged") / @plan.EnergyTarget.ToString("0") kcal" data-coach-intro="Your macro plan drives this supporting energy bar." hidden><p>Maintenance @Model.Engine30MaintenanceKcal.ToString("0") kcal · Plan @plan.EnergyTarget.ToString("0") kcal.</p><p>Green is within 5% of target. Yellow is below. Red is above.</p><p>@plan.PredictionNotice</p><p>@Model.EnergyCarryoverSummary</p></section>
    </dialog>
    }
</main>
@if (cockpit is not null)
{
<script type="application/json" id="d3-data">@Html.Raw(JsonSerializer.Serialize(new { cockpit.Score, cockpit.Training, plan.Bands, plan.EnergyEaten, plan.EnergyTarget, plan.PredictedEnergy }))</script>
<script src="~/js/dashboard3.js" asp-append-version="true" defer></script>
}

<script type="application/json" id="d2-data">@Html.Raw(JsonSerializer.Serialize(new { plan.Bands, plan.Meals }))</script>
<script src="~/js/dashboard2.js" asp-append-version="true" defer></script>
