                    @if (!analysis.HasCurrentMorningScale)
                    {
                        <div class="dash-analysis-scale-prompt">
                            <span class="dash-analysis-dot gray"></span>
                            <div>
                                <strong class="dash-analysis-missing-scale-text">Please enter this morning's scale readings</strong>
                                <span>That measurement lets Recomp compare yesterday's workout and nutrition with the next-morning response. The Dashboard itself remains usable without it.</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="dash-analysis-scale-strip">
                            <div>
