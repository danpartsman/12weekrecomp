@model DashboardViewModel
<!-- V1006_GUIDED_SHELL -->
@await Html.PartialAsync("_GuidedDemoShell")
@{
    ViewData["Title"] = "Dashboard";
    var isGuidedDemo =
        User.FindFirst("recomp_demo")?.Value == "true"
        && User.FindFirst("recomp_demo_type")?.Value == "GUIDED";
}

@if (isGuidedDemo)
{
    <style>
        .guided-demo-banner,
        .guided-demo-callout {
            border: 2px solid #dc2626;
            border-left-width: 8px;
            border-radius: 10px;
            background: #ffe3e3;
            color: #7f1d1d;
            box-shadow: 0 4px 14px rgba(127, 29, 29, 0.14);
        }

        .guided-demo-banner {
            margin: 0 0 1.25rem 0;
            padding: 1rem 1.1rem;
        }

        .guided-demo-callout {
            margin-top: 1rem;
            padding: 0.9rem 1rem;
        }

        .guided-demo-callout strong,
        .guided-demo-banner strong {
            display: inline-block;
            margin-bottom: 0.45rem;
            padding: 0.18rem 0.5rem;
            border-radius: 999px;
            background: #dc2626;
            color: #ffffff;
            font-size: 0.76rem;
            letter-spacing: 0.045em;
            text-transform: uppercase;
        }

        .guided-demo-callout span,
        .guided-demo-banner span {
            display: block;
            line-height: 1.45;
        }
    </style>

    <aside class="guided-demo-banner" role="note" aria-label="Guided Demo explanation">
        <strong>Guided Demo: Red callouts</strong>
        <span>Red boxes explain the decisions that matter. They appear only in the Guided Demo.</span>
    </aside>
}

<style>
/* B2.35.32_DASHBOARD_BOLD_ENERGY */

.dash-planactual-panel {
    display:flex;
    flex-direction:column;
    min-width:0;
    position:relative;
    overflow:hidden;
    background:
        radial-gradient(circle at 20% 0%, rgba(37,99,235,.11), transparent 42%),
        linear-gradient(180deg, rgba(11,31,55,.97), rgba(9,25,45,.97));
    border-color:#24486d;
    box-shadow:
        0 18px 44px rgba(0,0,0,.24),
        inset 0 1px 0 rgba(255,255,255,.03);
}

.dash-planactual-panel.dash-workout {
    border-top:4px solid #168CFF;
}

.dash-planactual-panel.dash-nutrition {
    border-top:4px solid #24D96B;
}

.dash-planactual-panel > .dash-panel-label {
    margin-bottom:14px;
    font-size:.82rem;
    letter-spacing:.10em;
    color:#dbeafe;
}

.dash-planactual-panel > .dash-panel-label .dash-number {
    width:29px;
    height:29px;
    border-radius:8px;
    box-shadow:0 0 22px rgba(22,140,255,.34);
}

.dash-planactual-panel.dash-nutrition > .dash-panel-label .dash-number {
    box-shadow:0 0 22px rgba(36,217,107,.28);
}

.dash-pa-stack {
    display:grid;
    grid-template-rows:repeat(2,minmax(265px,1fr));
    gap:14px;
    flex:1 1 auto;
}

.dash-pa-card {
    display:flex;
    flex-direction:column;
    min-width:0;
    min-height:265px;
    position:relative;
    overflow:hidden;
    padding:18px;
    border:1px solid #294a6d;
    border-radius:14px;
    color:#f8fbff;
    background:
        linear-gradient(145deg, rgba(22,47,77,.98), rgba(13,33,57,.98));
    box-shadow:
        0 12px 30px rgba(0,0,0,.22),
        inset 0 1px 0 rgba(255,255,255,.05);
}

.dash-pa-card::after {
    content:"";
    position:absolute;
    inset:0;
    pointer-events:none;
    background:linear-gradient(115deg, rgba(255,255,255,.025), transparent 30%, transparent 70%, rgba(255,255,255,.018));
}

.dash-pa-planned {
    border-top:4px solid #168CFF;
    box-shadow:
        0 12px 30px rgba(0,0,0,.22),
        0 0 0 1px rgba(22,140,255,.07),
        0 0 28px rgba(22,140,255,.08);
}

.dash-pa-actual {
    border-top:4px solid #24D96B;
    box-shadow:
        0 12px 30px rgba(0,0,0,.22),
        0 0 0 1px rgba(36,217,107,.07),
        0 0 28px rgba(36,217,107,.07);
}

.dash-pa-head {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-bottom:14px;
    position:relative;
    z-index:1;
}

.dash-pa-label {
    font-size:.78rem;
    font-weight:950;
    letter-spacing:.13em;
    color:#ffffff;
}

.dash-pa-planned .dash-pa-label {
    color:#75bbff;
}

.dash-pa-actual .dash-pa-label {
    color:#68f0a2;
}

.dash-pa-badge {
    display:inline-flex;
    align-items:center;
    padding:5px 9px;
    border-radius:999px;
    font-size:.63rem;
    font-weight:950;
    letter-spacing:.055em;
    white-space:nowrap;
    backdrop-filter:blur(4px);
}

.dash-pa-badge.plan {
    color:#d9edff;
    background:rgba(22,140,255,.16);
    border:1px solid rgba(93,176,255,.58);
    box-shadow:0 0 18px rgba(22,140,255,.10);
}

.dash-pa-badge.actual {
    color:#d8ffe7;
    background:rgba(36,217,107,.13);
    border:1px solid rgba(91,239,151,.48);
    box-shadow:0 0 18px rgba(36,217,107,.08);
}

.dash-pa-badge.waiting {
    color:#c9d6e5;
    background:rgba(148,163,184,.10);
    border:1px solid rgba(148,163,184,.30);
}

.dash-pa-badge.review {
    color:#ffe6b0;
    background:rgba(245,158,11,.13);
    border:1px solid rgba(245,158,11,.48);
}

.dash-pa-title {
    margin:0!important;
    color:#ffffff!important;
    font-size:1.48rem!important;
    line-height:1.16;
    font-weight:900!important;
    letter-spacing:-.015em;
    position:relative;
    z-index:1;
}

.dash-pa-meta,
.dash-pa-card .dash-workout-meta {
    margin-top:8px;
    color:#d7e2ef!important;
    font-size:.88rem;
    font-weight:800;
    position:relative;
    z-index:1;
}

.dash-pa-card .dash-workout-meta span {
    color:#b9cbe0;
}

.dash-pa-burn {
    margin-top:15px;
    position:relative;
    z-index:1;
}

.dash-pa-card .dash-workout-burn-grid {
    gap:9px;
}

.dash-pa-card .dash-workout-burn-grid > div {
    padding:11px 10px;
    border:1px solid rgba(148,163,184,.16);
    border-radius:10px;
    background:rgba(5,18,33,.40);
}

.dash-pa-card .dash-workout-burn-grid strong {
    color:#ffffff!important;
    font-size:1.05rem;
}

.dash-pa-card .dash-workout-burn-grid span {
    color:#95aac2!important;
}

.dash-pa-recommendation {
    margin-top:auto;
    padding:12px 13px;
    border-radius:10px;
    background:
        linear-gradient(135deg, rgba(124,58,237,.20), rgba(37,99,235,.10));
    border:1px solid rgba(167,139,250,.34);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.025);
    position:relative;
    z-index:1;
}

.dash-pa-recommendation.review {
    background:
        linear-gradient(135deg, rgba(245,158,11,.18), rgba(180,83,9,.09));
    border-color:rgba(245,158,11,.38);
}

.dash-pa-recommendation strong,
.dash-pa-recommendation span,
.dash-pa-recommendation small {
    display:block;
}

.dash-pa-recommendation strong {
    color:#c4b5fd;
    font-size:.7rem;
    font-weight:950;
    text-transform:uppercase;
    letter-spacing:.075em;
}

.dash-pa-recommendation.review strong {
    color:#fbbf24;
}

.dash-pa-recommendation span {
    margin-top:4px;
    color:#ffffff;
    font-size:1rem;
    font-weight:900;
}

.dash-pa-recommendation small {
    margin-top:5px;
    color:#aebed0;
    line-height:1.35;
}

.dash-pa-empty {
    margin:auto 0;
    padding:21px 16px;
    border:1px dashed rgba(125,211,252,.34);
    border-radius:12px;
    background:
        linear-gradient(135deg, rgba(30,64,175,.12), rgba(15,23,42,.20));
    position:relative;
    z-index:1;
}

.dash-pa-actual .dash-pa-empty {
    border-color:rgba(74,222,128,.30);
    background:
        linear-gradient(135deg, rgba(22,163,74,.10), rgba(15,23,42,.20));
}

.dash-pa-empty strong,
.dash-pa-empty span {
    display:block;
}

.dash-pa-empty strong {
    color:#ffffff;
    font-size:1.03rem;
    font-weight:900;
}

.dash-pa-empty span {
    margin-top:7px;
    color:#aebfd1;
    font-size:.86rem;
    line-height:1.45;
}

.dash-pa-note {
    margin:auto 0 0;
    color:#98abc0;
    font-size:.79rem;
    line-height:1.4;
    position:relative;
    z-index:1;
}

.dash-pa-calories {
    display:flex;
    align-items:baseline;
    gap:8px;
    margin:3px 0 16px;
    position:relative;
    z-index:1;
}

.dash-pa-calories strong {
    color:#ffffff;
    font-size:2.15rem;
    line-height:1;
    font-weight:950;
    letter-spacing:-.03em;
    text-shadow:0 0 20px rgba(255,255,255,.04);
}

.dash-pa-planned .dash-pa-calories strong {
    color:#8ec8ff;
}

.dash-pa-actual .dash-pa-calories strong {
    color:#78f0a7;
}

.dash-pa-calories span {
    color:#aec0d4;
    font-size:.82rem;
    font-weight:800;
}

.dash-pa-macro-track {
    display:flex;
    width:100%;
    height:18px;
    overflow:hidden;
    border-radius:999px;
    background:#071523;
    border:1px solid #29455f;
    box-shadow:
        inset 0 2px 6px rgba(0,0,0,.45),
        0 0 18px rgba(22,140,255,.04);
    position:relative;
    z-index:1;
}

.dash-pa-macro-segment {
    display:block;
    height:100%;
    flex:0 0 auto;
}

.dash-pa-macro-segment.protein,
.dash-pa-dot.protein {
    background:#168CFF;
}

.dash-pa-macro-segment.carbs,
.dash-pa-dot.carbs {
    background:#FFD400;
}

.dash-pa-macro-segment.fat,
.dash-pa-dot.fat {
    background:#24D96B;
}

.dash-pa-macro-track.actual-track {
    background:#0a1724;
    border-color:#314b63;
}

.dash-pa-actual-fill {
    display:flex;
    height:100%;
    min-width:0;
    max-width:100%;
    overflow:hidden;
    border-radius:inherit;
    flex-grow:0!important;
    flex-shrink:0!important;
    box-shadow:0 0 14px rgba(36,217,107,.10);
}

.dash-pa-actual-fill.over-plan {
    box-shadow:
        inset 0 0 0 2px #FFD400,
        0 0 16px rgba(255,212,0,.18);
}

.dash-pa-progress-copy {
    display:flex;
    align-items:baseline;
    gap:6px;
    margin-top:8px;
    color:#9fb2c7;
    font-size:.76rem;
    position:relative;
    z-index:1;
}

.dash-pa-progress-copy strong {
    color:#ffffff;
    font-size:.95rem;
    font-weight:950;
}

.dash-pa-macro-legend {
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:9px;
    margin-top:15px;
    position:relative;
    z-index:1;
}

.dash-pa-macro-legend > div {
    display:grid;
    grid-template-columns:9px 1fr;
    align-items:center;
    column-gap:6px;
    min-width:0;
}

.dash-pa-macro-legend strong {
    grid-column:2;
    color:#ffffff;
    font-size:.9rem;
    font-weight:900;
}

.dash-pa-macro-legend span:not(.dash-pa-dot) {
    color:#9fb2c7;
    font-size:.71rem;
    font-weight:750;
}

.dash-pa-dot {
    width:9px;
    height:9px;
    border-radius:50%;
    box-shadow:0 0 9px currentColor;
}

.dash-pa-nutrition-foot {
    margin-top:auto;
    padding-top:14px;
    position:relative;
    z-index:1;
}

.dash-pa-nutrition-foot strong,
.dash-pa-nutrition-foot span {
    display:block;
}

.dash-pa-nutrition-foot strong {
    color:#68f0a2;
    font-size:.83rem;
    font-weight:950;
    letter-spacing:.02em;
}

.dash-pa-nutrition-foot span {
    margin-top:4px;
    color:#9fb2c7;
    font-size:.77rem;
    line-height:1.38;
}

/* Make the three main Dashboard columns feel intentional together. */
.dash-primary-grid > .dash-coach {
    background:
        radial-gradient(circle at 50% 0%, rgba(124,58,237,.10), transparent 44%),
        linear-gradient(180deg, rgba(11,31,55,.98), rgba(9,25,45,.98));
    border-color:#29486c;
    box-shadow:
        0 18px 44px rgba(0,0,0,.22),
        inset 0 1px 0 rgba(255,255,255,.03);
}

.dash-primary-grid > .dash-coach h2 {
    color:#ffffff;
    font-weight:900;
}

.dash-primary-grid > .dash-coach p {
    color:#d8e3ef;
}

@@media(max-width:900px) {
    .dash-pa-stack {
        grid-template-rows:auto;
    }

    .dash-pa-card {
        min-height:245px;
    }
}

@@media(max-width:560px) {
    .dash-pa-card {
        min-height:0;
        padding:15px;
    }

    .dash-pa-macro-legend {
        grid-template-columns:1fr;
    }

    .dash-pa-head {
        align-items:flex-start;
        flex-direction:column;
    }
}
</style>
@{
    var reminderWeight = ViewData["ReminderWeight"] is true;
    var reminderWorkout = ViewData["ReminderWorkout"] is true;
    var reminderNutrition = ViewData["ReminderNutrition"] is true;
}
@if (reminderWeight || reminderWorkout || reminderNutrition)
{
    <style>
        .first-week-guide{max-width:min(92vw,620px);border:1px solid #54c8ec;border-radius:18px;background:#0b2031;color:#edfaff;padding:1.4rem;box-shadow:0 24px 70px #0009}
        .first-week-guide::backdrop{background:#0009}
        .first-week-guide h2{margin:.2rem 0 .6rem}
        .first-week-guide p{line-height:1.5}
        .first-week-guide a{display:block;margin:.65rem 0;color:#8eeeff;font-weight:700}
        .first-week-guide button{margin-top:.7rem}
    </style>
    <dialog class="first-week-guide" id="first-week-guide" aria-labelledby="first-week-guide-title">
        <h2 id="first-week-guide-title">A quick guide to today's entries</h2>
        <p>You can enter your daily numbers in the Weight, Training and Nutrition sections of Daily Entry. For more precise records, use Workout logging and the Food Log.</p>
        @if (reminderWeight)
        {
            <a asp-controller="DailyEntry" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")" asp-fragment="body-recovery">Enter today's weight in Daily Entry →</a>
        }
        @if (reminderWorkout)
        {
            <a asp-controller="DailyEntry" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")" asp-fragment="training">Enter today's workout in Daily Entry →</a>
            <a asp-controller="DetailedWorkout" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Or log a detailed workout →</a>
        }
        @if (reminderNutrition)
        {
            <a asp-controller="DailyEntry" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")" asp-fragment="nutrition">Enter today's nutrition in Daily Entry →</a>
            <a asp-controller="Nutrition" asp-action="Index" asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Or log foods for more accurate totals →</a>
        }
        <button type="button" class="button primary" onclick="this.closest('dialog').close()">Got it</button>
    </dialog>
    <script>
        (() => {
            const dialog = document.getElementById('first-week-guide');
            const key = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["ReminderKey"]));
            try {
                if (!sessionStorage.getItem(key)) {
                    dialog.showModal();
                    sessionStorage.setItem(key, 'seen');
                }
            } catch (_) { dialog.showModal(); }
        })();
    </script>
}
<div class="recomp-dashboard">
    <header class="dash-title-row">
        <div>
            <div class="dash-kicker">TODAY</div>
            <h1>@Model.ActionDate.ToString("dddd, MMMM d")</h1>
            <p class="lede">Week @Model.ProgramWeek &bull; @Model.PlanCode</p>
        </div>
        <div class="dash-status @Model.TodayStatusClass">@Model.TodayStatusLabel</div>
    </header>

    @if (Model.NeedsCurrentWeight)
    {
        <section class="card dashboard-weight-needed" aria-labelledby="weight-needed-title">
            <div class="app-kicker">ONE QUICK STEP</div>
            <h2 id="weight-needed-title">Morning weight needed</h2>
            <p>Enter today's morning weight before Recomp can calculate today's workout, nutrition, recovery, and glycogen recommendations. Your Dashboard will appear as soon as today's weight is saved.</p>
            <div class="app-action-row">
                <a class="primary button"
                   asp-controller="Daily"
                   asp-action="Index"
                   asp-route-date="@Model.ActionDate.ToString("yyyy-MM-dd")">Enter morning weight</a>
            </div>
        </section>
    }
    else
    {
    <!-- V1006_GUIDED_MUSCLE_CALLOUT -->
    @await Html.PartialAsync(
        "_GuidedDemoCallout",
        new[]
        {
            "Why is 12 Week Recomp different?",
            "Regular dieting can reduce muscle along with fat. Recomp combines resistance training, high protein, and controlled calories to lose fat while protecting - and when possible building - lean muscle."
        })

@await Component.InvokeAsync("WorkoutRecommendations", new { date = Model.ActionDate })
<div class="dash-primary-grid">
        <section class="dash-panel dash-workout dash-planactual-panel">
            <!-- B2.35.31_DASHBOARD_PLAN_ACTUAL_CARDS -->
            <div class="dash-panel-label">
                <span class="dash-number">1</span><span>TRAINING</span>
            </div>

            <div class="dash-pa-stack">
                <article class="dash-pa-card dash-pa-planned">
                    <div class="dash-pa-head">
                        <span class="dash-pa-label">PLANNED</span>
                        @if (Model.ScheduleChangeRecommended)
                        {
                            <span class="dash-pa-badge review">RECOMP ADJUSTMENT</span>
                        }
                        else
                        {
                            <span class="dash-pa-badge plan">ON PLAN</span>
                        }
                    </div>

                    <h2 class="dash-pa-title">@Model.PlannedWorkout</h2>

                    <div class="dash-workout-meta dash-pa-meta">
                        @Model.WorkoutDurationMin.ToString("0") min
                        <span>&bull;</span>
                        @Model.WorkoutEffort
                    </div>

                    <div class="dash-workout-burn-grid dash-pa-burn">
                        <div>
                            <strong>~@(Model.PlannedWorkoutCaloriesKcal?.ToString("0") ?? "-") kcal</strong>
                            <span>Estimated burn</span>
                        </div>
                        <div>
                            <strong>~@(Model.PlannedWorkoutGlycogenG?.ToString("0") ?? "-") g</strong>
                            <span>Estimated glycogen</span>
                        </div>
                    </div>

                    @{
                        var recommendedWorkoutTypeCode = Model.ScheduleChangeRecommended
                            ? Model.RecompRecommendation?.RecommendedWorkoutTypeCode
                            : Model.RecompRecommendation?.PlannedWorkoutTypeCode ?? Model.Engine30WorkoutTypeCode;
                        var recommendedSystemWorkout =
                            WebRecomp.Web.Services.WorkoutIntelligence.SystemWorkoutRecipeCatalog
                                .GetDefaultPresentationForEngine(recommendedWorkoutTypeCode);
                    }
                    @if (Model.ScheduleChangeRecommended)
                    {
                        <div class="dash-pa-recommendation review">
                            <strong>Engine plan estimate</strong>
                            <span>Change to @Model.RecommendedWorkout</span>
                            @if (!string.IsNullOrWhiteSpace(Model.WorkoutRecommendationRationale))
                            {
                                <small>@Model.WorkoutRecommendationRationale</small>
                            }
                            @if (recommendedSystemWorkout is not null)
                            {
                                <a class="btn btn-sm btn-primary mt-2"
                                   asp-controller="TodayWorkout"
                                   asp-action="Index">Review readiness-based options</a>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="dash-pa-recommendation">
                            <strong>Engine plan estimate</strong>
                            <span>Keep the planned session.</span>
                            @if (recommendedSystemWorkout is not null)
                            {
                                <a class="btn btn-sm btn-primary mt-2"
                                   asp-controller="TodayWorkout"
                                   asp-action="Index">Review readiness-based options</a>
                            }
                        </div>
                    }
                </article>

                <article class="dash-pa-card dash-pa-actual">
                    <div class="dash-pa-head">
                        <span class="dash-pa-label">ACTUAL</span>
                        @if (!string.IsNullOrWhiteSpace(Model.WorkoutActual))
                        {
                            <span class="dash-pa-badge actual">COMPLETED WORKOUT</span>
                        }
                        else
                        {
                            <span class="dash-pa-badge waiting">WAITING FOR ENTRY</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.WorkoutActual))
                    {
                        <h2 class="dash-pa-title">@Model.WorkoutActual</h2>

                        @if (Model.ActualWorkoutDurationMin.HasValue || Model.ActualWorkoutRpe.HasValue)
                        {
                            <div class="dash-workout-meta dash-pa-meta">
                                @if (Model.ActualWorkoutDurationMin.HasValue)
                                {
                                    <span>@Model.ActualWorkoutDurationMin.Value.ToString("0") min</span>
                                }
                                @if (Model.ActualWorkoutDurationMin.HasValue && Model.ActualWorkoutRpe.HasValue)
                                {
                                    <span>&bull;</span>
                                }
                                @if (Model.ActualWorkoutRpe.HasValue)
                                {
                                    <span>RPE @Model.ActualWorkoutRpe.Value.ToString("0.#")</span>
                                }
                            </div>
                        }

                        <div class="dash-workout-burn-grid dash-pa-burn">
                            <div>
                                <strong>~@(Model.ActualWorkoutCaloriesKcal?.ToString("0") ?? "-") kcal</strong>
                                <span>Actual-session estimate</span>
                            </div>
                            <div>
                                <strong>~@(Model.ActualWorkoutGlycogenG?.ToString("0") ?? "-") g</strong>
                                <span>Actual-session glycogen</span>
                            </div>
                        </div>

                        <p class="dash-pa-note">
                            Synced from the completed WorkoutSession. Daily Tracking and Engine 3.0 are using this actual session instead of the planned estimate.
                        </p>
                    }
                    else
                    {
                        <div class="dash-pa-empty">
                            <strong>Complete your training entry and it will appear here.</strong>
                            <span>
                                Once the workout is completed in Workout Builder or Daily Entry,
                                this card shows what you actually did.
                            </span>
                        </div>
                    }
                </article>
            </div>

            @if (isGuidedDemo)
            {
                <aside class="guided-demo-callout" role="note">
                    <strong>Plan versus actual</strong>
                    <span>Planned is the prescription. Actual is the completed training Recomp analyzes.</span>
                </aside>
            }
        </section>

<section class="dash-panel dash-nutrition dash-planactual-panel">
            <div class="dash-panel-label">
                <span class="dash-number">2</span><span>NUTRITION</span>
            </div>

            @{
                var dPlanCal = Model.Calories;
                var dPlanP = Model.ProteinG;
                var dPlanC = Model.CarbsG;
                var dPlanF = Model.FatG;

                var dPlanPk = dPlanP * 4m;
                var dPlanCk = dPlanC * 4m;
                var dPlanFk = dPlanF * 9m;
                var dPlanMk = dPlanPk + dPlanCk + dPlanFk;

                var dPlanPs = dPlanMk > 0m ? dPlanPk / dPlanMk * 100m : 0m;
                var dPlanCs = dPlanMk > 0m ? dPlanCk / dPlanMk * 100m : 0m;
                var dPlanFs = dPlanMk > 0m ? dPlanFk / dPlanMk * 100m : 0m;

                var dActualCal = Model.ActualCalories ?? 0m;
                var dActualP = Model.ActualProteinG ?? 0m;
                var dActualC = Model.ActualCarbsG ?? 0m;
                var dActualF = Model.ActualFatG ?? 0m;

                var dActualPk = dActualP * 4m;
                var dActualCk = dActualC * 4m;
                var dActualFk = dActualF * 9m;
                var dActualMk = dActualPk + dActualCk + dActualFk;

                var dActualPs = dActualMk > 0m ? dActualPk / dActualMk * 100m : 0m;
                var dActualCs = dActualMk > 0m ? dActualCk / dActualMk * 100m : 0m;
                var dActualFs = dActualMk > 0m ? dActualFk / dActualMk * 100m : 0m;

                var dActualPct = dPlanCal > 0m ? dActualCal / dPlanCal * 100m : 0m;
                var dActualBar = Math.Min(Math.Max(dActualPct, 0m), 100m);
                var dOver = dPlanCal > 0m && dActualCal > dPlanCal;

                var dPlanPw = dPlanPs.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
                var dPlanCw = dPlanCs.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
                var dPlanFw = dPlanFs.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
                var dActualPw = dActualPs.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
                var dActualCw = dActualCs.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
                var dActualFw = dActualFs.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
                var dActualBarW = dActualBar.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
            }

            <div class="dash-pa-stack">
                <article class="dash-pa-card dash-pa-planned">
                    <div class="dash-pa-head">
                        <span class="dash-pa-label">PLANNED</span>
                        <span class="dash-pa-badge plan">ENGINE TARGET</span>
                    </div>

                    <div class="dash-pa-calories">
                        <strong>@dPlanCal.ToString("0")</strong>
                        <span>calories</span>
                    </div>

                    <div class="dash-pa-macro-track" role="img" aria-label="Planned macro distribution">
                        @if (dPlanMk > 0m)
                        {
                            <span class="dash-pa-macro-segment protein" style="width:@dPlanPw"></span>
                            <span class="dash-pa-macro-segment carbs" style="width:@dPlanCw"></span>
                            <span class="dash-pa-macro-segment fat" style="width:@dPlanFw"></span>
                        }
                    </div>

                    <div class="dash-pa-macro-legend">
                        <div><span class="dash-pa-dot protein"></span><span>Protein</span><strong>@dPlanP.ToString("0") g</strong></div>
                        <div><span class="dash-pa-dot carbs"></span><span>Carbs</span><strong>@dPlanC.ToString("0") g</strong></div>
                        <div><span class="dash-pa-dot fat"></span><span>Fat</span><strong>@dPlanF.ToString("0") g</strong></div>
                    </div>

                    <div class="dash-pa-nutrition-foot">
                        <strong>@Model.NutritionDayLabel</strong>
                        <span>@Model.NutritionTip</span>
                    </div>
                </article>

                <article class="dash-pa-card dash-pa-actual">
                    <div class="dash-pa-head">
                        <span class="dash-pa-label">ACTUAL</span>
                        @if (Model.NutritionActualLogged)
                        {
                            <span class="dash-pa-badge actual">PARTIAL DAY</span>
                        }
                        else
                        {
                            <span class="dash-pa-badge waiting">WAITING FOR ENTRY</span>
                        }
                    </div>

                    @if (Model.NutritionActualLogged)
                    {
                        <div class="dash-pa-calories">
                            <strong>@dActualCal.ToString("0")</strong>
                            <span>calories so far</span>
                        </div>

                        <div class="dash-pa-macro-track actual-track"
                             role="img"
                             aria-label='Actual intake is @dActualPct.ToString("0.#") percent of plan'>
                            <div class="dash-pa-actual-fill @(dOver ? "over-plan" : string.Empty)"
                                 style="width:@dActualBarW;flex-basis:@dActualBarW">
                                @if (dActualMk > 0m)
                                {
                                    <span class="dash-pa-macro-segment protein" style="width:@dActualPw"></span>
                                    <span class="dash-pa-macro-segment carbs" style="width:@dActualCw"></span>
                                    <span class="dash-pa-macro-segment fat" style="width:@dActualFw"></span>
                                }
                            </div>
                        </div>

                        <div class="dash-pa-progress-copy">
                            <strong>@dActualPct.ToString("0")%</strong>
                            <span>of calorie target logged</span>
                        </div>

                        <div class="dash-pa-macro-legend">
                            <div><span class="dash-pa-dot protein"></span><span>Protein</span><strong>@dActualP.ToString("0") g</strong></div>
                            <div><span class="dash-pa-dot carbs"></span><span>Carbs</span><strong>@dActualC.ToString("0") g</strong></div>
                            <div><span class="dash-pa-dot fat"></span><span>Fat</span><strong>@dActualF.ToString("0") g</strong></div>
                        </div>

                        <p class="dash-pa-note">
                            Partial day &mdash; this updates as food or Daily Entry nutrition is logged.
                        </p>
                    }
                    else
                    {
                        <div class="dash-pa-empty">
                            <strong>Actual nutrition will appear here.</strong>
                            <span>
                                Log food during the day or complete Nutrition in Daily Entry.
                                Until then, the planned target remains your guide.
                            </span>
                        </div>
                    }
                </article>
            </div>

            @if (isGuidedDemo)
            {
                <aside class="guided-demo-callout" role="note">
                    <strong>Plan versus actual</strong>
                    <span>Planned is today's Engine target. Actual shows intake logged so far.</span>
                </aside>
            }
        </section>

<section class="dash-panel dash-coach">
            <div class="dash-panel-label"><span class="dash-number">3</span><span>COACH</span></div>
            <h2>@Model.CoachTitle</h2>
