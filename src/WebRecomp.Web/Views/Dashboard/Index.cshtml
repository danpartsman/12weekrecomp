                    </div>

                    <div class="dash-analysis-signal-list">
                        <div class="dash-analysis-signal">
                            <span class="dash-analysis-dot @analysis.Workout.CssClass"></span>
                            <div>
                                <strong>@analysis.Workout.Label</strong>
                                <span>@analysis.Workout.Detail</span>
                            </div>
                            <b>@analysis.Workout.Value</b>
                        </div>

                        <div class="dash-analysis-signal">
                            <span class="dash-analysis-dot @analysis.Glycogen.CssClass"></span>
                            <div>
                                <strong>@analysis.Glycogen.Label</strong>
                                <span>@analysis.Glycogen.Detail</span>
                            </div>
                            <b>@analysis.Glycogen.Value</b>
                        </div>

                        <div class="dash-analysis-signal">
                            <span class="dash-analysis-dot @analysis.Calories.CssClass"></span>
                            <div>
                                <strong>@analysis.Calories.Label</strong>
                                <span>@analysis.Calories.Detail</span>
                            </div>
                            <b>@analysis.Calories.Value</b>
                        </div>

                        <div class="dash-analysis-signal">
                            <span class="dash-analysis-dot @analysis.Carbohydrate.CssClass"></span>
                            <div>
                                <strong>@analysis.Carbohydrate.Label</strong>
                                <span>@analysis.Carbohydrate.Detail</span>
                            </div>
                            <b>@analysis.Carbohydrate.Value</b>
                        </div>

                        <div class="dash-analysis-signal">
                            <span class="dash-analysis-dot @analysis.Protein.CssClass"></span>
                            <div>
                                <strong>@analysis.Protein.Label</strong>
                                <span>@analysis.Protein.Detail</span>
                            </div>
                            <b>@analysis.Protein.Value</b>
                        </div>

                        <div class="dash-analysis-signal">
                            <span class="dash-analysis-dot @analysis.Fat.CssClass"></span>
                            <div>
                                <strong>@analysis.Fat.Label</strong>
                                <span>@analysis.Fat.Detail</span>
                            </div>
                            <b>@analysis.Fat.Value</b>
                        </div>

                        <div class="dash-analysis-signal">
                            <span class="dash-analysis-dot @analysis.ScaleConsistency.CssClass"></span>
                            <div>
                                <strong>@analysis.ScaleConsistency.Label</strong>
                                <span>@analysis.ScaleConsistency.Detail</span>
                            </div>
                            <b class="@(!analysis.HasCurrentMorningScale ? "dash-analysis-missing-scale-text" : "")">@analysis.ScaleConsistency.Value</b>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(analysis.Kudos))
                    {
                        <div class="dash-analysis-kudos">
                            <strong>Good execution</strong>
                            <span>@analysis.Kudos</span>
                        </div>
                    }

                    <div class="dash-analysis-narrative">
                        <strong>What yesterday likely did</strong>
                        <p>@analysis.YesterdayNarrative</p>
