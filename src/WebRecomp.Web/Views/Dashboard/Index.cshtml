<div
    class="dash-coach-modal"
    id="coachDailyBriefModal"
    hidden
    aria-hidden="true">
    <div class="dash-coach-modal__backdrop" data-coach-brief-close></div>

    <div
        class="dash-coach-modal__dialog"
        role="dialog"
        aria-modal="true"
        aria-labelledby="coachDailyBriefTitle">

        <div class="dash-coach-modal__header">
            <div>
                <div class="dash-coach-modal__eyebrow">COACH</div>
                <h2 id="coachDailyBriefTitle">Daily Brief</h2>
            </div>

            <button
                type="button"
                class="dash-coach-modal__close"
                data-coach-brief-close
                aria-label="Close Coach Daily Brief">
                X
            </button>
        </div>

        <div class="dash-coach-modal__body">
            <div class="dash-coach-brief-grid">

                <section class="dash-coach-card">
                    <div class="dash-coach-card__eyebrow">Planned Workout</div>
                    <h3 class="dash-coach-card__title">@Model.PlannedWorkout</h3>
                    <p class="dash-coach-card__meta">
                        @Model.WorkoutDurationMin.ToString("0") min
                        <span> &bull; </span>
                        @Model.WorkoutEffort
                    </p>

                    <div class="dash-coach-metric-grid">
                        <div>
                            <strong>~@(Model.PlannedWorkoutCaloriesKcal?.ToString("0") ?? "-") kcal</strong>
                            <span>Estimated workout burn</span>
                        </div>
                        <div>
                            <strong>~@(Model.PlannedWorkoutGlycogenG?.ToString("0") ?? "-") g</strong>
                            <span>Estimated glycogen demand</span>
                        </div>
                    </div>

                    <p class="dash-coach-note">@Model.WorkoutDescription</p>
                </section>

                <section class="dash-coach-card dash-coach-card-actual">
                    <div class="dash-coach-card__eyebrow">Actual Workout</div>

                    @if (!string.IsNullOrWhiteSpace(Model.WorkoutActual))
                    {
                        <h3 class="dash-coach-card__title">@Model.WorkoutActual</h3>
                    }
                    else
                    {
                        <h3 class="dash-coach-card__title dash-not-logged">Not logged yet</h3>
                    }

                    @if (Model.ActualWorkoutDurationMin.HasValue || Model.ActualWorkoutRpe.HasValue)
                    {
                        <p class="dash-coach-card__meta">
                            @if (Model.ActualWorkoutDurationMin.HasValue)
                            {
                                <span>@Model.ActualWorkoutDurationMin.Value.ToString("0") min</span>
                            }

                            @if (Model.ActualWorkoutDurationMin.HasValue && Model.ActualWorkoutRpe.HasValue)
                            {
                                <span> &bull; </span>
                            }

                            @if (Model.ActualWorkoutRpe.HasValue)
                            {
                                <span>RPE @Model.ActualWorkoutRpe.Value.ToString("0.#")</span>
                            }
                        </p>
                    }

                    <div class="dash-coach-metric-grid">
                        <div>
                            <strong>~@(Model.ActualWorkoutCaloriesKcal?.ToString("0") ?? "-") kcal</strong>
                            <span>Completed-session calorie estimate</span>
                        </div>
                        <div>
                            <strong>~@(Model.ActualWorkoutGlycogenG?.ToString("0") ?? "-") g</strong>
                            <span>Completed-session glycogen estimate</span>
                        </div>
                    </div>

                    <p class="dash-coach-note">
                        Engine 3.0 uses completed-session inputs for the actual-side estimate.
                        Glycogen remains modeled rather than directly measured.
                    </p>
                </section>

                <section class="dash-coach-card">
                    <div class="dash-coach-card__eyebrow">Nutrition Today</div>
                    <h3 class="dash-coach-card__title">@Model.NutritionDayLabel</h3>

                    <div class="dash-coach-metric-grid">
                        <div>
                            <strong>@Model.Calories.ToString("0") kcal</strong>
                            <span>Today's prescription</span>
                        </div>
                        <div>
                            <strong>@Model.TodayBaselinePrescribedEnergyKcal.ToString("0") kcal</strong>
                            <span>Before energy carryover</span>
                        </div>
                        <div>
                            <strong>@Model.ProteinG.ToString("0") g</strong>
                            <span>Protein</span>
                        </div>
                        <div>
                            <strong>@Model.CarbsG.ToString("0") g</strong>
                            <span>Carbohydrate</span>
                        </div>
                        <div>
                            <strong>@Model.FatG.ToString("0") g</strong>
                            <span>Fat</span>
                        </div>
                        <div>
                            <strong>@Model.TodayEnergyCarryoverCorrectionKcal.ToString("0") kcal</strong>
                            <span>Carryover correction today</span>
                        </div>
                    </div>

                    <p class="dash-coach-note">@Model.EnergyCarryoverSummary</p>

                    @if (
                        Model.WeekEligibleEnergyCarryoverKcal > 0m
                        && Model.Engine30WorkoutCategoryCode == "MAJOR_STRENGTH"
                        && Model.TodayEnergyCarryoverCorrectionKcal <= 0m)
                    {
                        <p class="dash-coach-note">
                            Major Strength protection is active today. Eligible energy correction is being
                            directed toward lower-priority days instead of cutting this hard-training day.
                        </p>
                    }
                </section>
            </div>
        </div>
    </div>
</div>


