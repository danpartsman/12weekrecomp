@using System.Globalization
@using WebRecomp.Web.Services.Dashboard3
@model RecompBodyCompositionComparison
<section class="d3-composition" aria-label="@Model.ComparisonDays-day body composition change" data-comparison-days="@Model.ComparisonDays">
    @foreach (var metric in new[] { Model.Fat, Model.Muscle })
    {
        <div class="d3-composition-row d3-composition-@metric.Band" data-composition="@metric.Key">
            <div class="d3-composition-label">
                <h3>@Model.ComparisonDays day @(metric.Key == "muscle" ? "MUSCLE MASS" : "BODY FAT") change</h3>
                @if (metric.DisplayChangeLb is decimal result)
                {
                    <strong>@result.ToString("+0.0;-0.0;0.0") lb</strong>
                }
                else
                {
                    <span class="d3-composition-missing" role="status" title="@metric.MissingNotice">@(metric.Latest.Count == 0 && metric.Previous.Count == 0 ? "No readings in either period" : metric.Latest.Count == 0 ? "No latest readings" : "No earlier readings")</span>
                }
            </div>
            @if (metric.DisplayChangeLb is decimal change)
            {
                var position = Model.Position(change);
                var left = Math.Min(50m, position).ToString("0.###", CultureInfo.InvariantCulture);
                var width = Math.Abs(position - 50m).ToString("0.###", CultureInfo.InvariantCulture);
                <div class="d3-energy-track d3-composition-track" role="img" aria-label="@metric.Label: @change.ToString("+0.0;-0.0;0.0") pounds, @metric.Status. Left is loss; right is gain.">
                    <span class="d3-composition-zero" aria-hidden="true"><span>0</span></span>
                    <span class="d3-composition-fill" style="left:@(left)%;width:@(width)%" aria-hidden="true"></span>
                    <span class="d3-energy-needle" style="left:@(position.ToString("0.###", CultureInfo.InvariantCulture))%" aria-hidden="true"></span>
                </div>
            }
            else
            {
                <div class="d3-energy-track d3-composition-track" aria-hidden="true"><span class="d3-composition-zero"><span>0</span></span></div>
            }
        </div>
        @if (metric.Key == "fat")
        {
            <div class="d3-composition-divider" aria-hidden="true"></div>
        }
    }
    @if (Model.WeightChangeLb is decimal weightChange) { <p>Average weight change: @weightChange.ToString("+0.0;-0.0;0.0") lb · @Model.LatestWeight!.Count versus @Model.PreviousWeight!.Count readings.</p> }
    <details class="d3-composition-details"><summary>Dates, averages and calculation</summary>
        <ul><li>Compares two completed seven-day windows ending @Model.ComparisonDays days apart.</li><li>@(Model.ComparisonDays == 7 ? "Weights, newest first: 20%, 18%, 16%, 14%, 12%, 11%, 9%." : "Both windows use straight averages.")</li><li>Missing readings are skipped. Available weights are recalculated for each metric.</li></ul>
        <p>Shared scale: ±@Model.ScaleLb.ToString("0.#") lb. Left shows loss. Right shows gain.</p>
        <div class="d2-table-wrap"><table><thead><tr><th>Measure</th><th>Latest period</th><th>Earlier period</th></tr></thead><tbody>
        @foreach (var metric in new[] { Model.Fat, Model.Muscle })
        {
            <tr><th>@metric.Label</th><td>@metric.Latest.Start.ToString("MMM d, yyyy")–@metric.Latest.End.ToString("MMM d, yyyy")<br />@(metric.Latest.AverageLb?.ToString("0.0") ?? "No readings")@(metric.Latest.AverageLb.HasValue ? " lb average" : "") · @metric.Latest.Count readings</td><td>@metric.Previous.Start.ToString("MMM d, yyyy")–@metric.Previous.End.ToString("MMM d, yyyy")<br />@(metric.Previous.AverageLb?.ToString("0.0") ?? "No readings")@(metric.Previous.AverageLb.HasValue ? " lb average" : "") · @metric.Previous.Count readings</td></tr>
        }
        </tbody></table></div>
        @foreach (var metric in new[] { Model.Fat, Model.Muscle })
        {
            @if (metric.MissingNotice is not null)
            {
                <p>@metric.MissingNotice</p>
            }
        }
        <ul><li>Fat mass is averaged from weight × body-fat fraction.</li><li>Both windows use the same muscle measurement type.</li><li>Each day uses its latest reading.</li></ul>
        <a href="/Progress">Review longer-term progress →</a>
    </details>
</section>
