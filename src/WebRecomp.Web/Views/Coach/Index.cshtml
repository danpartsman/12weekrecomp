@model CoachCenterViewModel
@using WebRecomp.Web.Services.Coaching
@inject WebRecomp.Web.Services.AppUserContextService CurrentUsers
@inject Microsoft.Extensions.Configuration.IConfiguration CoachConfiguration
@{
    var currentCoachId = (await CurrentUsers.GetAsync(Context, Context.RequestAborted)).User.UserId;
    var showAccountability = AccountabilityPreview.Enabled(CoachConfiguration);
    var showTasks = SimpleCoaching.Enabled(CoachConfiguration);
    Layout = "_CoachLayout";
    ViewData["Title"] = "Coach Center";
}
<section class="page-header coach-photo-heading">
    <div><h1>Coach Center</h1></div>
    <img src="/images/coach-workspace-welcome.webp" width="320" height="160" alt="" decoding="async" />
</section>
@if (TempData["CoachStatus"] is string status) { <div class="app-message success">@status</div> }
<details class="card coach-panel" open>
    <summary>Clients · @Model.Clients.Count</summary>
    <div class="coach-panel-body">
        @if (Model.Clients.Count == 0)
        {
            <p>No clients yet.</p>
        }
        else
        {
            <div class="coach-client-list">
                <table class="coach-client-table">
                    <thead><tr><th scope="col">Client</th><th scope="col">Shortcuts</th><th scope="col">Goal</th><th scope="col">Last workout</th><th scope="col">Snap status</th></tr></thead>
                    <tbody>
                    @foreach (var client in Model.Clients)
                    {
                        <tr>
                            <td><a class="button" asp-controller="CoachSummary" asp-action="Index" asp-route-clientId="@client.ClientId">@client.Name</a></td>
                            <td>
                                <div class="coach-review-actions">
                                    @if (showAccountability)
                                    {
                                        <a class="button" asp-controller="AccountabilityLedger" asp-action="Index" asp-route-clientId="@client.ClientId" aria-label="Fees and payments for @client.Name">Fees</a>
                                    }
                                    <a class="button" asp-controller="CoachSummary" asp-action="Day" asp-route-clientId="@client.ClientId">Daily Review</a>
                                    @if (showAccountability)
                                    {
                                        <a class="button" asp-controller="SimpleSnap" asp-action="Index" asp-route-clientId="@client.ClientId" asp-fragment="snap-workout">Snap Workout</a>
                                    }
                                    @if (showTasks)
                                    {
                                        <a class="button" asp-controller="CoachTasks" asp-action="Index" asp-route-clientId="@client.ClientId" asp-route-coachId="@currentCoachId">Tasks</a>
                                    }
                                    <a class="button" asp-controller="CoachWorkspace" asp-action="Index" asp-route-clientId="@client.ClientId" asp-route-coachId="@currentCoachId">Workspace</a>
                                    <a class="button" asp-controller="CoachSummary" asp-action="Index" asp-route-clientId="@client.ClientId">Weekly Summary</a>
                                    <a class="button" asp-action="Client" asp-route-clientId="@client.ClientId">Plan &amp; Controls</a>
                                </div>
                            </td>
                            <td data-label="Goal">@(client.Goal is { Length: > 0 } goal ? System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(goal.Replace("_", " ").ToLowerInvariant()) : "—")</td>
                            <td data-label="Last workout">@(client.LastWorkout?.ToString("MMM d, yyyy") ?? "—")</td>
                            <td data-label="Snap status" data-snap-client="@client.ClientId">@await Html.PartialAsync("_CoachSnapStatus", client)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        @if (Model.PendingInvites > 0) { <p>Pending codes · @Model.PendingInvites</p> }
        <form asp-action="Invite" method="post"><button type="submit">Create connection code</button></form>
        @if (TempData["CoachInviteCode"] is string code)
        {
            <p>Share this one-time code. Enter it in My Coach within 24 hours.</p>
            <textarea readonly aria-label="Client connection code" rows="1" style="width:10em;font-size:1.5rem;letter-spacing:0.12em">@code</textarea>
        }
    </div>
</details>
@if(Model.FormerClients.Count>0)
{
<details class="card coach-panel"><summary>Former clients · @Model.FormerClients.Count</summary><div class="coach-panel-body">
@foreach(var client in Model.FormerClients){<p><a class="button" asp-controller="AccountabilityLedger" asp-action="Index" asp-route-clientId="@client.ClientId">@client.Name · fees &amp; payments</a></p>}
</div></details>
}
<details class="card coach-panel" open="@(!ViewData.ModelState.IsValid)"><summary>Coach profile</summary><div class="coach-panel-body"><form asp-action="Profile" method="post"><div asp-validation-summary="All"></div>
<label for="DisplayName">Coach name</label><input id="DisplayName" name="DisplayName" value="@Model.Profile.DisplayName" maxlength="100" required />
<label for="Specialties">Specialties</label><input id="Specialties" name="Specialties" value="@Model.Profile.Specialties" maxlength="500" />
<label for="Bio">About you</label><textarea id="Bio" name="Bio" maxlength="2000" rows="3">@Model.Profile.Bio</textarea>
<button type="submit">Save profile</button></form></div></details>

<script src="~/js/coach-snap-status.js" asp-append-version="true" defer></script>
