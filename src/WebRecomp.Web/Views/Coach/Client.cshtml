@using WebRecomp.Web.Services.Coaching
@model CoachClientDetailViewModel
@{ Layout="_CoachLayout";ViewData["Title"]=Model.Client.ClientName; }
<link rel="stylesheet" href="~/css/dashboard3.css" asp-append-version="true" />
<p><a asp-action="Index">← Coach Center</a></p><h1>@Model.Client.ClientName’s plan</h1>
@if(TempData["CoachStatus"] is string status){<div class="app-message success">@status</div>}
<p><a class="button" asp-controller="CoachPrescription" asp-action="Index" asp-route-clientId="@Model.Client.ClientId">Adjust macro and calorie limits</a></p>
<section class="card"><h2>Client overview</h2><p>Goal: @(Model.Program?.GoalCode ?? "No active program")</p>
@if(Model.Measurement is {} reading){<p>Latest reading · @reading.LocalMeasurementDate.ToString("MMM d, yyyy") · Weight @(reading.WeightLb?.ToString("0.0") ?? "—") lb · Body fat @((reading.BodyFatPct*100)?.ToString("0.0") ?? "—")% · Muscle @((reading.SkeletalMuscleMassLb ?? reading.MuscleMassLb)?.ToString("0.0") ?? "—") lb</p>}
else {<p>No body measurements recorded.</p>}</section>
@if(Model.Plan is {} plan){
@if(plan.Notice is not null){<div class="app-message">@plan.Notice</div>}
@if(plan.Progress is {} progress){<section class="card"><h2>Last 7 completed days · @progress.WeekStart.ToString("MMM d")–@progress.ScoreEnd.ToString("MMM d")</h2><p><strong>Recomp @(progress.Score.DisplayScore?.ToString() ?? "—") · Nutrition @(progress.Score.NutritionScore?.ToString() ?? "—") · Workout @(progress.Score.WorkoutScore?.ToString() ?? "—")</strong></p><p>@progress.DataNotice</p><p>@progress.Score.KnownNutritionDays / @progress.Score.CompletedNutritionDays days have nutrition evidence. Missing logs are unknown, not zero intake.</p><details><summary>Score explanation</summary>@foreach(var component in progress.Score.Components.Where(x=>x.Included)){<p><strong>@component.Label · @component.Earned.ToString("0.#") / @component.Weight.ToString("0.#")</strong><br />@component.Explanation</p>}</details></section>
<div class="d3 d2">@if(progress.BodyComposition is {} composition){@await Html.PartialAsync("~/Views/Dashboard/_RecompBodyCompositionTrends.cshtml",composition)}@if(progress.WeeklyTrend is {} trend){@await Html.PartialAsync("~/Views/Dashboard/_RecompWeeklyTrend.cshtml",trend)}</div>}
<section class="card"><h2>Weekly plan · @plan.WeekStart.ToString("MMM d")–@plan.WeekStart.AddDays(6).ToString("MMM d")</h2>
<form method="get"><label for="coach-week">Choose a week</label><input type="date" id="coach-week" name="week" value="@plan.WeekStart.ToString("yyyy-MM-dd")" min="@plan.Today.AddDays(-84).ToString("yyyy-MM-dd")" max="@plan.Today.AddDays(84).ToString("yyyy-MM-dd")" /><button>View week</button></form>
<p>The engine column uses the current training schedule before trainer macro limits. Assigned targets match the client's plan. Completed workouts drive their actualized nutrition targets. Future targets can change with training and food logs.</p>
@if(plan.Days.Count>0){<p><strong>Assigned weekly totals:</strong> @plan.Days.Sum(x=>x.Assigned.ProteinG).ToString("0") g protein · @plan.Days.Sum(x=>x.Assigned.RecommendedCarbsG).ToString("0") g carbs · @plan.Days.Sum(x=>x.Assigned.FatG).ToString("0") g fat · @plan.Days.Sum(x=>x.Assigned.PrescribedEnergyKcal).ToString("0") calories</p>}
@foreach(var day in plan.Days){<details class="card" open="@(day.Date==plan.Today)"><summary><strong>@day.Date.ToString("ddd, MMM d") · @day.Name</strong> · @(day.Actual.Count>0?"Completed":day.Date<plan.Today?"No completed workout":day.Plan is null?"Not scheduled":"Planned")</summary>
@if(day.Plan?.SourceCode=="COACH"){<p><strong>Adjusted by your trainer</strong></p>}
<p>Scheduled: @(day.Plan?.PlannedDurationMin?.ToString("0.#") ?? day.Assigned.PlannedDurationMinutes.ToString("0.#")) minutes · Effort @(day.Plan?.PlannedRpe?.ToString("0.#") ?? day.Assigned.PlannedRpe?.ToString("0.#") ?? "—") / 10</p>
@if(day.CanEdit){<p><a class="button" asp-controller="CoachWorkout" asp-action="Index" asp-route-clientId="@Model.Client.ClientId" asp-route-date="@day.Date.ToString("yyyy-MM-dd")">Adjust or schedule workout</a></p>}
else {<p>Past, started and completed sessions remain locked.</p>}
<div style="overflow-x:auto"><table><thead><tr><th>Nutrient</th><th>Engine</th><th>Assigned</th><th>Logged</th></tr></thead><tbody>
@foreach(var row in new[]{("Protein (g)",day.Engine.ProteinG,day.Assigned.ProteinG,day.Intake?.ActualProteinG),("Carbs (g)",day.Engine.RecommendedCarbsG,day.Assigned.RecommendedCarbsG,day.Intake?.ActualCarbsG),("Fat (g)",day.Engine.FatG,day.Assigned.FatG,day.Intake?.ActualFatG),("Calories",day.Engine.PrescribedEnergyKcal,day.Assigned.PrescribedEnergyKcal,day.Intake?.ActualCalories)}){<tr><th>@row.Item1</th><td>@row.Item2.ToString("0.#")</td><td>@row.Item3.ToString("0.#")</td><td>@(row.Item4?.ToString("0.#") ?? "Not logged")</td></tr>}
</tbody></table></div>
@if(day.Assigned.CoachPrescriptionNotice is string notice){<p>@notice</p>}
@if(day.Exercises.Count>0){<h3>Planned exercises</h3><p>System exercises are resolved with the client's current preferences; a custom trainer routine preserves its saved exercises.</p><div style="overflow-x:auto"><table><thead><tr><th>Exercise</th><th>Sets</th><th>Reps</th><th>Weight (lb)</th></tr></thead><tbody>@foreach(var exercise in day.Exercises){<tr><td>@exercise.Name</td><td>@exercise.Sets</td><td>@exercise.Reps</td><td>@(exercise.WeightLb?.ToString("0.#") ?? "—")</td></tr>}</tbody></table></div>}
else {<p>Duration-based, rest or unresolved exercise details. The training category and duration still drive the plan.</p>}
@foreach(var actual in day.Actual){<h3>Completed · @(actual.Session.WorkoutName ?? actual.Session.WorkoutTypeCode)</h3><p>@actual.Session.DurationMin.ToString("0.#") min · RPE @(actual.Session.SessionRpe?.ToString("0.#") ?? "—")</p><ul>@foreach(var exercise in actual.Exercises){<li><strong>@exercise.ExerciseNameSnapshot</strong>: @string.Join("; ",exercise.Sets.OrderBy(x=>x.SetOrder).Select(x=>$"{x.Reps?.ToString() ?? "—"} reps × {CoachClientPlanService.Pounds(x.Load,x.LoadUnitCode)?.ToString("0.#") ?? "—"} lb"))</li>}</ul>}
</details>}</section>
<section class="card"><h2>Trainer change history</h2>@if(plan.History.Count==0){<p>No trainer workout changes yet.</p>}
@foreach(var revision in plan.History){<details><summary>@revision.WorkoutDate.ToString("MMM d, yyyy") · @revision.CreatedAtUtc.ToString("MMM d HH:mm") UTC</summary><p>@plan.Authors.GetValueOrDefault(revision.CoachUserId,"Trainer") · @revision.Reason</p><p>The original and adjusted workout and seven-day nutrition preview are retained with this version.</p></details>}</section>
}
<section class="card"><h2>Client connection</h2><p>Disconnecting removes your access to this client's plan.</p><form asp-action="Disconnect" asp-route-clientId="@Model.Client.ClientId" method="post"><button>Disconnect client</button></form></section>
<script src="~/js/dashboard3.js" asp-append-version="true" defer></script>
