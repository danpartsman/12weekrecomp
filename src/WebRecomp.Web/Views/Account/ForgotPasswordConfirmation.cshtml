@{
    ViewData["Title"] = "Check Your Email";
    ViewData["PublicPage"] = true;
}

<style>
.auth-shell{min-height:calc(100vh - 80px);display:grid;place-items:center;padding:28px 16px;background:linear-gradient(160deg,#04101d 0%,#071827 52%,#050b14 100%);color:#f5f9ff}.auth-card{width:min(500px,100%);background:rgba(8,25,41,.96);border:1px solid rgba(74,196,240,.3);border-radius:24px;padding:30px;box-shadow:0 30px 80px rgba(0,0,0,.35)}.auth-kicker{font-size:.75rem;letter-spacing:.2em;font-weight:900;color:#53d9ff}.auth-card h1{margin:.45rem 0 .55rem;font-size:2rem}.auth-card p{color:#b8cad9;line-height:1.55}.auth-links{margin-top:20px}.auth-links a{color:#55ddff;font-weight:800}
</style>

<div class="auth-shell">
    <section class="auth-card">
        <div class="auth-kicker">12 WEEK RECOMP</div>
        <h1>Check your email.</h1>
        <p>If that email is associated with a 12WR account, a reset link has been sent. The link is valid for 60 minutes.</p>
        <p>For security, we show the same message whether or not an account exists.</p>
        <div class="auth-links"><a asp-controller="Account" asp-action="SignIn">Return to sign in</a></div>
    </section>
</div>
