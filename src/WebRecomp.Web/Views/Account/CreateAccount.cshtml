@model LocalRegisterViewModel
@{
    ViewData["Title"] = "Create Account";
    ViewData["PublicPage"] = true;
}

<style>
.auth-shell{min-height:calc(100vh - 80px);display:grid;place-items:center;padding:28px 16px;background:radial-gradient(circle at 18% 18%,rgba(42,199,255,.13),transparent 32%),radial-gradient(circle at 82% 20%,rgba(66,235,150,.10),transparent 30%),linear-gradient(160deg,#04101d 0%,#071827 52%,#050b14 100%);color:#f5f9ff}.auth-card{width:min(500px,100%);background:rgba(8,25,41,.96);border:1px solid rgba(74,196,240,.3);border-radius:24px;padding:30px;box-shadow:0 30px 80px rgba(0,0,0,.35)}.auth-kicker{font-size:.75rem;letter-spacing:.2em;font-weight:900;color:#53d9ff}.auth-card h1{margin:.45rem 0 .55rem;font-size:2.1rem}.auth-card p{color:#aebfd0;line-height:1.5}.auth-field{display:flex;flex-direction:column;gap:7px;margin-top:16px}.auth-field label{font-weight:800;font-size:.88rem}.auth-field input{width:100%;box-sizing:border-box;border:1px solid #315874;background:#061726;color:#fff;border-radius:12px;padding:13px 14px;font:inherit}.auth-help{font-size:.78rem;color:#8199ad}.auth-button{width:100%;border:0;border-radius:999px;padding:13px 18px;margin-top:22px;background:linear-gradient(90deg,#2ecbff,#43eb96);color:#031019;font-weight:950;cursor:pointer;font-size:1rem}.auth-links{text-align:center;margin-top:18px;color:#9fb2c4}.auth-links a{color:#55ddff;font-weight:800}.auth-errors{margin:14px 0;color:#ffadb7}.auth-legacy{margin-top:24px;padding-top:18px;border-top:1px solid #20384b;text-align:center;font-size:.88rem;color:#7992a7}.auth-legacy a{color:#9cc8e8}.field-validation-error{color:#ff9aa6;font-size:.8rem}.input-validation-error{border-color:#ff6676!important}
</style>

<div class="auth-shell">
    <section class="auth-card">
        <div class="auth-kicker">12 WEEK RECOMP</div>
        <h1>Create your account.</h1>
        <p>This is your 12WR login. No Microsoft account, tenant, or external account setup is required.</p>

        <form asp-controller="Account" asp-action="CreateAccount" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="auth-errors"></div>

            <div class="auth-field">
                <label asp-for="DisplayName">Your name</label>
                <input asp-for="DisplayName" autocomplete="name" autofocus />
                <span asp-validation-for="DisplayName"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" autocomplete="email" />
                <span asp-validation-for="Email"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Password">Create a password</label>
                <input asp-for="Password" type="password" autocomplete="new-password" />
                <div class="auth-help">At least 8 characters with at least one letter and one number.</div>
                <span asp-validation-for="Password"></span>
            </div>

            <div class="auth-field">
                <label asp-for="ConfirmPassword">Confirm password</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>

            <button class="auth-button" type="submit">Create account & continue →</button>
        </form>

        <div class="auth-links">
            Already have a native 12WR account? <a asp-controller="Account" asp-action="SignIn" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a>
        </div>

        <div class="auth-legacy">
            Existing TEST account created through Microsoft?
            <a asp-controller="Account" asp-action="MicrosoftSignIn" asp-route-returnUrl="@Model.ReturnUrl">Use legacy Microsoft sign-in</a>
        </div>
    </section>
</div>
