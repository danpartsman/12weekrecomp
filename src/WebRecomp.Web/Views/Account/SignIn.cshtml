@model LocalSignInViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["PublicPage"] = true;
    var nativeAuthAvailable = ViewData["NativeAuthAvailable"] as bool? ?? false;
}

<style>
.auth-shell{min-height:calc(100vh - 80px);display:grid;place-items:center;padding:28px 16px;background:radial-gradient(circle at 18% 18%,rgba(42,199,255,.13),transparent 32%),radial-gradient(circle at 82% 20%,rgba(66,235,150,.10),transparent 30%),linear-gradient(160deg,#04101d 0%,#071827 52%,#050b14 100%);color:#f5f9ff}.auth-card{width:min(470px,100%);background:rgba(8,25,41,.96);border:1px solid rgba(74,196,240,.3);border-radius:24px;padding:30px;box-shadow:0 30px 80px rgba(0,0,0,.35)}.auth-kicker{font-size:.75rem;letter-spacing:.2em;font-weight:900;color:#53d9ff}.auth-card h1{margin:.45rem 0 .55rem;font-size:2.1rem}.auth-card p{color:#aebfd0;line-height:1.5}.auth-field{display:flex;flex-direction:column;gap:7px;margin-top:16px}.auth-field label{font-weight:800;font-size:.88rem}.auth-field input{width:100%;box-sizing:border-box;border:1px solid #315874;background:#061726;color:#fff;border-radius:12px;padding:13px 14px;font:inherit}.auth-check{display:flex;gap:8px;align-items:center;margin:16px 0;color:#c5d5e3}.auth-button{width:100%;border:0;border-radius:999px;padding:13px 18px;background:linear-gradient(90deg,#2ecbff,#43eb96);color:#031019;font-weight:950;cursor:pointer;font-size:1rem}.auth-links{text-align:center;margin-top:18px;color:#9fb2c4}.auth-links a{color:#55ddff;font-weight:800}.auth-errors{margin:14px 0;color:#ffadb7}.auth-notice{margin:18px 0;padding:14px 16px;border:1px solid rgba(255,196,85,.45);border-radius:14px;background:rgba(255,178,44,.08);color:#ffd995;line-height:1.45}.field-validation-error{color:#ff9aa6;font-size:.8rem}.input-validation-error{border-color:#ff6676!important}
</style>

<div class="auth-shell">
    <section class="auth-card">
        <div class="auth-kicker">12 WEEK RECOMP</div>
        <h1>Welcome back.</h1>

        @if (nativeAuthAvailable)
        {
            <p>Sign in to your 12 Week Recomp account.</p>

            <form asp-controller="Account" asp-action="SignIn" method="post">
                <input asp-for="ReturnUrl" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="auth-errors"></div>

                <div class="auth-field">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" type="email" autocomplete="email" autofocus />
                    <span asp-validation-for="Email"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password">Password</label>
                    <input asp-for="Password" type="password" autocomplete="current-password" />
                    <span asp-validation-for="Password"></span>
                </div>

                <label class="auth-check">
                    <input asp-for="RememberMe" />
                    <span>Keep me signed in for 7 days</span>
                </label>

                <button class="auth-button" type="submit">Sign in →</button>
            </form>

            <div class="auth-links">
                New to 12WR? <span class="free-signup-group"><a asp-controller="Account" asp-action="CreateAccount" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a><a class="free-signup-note" href="/recomp/why-free"><span class="free-stamp free-stamp--small">100% FREE</span><span class="free-signup-note__copy">No credit card. No hidden fees.<small>Why it’s free ↗</small></span></a></span>
            </div>
        }
        else
        {
            <div class="auth-notice">
                Account sign-in is temporarily unavailable. Please try again shortly.
            </div>
        }
    </section>
</div>
