@{
    ViewData["Title"] = "Password Updated";
    ViewData["PublicPage"] = true;
}

<style>
.auth-shell{min-height:calc(100vh - 80px);display:grid;place-items:center;padding:28px 16px;background:linear-gradient(160deg,#04101d 0%,#071827 52%,#050b14 100%);color:#f5f9ff}.auth-card{width:min(500px,100%);background:rgba(8,25,41,.96);border:1px solid rgba(74,196,240,.3);border-radius:24px;padding:30px;box-shadow:0 30px 80px rgba(0,0,0,.35)}.auth-kicker{font-size:.75rem;letter-spacing:.2em;font-weight:900;color:#53d9ff}.auth-card h1{margin:.45rem 0 .55rem;font-size:2rem}.auth-card p{color:#b8cad9;line-height:1.55}.auth-button{display:inline-block;text-decoration:none;border-radius:999px;padding:12px 20px;margin-top:14px;background:linear-gradient(90deg,#2ecbff,#43eb96);color:#031019;font-weight:950}
</style>

<div class="auth-shell">
    <section class="auth-card">
        <div class="auth-kicker">12 WEEK RECOMP</div>
        <h1>Your password is ready.</h1>
        <p>Your 12WR password has been updated. If this was an older Microsoft-based 12WR account, the same profile and data were kept and the account is now ready for normal 12WR sign-in.</p>
        <a class="auth-button" asp-controller="Account" asp-action="SignIn">Sign in →</a>
    </section>
</div>
