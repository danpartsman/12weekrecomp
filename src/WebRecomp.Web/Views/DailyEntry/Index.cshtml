<script>
(() => {
    const form =
        document.getElementById(
            "daily-entry-autosave-form");

    if (!form) return;

    const dialog =
        document.getElementById(
            "daily-my-workouts-dialog");

    const date =
        form.querySelector(
            'input[name="Date"]')
            ?.value;

    const antiForgery =
        form.querySelector(
            'input[name="__RequestVerificationToken"]')
            ?.value;

    function syncCompletionFields(row, option) {
        if (!row) return;

        const systemCode =
            option?.dataset.systemCode
            || row.querySelector("[data-daily-system-code]")?.value
            || "";

        const engineCode =
            option?.dataset.workoutTypeCode
            || row.querySelector("[data-daily-engine-code]")?.value
            || "";

        const cardioField =
            row.querySelector("[data-cardio-activity-field]");

        const cardioSelect =
            row.querySelector("[data-cardio-activity]");

        const durationInput =
            row.querySelector('input[name$=".DurationMin"]');

        const rpeInput =
            row.querySelector('input[name$=".SessionRpe"]');

        const isCardio =
            systemCode.toUpperCase() === "CARDIO";

        const isRest =
            systemCode.toUpperCase() === "REST"
            || engineCode.toUpperCase() === "REST";

        if (cardioField) {
            cardioField.hidden = !isCardio;
        }

        if (cardioSelect) {
            cardioSelect.disabled = !isCardio;
            if (!isCardio) {
                cardioSelect.value = "";
            }
        }

        if (durationInput) {
            durationInput.closest("label")?.toggleAttribute("hidden", isRest);
            if (isRest) {
                durationInput.value = "0";
            }
        }

        if (rpeInput) {
            rpeInput.closest("label")?.toggleAttribute("hidden", isRest);
            if (isRest) {
                rpeInput.value = "";
            }
        }
    }

    form.querySelectorAll(
        "[data-daily-workout-type]"
    ).forEach(select => {
        select.dataset.previousValue =
            select.value;

        const row = select.closest("[data-workout-row]");
        const option = select.options[select.selectedIndex];
        syncCompletionFields(row, option);
    });

    function closeDialog() {
        if (dialog?.close) {
            dialog.close();
        }
        else {
            dialog?.removeAttribute(
                "open");
        }
    }

    function openDialog() {
        if (dialog?.showModal) {
            dialog.showModal();
        }
        else if (dialog) {
            dialog.setAttribute(
                "open",
                "open");
        }
    }

    function createCustom() {
        const url =
            dialog?.dataset
                .createCustomUrl;

        if (url) {
            window.location.href = url;
        }
    }

    form.addEventListener(
        "change",
        event => {
            const select =
                event.target.closest(
                    "[data-daily-workout-type]");

            if (!select) return;

            if (
                select.value
                    === "__MY_WORKOUTS__"
            ) {
                event.stopImmediatePropagation();

                select.value =
                    select.dataset
                        .previousValue
                    || "";

                openDialog();
                return;
            }

            if (
                select.value
                    === "__CREATE_CUSTOM__"
            ) {
                event.stopImmediatePropagation();

                select.value =
                    select.dataset
                        .previousValue
                    || "";

                createCustom();
                return;
            }

            const row =
                select.closest(
                    "[data-workout-row]");

            const option =
                select.options[
                    select.selectedIndex];

            const engineInput =
                row?.querySelector(
                    "[data-daily-engine-code]");

            const systemInput =
                row?.querySelector(
                    "[data-daily-system-code]");

            const nameInput =
                row?.querySelector(
                    "[data-daily-workout-name]");

            if (engineInput) {
                engineInput.value =
                    option?.dataset.workoutTypeCode
                    || "";
            }

            if (systemInput) {
                systemInput.value =
                    option?.dataset.systemCode
                    || "";
            }

            if (nameInput) {
                nameInput.value =
                    option?.dataset.systemCode
                        ? option.textContent.trim()
                        : "";
            }

            if (option?.dataset.systemCode) {
                const durationInput =
                    row?.querySelector(
                        'input[name$=".DurationMin"]');

                const rpeInput =
                    row?.querySelector(
                        'input[name$=".SessionRpe"]');

                if (durationInput
                    && option.dataset.defaultMinutes) {
                    durationInput.value =
                        option.dataset.defaultMinutes;
                }

                if (rpeInput
                    && option.dataset.defaultRpe) {
                    rpeInput.value =
                        option.dataset.defaultRpe;
                }
            }

            syncCompletionFields(row, option);

            select.dataset.previousValue =
                select.value;
        });

    dialog?.querySelectorAll(
        "[data-template-dialog-close]"
    ).forEach(button => {
        button.addEventListener(
            "click",
            closeDialog);
    });

    dialog?.addEventListener(
        "click",
        event => {
            if (event.target === dialog) {
                closeDialog();
            }
        });

    dialog?.querySelectorAll(
        "[data-daily-template-choice]"
    ).forEach(button => {
        button.addEventListener(
            "click",
            () => {
                const templateId =
                    button.dataset.templateId;

                if (
                    !templateId
                    || !date
                    || !antiForgery
                ) {
                    return;
                }

                const post =
                    document.createElement(
                        "form");

                post.method = "post";
                post.action =
                    "/DetailedWorkout/UseTemplate";

                post.style.display =
                    "none";

                const values = {
                    __RequestVerificationToken:
                        antiForgery,
                    templateId,
                    date,
                    returnContext: "daily"
                };

                Object.entries(values)
                    .forEach(
                        ([name, value]) => {
                            const input =
                                document.createElement(
                                    "input");

                            input.type =
                                "hidden";
                            input.name =
                                name;
                            input.value =
                                value;

                            post.appendChild(
                                input);
                        });

                document.body.appendChild(
                    post);

                post.submit();
            });
    });

    dialog?.querySelector(
        "[data-daily-create-custom]"
    )?.addEventListener(
        "click",
        createCustom);
})();
</script>

<script>
(() => {
    const override =
        document.getElementById("nutrition-manual-override");

    const fields =
        Array.from(
            document.querySelectorAll(
                "[data-nutrition-engine-field]"));

    const applyMode = () => {
        if (!override) {
            return;
        }

        fields.forEach(field => {
            field.readOnly = !override.checked;

            if (override.checked) {
                field.removeAttribute("aria-readonly");
                field.removeAttribute("title");
            }
            else {
                field.setAttribute("aria-readonly", "true");
                field.setAttribute(
                    "title",
                    "Calculated from Food Log. Turn on Manual Override to edit.");
            }
        });
    };

    applyMode();

    override?.addEventListener("change", () => {
        applyMode();
    });
})();
</script>

<script>
(() => {
    const form = document.getElementById("daily-entry-autosave-form");


    window.RecompAutosave?.bind(form, {
        statusSelector: "#daily-entry-autosave-status",
        delay: 750,
        afterSave: payload => {
            refreshDailyEntryCompletion();

            if (payload?.nutrition) {
                const nutritionMap = {
                    Calories: payload.nutrition.calories,
                    ProteinG: payload.nutrition.proteinG,
                    CarbsG: payload.nutrition.carbsG,
                    FatG: payload.nutrition.fatG,
                    FiberG: payload.nutrition.fiberG
                };

                Object.entries(nutritionMap).forEach(([name, value]) => {
                    const input =
                        form.querySelector(`[name="${name}"]`);

                    if (input && value !== null && value !== undefined) {
                        input.value = value;
                    }
                });

                const sourceLabel =
                    document.getElementById("nutrition-source-label");

                if (sourceLabel && payload.nutrition.source) {
                    sourceLabel.textContent =
                        `Source: ${payload.nutrition.source}`;
                }
            }

            if (!Array.isArray(payload?.workoutSessionIds)) {
                return;
            }

            const rows = form.querySelectorAll("[data-workout-row]");

            payload.workoutSessionIds.forEach((id, index) => {
                if (!id || !rows[index]) {
                    return;
                }

                const idField =
                    rows[index].querySelector(
                        'input[name$=".WorkoutSessionId"]');

                if (idField) {
                    idField.value = id;
                }
            });
        }
    });
})();
</script>

<script>
<script>
/* B2.35.30_REV2_DAILY_ENTRY_SERVER_MODEL_HYDRATION */
(() => {
    // The server model is authoritative for a GET. This intentionally assigns
    // values without dispatching input/change events, so autosave is NOT triggered.
    const values = @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
            new
            {
                WeightLb = Model.WeightLb,
                BodyFatPercent = Model.BodyFatPercent,
                SkeletalMuscleMassLb = Model.SkeletalMuscleMassLb,
                SubcutaneousFatPercent = Model.SubcutaneousFatPercent,
                BodyWaterLb = Model.BodyWaterLb,
                VisceralFatRating = Model.VisceralFatRating,
                WaistIn = Model.WaistIn,
                HipsIn = Model.HipsIn,
                SleepHours = Model.SleepHours,
                RestingHr = Model.RestingHr,
                DailyActivityHours = Model.DailyActivityHours,
                EnergyScore = Model.EnergyScore,
                SorenessScore = Model.SorenessScore,
                Calories = Model.Calories,
                ProteinG = Model.ProteinG,
                CarbsG = Model.CarbsG,
                FatG = Model.FatG,
                FiberG = Model.FiberG,
                WaterOz = Model.WaterOz
            }));

    Object.entries(values).forEach(([name, value]) => {
        const field =
            document.querySelector(
                `#daily-entry-autosave-form [name="${name}"]`);

        if (!field) return;

        field.value =
            value === null || value === undefined
                ? ""
                : String(value);
    });

    const booleans = {
        PainFlag: @Model.PainFlag.ToString().ToLowerInvariant(),
        IllnessFlag: @Model.IllnessFlag.ToString().ToLowerInvariant()
    };

    Object.entries(booleans).forEach(([name, value]) => {
        const field =
            document.querySelector(
                `#daily-entry-autosave-form input[type="checkbox"][name="${name}"]`);

        if (field) {
            field.checked = value;
        }
    });
})();
</script>
<script>
/* B2.35.28_REV2_DAILY_ENTRY_DELETE_NATIVE_POST */
(() => {
    const dailyForm =
        document.getElementById(
            "daily-entry-autosave-form");

    if (!dailyForm) return;

    const token =
        dailyForm.querySelector(
            'input[name="__RequestVerificationToken"]')
            ?.value;

    const date =
        dailyForm.querySelector(
            'input[name="Date"]')
            ?.value;

    const endpoint =
        '@Url.Action("DeleteWorkoutActual", "DailyEntry")';

    document.querySelectorAll(
        "[data-workout-delete]"
    ).forEach(button => {
        button.addEventListener(
            "click",
            () => {
                const workoutSessionId =
                    button.dataset.workoutSessionId;

                const workoutName =
                    button.dataset.workoutName
                    || "this workout";

                if (
                    !workoutSessionId
                    || !date
                    || !token
                ) {
                    window.alert(
                        "Workout delete information is incomplete.");
                    return;
                }

                const confirmed =
                    window.confirm(
                        `Delete "${workoutName}" from actual workouts?\n\n` +
                        "This deletes this completed workout session and its detailed " +
                        "exercise/set records. It does NOT delete a saved My Workout " +
                        "template or a 12WR System Workout definition."
                    );

                if (!confirmed) return;

                button.disabled = true;
                button.textContent = "Deleting...";

                // Daily Entry's main form is managed by RecompAutosave.
                // Use a detached native form so this action cannot be intercepted
                // and sent to the Daily Entry autosave endpoint by mistake.
                const post =
                    document.createElement(
                        "form");

                post.method =
                    "post";

                post.action =
                    endpoint;

                post.style.display =
                    "none";

                const values = {
                    __RequestVerificationToken:
                        token,
                    workoutSessionId:
                        workoutSessionId,
                    date:
                        date
                };

                Object.entries(values)
                    .forEach(
                        ([name, value]) => {
                            const input =
                                document.createElement(
                                    "input");

                            input.type =
                                "hidden";

                            input.name =
                                name;

                            input.value =
                                value;

                            post.appendChild(
                                input);
                        });

                document.body.appendChild(
                    post);

                post.submit();
            });
    });
})();</script>
/* v1006-daily-entry-ui - date submit handled natively by B2.35.30 REV2 */

async function refreshDailyEntryCompletion() {
    const form = document.getElementById("daily-entry-autosave-form");
    if (!form) return;

    try {
        const url = new URL(window.location.href);
        const date = form.querySelector('input[name="Date"]')?.value;

        if (date) {
            url.searchParams.set("date", date);
        }

        const response = await fetch(url.toString(), {
            method: "GET",
            credentials: "same-origin",
            cache: "no-store"
        });

        if (!response.ok) return;

        const html = await response.text();
        const doc = new DOMParser().parseFromString(html, "text/html");

        ["body", "workout", "nutrition"].forEach(key => {
            const current = document.querySelector(
                `[data-completion="${key}"]`);

            const updated = doc.querySelector(
                `[data-completion="${key}"]`);

            if (!current || !updated) return;

            current.className = updated.className;

            const currentText = current.querySelector("em");
            const updatedText = updated.querySelector("em");

            if (currentText && updatedText) {
                currentText.textContent =
                    updatedText.textContent;
            }
        });
    }
    catch {
        // Autosave itself has already succeeded.
        // A completion-refresh failure should not interrupt entry.
    }
}
</script>