@model WebRecomp.Web.ViewModels.DailyEntryViewModel
@{
    ViewData["Title"] = "Daily Entry";

    var isGuidedDemo =
        User.FindFirst("recomp_demo")?.Value == "true"
        && User.FindFirst("recomp_demo_type")?.Value == "GUIDED";

    string CompletionClass(bool complete) =>
        complete ? "daily-entry-status is-complete" : "daily-entry-status";

    string CompletionText(bool complete) =>
        complete ? "Complete" : "Open";
}

<link rel="stylesheet"
      href="~/css/daily-entry.css"
      asp-append-version="true" />

<div class="daily-entry-page">

    <header class="daily-entry-header">
        <div>
            <p class="daily-entry-kicker">
                PLAN &bull; ENTER &bull; ANALYZE &bull; ADAPT
            </p>

            <h1>Daily Entry</h1>

            <p class="daily-entry-lede">
                Tell Recomp what happened today. One page gives the analytical
                engine the body, recovery, training, and nutrition inputs it
                needs to keep your program current.
            </p>
        </div>

        <a class="daily-entry-dashboard-link"
           asp-controller="Dashboard"
           asp-action="Index">
            View Dashboard
        </a>
    </header>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="daily-entry-success" role="status">
            @statusMessage
        </div>
    }

    @if (isGuidedDemo)
    {
        <aside class="guided-demo-callout" role="note">
            <strong>One daily page. The engine does the hard part.</strong>
            <span>
                Enter a few numbers here, then Recomp combines them with the
                Weekly Plan to update the recommendations on the Dashboard.
            </span>
        </aside>
    }

    <section class="daily-entry-datebar">
        <form asp-action="Index"
              method="get"
              class="daily-entry-date-form">

            <label for="daily-entry-date">Entry date</label>

            <input id="daily-entry-date"
                   name="date"
                   type="date"
                   value="@Model.Date.ToString("yyyy-MM-dd")" />
        </form>

        <div class="daily-entry-progress"
             aria-label="Daily entry progress">

            <span data-completion="body" class="@CompletionClass(Model.BodyRecoveryComplete)">
                <b>1</b>
                Body &amp; Recovery
                <em>@CompletionText(Model.BodyRecoveryComplete)</em>
            </span>

            <span data-completion="workout" class="@CompletionClass(Model.WorkoutComplete)">
                <b>2</b>
                Training
                <em>@CompletionText(Model.WorkoutComplete)</em>
            </span>

            <span data-completion="nutrition" class="@CompletionClass(Model.NutritionComplete)">
                <b>3</b>
                Nutrition
                <em>@CompletionText(Model.NutritionComplete)</em>
            </span>
        </div>
    </section>

    <form asp-action="Index"
          method="post"
          id="daily-entry-autosave-form"
          class="daily-entry-form">

        @Html.AntiForgeryToken()
        <input asp-for="Date" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="validation"></div>

        <section class="daily-entry-section" id="body-recovery">

            <div class="daily-entry-section-heading">
                <div class="daily-entry-section-number">1</div>
                <div>
                    <h2>Body &amp; Recovery</h2>
                    <p>
                        Track the body-composition signals that matter most to
                        recomposition, plus the recovery signals that help shape
                        today's recommendation.
                    </p>
                </div>
            </div>

            <div class="daily-entry-info">
                <strong>Recomposition means fat down, skeletal muscle protected or up</strong>
                <span>
                    Body weight is useful, but it cannot tell that story by
                    itself. If your scale provides skeletal muscle,
                    subcutaneous fat, or visceral fat estimates, enter them
                    here and judge them by trend rather than a single reading.
                </span>

                @if (!string.IsNullOrWhiteSpace(Model.MeasurementSourceLabel))
                {
                    <small>Source: @Model.MeasurementSourceLabel</small>
                }
            </div>

            <div class="daily-entry-grid daily-entry-grid-body">

                <label>
                    Weight (lb)
                    <input asp-for="WeightLb"
                           inputmode="decimal"
                           step="0.1" />
                    <span asp-validation-for="WeightLb"></span>
                </label>

                <label>
                    Body fat (%)
                    <input asp-for="BodyFatPercent"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Optional</small>
                    <span asp-validation-for="BodyFatPercent"></span>
                </label>

                <label>
                    Skeletal muscle (lb)
                    <input asp-for="SkeletalMuscleMassLb"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Preferred muscle metric</small>
                    <span asp-validation-for="SkeletalMuscleMassLb"></span>
                </label>

                <label>
                    Subcutaneous fat (%)
                    <input asp-for="SubcutaneousFatPercent"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Optional</small>
                    <span asp-validation-for="SubcutaneousFatPercent"></span>
                </label>

                <label>
                    Visceral fat rating
                    <input asp-for="VisceralFatRating"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Optional</small>
                    <span asp-validation-for="VisceralFatRating"></span>
                </label>

                <label>
                    Body water (lb)
                    <input asp-for="BodyWaterLb"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Optional</small>
                    <span asp-validation-for="BodyWaterLb"></span>
                </label>

                <label>
                    Waist (in)
                    <input asp-for="WaistIn"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Optional secondary metric</small>
                    <span asp-validation-for="WaistIn"></span>
                </label>

                <label>
                    Hips (in)
                    <input asp-for="HipsIn"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Optional secondary metric</small>
                    <span asp-validation-for="HipsIn"></span>
                </label>

            </div>

            <div class="daily-entry-subheading">
                <h3>Recovery signals</h3>
                <p>
                    Sleep, resting heart rate, energy, soreness, pain, and
                    illness give the analytical engine context when evaluating
                    the workout on your Weekly Plan.
                </p>
            </div>

            <div class="daily-entry-grid">

                <label>
                    Sleep (hours)
                    <input asp-for="SleepHours"
                           inputmode="decimal"
                           step="0.1" />
                    <span asp-validation-for="SleepHours"></span>
                </label>

                <label>
                    Resting HR
                    <input asp-for="RestingHr"
                           inputmode="numeric" />
                    <span asp-validation-for="RestingHr"></span>
                </label>



                <label>
                    Energy (1-10)
                    <input asp-for="EnergyScore"
                           inputmode="numeric"
                           min="1"
                           max="10" />
                    <span asp-validation-for="EnergyScore"></span>
                </label>

                <label>
                    Soreness (1-10)
                    <input asp-for="SorenessScore"
                           inputmode="numeric"
                           min="1"
                           max="10" />
                    <span asp-validation-for="SorenessScore"></span>
                </label>

            </div>

            <div class="daily-entry-checks">
                <label>
                    <input asp-for="PainFlag" />
                    Pain or injury today
                </label>

                <label>
                    <input asp-for="IllnessFlag" />
                    Illness today
                </label>
            </div>

            <label class="daily-entry-notes">
                Recovery notes
                <textarea asp-for="RecoveryNotes" rows="2"></textarea>
                <small>Optional</small>
                <span asp-validation-for="RecoveryNotes"></span>
            </label>

        </section>

        <section class="daily-entry-section" id="training">

            <div class="daily-entry-section-heading">
                <div class="daily-entry-section-number">2</div>
                <div>
                    <h2>Training</h2>
                    <p>
                        Recomp starts with the Weekly Plan and replaces the
                        estimate with your actual workload when you log it.
                    </p>
                </div>
            </div>

            <div class="daily-entry-planned">
                <span>Planned today</span>
                <strong>@Model.PlannedWorkoutName</strong>
            </div>

            <div class="daily-entry-info">
                <strong>Your plan is already doing work</strong>
                <span>
                    Until you record an actual session, Recomp uses today's
                    planned workout in its calculations. After you train, the
                    system uses what you really did to recalculate workload,
                    glycogen demand, recovery, and future recommendations.
                </span>
            </div>

            <div id="workout-list" class="daily-entry-workouts">

@for (var i = 0; i < Model.Workouts.Count; i++)
                {
                    var workout = Model.Workouts[i];
                    var isSaved = workout.WorkoutSessionId.HasValue;

                    <article class="daily-entry-workout-card"
                             data-workout-row>

                        <input asp-for="Workouts[i].WorkoutSessionId"
                               type="hidden" />

                        <div class="daily-entry-workout-title">
                            <h3>@(isSaved ? $"Workout {i + 1}" : "Add workout")</h3>

                            @if (!string.IsNullOrWhiteSpace(workout.SourceLabel))
                            {
                                <small>Source: @workout.SourceLabel</small>
                            }
                        </div>

                        <div class="daily-entry-grid">

                            <label>
                                Workout type
                                <select asp-for="Workouts[i].WorkoutTypeCode">
                                    <option value="">Choose...</option>
                                    @foreach (var option in Model.WorkoutTypeOptions)
                                    {
                                        <option value="@option.Code">
                                            @option.DisplayName
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="Workouts[i].WorkoutTypeCode"></span>
                            </label>

                            <label>
                                Duration (minutes)
                                <input asp-for="Workouts[i].DurationMin"
                                       inputmode="decimal"
                                       step="1" />
                                <span asp-validation-for="Workouts[i].DurationMin"></span>
                            </label>

                            <label>
                                RPE
                                <input asp-for="Workouts[i].SessionRpe"
                                       inputmode="decimal"
                                       step="0.5"
                                       min="1"
                                       max="10" />
                                <small>
                                    8-9 very hard &bull; 5 light/moderate &bull;
                                    2-3 recovery/easy
                                </small>
                                <span asp-validation-for="Workouts[i].SessionRpe"></span>
                            </label>

                            <label>
                                Typical rest (seconds)
                                <input asp-for="Workouts[i].TypicalRestSec"
                                       inputmode="numeric" />
                                <small>Optional</small>
                                <span asp-validation-for="Workouts[i].TypicalRestSec"></span>
                            </label>

                            <label>
                                Device calories
                                <input asp-for="Workouts[i].DeviceCalories"
                                       inputmode="decimal"
                                       step="1" />
                                <small>Optional</small>
                                <span asp-validation-for="Workouts[i].DeviceCalories"></span>
                            </label>

                        </div>

                        @if (i == 0)
                        {
                            <div class="daily-entry-activity-grid">
                                <label>
                                    Daily activity (hours)
                                    <input asp-for="DailyActivityHours"
                                           type="number"
                                           inputmode="decimal"
                                           min="0"
                                           max="24"
                                           step="0.1" />
                                    <small>
                                        Non-workout activity for the day: walking,
                                        yardwork, housework, vehicle cleaning,
                                        moving, construction, and similar activity.
                                    </small>
                                    <span asp-validation-for="DailyActivityHours"></span>
                                </label>

                                <label>
                                    Activity effort
                                    <select asp-for="DailyActivityEffortCode">
                                        <option value="">Not specified</option>
                                        <option value="LIGHT">Light</option>
                                        <option value="MODERATE">Moderate</option>
                                        <option value="HARD">Hard</option>
                                    </select>
                                    <small>
                                        Overall effort of your non-workout activity
                                        for the day.
                                    </small>
                                    <span asp-validation-for="DailyActivityEffortCode"></span>
                                </label>
                            </div>
                        }

                        <label class="daily-entry-notes">
                            Workout notes
                            <textarea asp-for="Workouts[i].Notes"
                                      rows="2"></textarea>
                            <small>Optional</small>
                            <span asp-validation-for="Workouts[i].Notes"></span>
                        </label>

                    </article>
                }

            </div>

            <button id="add-workout"
                    class="daily-entry-add-workout"
                    type="button">
                + Add another workout
            </button>

            <p class="daily-entry-microcopy">
                Multiple sessions in one day are supported. Each session
                contributes independently to the analytical engine.
            </p>

            <template id="workout-template">
                <article class="daily-entry-workout-card" data-workout-row>

                    <input name="Workouts[__index__].WorkoutSessionId"
                           type="hidden"
                           value="" />

                    <div class="daily-entry-workout-title">
                        <h3>Additional workout</h3>
                    </div>

                    <div class="daily-entry-grid">

                        <label>
                            Workout type
                            <select name="Workouts[__index__].WorkoutTypeCode">
                                <option value="">Choose...</option>
                                @foreach (var option in Model.WorkoutTypeOptions)
                                {
                                    <option value="@option.Code">
                                        @option.DisplayName
                                    </option>
                                }
                            </select>
                        </label>

                        <label>
                            Duration (minutes)
                            <input name="Workouts[__index__].DurationMin"
                                   inputmode="decimal"
                                   step="1" />
                        </label>

                        <label>
                            RPE
                            <input name="Workouts[__index__].SessionRpe"
                                   inputmode="decimal"
                                   step="0.5"
                                   min="1"
                                   max="10" />
                            <small>
                                8-9 very hard &bull; 5 light/moderate &bull;
                                2-3 recovery/easy
                            </small>
                        </label>

                        <label>
                            Typical rest (seconds)
                            <input name="Workouts[__index__].TypicalRestSec"
                                   inputmode="numeric" />
                            <small>Optional</small>
                        </label>

                        <label>
                            Device calories
                            <input name="Workouts[__index__].DeviceCalories"
                                   inputmode="decimal"
                                   step="1" />
                            <small>Optional</small>
                        </label>

                    </div>

                    <label class="daily-entry-notes">
                        Workout notes
                        <textarea name="Workouts[__index__].Notes"
                                  rows="2"></textarea>
                        <small>Optional</small>
                    </label>

                </article>
            </template>

        </section>

        <section class="daily-entry-section" id="nutrition">

            <div class="daily-entry-section-heading">
                <div class="daily-entry-section-number">3</div>
                <div>
                    <h2>Nutrition</h2>
                    <p>
                        Bring over the daily totals from the food tracker you
                        already use. No second food diary required.
                    </p>
                </div>
            </div>

            <div class="daily-entry-info">
                <strong>Recomp turns totals into fueling intelligence</strong>
                <span>
                    Protein supports lean-mass retention. Carbohydrates restore
                    glycogen used by harder training. Recomp compares what you
                    ate with what your training demanded and carries that
                    information into the Dashboard.
                </span>

                @if (!string.IsNullOrWhiteSpace(Model.NutritionSourceLabel))
                {
                    <small>Source: @Model.NutritionSourceLabel</small>
                }
            </div>

            <div class="daily-entry-grid daily-entry-grid-nutrition">

                <label>
                    Calories
                    <input asp-for="Calories"
                           inputmode="decimal"
                           step="1" />
                    <span asp-validation-for="Calories"></span>
                </label>

                <label>
                    Protein (g)
                    <input asp-for="ProteinG"
                           inputmode="decimal"
                           step="1" />
                    <span asp-validation-for="ProteinG"></span>
                </label>

                <label>
                    Carbs (g)
                    <input asp-for="CarbsG"
                           inputmode="decimal"
                           step="1" />
                    <span asp-validation-for="CarbsG"></span>
                </label>

                <label>
                    Fat (g)
                    <input asp-for="FatG"
                           inputmode="decimal"
                           step="1" />
                    <span asp-validation-for="FatG"></span>
                </label>

                <label>
                    Fiber (g)
                    <input asp-for="FiberG"
                           inputmode="decimal"
                           step="1" />
                    <small>Optional</small>
                    <span asp-validation-for="FiberG"></span>
                </label>

                <label>
                    Water (oz)
                    <input asp-for="WaterOz"
                           inputmode="decimal"
                           step="1" />
                    <small>Optional</small>
                    <span asp-validation-for="WaterOz"></span>
                </label>

            </div>

            <label class="daily-entry-notes">
                Nutrition notes
                <textarea asp-for="NutritionNotes" rows="2"></textarea>
                <small>Optional</small>
                <span asp-validation-for="NutritionNotes"></span>
            </label>

            <div class="daily-entry-future">
                <strong>Built for easier entry later</strong>
                <span>
                    This page writes to normalized records that future scale,
                    nutrition-tracker, wearable, and workout integrations can
                    populate automatically.
                </span>
            </div>

        </section>

        <div class="daily-entry-autosave-row">
            <span id="daily-entry-autosave-status"
                  class="autosave-status"
                  aria-live="polite"
                  hidden></span>

            <noscript>
                <button class="daily-entry-save"
                        type="submit">
                    Save Daily Entry
                </button>
            </noscript>
        </div>

    </form>

</div>

<script>
    (() => {
        const addButton = document.getElementById('add-workout');
        const list = document.getElementById('workout-list');
        const template = document.getElementById('workout-template');

        if (!addButton || !list || !template) {
            return;
        }

        addButton.addEventListener('click', () => {
            const index =
                list.querySelectorAll('[data-workout-row]').length;

            const html =
                template.innerHTML.replaceAll(
                    '__index__',
                    index.toString());

            list.insertAdjacentHTML('beforeend', html);

            const rows =
                list.querySelectorAll('[data-workout-row]');

            const newest = rows[rows.length - 1];

            newest
                ?.querySelector('select, input')
                ?.focus();

            newest?.scrollIntoView({
                behavior: 'smooth',
                block: 'nearest'
            });
        });
    })();
</script>



<script>
(() => {
    const form = document.getElementById("daily-entry-autosave-form");

    window.RecompAutosave?.bind(form, {
        statusSelector: "#daily-entry-autosave-status",
        delay: 750,
        afterSave: payload => {
            refreshDailyEntryCompletion();
            if (!Array.isArray(payload?.workoutSessionIds)) {
                return;
            }

            const rows = form.querySelectorAll("[data-workout-row]");

            payload.workoutSessionIds.forEach((id, index) => {
                if (!id || !rows[index]) {
                    return;
                }

                const idField =
                    rows[index].querySelector(
                        'input[name$=".WorkoutSessionId"]');

                if (idField) {
                    idField.value = id;
                }
            });
        }
    });
})();
</script>

<script>
/* v1006-daily-entry-ui */
(() => {
    const dateInput = document.getElementById("daily-entry-date");

    dateInput?.addEventListener("change", () => {
        dateInput.form?.requestSubmit();
    });
})();

async function refreshDailyEntryCompletion() {
    const form = document.getElementById("daily-entry-autosave-form");
    if (!form) return;

    try {
        const url = new URL(window.location.href);
        const date = form.querySelector('input[name="Date"]')?.value;

        if (date) {
            url.searchParams.set("date", date);
        }

        const response = await fetch(url.toString(), {
            method: "GET",
            credentials: "same-origin",
            cache: "no-store"
        });

        if (!response.ok) return;

        const html = await response.text();
        const doc = new DOMParser().parseFromString(html, "text/html");

        ["body", "workout", "nutrition"].forEach(key => {
            const current = document.querySelector(
                `[data-completion="${key}"]`);

            const updated = doc.querySelector(
                `[data-completion="${key}"]`);

            if (!current || !updated) return;

            current.className = updated.className;

            const currentText = current.querySelector("em");
            const updatedText = updated.querySelector("em");

            if (currentText && updatedText) {
                currentText.textContent =
                    updatedText.textContent;
            }
        });
    }
    catch {
        // Autosave itself has already succeeded.
        // A completion-refresh failure should not interrupt entry.
    }
}
</script>