@model WebRecomp.Web.ViewModels.DailyEntryViewModel
@{
    ViewData["Title"] = "Daily Entry";

    var isGuidedDemo =
        User.FindFirst("recomp_demo")?.Value == "true"
        && User.FindFirst("recomp_demo_type")?.Value == "GUIDED";

    string CompletionClass(bool complete) =>
        complete ? "daily-entry-status is-complete" : "daily-entry-status";

    string CompletionText(bool complete) =>
        complete ? "Complete" : "Open";

    var systemCategoryOrder =
        WebRecomp.Web.Services.WorkoutIntelligence
            .SystemWorkoutRecipeCatalog
            .PresentationCategoryOrder;

    string SystemWorkoutCategory(string engineWorkoutTypeCode) =>
        WebRecomp.Web.Services.WorkoutIntelligence
            .SystemWorkoutRecipeCatalog
            .PresentationCategoryForEngineWorkoutType(
                engineWorkoutTypeCode);

    var nutritionFromFoodLog =
        string.Equals(
            Model.NutritionSourceLabel,
            "Food Log",
            StringComparison.OrdinalIgnoreCase);

    var nutritionManualOverride =
        Model.NutritionFoodLogEnabled
        && !nutritionFromFoodLog;
}

<link rel="stylesheet"
      href="~/css/daily-entry.css"
      asp-append-version="true" />

<div class="daily-entry-page">

    <header class="daily-entry-v2-hero">
        <div class="daily-entry-v2-copy">
            <p class="daily-entry-hero-eyebrow">Daily | Recomp Intelligence</p>
            <h1>Daily Entry</h1>
            <p class="daily-entry-v2-date">@Model.Date.ToString("dddd, MMMM d")</p>
            <p class="daily-entry-lede">
                Log your body, recovery, training, and nutrition so your plan stays current.
            </p>
        </div>

        <figure class="daily-entry-v2-photo">
            <img src="https://images.pexels.com/photos/4589504/pexels-photo-4589504.jpeg?auto=compress&amp;dpr=1&amp;h=750&amp;w=1260"
                 alt="Friends enjoying a healthy outdoor lunch together"
                 fetchpriority="high" />
        </figure>

        <div class="daily-entry-v2-actions">
            <form asp-action="Index"
                  method="get"
                  class="app-date-picker daily-entry-date-form">
                <label for="daily-entry-date">Date</label>
                <input id="daily-entry-date"
                       name="date"
                       type="date"
                       value="@Model.Date.ToString("yyyy-MM-dd")"
                       onchange="this.form.submit()" />
                <div class="app-adjacent-days">
                    <a asp-action="Index"
                       asp-route-date="@(Model.Date.AddDays(-1).ToString("yyyy-MM-dd"))"
                       aria-label="Previous day"
                       class="button app-day-nav-button">← Previous day</a>
                    <a asp-action="Index"
                       asp-route-date="@(Model.Date.AddDays(1).ToString("yyyy-MM-dd"))"
                       aria-label="Next day"
                       class="button app-day-nav-button">Next day →</a>
                </div>
            </form>
        </div>
    </header>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="daily-entry-success" role="status">
            @statusMessage
        </div>
    }

    @if (isGuidedDemo)
    {
        <aside class="guided-demo-callout" role="note">
            <strong>One daily page. The engine does the hard part.</strong>
            <span>
                Enter a few numbers here, then Recomp combines them with the
                Weekly Plan to update the recommendations on the Dashboard.
            </span>
        </aside>
    }

    <section class="daily-entry-datebar">


        <div class="daily-entry-progress"
             aria-label="Daily entry progress">

            <span data-completion="body" class="@CompletionClass(Model.BodyRecoveryComplete)">
                <b>1</b>
                Body &amp; Recovery
                <em>@CompletionText(Model.BodyRecoveryComplete)</em>
            </span>

            <span data-completion="workout" class="@CompletionClass(Model.WorkoutComplete)">
                <b>2</b>
                Training
                <em>@CompletionText(Model.WorkoutComplete)</em>
            </span>

            <span data-completion="nutrition" class="@CompletionClass(Model.NutritionComplete)">
                <b>3</b>
                Nutrition
                <em>@CompletionText(Model.NutritionComplete)</em>
            </span>
        </div>
    </section>

    <form asp-action="Index"
          method="post"
          id="daily-entry-autosave-form"
          class="daily-entry-form">

        @Html.AntiForgeryToken()
        <input asp-for="Date" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="validation"></div>

        <section class="daily-entry-section" id="body-recovery">

            <div class="daily-entry-section-heading">
                <div class="daily-entry-section-number">1</div>
                <div>
                    <h2>Body &amp; Recovery</h2>
                    <p>
                        Track the body-composition signals that matter most to
                        recomposition, plus the recovery signals that help shape
                        today's recommendation.
                    </p>
                </div>
            </div>

            <div class="daily-entry-info">
                <strong>Recomposition means fat down, skeletal muscle protected or up</strong>
                <span>
                    Body weight is useful, but it cannot tell that story by
                    itself. If your scale provides skeletal muscle,
                    subcutaneous fat, or visceral fat estimates, enter them
                    here and judge them by trend rather than a single reading.
                </span>

                @if (!string.IsNullOrWhiteSpace(Model.MeasurementSourceLabel))
                {
                    <small>Source: @Model.MeasurementSourceLabel</small>
                }
            </div>

            <div class="daily-entry-grid daily-entry-grid-body">

                <label>
                    Weight (lb)
                    <input asp-for="WeightLb"
                           inputmode="decimal"
                           step="0.1" />
                    <span asp-validation-for="WeightLb"></span>
                </label>

                <label>
                    Body fat (%)
                    <input asp-for="BodyFatPercent"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Optional</small>
                    <span asp-validation-for="BodyFatPercent"></span>
                </label>

                <label>
                    Skeletal muscle (lb)
                    <input asp-for="SkeletalMuscleMassLb"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Preferred muscle metric</small>
                    <span asp-validation-for="SkeletalMuscleMassLb"></span>
                </label>

                <label>
                    Subcutaneous fat (%)
                    <input asp-for="SubcutaneousFatPercent"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Optional</small>
                    <span asp-validation-for="SubcutaneousFatPercent"></span>
                </label>

                <label>
                    Visceral fat rating
                    <input asp-for="VisceralFatRating"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Optional</small>
                    <span asp-validation-for="VisceralFatRating"></span>
                </label>

                <label>
                    Body water (lb)
                    <input asp-for="BodyWaterLb"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Optional</small>
                    <span asp-validation-for="BodyWaterLb"></span>
                </label>

                <label>
                    Waist (in)
                    <input asp-for="WaistIn"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Optional secondary metric</small>
                    <span asp-validation-for="WaistIn"></span>
                </label>

                <label>
                    Hips (in)
                    <input asp-for="HipsIn"
                           inputmode="decimal"
                           step="0.1" />
                    <small>Optional secondary metric</small>
                    <span asp-validation-for="HipsIn"></span>
                </label>

            </div>

            <div class="daily-entry-subheading">
                <h3>Recovery signals</h3>
                <p>
                    Sleep, resting heart rate, energy, soreness, pain, and
                    illness give the analytical engine context when evaluating
                    the workout on your Weekly Plan.
                </p>
            </div>

            <div class="daily-entry-grid">

                <label>
                    Sleep (hours)
                    <input asp-for="SleepHours"
                           inputmode="decimal"
                           step="0.1" />
                    <span asp-validation-for="SleepHours"></span>
                </label>

                <label>
                    Resting HR
                    <input asp-for="RestingHr"
                           inputmode="numeric" />
                    <span asp-validation-for="RestingHr"></span>
                </label>



                <label>
                    Energy (1-10)
                    <input asp-for="EnergyScore"
                           inputmode="numeric"
                           min="1"
                           max="10" />
                    <span asp-validation-for="EnergyScore"></span>
                </label>

                <label>
                    Soreness (1-10)
                    <input asp-for="SorenessScore"
                           inputmode="numeric"
                           min="1"
                           max="10" />
                    <span asp-validation-for="SorenessScore"></span>
                </label>

            </div>

            <div class="daily-entry-checks">
                <label>
                    <input asp-for="PainFlag" />
                    Pain or injury today
                </label>

                <label>
                    <input asp-for="IllnessFlag" />
                    Illness today
                </label>
            </div>

            <label class="daily-entry-notes">
                Recovery notes
                <textarea asp-for="RecoveryNotes" rows="2"></textarea>
                <small>Optional</small>
                <span asp-validation-for="RecoveryNotes"></span>
            </label>

        </section>

        <section class="daily-entry-section" id="training">

            <div class="daily-entry-section-heading">
                <div class="daily-entry-section-number">2</div>
                <div>
                    <h2>Training</h2>
                    <p>
                        Recomp starts with the Weekly Plan and replaces the
                        estimate with your actual workload when you log it.
                    </p>
                </div>
            </div>

            <div class="daily-entry-planned">
                <span>Planned today</span>
                <strong>@Model.PlannedWorkoutName</strong>
            </div>

            <div class="daily-entry-info">
                <strong>Your plan is already doing work</strong>
                <span>
                    Until you record an actual session, Recomp uses today's
                    planned workout in its calculations. After you train, the
                    system uses what you really did to recalculate workload,
                    glycogen demand, recovery, and future recommendations.
                </span>
            </div>

            <!-- PHASE2D1_WORKOUT_BUILDER_LINK -->
            @if (Model.DetailedWorkoutEntryEnabled)
            {
                <div class="daily-entry-info daily-entry-workout-builder-link">
                    <div>
                        <strong>Workout Builder is active</strong>
                        <span>
                            Use the exercise-based builder for today's training,
                            saved workouts, sets, reps, and max weight.
                        </span>
                    </div>

                    <a class="button primary"
                       asp-controller="DetailedWorkout"
                       asp-action="Index"
                       asp-route-mode="@(!string.IsNullOrWhiteSpace(Model.PlannedSystemWorkoutCode) ? "system" : null)"
                       asp-route-systemCode="@Model.PlannedSystemWorkoutCode"
                       asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                       asp-route-returnContext="daily">
                        @(!string.IsNullOrWhiteSpace(Model.PlannedSystemWorkoutCode)
                            ? "Open Planned Workout"
                            : "Open Workout Builder")
                    </a>
                </div>
            }
            <div id="workout-list" class="daily-entry-workouts">

@for (var i = 0; i < Model.Workouts.Count; i++)
                {
                    var workout = Model.Workouts[i];
                    var isSaved = workout.WorkoutSessionId.HasValue;

                    <article class="daily-entry-workout-card"
                             data-workout-row>

                        <input asp-for="Workouts[i].WorkoutSessionId"
                               type="hidden" />
                        <input asp-for="Workouts[i].WorkoutTypeCode"
                               type="hidden"
                               data-daily-engine-code />
                        <input asp-for="Workouts[i].SystemWorkoutCode"
                               type="hidden"
                               data-daily-system-code />
                        <input asp-for="Workouts[i].WorkoutName"
                               type="hidden"
                               data-daily-workout-name />

                        <div class="daily-entry-workout-title">
                            <h3>
                                @(!string.IsNullOrWhiteSpace(workout.WorkoutName)
                                    ? workout.WorkoutName
                                    : isSaved
                                        ? $"Workout {i + 1}"
                                        : "Add workout")
                            </h3>

                            @if (!string.IsNullOrWhiteSpace(workout.SourceLabel))
                            {
                                <small>Source: @workout.SourceLabel</small>
                            }
                            @* B2.35.26_ENGINE_ACTUALS_LEDGER *@
                            @if (isSaved)
                            {
                                <div class="daily-entry-workout-correction">
                                    <a class="button"
                                       asp-controller="DetailedWorkout"
                                       asp-action="Index"
                                       asp-route-mode="live"
                                       asp-route-workoutSessionId="@workout.WorkoutSessionId"
                                       asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"
                                       asp-route-editCompleted="true"
                                       asp-route-returnContext="daily">
                                        Edit
                                    </a>

                                    <button type="button"
                                            class="button"
                                            data-workout-delete
                                            data-workout-session-id="@workout.WorkoutSessionId"
                                            data-workout-name="@workout.WorkoutName">
                                        Delete
                                    </button>

                                    <small>
                                        These controls modify this completed actual workout only.
                                        Saved My Workouts and System Workouts are not deleted.
                                    </small>
                                </div>
                            }
                        </div>

                        <div class="daily-entry-grid">

                            <label>
                                Workout type
                                <select class="daily-workout-type-select"
                                        data-collapsible-workout-picker
                                    data-daily-workout-type>
                                    <option value="">Choose...</option>

                                    @foreach (var categoryName in systemCategoryOrder)
                                    {
                                        var groupedWorkouts =
                                            Model.SystemWorkouts
                                                .Where(
                                                    x => SystemWorkoutCategory(
                                                x.EngineWorkoutTypeCode).Equals(
                                                categoryName,
                                                StringComparison.OrdinalIgnoreCase))
                                                .OrderBy(
                                                    x => x.DisplayName,
                                                    StringComparer.OrdinalIgnoreCase)
                                                .ToList();

                                        if (groupedWorkouts.Count == 0)
                                        {
                                            continue;
                                        }

                                        <optgroup label="@categoryName">
                                            @foreach (var option in groupedWorkouts)
                                            {
                                                var selectedSystem =
                                                    !string.IsNullOrWhiteSpace(
                                                        workout.SystemWorkoutCode)
                                                    && option.SystemCode.Equals(
                                                        workout.SystemWorkoutCode,
                                                        StringComparison.OrdinalIgnoreCase);

                                                <option value="@($"SYSTEM:{option.SystemCode}")"
                                                        data-workout-type-code="@option.EngineWorkoutTypeCode"
                                                        data-system-code="@option.SystemCode"
                                                        data-default-minutes="@option.DefaultMinutes"
                                                        data-default-rpe="@option.DefaultRpe"
                                                        selected="@(selectedSystem ? "selected" : null)">
                                                    @option.DisplayName
                                                </option>
                                            }
                                        </optgroup>
                                    }

                                    @if (string.IsNullOrWhiteSpace(workout.SystemWorkoutCode)
                                        && !string.IsNullOrWhiteSpace(workout.WorkoutTypeCode))
                                    {
                                        var fallback =
                                            Model.WorkoutTypeOptions
                                                .FirstOrDefault(
                                                    x => x.Code.Equals(
                                                        workout.WorkoutTypeCode,
                                                        StringComparison.OrdinalIgnoreCase));

                                        if (fallback is not null)
                                        {
                                            <option value="@($"MANUAL:{fallback.Code}")"
                                                    data-workout-type-code="@fallback.Code"
                                                    selected="selected">
                                                Current / manual: @fallback.DisplayName
                                            </option>
                                        }
                                    }

                                    @if (Model.DetailedWorkoutEntryEnabled)
                                    {
                                        <option value="__MY_WORKOUTS__">
                                            â–¶ My Workouts
                                        </option>
                                        <option value="__CREATE_CUSTOM__">
                                            + Create Custom Workout
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="Workouts[i].WorkoutTypeCode"></span>
                            </label>

                            <label data-cardio-activity-field
                                   hidden="@(!string.Equals(workout.SystemWorkoutCode, WebRecomp.Web.Services.WorkoutIntelligence.CardioActivityCatalog.PresentationSystemCode, StringComparison.OrdinalIgnoreCase))">
                                Cardio activity
                                <select asp-for="Workouts[i].CardioActivityCode"
                                        data-cardio-activity>
                                    <option value="">Choose activity...</option>
                                    @foreach (var activity in Model.CardioActivities)
                                    {
                                        <option value="@activity.ActivityCode">
                                            @activity.DisplayName
                                        </option>
                                    }
                                </select>
                                <small>Activity + duration + RPE feed the existing Engine 3.0 workout profile.</small>
                            </label>

                            <label>
                                Duration (minutes)
                                <input asp-for="Workouts[i].DurationMin"
                                       inputmode="decimal"
                                       step="1" />
                                <span asp-validation-for="Workouts[i].DurationMin"></span>
                            </label>

                            <label>
                                RPE
                                <input asp-for="Workouts[i].SessionRpe"
                                       inputmode="decimal"
                                       step="0.5"
                                       min="1"
                                       max="10" />
                                <small>
                                    8-9 very hard &bull; 5 light/moderate &bull;
                                    2-3 recovery/easy
                                </small>
                                <span asp-validation-for="Workouts[i].SessionRpe"></span>
                            </label>

                            <label>
                                Typical rest (seconds)
                                <input asp-for="Workouts[i].TypicalRestSec"
                                       inputmode="numeric" />
                                <small>Optional</small>
                                <span asp-validation-for="Workouts[i].TypicalRestSec"></span>
                            </label>

                            <label>
                                Device calories
                                <input asp-for="Workouts[i].DeviceCalories"
                                       inputmode="decimal"
                                       step="1" />
                                <small>Optional</small>
                                <span asp-validation-for="Workouts[i].DeviceCalories"></span>
                            </label>

                        </div>

                        @if (i == 0)
                        {
                            <div class="daily-entry-activity-grid">
                                <label>
                                    Daily activity (hours)
                                    <input asp-for="DailyActivityHours"
                                           type="number"
                                           inputmode="decimal"
                                           min="0"
                                           max="24"
                                           step="0.1" />
                                    <small>
                                        Non-workout activity for the day: walking,
                                        yardwork, housework, vehicle cleaning,
                                        moving, construction, and similar activity.
                                    </small>
                                    <span asp-validation-for="DailyActivityHours"></span>
                                </label>

                                <label>
                                    Activity effort
                                    <select asp-for="DailyActivityEffortCode">
                                        <option value="">Not specified</option>
                                        <option value="LIGHT">Light</option>
                                        <option value="MODERATE">Moderate</option>
                                        <option value="HARD">Hard</option>
                                    </select>
                                    <small>
                                        Overall effort of your non-workout activity
                                        for the day.
                                    </small>
                                    <span asp-validation-for="DailyActivityEffortCode"></span>
                                </label>
                            </div>
                        }

                        <label class="daily-entry-notes">
                            Workout notes
                            <textarea asp-for="Workouts[i].Notes"
                                      rows="2"></textarea>
                            <small>Optional</small>
                            <span asp-validation-for="Workouts[i].Notes"></span>
                        </label>

                    </article>
                }

            </div>

            <button id="add-workout"
                    class="daily-entry-add-workout"
                    type="button">
                + Add another workout
            </button>

            <p class="daily-entry-microcopy">
                Multiple sessions in one day are supported. Each session
                contributes independently to the analytical engine.
            </p>

            <template id="workout-template">
                <article class="daily-entry-workout-card" data-workout-row>

                    <input name="Workouts[__index__].WorkoutSessionId"
                           type="hidden"
                           value="" />
                    <input name="Workouts[__index__].WorkoutTypeCode"
                           type="hidden"
                           value=""
                           data-daily-engine-code />
                    <input name="Workouts[__index__].SystemWorkoutCode"
                           type="hidden"
                           value=""
                           data-daily-system-code />
                    <input name="Workouts[__index__].WorkoutName"
                           type="hidden"
                           value=""
                           data-daily-workout-name />

                    <div class="daily-entry-workout-title">
                        <h3>Additional workout</h3>
                    </div>

                    <div class="daily-entry-grid">

                        <label>
                            Workout type
                            <select class="daily-workout-type-select"
                                    data-collapsible-workout-picker
                                    data-daily-workout-type>
                                <option value="">Choose...</option>

                                @foreach (var categoryName in systemCategoryOrder)
                                {
                                    var groupedWorkouts =
                                        Model.SystemWorkouts
                                            .Where(
                                                x => SystemWorkoutCategory(
                                                x.EngineWorkoutTypeCode).Equals(
                                                categoryName,
                                                StringComparison.OrdinalIgnoreCase))
                                            .OrderBy(
                                                x => x.DisplayName,
                                                StringComparer.OrdinalIgnoreCase)
                                            .ToList();

                                    if (groupedWorkouts.Count == 0)
                                    {
                                        continue;
                                    }

                                    <optgroup label="@categoryName">
                                        @foreach (var option in groupedWorkouts)
                                        {
                                            <option value="@($"SYSTEM:{option.SystemCode}")"
                                                    data-workout-type-code="@option.EngineWorkoutTypeCode"
                                                    data-system-code="@option.SystemCode"
                                                    data-default-minutes="@option.DefaultMinutes"
                                                    data-default-rpe="@option.DefaultRpe">
                                                @option.DisplayName
                                            </option>
                                        }
                                    </optgroup>
                                }

                                @if (Model.DetailedWorkoutEntryEnabled)
                                {
                                    <option value="__MY_WORKOUTS__">
                                        â–¶ My Workouts
                                    </option>
                                    <option value="__CREATE_CUSTOM__">
                                        + Create Custom Workout
                                    </option>
                                }
                            </select>
                        </label>

                        <label data-cardio-activity-field hidden>
                            Cardio activity
                            <select name="Workouts[__index__].CardioActivityCode"
                                    data-cardio-activity>
                                <option value="">Choose activity...</option>
                                @foreach (var activity in Model.CardioActivities)
                                {
                                    <option value="@activity.ActivityCode">
                                        @activity.DisplayName
                                    </option>
                                }
                            </select>
                            <small>Activity + duration + RPE feed the existing Engine 3.0 workout profile.</small>
                        </label>

                        <label>
                            Duration (minutes)
                            <input name="Workouts[__index__].DurationMin"
                                   inputmode="decimal"
                                   step="1" />
                        </label>

                        <label>
                            RPE
                            <input name="Workouts[__index__].SessionRpe"
                                   inputmode="decimal"
                                   step="0.5"
                                   min="1"
                                   max="10" />
                            <small>
                                8-9 very hard &bull; 5 light/moderate &bull;
                                2-3 recovery/easy
                            </small>
                        </label>

                        <label>
                            Typical rest (seconds)
                            <input name="Workouts[__index__].TypicalRestSec"
                                   inputmode="numeric" />
                            <small>Optional</small>
                        </label>

                        <label>
                            Device calories
                            <input name="Workouts[__index__].DeviceCalories"
                                   inputmode="decimal"
                                   step="1" />
                            <small>Optional</small>
                        </label>

                    </div>

                    <label class="daily-entry-notes">
                        Workout notes
                        <textarea name="Workouts[__index__].Notes"
                                  rows="2"></textarea>
                        <small>Optional</small>
                    </label>

                </article>
            </template>

        </section>

        <section class="daily-entry-section" id="nutrition">

            <div class="daily-entry-section-heading">
                <div class="daily-entry-section-number">3</div>
                <div>
                    <h2>Nutrition</h2>
                    <p>
                        Daily Entry is the final nutrition summary used by
                        Engine 3.0. Use Food Log for detailed foods, or enter
                        totals here manually when you do not use the Food Log.
                    </p>
                </div>
            </div>

            <div class="daily-entry-info">
                <strong>One Engine-facing nutrition record</strong>
                <span>
                    Food Log totals flow into this Daily Entry automatically.
                    Manual Override always wins and remains in control until
                    you turn it off again.
                </span>

                <div style="display:flex;align-items:center;gap:.8rem;flex-wrap:wrap;margin-top:.65rem;">
                    @if (Model.NutritionFoodLogEnabled)
                    {
                        <a class="daily-entry-dashboard-link"
                           asp-controller="Nutrition"
                           asp-action="Index"
                           asp-route-date="@Model.Date.ToString("yyyy-MM-dd")">
                            Open Food Log
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.NutritionSourceLabel))
                    {
                        <small id="nutrition-source-label">
                            Source: @Model.NutritionSourceLabel
                        </small>
                    }
                    else
                    {
                        <small id="nutrition-source-label">
                            Source: Manual entry
                        </small>
                    }
                </div>
            </div>

            @if (Model.NutritionFoodLogEnabled)
            {
                <div class="daily-entry-info">
                    <strong>Nutrition source control</strong>
                    <span>
                        Leave Manual Override off to use current Food Log
                        totals. Turn it on when you want your manually entered
                        calories and macros to replace the calculated Food Log
                        values for this date.
                    </span>

                    <label style="display:flex;align-items:center;gap:.55rem;margin-top:.7rem;"
                           for="nutrition-manual-override">
                        @if (nutritionManualOverride)
                        {
                            <input id="nutrition-manual-override"
