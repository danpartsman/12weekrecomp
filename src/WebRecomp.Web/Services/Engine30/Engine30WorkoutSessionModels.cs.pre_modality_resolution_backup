namespace WebRecomp.Web.Services.Engine30;

/// <summary>
/// Engine 3.0 authoritative workout-session model.
///
/// This file defines WHAT happened (or is planned to happen).
/// It does not itself calculate calories or glycogen.
///
/// Both the workout-energy model and glycogen/fuel model should consume
/// this same authoritative workout description so that calories and fuel
/// are based on the same individual session.
///
/// Core principles:
/// - Workout type describes the physical activity; it does not dictate a
///   fixed calorie or glycogen result.
/// - Default RPE comes from Engine/config workout-type definitions.
/// - Planned RPE defaults from the workout type but is user-editable.
/// - Actual RPE overrides planned RPE for completed-session analysis.
/// - Monitor calories are evidence, not an automatic override.
/// - Monitor calorie type must identify ACTIVE, GROSS, or UNKNOWN when known.
/// - Glycogen is never inferred directly from monitor calorie totals.
/// </summary>

public static class Engine30WorkoutSessionCodes
{
    public const string StructureContinuous = "CONTINUOUS";
    public const string StructureResistanceSets = "RESISTANCE_SETS";
    public const string StructureIntervals = "INTERVALS";
    public const string StructureComposite = "COMPOSITE";

    public const string MonitorCaloriesActive = "ACTIVE";
    public const string MonitorCaloriesGross = "GROSS";
    public const string MonitorCaloriesUnknown = "UNKNOWN";

    public const string RpeSourceWorkoutTypeDefault = "WORKOUT_TYPE_DEFAULT";
    public const string RpeSourceUserPlannedOverride = "USER_PLANNED_OVERRIDE";
    public const string RpeSourceActualReported = "ACTUAL_REPORTED";

    public const string DurationSourcePlanned = "PLANNED";
    public const string DurationSourceActualReported = "ACTUAL_REPORTED";
}

/// <summary>
/// Config-owned definition of a workout type.
///
/// Example:
/// ZONE2_CARDIO may have DefaultRpe = 3.
///
/// Default RPE is a starting value only. The user may override it for the
/// plan, and the completed workout may have a different actual RPE.
/// </summary>
public sealed record Engine30WorkoutTypeProfile(
    string WorkoutTypeCode,
    string WorkoutFamilyCode,
    string SessionStructureCode,
    decimal DefaultRpe);

/// <summary>
/// Optional monitor/device evidence attached to the workout.
///
/// ReportedCalories must not be interpreted until ReportedCalorieTypeCode
/// is considered:
///
/// ACTIVE
///     Calories above resting expenditure. Conceptually comparable to
///     Engine 3.0 Bucket #3 after quality/reconciliation checks.
///
/// GROSS
///     Exercise-period calories including resting expenditure. Resting
///     calories for those minutes must be removed before comparison to
///     Bucket #3.
///
/// UNKNOWN
///     Do not silently assume active or gross. Treat as lower-confidence
///     evidence and request clarification when material.
///
/// Monitor calorie data may help reconcile workout ENERGY.
/// It does not directly determine glycogen depletion.
/// </summary>
public sealed record Engine30WorkoutMonitorData(
    string? DeviceSourceCode = null,
    string? DeviceModel = null,

    decimal? ReportedCalories = null,
    string? ReportedCalorieTypeCode = null,

    decimal? AverageHeartRateBpm = null,
    decimal? MaximumHeartRateBpm = null,

    decimal? MinutesZone1 = null,
    decimal? MinutesZone2 = null,
    decimal? MinutesZone3 = null,
    decimal? MinutesZone4 = null,
    decimal? MinutesZone5 = null);

/// <summary>
/// Optional objective workload measurements for a segment.
///
/// Populate only fields relevant to the modality.
/// Examples:
/// - Cycling: AverageWatts
/// - Treadmill: SpeedMph + GradePercent
/// - Rowing: AverageWatts and/or PaceSecondsPer500M
///
/// Objective workload should receive higher authority than generic
/// modality assumptions when measurement quality is adequate.
/// </summary>
public sealed record Engine30ObjectiveWorkload(
    decimal? AverageWatts = null,
    decimal? SpeedMph = null,
    decimal? GradePercent = null,
    decimal? PaceSecondsPer500M = null,
    decimal? DistanceMiles = null);

/// <summary>
/// Individual muscle-region work within a resistance segment.
///
/// HardSets and rest/density are intentionally separate from muscle-region
/// identity. Smaller muscles may have high local glycogen depletion even
/// though whole-body glycogen grams remain lower than a large-muscle session.
/// </summary>
public sealed record Engine30WorkoutMuscleWork(
    string MuscleGroupCode,
    decimal? HardSets = null,
    decimal? RecruitmentFraction = null);

/// <summary>
/// Resistance-specific session details.
///
/// AverageRestSeconds is meaningful for resistance work.
/// It should not be forced onto steady-state cardio.
/// </summary>
public sealed record Engine30ResistanceSegmentDetails(
    decimal? TotalHardSets = null,
    decimal? AverageRestSeconds = null,
    decimal? AverageRepsPerSet = null,
    decimal? AveragePercentOneRepMax = null,
    IReadOnlyCollection<Engine30WorkoutMuscleWork>? MuscleGroups = null);

/// <summary>
/// Interval-specific details.
///
/// Interval recovery is not the same concept as resistance-set rest.
/// </summary>
public sealed record Engine30IntervalSegmentDetails(
    decimal? WorkIntervalSeconds = null,
    decimal? RecoveryIntervalSeconds = null,
    int? Repetitions = null,
    decimal? WorkRpe = null,
    decimal? RecoveryRpe = null);

/// <summary>
/// One modality block within a workout.
///
/// Composite sessions such as Orangetheory can contain multiple segments:
/// treadmill + rower + floor/resistance.
///
/// A simple continuous workout may contain a single segment.
///
/// Segment DefaultRpe is an engine/config-provided starting point.
/// PlannedRpeOverride is optional and user-editable.
/// ActualRpe is the completed-session observation.
/// </summary>
public sealed record Engine30WorkoutSegmentInput(
    string SegmentCode,
    string ModalityCode,

    decimal PlannedDurationMinutes,
    decimal DefaultRpe,

    decimal? PlannedRpeOverride = null,
    decimal? ActualDurationMinutes = null,
    decimal? ActualRpe = null,

    Engine30ObjectiveWorkload? ObjectiveWorkload = null,
    Engine30ResistanceSegmentDetails? Resistance = null,
    Engine30IntervalSegmentDetails? Intervals = null);

/// <summary>
/// Authoritative planned/actual workout record consumed by Engine 3.0.
///
/// PlannedRpeOverride:
///     Null means use the workout-type default.
///     A supplied value means the user intentionally changed the planned RPE.
///
/// ActualRpe:
///     When present, completed-session calculations should use it instead of
///     planned/default RPE.
///
/// The original planned values remain preserved.
/// </summary>
public sealed record Engine30WorkoutSessionInput(
    string WorkoutTypeCode,

    decimal PlannedDurationMinutes,

    decimal? PlannedRpeOverride = null,
    decimal? ActualDurationMinutes = null,
    decimal? ActualRpe = null,

    Engine30WorkoutMonitorData? MonitorData = null,
    IReadOnlyCollection<Engine30WorkoutSegmentInput>? Segments = null);

/// <summary>
/// Resolved RPE value plus provenance.
/// </summary>
public sealed record Engine30ResolvedRpe(
    decimal Value,
    string SourceCode);

/// <summary>
/// Resolved duration value plus provenance.
/// </summary>
public sealed record Engine30ResolvedDuration(
    decimal Minutes,
    string SourceCode);

/// <summary>
/// Resolved workout session.
///
/// PlannedRpe is what should be displayed on Workout Plan / Dashboard.
/// AnalysisRpe is what the engine should use for current calculations:
/// actual RPE if reported, otherwise planned RPE.
///
/// Planned values are never destroyed when actual values arrive.
/// </summary>
public sealed record Engine30ResolvedWorkoutSession(
    string WorkoutTypeCode,
    string WorkoutFamilyCode,
    string SessionStructureCode,

    decimal DefaultRpe,

    Engine30ResolvedRpe PlannedRpe,
    Engine30ResolvedRpe AnalysisRpe,

    Engine30ResolvedDuration AnalysisDuration,

    Engine30WorkoutMonitorData? MonitorData,
    IReadOnlyCollection<Engine30WorkoutSegmentInput> Segments);

/// <summary>
/// Resolves workout-type defaults, user planned overrides, and actual
/// completed-session observations without changing the raw inputs.
///
/// This is intentionally deterministic and contains no calorie or glycogen
/// calculation.
/// </summary>
public sealed class Engine30WorkoutSessionResolver
{
    public Engine30ResolvedWorkoutSession Resolve(
        Engine30WorkoutTypeProfile profile,
        Engine30WorkoutSessionInput session)
    {
        ArgumentNullException.ThrowIfNull(profile);
        ArgumentNullException.ThrowIfNull(session);

        ValidateProfile(profile);
        ValidateSession(session);

        var profileWorkoutCode =
            NormalizeRequiredCode(
                profile.WorkoutTypeCode,
                nameof(profile.WorkoutTypeCode));

        var sessionWorkoutCode =
            NormalizeRequiredCode(
                session.WorkoutTypeCode,
                nameof(session.WorkoutTypeCode));

        if (profileWorkoutCode != sessionWorkoutCode)
        {
            throw new ArgumentException(
                $"Workout session type '{session.WorkoutTypeCode}' does not match " +
                $"profile type '{profile.WorkoutTypeCode}'.");
        }

        var familyCode =
            NormalizeRequiredCode(
                profile.WorkoutFamilyCode,
                nameof(profile.WorkoutFamilyCode));

        var structureCode =
            NormalizeStructureCode(
                profile.SessionStructureCode);

        var plannedRpe =
            session.PlannedRpeOverride.HasValue
                ? new Engine30ResolvedRpe(
                    Round(session.PlannedRpeOverride.Value, 1),
                    Engine30WorkoutSessionCodes.RpeSourceUserPlannedOverride)
                : new Engine30ResolvedRpe(
                    Round(profile.DefaultRpe, 1),
                    Engine30WorkoutSessionCodes.RpeSourceWorkoutTypeDefault);

        var analysisRpe =
            session.ActualRpe.HasValue
                ? new Engine30ResolvedRpe(
                    Round(session.ActualRpe.Value, 1),
                    Engine30WorkoutSessionCodes.RpeSourceActualReported)
                : plannedRpe;

        var analysisDuration =
            session.ActualDurationMinutes.HasValue
                ? new Engine30ResolvedDuration(
                    Round(session.ActualDurationMinutes.Value, 2),
                    Engine30WorkoutSessionCodes.DurationSourceActualReported)
                : new Engine30ResolvedDuration(
                    Round(session.PlannedDurationMinutes, 2),
                    Engine30WorkoutSessionCodes.DurationSourcePlanned);

        var segments =
            session.Segments
            ?? Array.Empty<Engine30WorkoutSegmentInput>();

        ValidateSegments(
            segments,
            structureCode);

        return new Engine30ResolvedWorkoutSession(
            WorkoutTypeCode:
                profileWorkoutCode,

            WorkoutFamilyCode:
                familyCode,

            SessionStructureCode:
                structureCode,

            DefaultRpe:
                Round(profile.DefaultRpe, 1),

            PlannedRpe:
                plannedRpe,

            AnalysisRpe:
                analysisRpe,

            AnalysisDuration:
                analysisDuration,

            MonitorData:
                NormalizeMonitorData(
                    session.MonitorData),

            Segments:
                segments.ToArray());
    }

    private static void ValidateProfile(
        Engine30WorkoutTypeProfile profile)
    {
        ValidateRpe(
            profile.DefaultRpe,
            nameof(profile.DefaultRpe));

        NormalizeRequiredCode(
            profile.WorkoutTypeCode,
            nameof(profile.WorkoutTypeCode));

        NormalizeRequiredCode(
            profile.WorkoutFamilyCode,
            nameof(profile.WorkoutFamilyCode));

        NormalizeStructureCode(
            profile.SessionStructureCode);
    }

    private static void ValidateSession(
        Engine30WorkoutSessionInput session)
    {
        NormalizeRequiredCode(
            session.WorkoutTypeCode,
            nameof(session.WorkoutTypeCode));

        if (session.PlannedDurationMinutes < 0m)
        {
            throw new ArgumentOutOfRangeException(
                nameof(session.PlannedDurationMinutes),
                "Planned duration cannot be negative.");
        }

        if (session.ActualDurationMinutes.HasValue &&
            session.ActualDurationMinutes.Value < 0m)
        {
            throw new ArgumentOutOfRangeException(
                nameof(session.ActualDurationMinutes),
                "Actual duration cannot be negative.");
        }

        if (session.PlannedRpeOverride.HasValue)
        {
            ValidateRpe(
                session.PlannedRpeOverride.Value,
                nameof(session.PlannedRpeOverride));
        }

        if (session.ActualRpe.HasValue)
        {
            ValidateRpe(
                session.ActualRpe.Value,
                nameof(session.ActualRpe));
        }
    }

    private static void ValidateSegments(
        IReadOnlyCollection<Engine30WorkoutSegmentInput> segments,
        string structureCode)
    {
        foreach (var segment in segments)
        {
            NormalizeRequiredCode(
                segment.SegmentCode,
                nameof(segment.SegmentCode));

            NormalizeRequiredCode(
                segment.ModalityCode,
                nameof(segment.ModalityCode));

            if (segment.PlannedDurationMinutes < 0m)
            {
                throw new ArgumentOutOfRangeException(
                    nameof(segment.PlannedDurationMinutes),
                    "Segment planned duration cannot be negative.");
            }

            if (segment.ActualDurationMinutes.HasValue &&
                segment.ActualDurationMinutes.Value < 0m)
            {
                throw new ArgumentOutOfRangeException(
                    nameof(segment.ActualDurationMinutes),
                    "Segment actual duration cannot be negative.");
            }

            ValidateRpe(
                segment.DefaultRpe,
                nameof(segment.DefaultRpe));

            if (segment.PlannedRpeOverride.HasValue)
            {
                ValidateRpe(
                    segment.PlannedRpeOverride.Value,
                    nameof(segment.PlannedRpeOverride));
            }

            if (segment.ActualRpe.HasValue)
            {
                ValidateRpe(
                    segment.ActualRpe.Value,
                    nameof(segment.ActualRpe));
            }

            if (segment.Resistance?.AverageRestSeconds is < 0m)
            {
                throw new ArgumentOutOfRangeException(
                    nameof(segment.Resistance.AverageRestSeconds),
                    "Resistance rest seconds cannot be negative.");
            }

            if (segment.Resistance?.TotalHardSets is < 0m)
            {
                throw new ArgumentOutOfRangeException(
                    nameof(segment.Resistance.TotalHardSets),
                    "Resistance hard sets cannot be negative.");
            }

            if (segment.Intervals?.Repetitions is < 0)
            {
                throw new ArgumentOutOfRangeException(
                    nameof(segment.Intervals.Repetitions),
                    "Interval repetitions cannot be negative.");
            }
        }

        if (structureCode == Engine30WorkoutSessionCodes.StructureComposite &&
            segments.Count < 2)
        {
            throw new ArgumentException(
                "A COMPOSITE workout must contain at least two segments.",
                nameof(segments));
        }
    }

    private static Engine30WorkoutMonitorData? NormalizeMonitorData(
        Engine30WorkoutMonitorData? monitor)
    {
        if (monitor is null)
        {
            return null;
        }

        if (monitor.ReportedCalories.HasValue &&
            monitor.ReportedCalories.Value < 0m)
        {
            throw new ArgumentOutOfRangeException(
                nameof(monitor.ReportedCalories),
                "Monitor-reported calories cannot be negative.");
        }

        if (monitor.AverageHeartRateBpm.HasValue &&
            monitor.AverageHeartRateBpm.Value <= 0m)
        {
            throw new ArgumentOutOfRangeException(
                nameof(monitor.AverageHeartRateBpm),
                "Average heart rate must be greater than zero.");
        }

        if (monitor.MaximumHeartRateBpm.HasValue &&
            monitor.MaximumHeartRateBpm.Value <= 0m)
        {
            throw new ArgumentOutOfRangeException(
                nameof(monitor.MaximumHeartRateBpm),
                "Maximum heart rate must be greater than zero.");
        }

        string? calorieType = null;

        if (!string.IsNullOrWhiteSpace(
            monitor.ReportedCalorieTypeCode))
        {
            calorieType =
                monitor.ReportedCalorieTypeCode
                    .Trim()
                    .ToUpperInvariant();

            if (calorieType != Engine30WorkoutSessionCodes.MonitorCaloriesActive &&
                calorieType != Engine30WorkoutSessionCodes.MonitorCaloriesGross &&
                calorieType != Engine30WorkoutSessionCodes.MonitorCaloriesUnknown)
            {
                throw new ArgumentException(
                    $"Unsupported monitor calorie type " +
                    $"'{monitor.ReportedCalorieTypeCode}'.");
            }
        }

        if (monitor.ReportedCalories.HasValue &&
            calorieType is null)
        {
            calorieType =
                Engine30WorkoutSessionCodes.MonitorCaloriesUnknown;
        }

        return monitor with
        {
            DeviceSourceCode =
                NormalizeOptionalCode(
                    monitor.DeviceSourceCode),

            ReportedCalorieTypeCode =
                calorieType
        };
    }

    private static string NormalizeStructureCode(
        string code)
    {
        var normalized =
            NormalizeRequiredCode(
                code,
                nameof(code));

        return normalized switch
        {
            Engine30WorkoutSessionCodes.StructureContinuous =>
                Engine30WorkoutSessionCodes.StructureContinuous,

            Engine30WorkoutSessionCodes.StructureResistanceSets =>
                Engine30WorkoutSessionCodes.StructureResistanceSets,

            Engine30WorkoutSessionCodes.StructureIntervals =>
                Engine30WorkoutSessionCodes.StructureIntervals,

            Engine30WorkoutSessionCodes.StructureComposite =>
                Engine30WorkoutSessionCodes.StructureComposite,

            _ =>
                throw new ArgumentException(
                    $"Unsupported session structure '{code}'.",
                    nameof(code))
        };
    }

    private static void ValidateRpe(
        decimal value,
        string parameterName)
    {
        if (value < 0m ||
            value > 10m)
        {
            throw new ArgumentOutOfRangeException(
                parameterName,
                "RPE must be between 0 and 10.");
        }
    }

    private static string NormalizeRequiredCode(
        string code,
        string parameterName)
    {
        if (string.IsNullOrWhiteSpace(code))
        {
            throw new ArgumentException(
                "Code is required.",
                parameterName);
        }

        return code
            .Trim()
            .ToUpperInvariant();
    }

    private static string? NormalizeOptionalCode(
        string? code)
        => string.IsNullOrWhiteSpace(code)
            ? null
            : code.Trim().ToUpperInvariant();

    private static decimal Round(
        decimal value,
        int decimals)
        => Math.Round(
            value,
            decimals,
            MidpointRounding.AwayFromZero);
}