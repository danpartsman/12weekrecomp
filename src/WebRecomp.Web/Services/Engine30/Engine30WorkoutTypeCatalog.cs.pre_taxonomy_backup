    private static readonly IReadOnlyDictionary<string, Engine30WorkoutTypeDefinition> ByCode =
        Definitions.ToDictionary(
            x => x.WorkoutTypeCode,
            StringComparer.OrdinalIgnoreCase);

    public IReadOnlyList<Engine30WorkoutTypeDefinition> GetAll()
        => Definitions;

    public Engine30WorkoutTypeDefinition GetRequired(
        string workoutTypeCode)
    {
        if (string.IsNullOrWhiteSpace(
            workoutTypeCode))
        {
            throw new ArgumentException(
                "Workout type code is required.",
                nameof(workoutTypeCode));
        }

        var normalized =
            workoutTypeCode
                .Trim()
                .ToUpperInvariant();

        if (!ByCode.TryGetValue(
            normalized,
            out var definition))
        {
            throw new KeyNotFoundException(
                $"Unknown Engine 3.0 workout type '{workoutTypeCode}'.");
        }

        return definition;
    }

    public bool TryGet(
        string workoutTypeCode,
        out Engine30WorkoutTypeDefinition? definition)
    {
        definition = null;

        if (string.IsNullOrWhiteSpace(
            workoutTypeCode))
        {
            return false;
        }

        return ByCode.TryGetValue(
            workoutTypeCode.Trim(),
            out definition);
    }

    public Engine30WorkoutTypeProfile GetProfile(
        string workoutTypeCode)
    {
        var definition =
            GetRequired(
                workoutTypeCode);

        return new Engine30WorkoutTypeProfile(
            WorkoutTypeCode:
                definition.WorkoutTypeCode,

            WorkoutFamilyCode:
                definition.WorkoutFamilyCode,

            SessionStructureCode:
                definition.SessionStructureCode,

            DefaultRpe:
                definition.DefaultRpe);
    }
