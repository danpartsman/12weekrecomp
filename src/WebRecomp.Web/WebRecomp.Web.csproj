<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InformationalVersion>v1014B</InformationalVersion>
    <RecompEngineVersion>3.0</RecompEngineVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="RecompEngineVersion" Value="$(RecompEngineVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebRecomp.WorkoutIntelligence\WebRecomp.WorkoutIntelligence.csproj" />
    <ProjectReference Include="..\WebRecomp.CatalogSync\WebRecomp.CatalogSync.csproj" />
    <ProjectReference Include="..\WebRecomp.NutritionIntelligence\WebRecomp.NutritionIntelligence.csproj" />
  </ItemGroup>

</Project>
