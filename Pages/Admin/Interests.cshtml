@page "/admin/interests"
@model TwelveWeekRecomp.Live.Pages.Admin.InterestsModel
@{
    ViewData["Title"] = "Signup List";
}
<section class="section admin-wide">
  <div class="admin-header">
    <div>
      <p class="eyebrow">LIVE ADMINISTRATION</p>
      <h1>Signup list</h1>
    </div>
    <div class="admin-actions compact">
      <a class="btn btn-secondary" href="/admin">Admin home</a>
      <a class="btn btn-primary" href="/admin/interests?handler=Export&search=@Uri.EscapeDataString(Model.Search ?? "")&interestCode=@Model.InterestCode&emailStatus=@Model.EmailStatus">Export CSV</a>
    </div>
  </div>

  <form method="get" class="filter-row">
    <input name="search" value="@Model.Search" placeholder="Search name or email" />
    <select name="interestCode">
      <option value="">All interests</option>
      <option value="FREE_UPDATES">Free trial updates</option>
      <option value="FOUNDERS_RATE">Founders Rate</option>
    </select>
    <select name="emailStatus">
      <option value="">All email statuses</option>
      <option value="ACTIVE">Active</option>
      <option value="UNSUBSCRIBED">Unsubscribed</option>
    </select>
    <button class="btn btn-secondary" type="submit">Filter</button>
  </form>

  <div class="table-wrap">
    <table class="admin-table">
      <thead><tr><th>Name</th><th>Email</th><th>Interest</th><th>Email</th><th>Submissions</th><th>Last submitted (UTC)</th><th>Welcome email</th></tr></thead>
      <tbody>
      @foreach (var row in Model.Rows)
      {
        <tr>
          <td>@row.Name</td>
          <td>@row.Email</td>
          <td>@row.InterestCode</td>
          <td>@row.EmailStatus</td>
          <td>@row.SubmissionCount</td>
          <td>@row.LastSubmittedUtc.ToString("yyyy-MM-dd HH:mm")</td>
          <td>@row.WelcomeEmailStatus</td>
        </tr>
      }
      </tbody>
    </table>
  </div>
  <p class="muted">Showing @Model.Rows.Count record(s), maximum 1,000.</p>
</section>
