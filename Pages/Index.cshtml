@page
@{
    ViewData["Title"] = "12 Week Recomp | Individualized Body Recomposition";
    ViewData["Description"] = "Move, lose fat, and eat to build muscle with an individualized recommendation engine, daily coach messages, and weekly progress guidance.";
    ViewData["CanonicalPath"] = "/";
}

@section Head {
<script type="application/ld+json">
{
  "@@context": "https://schema.org",
  "@@type": "WebApplication",
  "name": "12 Week Recomp",
  "applicationCategory": "HealthApplication",
  "operatingSystem": "Web",
  "url": "https://12weekrecomp.com/",
  "offers": {
    "@@type": "Offer",
    "price": "20.00",
    "priceCurrency": "USD"
  },
  "description": "A 12-week body recomposition program using individualized training and nutrition recommendations, daily coach messaging, and weekly progress guidance."
}
</script>
}

<section class="hero">
  <div class="shell hero-grid">
    <div>
      <span class="kicker">Coming Fall 2026</span>
      <h1>Move, lose fat, and <em>FUEL</em> to build muscle.</h1>
      <p class="lead">
        12 Week Recomp combines an individualized recommendation engine,
        daily coach messaging, and weekly progress notifications so the plan
        keeps adapting to your real training, recovery, and results.
      </p>
      <div class="button-row">
        <a class="button primary" asp-page="/Join">Join the prelaunch list</a>
        <a class="button secondary" asp-page="/Evidence">See the evidence</a>
      </div>
    </div>
    <div class="hero-card">
      <img src="/assets/group.jpg" alt="Fit men and women training together in a gym">
    </div>
  </div>
</section>

<section class="section alt">
  <div class="shell grid-3">
    <div class="price-card">
      <div class="eyebrow">Simple offer</div>
      <strong class="big">$20</strong>
      <p>
        for <strong>12 weeks</strong> of focused guidance designed to build
        knowledge and habits that stay with you long after the course ends.
      </p>
    </div>
    <div class="price-card">
      <div class="eyebrow">No trap</div>
      <strong class="big">Teach first</strong>
      <p>
        Our goal is to teach you, help you improve, develop lifetime habits, then get out of your way.
      </p>
    </div>
    <div class="price-card">
      <div class="eyebrow">Personalized</div>
      <strong class="big">Daily guidance</strong>
      <p>
        Recommendations are shaped by training demand, recovery context,
        nutrition, and progress trends rather than a one-size-fits-all diet sheet.
      </p>
    </div>
  </div>
</section>

<section class="section">
  <div class="shell">
    <div class="section-head">
      <h2>The engine is the difference.</h2>
      <p>
        This is more than generic fitness motivation. A real individualized
        recommendation engine sits underneath the coaching.
      </p>
    </div>

    <div class="grid-3">
      <article class="feature-card">
        <div class="icon">1</div>
        <h3>Individualized recommendation engine</h3>
        <p>
          The engine uses workout demand, recovery signals, nutrition,
          body-composition context, and plan structure to generate recommendations
          designed for your day.
        </p>
      </article>

      <article class="feature-card">
        <div class="icon">2</div>
        <h3>Daily trainer messages</h3>
        <p>
          Your coaches deliver daily messages built around your current situation:
          what to focus on today, how to fuel the work, and what matters most right now.
        </p>
      </article>

      <article class="feature-card">
        <div class="icon">3</div>
        <h3>Weekly progress notifications</h3>
        <p>
          Get weekly feedback, progress nudges, and practical hints and tips designed
          around your ongoing progress instead of generic advice blasts.
        </p>
      </article>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="shell">
    <div class="callout">
      <h3>Your plan should react to your real life.</h3>
      <p>
        Hard training days, easier recovery days, soreness, missed meals, strong workouts,
        and weekly progress changes all matter. 12 Week Recomp is built to respond with
        coaching that feels personal and useful.
      </p>
    </div>
  </div>
</section>

<section class="section">
  <div class="shell">
    <div class="section-head">
      <h2>Real coaching, real training, real food.</h2>
      <p>
        Cassie, Marisol, and Steve bring the program to life across training, nutrition,
        technique, adherence, and day-to-day execution.
      </p>
    </div>

    <div class="story-grid">
      <article class="story-card story-card-large">
        <img src="/assets/coach-training.jpg" alt="Cassie, Marisol, and Steve coaching a strength-training session">
        <div class="photo-copy">
          <div class="eyebrow">Train with purpose</div>
          <h3>Strength work that earns the adaptation</h3>
          <p>Technique, progressive overload, and enough fuel to support the work all matter.</p>
        </div>
      </article>

      <article class="story-card">
        <img src="/assets/coach-mealprep.jpg" alt="Cassie, Marisol, and Steve preparing balanced meals">
        <div class="photo-copy">
          <div class="eyebrow">Eat for the work</div>
          <h3>Practical nutrition, not punishment</h3>
        </div>
      </article>

      <article class="story-card">
        <img src="/assets/coach-snacks.jpg" alt="Cassie, Marisol, and Steve preparing simple protein-focused foods">
        <div class="photo-copy">
          <div class="eyebrow">Build repeatable habits</div>
          <h3>Simple choices you can keep using</h3>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="section alt">
  <div class="shell">
    <div class="section-head">
      <h2>A few screens to show the system in development.</h2>
      <p>
        The public site shows the application to reinforce that the
        recommendations, messages, and progress feedback come from a real platform.
      </p>
    </div>

    <div class="split">
      <div class="panel">
        <img src="/assets/weekly-plan.png" alt="12 Week Recomp weekly plan">
      </div>
      <div class="panel">
        <img src="/assets/fuel-refill.png" alt="12 Week Recomp fuel and glycogen refill guidance">
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="shell center">
    <div class="section-head">
      <h2>Three coaching roles. One engine truth.</h2>
      <p>
        The personalities can differ, but the individualized recommendation engine
        remains the source of the physiological plan.
      </p>
    </div>

    <div class="coach-grid">
      <article class="coach">
        <img src="/assets/cassie.jpg" alt="Cassie">
        <div class="coach-body">
          <div class="role">Main coach</div>
          <h3>Cassie</h3>
          <h4>Main Trainer &amp; Nutritionist</h4>
          <p>
            Primary day-to-day coach for training, nutrition timing, recovery context,
            and the complete recomp strategy.
          </p>
        </div>
      </article>

      <article class="coach">
        <img src="/assets/marisol.jpg" alt="Marisol">
        <div class="coach-body">
          <div class="role">Coaching specialist</div>
          <h3>Marisol</h3>
          <h4>Motivation, Technique, Mobility &amp; Fat-Loss-Day Specialist</h4>
          <p>
            Movement quality, mobility, adherence, and supportive messaging that helps
            users keep progressing.
          </p>
        </div>
      </article>

      <article class="coach">
        <img src="/assets/steve.jpg" alt="Steve">
        <div class="coach-body">
          <div class="role">Strength specialist</div>
          <h3>Steve</h3>
          <h4>Workout Technique, Progressive Overload &amp; Muscle-Building Specialist</h4>
          <p>
            Execution, progressive overload, and strength-training guidance designed
            to build or preserve muscle.
          </p>
        </div>
      </article>
    </div>
  </div>
</section>
