@page
@{
    ViewData["Title"] = "Privacy | 12 Week Recomp";
    ViewData["Description"] = "12 Week Recomp prelaunch privacy notice.";
    ViewData["CanonicalPath"] = "/privacy";
}
<section class="section hero" style="padding-top:58px">
  <div class="shell">
    <span class="kicker">Privacy</span>
    <h1>Prelaunch privacy notice</h1>
  </div>
</section>

<section class="section">
  <div class="shell narrow">
    <div class="callout">
      <p>
        The prelaunch form collects only the name, email address, and interest option you submit.
        That information is used for launch-related communications and to understand prelaunch interest.
      </p>
      <p>
        The prelaunch form does not collect payment-card information or postal addresses.
      </p>
      <p>
        Basic technical logs may be retained for security, abuse prevention, and site operation.
      </p>
    </div>
  </div>
</section>
