using WebRecomp.Web.Services.Engine30;
using Xunit.Abstractions;

namespace WebRecomp.Web.Tests;

public sealed class Engine30ResistanceGlycogenWorkloadCalculatorTests
{
    private readonly Engine30ResistanceGlycogenWorkloadCalculator _calculator = new();
    private readonly ITestOutputHelper _output;

    public Engine30ResistanceGlycogenWorkloadCalculatorTests(
        ITestOutputHelper output)
    {
        _output = output;
    }

    [Fact]
    public void ResistanceGlycogenWorkload_RespondsDirectionally_ToActualWork()
    {
        var config =
            new Engine30ResistanceGlycogenWorkloadConfig(
                ReferenceDurationMinutes:
                    60m,

                ReferenceHardSetsPerMuscleGroup:
                    8m,

                ReferenceDepletionFraction:
                    0.28m,

                HardSetSensitivity:
                    0.50m,

                DurationSensitivity:
                    0.25m,

                TrainedFactor:
                    1.00m,

                UntrainedFactor:
                    1.10m,

                ReferencePercentOneRepMax:
                    70m,

                PercentOneRepMaxSensitivity:
                    0.25m,

                MinimumDepletionFraction:
                    0.05m,

                MaximumDepletionFraction:
                    0.60m);

        var reference =
            Calculate(
                config,
                durationMinutes: 60m,
                hardSets: 8m,
                trainingStatus:
                    Engine30ResistanceGlycogenTrainingStatusCodes.Trained,
                percentOneRepMax: null);

        var moreSets =
            Calculate(
                config,
                durationMinutes: 60m,
                hardSets: 12m,
                trainingStatus:
                    Engine30ResistanceGlycogenTrainingStatusCodes.Trained,
                percentOneRepMax: null);

        var longerSession =
            Calculate(
                config,
                durationMinutes: 75m,
                hardSets: 8m,
                trainingStatus:
                    Engine30ResistanceGlycogenTrainingStatusCodes.Trained,
                percentOneRepMax: null);

        var untrained =
            Calculate(
                config,
                durationMinutes: 60m,
                hardSets: 8m,
                trainingStatus:
                    Engine30ResistanceGlycogenTrainingStatusCodes.Untrained,
                percentOneRepMax: null);

        var knownHigherLoad =
            Calculate(
                config,
                durationMinutes: 60m,
                hardSets: 8m,
                trainingStatus:
                    Engine30ResistanceGlycogenTrainingStatusCodes.Trained,
                percentOneRepMax: 84m);

        var zeroSets =
            Calculate(
                config,
                durationMinutes: 60m,
                hardSets: 0m,
                trainingStatus:
                    Engine30ResistanceGlycogenTrainingStatusCodes.Trained,
                percentOneRepMax: null);

        _output.WriteLine("");
        _output.WriteLine(
            "ENGINE 3.0 - RESISTANCE GLYCOGEN WORKLOAD RESOLVER");

        _output.WriteLine(
            "DRAFT coefficients; validates directional behavior and data flow only.");

        _output.WriteLine("");
        _output.WriteLine(
            new string('-', 112));

        _output.WriteLine(
            $"{"Case",-24} " +
            $"{"Min",6} " +
            $"{"Sets",6} " +
            $"{"SetRatio",9} " +
            $"{"DurRatio",9} " +
            $"{"BaseWork",9} " +
            $"{"Train",7} " +
            $"{"%1RM",7} " +
            $"{"LoadFx",7} " +
            $"{"Deplete",9}");

        _output.WriteLine(
            new string('-', 112));

        Print(
            "Reference",
            reference);

        Print(
            "More sets",
            moreSets);

        Print(
            "Longer session",
            longerSession);

        Print(
            "Untrained",
            untrained);

        Print(
            "Known 84% 1RM",
            knownHigherLoad);

        Print(
            "Zero hard sets",
            zeroSets);

        _output.WriteLine(
            new string('-', 112));

        var referenceMuscle =
            AssertSingleMuscle(
                reference);

        var moreSetsMuscle =
            AssertSingleMuscle(
                moreSets);

        var longerMuscle =
            AssertSingleMuscle(
                longerSession);

        var untrainedMuscle =
            AssertSingleMuscle(
                untrained);

        var higherLoadMuscle =
            AssertSingleMuscle(
                knownHigherLoad);

        var zeroSetsMuscle =
            AssertSingleMuscle(
                zeroSets);

        // Reference condition remains the configured reference depletion.
        Assert.Equal(
            1.0000m,
            referenceMuscle.HardSetRatio);

        Assert.Equal(
            1.0000m,
            referenceMuscle.DurationRatio);

        Assert.Equal(
            1.0000m,
            referenceMuscle.BaseWorkloadFactor);

        Assert.Equal(
            1.0000m,
            referenceMuscle.PercentOneRepMaxFactor);

        Assert.Equal(
            0.2800m,
            referenceMuscle.ResolvedDepletionFraction);

        // More hard sets at the same duration increase depletion.
        Assert.Equal(
            1.5000m,
            moreSetsMuscle.HardSetRatio);

        Assert.Equal(
            1.2500m,
            moreSetsMuscle.BaseWorkloadFactor);

        Assert.Equal(
            0.3500m,
            moreSetsMuscle.ResolvedDepletionFraction);

        // Longer duration with the same hard sets also increases depletion,
        // but only through the configured duration sensitivity.
        Assert.Equal(
            1.2500m,
            longerMuscle.DurationRatio);

        Assert.Equal(
            1.0625m,
            longerMuscle.BaseWorkloadFactor);

        Assert.Equal(
            0.2975m,
            longerMuscle.ResolvedDepletionFraction);

        // Training status is an explicit physiological modifier.
        Assert.Equal(
            1.1000m,
            untrainedMuscle.TrainingStatusFactor);

        Assert.Equal(
            0.3080m,
            untrainedMuscle.ResolvedDepletionFraction);

        // Actual known %1RM is preserved but is currently diagnostic only.
        // Without repetitions / load-volume, load alone does not change
        // glycogen depletion. RPE is not involved in this calculation.
        Assert.Equal(
            1.0000m,
            higherLoadMuscle.PercentOneRepMaxFactor);

        Assert.Equal(
            0.2800m,
            higherLoadMuscle.ResolvedDepletionFraction);

        // No meaningful work -> no depletion, regardless of configured minimum.
        Assert.Equal(
            0.0000m,
            zeroSetsMuscle.ResolvedDepletionFraction);

        // Directional checks.
        Assert.True(
            moreSetsMuscle.ResolvedDepletionFraction
            > referenceMuscle.ResolvedDepletionFraction);

        Assert.True(
            longerMuscle.ResolvedDepletionFraction
            > referenceMuscle.ResolvedDepletionFraction);

        Assert.True(
            untrainedMuscle.ResolvedDepletionFraction
            > referenceMuscle.ResolvedDepletionFraction);

        Assert.Equal(
            referenceMuscle.ResolvedDepletionFraction,
            higherLoadMuscle.ResolvedDepletionFraction);

        // The calculator produces muscle-group inputs ready for the
        // existing Engine30GlycogenDemandCalculator.
        Assert.Single(
            reference.ResolvedMuscleGroups);

        Assert.Equal(
            "LEGS",
            reference.ResolvedMuscleGroups[0].MuscleGroupCode);

        Assert.Equal(
            0.50m,
            reference.ResolvedMuscleGroups[0].WholeBodySkeletalMuscleFraction);

        Assert.Equal(
            0.85m,
            reference.ResolvedMuscleGroups[0].RecruitmentFraction);

        Assert.Equal(
            0.28m,
            reference.ResolvedMuscleGroups[0].DepletionFraction);
    }

    private Engine30ResistanceGlycogenWorkloadResult Calculate(
        Engine30ResistanceGlycogenWorkloadConfig config,
        decimal durationMinutes,
        decimal hardSets,
        string trainingStatus,
        decimal? percentOneRepMax)
    {
        return _calculator.Calculate(
            new Engine30ResistanceGlycogenWorkloadInput(
                DurationMinutes:
                    durationMinutes,

                TrainingStatusCode:
                    trainingStatus,

                MuscleGroups:
                    new[]
                    {
                        new Engine30ResistanceMuscleGlycogenWorkInput(
                            MuscleGroupCode:
                                "LEGS",

                            WholeBodySkeletalMuscleFraction:
                                0.50m,

                            RecruitmentFraction:
                                0.85m,

                            HardSets:
                                hardSets,

                            PercentOneRepMax:
                                percentOneRepMax)
                    }),

            config);
    }

    private static Engine30ResistanceMuscleGlycogenWorkResult AssertSingleMuscle(
        Engine30ResistanceGlycogenWorkloadResult result)
    {
        Assert.Single(
            result.MuscleResults);

        return result.MuscleResults[0];
    }

    private void Print(
        string label,
        Engine30ResistanceGlycogenWorkloadResult result)
    {
        var muscle =
            AssertSingleMuscle(
                result);

        var load =
            muscle.PercentOneRepMax.HasValue
                ? muscle.PercentOneRepMax.Value.ToString("0")
                : "-";

        _output.WriteLine(
            $"{label,-24} " +
            $"{result.DurationMinutes,6:0} " +
            $"{muscle.HardSets,6:0} " +
            $"{muscle.HardSetRatio,9:0.000} " +
            $"{muscle.DurationRatio,9:0.000} " +
            $"{muscle.BaseWorkloadFactor,9:0.000} " +
            $"{muscle.TrainingStatusFactor,7:0.000} " +
            $"{load,7} " +
            $"{muscle.PercentOneRepMaxFactor,7:0.000} " +
            $"{muscle.ResolvedDepletionFraction,9:0.0000}");
    }
}