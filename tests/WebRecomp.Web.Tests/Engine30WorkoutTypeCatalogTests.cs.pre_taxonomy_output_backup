using WebRecomp.Web.Services.Engine30;
using Xunit.Abstractions;

namespace WebRecomp.Web.Tests;

public sealed class Engine30WorkoutTypeCatalogTests
{
    private readonly Engine30WorkoutTypeCatalog _catalog = new();
    private readonly Engine30WorkoutSessionResolver _resolver = new();
    private readonly ITestOutputHelper _output;

    public Engine30WorkoutTypeCatalogTests(
        ITestOutputHelper output)
    {
        _output = output;
    }

    [Fact]
    public void Catalog_PrintsEveryWorkoutTypeAndValidatesDefaultRpe()
    {
        var definitions =
            _catalog.GetAll();

        Assert.NotEmpty(
            definitions);

        var duplicateCodes =
            definitions
                .GroupBy(
                    x => x.WorkoutTypeCode,
                    StringComparer.OrdinalIgnoreCase)
                .Where(
                    x => x.Count() > 1)
                .Select(
                    x => x.Key)
                .ToArray();

        Assert.Empty(
            duplicateCodes);

        _output.WriteLine("");
        _output.WriteLine(
            "ENGINE 3.0 â€” WORKOUT TYPE / DEFAULT RPE CATALOG");

        _output.WriteLine(
            "Default RPE is a planning starting value only and remains user-editable.");

        _output.WriteLine("");

        _output.WriteLine(
            new string('-', 124));

        _output.WriteLine(
            $"{"Code",-24} " +
            $"{"Display",-32} " +
            $"{"Family",-12} " +
            $"{"Structure",-17} " +
            $"{"RPE",5}");

        _output.WriteLine(
            new string('-', 124));

        foreach (var definition in definitions)
        {
            Assert.False(
                string.IsNullOrWhiteSpace(
                    definition.WorkoutTypeCode));

            Assert.False(
                string.IsNullOrWhiteSpace(
                    definition.DisplayName));

            Assert.False(
                string.IsNullOrWhiteSpace(
                    definition.WorkoutFamilyCode));

            Assert.False(
                string.IsNullOrWhiteSpace(
                    definition.SessionStructureCode));

            Assert.InRange(
                definition.DefaultRpe,
                0m,
                10m);

            _output.WriteLine(
                $"{definition.WorkoutTypeCode,-24} " +
                $"{definition.DisplayName,-32} " +
                $"{definition.WorkoutFamilyCode,-12} " +
                $"{definition.SessionStructureCode,-17} " +
                $"{definition.DefaultRpe,5:0.0}");
        }

        _output.WriteLine(
            new string('-', 124));

        var zone2 =
            _catalog.GetRequired(
                "ZONE2_CARDIO");

        Assert.Equal(
            3m,
            zone2.DefaultRpe);

        var rest =
            _catalog.GetRequired(
                "REST");

        Assert.Equal(
            0m,
            rest.DefaultRpe);
    }

    [Fact]
    public void Zone2_NoOverride_UsesDefaultRpe3()
    {
        var profile =
            _catalog.GetProfile(
                "ZONE2_CARDIO");

        var resolved =
            _resolver.Resolve(
                profile,
                new Engine30WorkoutSessionInput(
                    WorkoutTypeCode:
                        "ZONE2_CARDIO",

                    PlannedDurationMinutes:
                        45m));

        Assert.Equal(
            3m,
            resolved.DefaultRpe);

        Assert.Equal(
            3m,
            resolved.PlannedRpe.Value);

        Assert.Equal(
            Engine30WorkoutSessionCodes.RpeSourceWorkoutTypeDefault,
            resolved.PlannedRpe.SourceCode);

        Assert.Equal(
            3m,
            resolved.AnalysisRpe.Value);

        Assert.Equal(
            Engine30WorkoutSessionCodes.RpeSourceWorkoutTypeDefault,
            resolved.AnalysisRpe.SourceCode);

        Assert.Equal(
            45m,
            resolved.AnalysisDuration.Minutes);

        Assert.Equal(
            Engine30WorkoutSessionCodes.DurationSourcePlanned,
            resolved.AnalysisDuration.SourceCode);
    }

    [Fact]
    public void PlannedRpeOverride_PreservesUserChoice()
    {
        var profile =
            _catalog.GetProfile(
                "ZONE2_CARDIO");

        var resolved =
            _resolver.Resolve(
                profile,
                new Engine30WorkoutSessionInput(
                    WorkoutTypeCode:
                        "ZONE2_CARDIO",

                    PlannedDurationMinutes:
                        45m,

                    PlannedRpeOverride:
                        4m));

        Assert.Equal(
            3m,
            resolved.DefaultRpe);

        Assert.Equal(
            4m,
            resolved.PlannedRpe.Value);

        Assert.Equal(
            Engine30WorkoutSessionCodes.RpeSourceUserPlannedOverride,
            resolved.PlannedRpe.SourceCode);

        Assert.Equal(
            4m,
            resolved.AnalysisRpe.Value);
    }

    [Fact]
    public void ActualWorkout_OverridesAnalysisButDoesNotDestroyPlan()
    {
        var profile =
            _catalog.GetProfile(
                "ZONE2_CARDIO");

        var resolved =
            _resolver.Resolve(
                profile,
                new Engine30WorkoutSessionInput(
                    WorkoutTypeCode:
                        "ZONE2_CARDIO",

                    PlannedDurationMinutes:
                        45m,

                    PlannedRpeOverride:
                        4m,

                    ActualDurationMinutes:
                        52m,

                    ActualRpe:
                        5m));

        Assert.Equal(
            4m,
            resolved.PlannedRpe.Value);

        Assert.Equal(
            Engine30WorkoutSessionCodes.RpeSourceUserPlannedOverride,
            resolved.PlannedRpe.SourceCode);

        Assert.Equal(
            5m,
            resolved.AnalysisRpe.Value);

        Assert.Equal(
            Engine30WorkoutSessionCodes.RpeSourceActualReported,
            resolved.AnalysisRpe.SourceCode);

        Assert.Equal(
            52m,
            resolved.AnalysisDuration.Minutes);

        Assert.Equal(
            Engine30WorkoutSessionCodes.DurationSourceActualReported,
            resolved.AnalysisDuration.SourceCode);
    }

    [Fact]
    public void MajorLegs_UsesResistanceDefaultButAllowsActualOverride()
    {
        var profile =
            _catalog.GetProfile(
                "MAJOR_LEGS");

        var planned =
            _resolver.Resolve(
                profile,
                new Engine30WorkoutSessionInput(
                    WorkoutTypeCode:
                        "MAJOR_LEGS",

                    PlannedDurationMinutes:
                        60m));

        Assert.Equal(
            8m,
            planned.PlannedRpe.Value);

        var actual =
            _resolver.Resolve(
                profile,
                new Engine30WorkoutSessionInput(
                    WorkoutTypeCode:
                        "MAJOR_LEGS",

                    PlannedDurationMinutes:
                        60m,

                    ActualDurationMinutes:
                        70m,

                    ActualRpe:
                        9m));

        Assert.Equal(
            8m,
            actual.PlannedRpe.Value);

        Assert.Equal(
            9m,
            actual.AnalysisRpe.Value);

        Assert.Equal(
            70m,
            actual.AnalysisDuration.Minutes);
    }

    [Fact]
    public void Orangetheory_IsComposite_DefaultRpe7_AndSupportsSegments()
    {
        var profile =
            _catalog.GetProfile(
                "ORANGETHEORY");

        var resolved =
            _resolver.Resolve(
                profile,
                new Engine30WorkoutSessionInput(
                    WorkoutTypeCode:
                        "ORANGETHEORY",

                    PlannedDurationMinutes:
                        60m,

                    Segments:
                        new[]
                        {
                            new Engine30WorkoutSegmentInput(
                                SegmentCode:
                                    "TREAD",

                                ModalityCode:
                                    "TREADMILL",

                                PlannedDurationMinutes:
                                    20m,

                                DefaultRpe:
                                    7m),

                            new Engine30WorkoutSegmentInput(
                                SegmentCode:
                                    "ROW",

                                ModalityCode:
                                    "ROWING",

                                PlannedDurationMinutes:
                                    20m,

                                DefaultRpe:
                                    7m),

                            new Engine30WorkoutSegmentInput(
                                SegmentCode:
                                    "FLOOR",

                                ModalityCode:
                                    "RESISTANCE",

                                PlannedDurationMinutes:
                                    20m,

                                DefaultRpe:
                                    7m,

                                Resistance:
                                    new Engine30ResistanceSegmentDetails(
                                        TotalHardSets:
                                            8m,

                                        AverageRestSeconds:
                                            45m))
                        }));

        Assert.Equal(
            Engine30WorkoutSessionCodes.StructureComposite,
            resolved.SessionStructureCode);

        Assert.Equal(
            7m,
            resolved.PlannedRpe.Value);

        Assert.Equal(
            3,
            resolved.Segments.Count);
    }

    [Fact]
    public void MonitorCaloriesWithoutType_ArePreservedAsUnknownEvidence()
    {
        var profile =
            _catalog.GetProfile(
                "GENERAL_CARDIO");

        var resolved =
            _resolver.Resolve(
                profile,
                new Engine30WorkoutSessionInput(
                    WorkoutTypeCode:
                        "GENERAL_CARDIO",

                    PlannedDurationMinutes:
                        30m,

                    MonitorData:
                        new Engine30WorkoutMonitorData(
                            DeviceSourceCode:
                                "WATCH",

                            ReportedCalories:
                                300m)));

        Assert.NotNull(
            resolved.MonitorData);

        Assert.Equal(
            300m,
            resolved.MonitorData!.ReportedCalories);

        Assert.Equal(
            Engine30WorkoutSessionCodes.MonitorCaloriesUnknown,
            resolved.MonitorData.ReportedCalorieTypeCode);
    }
}